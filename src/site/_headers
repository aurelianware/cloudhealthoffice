# Cloudflare Pages headers
# Migrated from staticwebapp.config.json "globalHeaders" + per-route headers.
# Syntax: a path pattern on its own line, followed by indented "Header: value".
#
# mimeTypes from the SWA config were intentionally dropped — Cloudflare Pages
# sets Content-Type automatically from the file extension (.svg -> image/svg+xml,
# .css -> text/css, .js -> text/javascript, .json -> application/json,
# .xml -> application/xml, .txt -> text/plain, .html -> text/html).
#
# IMPORTANT — path matching: Cloudflare Pages matches _headers patterns against
# the REQUEST path, not the file that is ultimately served. Because pages are
# served at clean URLs (e.g. /pricing, which Pages serves from pricing.html
# by default), a "/*.html" rule would never match those requests. So the HTML
# cache policy is set as the default on "/*" instead, and the asset paths
# override it below. Pages does NOT let the more specific rule win: it joins
# the values of every matching rule into one header (verified with
# `wrangler pages dev`: "public, max-age=3600, public, max-age=604800"). So each
# override first detaches the inherited header with "! Cache-Control".

# Global: security headers + default short cache (covers HTML at clean URLs,
# /sitemap.xml, /robots.txt, and anything else not overridden below)
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cache-Control: public, max-age=3600

# CSS and JS keep stable, un-hashed filenames (css/sentinel.css, js/*.js), so
# they must NOT be cached as immutable: a one-year immutable cache would pin
# returning visitors to the old file after every change. Short cache plus
# stale-while-revalidate keeps repeat views fast while picking up changes
# within the hour.
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Images also keep stable filenames (og images, logos), so a week, not immutable.
/graphics/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
