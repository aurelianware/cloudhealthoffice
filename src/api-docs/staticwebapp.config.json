{
  "routes": [
    {
      "route": "/fhir/r4",
      "redirect": "/?spec=patient-access",
      "statusCode": 302
    },
    {
      "route": "/fhir/r4/*",
      "redirect": "/?spec=patient-access",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Access-Control-Allow-Origin": "https://portal.cloudhealthoffice.com"
  },
  "mimeTypes": {
    ".yaml": "text/yaml",
    ".json": "application/json"
  }
}
