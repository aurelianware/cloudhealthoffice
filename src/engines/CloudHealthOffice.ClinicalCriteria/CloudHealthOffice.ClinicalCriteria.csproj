<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CloudHealthOffice.ClinicalCriteria</RootNamespace>
    <AssemblyName>CloudHealthOffice.ClinicalCriteria</AssemblyName>
    <Description>
      Clinical criteria seam for utilization management. Routes a criteria
      request to a configured provider (InterQual, MCG, or the in-repo rule
      engine) and returns one normalized evaluation. Ships no licensed
      criteria content.
    </Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudHealthOffice.PriorAuthRuleEngine\CloudHealthOffice.PriorAuthRuleEngine.csproj" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Microsoft.Extensions.Options.ConfigurationExtensions (services.Configure(IConfigurationSection))
         arrives transitively with Hosting.Abstractions, as in the PA rule engine. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
