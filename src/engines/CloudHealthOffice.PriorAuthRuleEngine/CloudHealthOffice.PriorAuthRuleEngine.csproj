<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
    <RootNamespace>CloudHealthOffice.PriorAuthRuleEngine</RootNamespace>
    <AssemblyName>CloudHealthOffice.PriorAuthRuleEngine</AssemblyName>
    <Description>
      State-specific prior authorization decision rule engine.
      Resolves applicable rule sets by (StateCode, LOB, Program) and evaluates
      them in priority order. Produces Approve / Deny / Pend decisions consumed
      by PasAutoAdjudicator and the authorization-service directly.
    </Description>
    <Version>4.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surface the internal CachedRuleSet serialization wrapper to the
         tests project so NSubstitute can set up returns on the exact
         ICacheProvider.GetOrSetAsync<T> instantiation used by
         RedisPaRuleRepository — generic method match is per-T. -->
    <InternalsVisibleTo Include="CloudHealthOffice.PriorAuthRuleEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- StackExchange.Redis arrives transitively from CloudHealthOffice.Infrastructure.
         RedisPaRuleRepository still touches IConnectionMultiplexer/IServer directly
         for the state-level SCAN invalidation path — a deliberate exception documented
         on the class. See docs/architecture/shared-cache.md and Addendum A.7.2. -->
    <ProjectReference Include="..\..\services\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />

    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="MongoDB.Driver"                      Version="3.7.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options"        Version="8.0.2" />
  </ItemGroup>

</Project>
