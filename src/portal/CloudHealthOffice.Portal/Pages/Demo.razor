@page "/demo"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Guided demo - Cloud Health Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <!-- Synthetic data banner. Every figure a visitor sees elsewhere in the portal comes from the demo tenant's synthetic records; this page shows none of its own. -->
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Icon="@Icons.Material.Filled.Science">
        <MudText Typo="Typo.h6">Synthetic demo environment</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            Every member, provider, claim and authorization here is synthetic. Nothing is live payer data,
            and this environment is not a production or HIPAA-attested deployment.
        </MudText>
    </MudAlert>

    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Explore" Class="mr-2" />
        Guided demo
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Work through these in order. Each one opens the real screen a plan's staff would use, running on the demo tenant.
    </MudText>

    <MudGrid>
        @foreach (var step in Steps)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Style="height: 100%" Class="d-flex flex-column">
                    <MudCardContent Class="flex-grow-1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Step @step.Number</MudText>
                        <MudText Typo="Typo.h6" GutterBottom="true">@step.Title</MudText>
                        <MudText Typo="Typo.body2">@step.LookFor</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton StartIcon="@step.Icon" Color="Color.Primary" Href="@step.Href" Variant="Variant.Text">
                            Open →
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="mt-6 pa-6" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">What is built, and what is not yet proven</MudText>
        <MudList Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                <MudText><strong>Claims:</strong> 837 intake, adjudication with NCCI edits, 835 remittance, and an advisory AI examiner whose recommendations a person decides on.</MudText>
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                <MudText><strong>CMS-0057-F APIs:</strong> Patient Access, Provider Access with bulk export, Payer-to-Payer, Prior Authorization (Da Vinci PAS) and a public Plan-Net provider directory are built.</MudText>
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                <MudText><strong>SMART Backend Services:</strong> passed the hosted Inferno Bulk Data test group against this demo environment.</MudText>
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Info" IconColor="Color.Info">
                <MudText><strong>Not yet:</strong> production use at a health plan, full Da Vinci and Plan-Net conformance runs, and adapters to an existing core system, which are built per engagement.</MudText>
            </MudListItem>
        </MudList>
    </MudPaper>

    <MudPaper Class="mt-6 pa-6" Elevation="3">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h5" GutterBottom="true">Want to see it with your plan's workflows?</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    We run pilots on synthetic or de-identified data first, beside your existing core system.
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center justify-center">
                <MudButton Href="/contact-sales"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Forum"
                           FullWidth="true">
                    Talk to us
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private sealed record DemoStep(int Number, string Title, string LookFor, string Href, string Icon);

    // Steps 3 to 7 open the prior authorizations scripts/demo/gcp/cho_demo.py seed-story loads (fixed ids).
    private static readonly DemoStep[] Steps =
    [
        new(1, "Members and eligibility",
            "Open a member to see coverage spans, dependents, ID cards and accumulators.",
            "/members", Icons.Material.Filled.People),
        new(2, "A claim, adjudicated",
            "Open a paid claim for its line-level adjudication, then a pended one for the AI examiner's advisory note.",
            "/claims", Icons.Material.Filled.Description),
        new(3, "Prior auth approved in minutes",
            "Maria Alvarez's lumbar MRI is on the plan's auto-approve list, so a rule approved it six minutes after receipt.",
            "/authorizations/story-pa-auto-approved/review", Icons.Material.Filled.Bolt),
        new(4, "A partial approval, line by line",
            "Daniel Brooks asked for 12 therapy visits and manual therapy. Each line has its own decision and a coded reason.",
            "/authorizations/story-pa-partial/services", Icons.Material.Filled.Rule),
        new(5, "A denial with a specific reason",
            "Keisha Thompson's knee arthroscopy was denied because conservative therapy wasn't documented.",
            "/authorizations/story-pa-denied/services", Icons.Material.Filled.Block),
        new(6, "One lawful 14-day extension",
            "Samuel Ortiz's sleep study needs consult notes. The deadline moved once, and the member notice is recorded.",
            "/authorizations/story-pa-extended/review", Icons.Material.Filled.EventRepeat),
        new(7, "An expedited request on the clock",
            "Ana Lopez's expedited inpatient request is still open. See how close it is to its 72-hour decision deadline.",
            "/authorizations/story-pa-expedited-open/review", Icons.Material.Filled.Timer),
        new(8, "CMS-0057-F compliance console",
            "Decision timeliness across all requests and the metrics a plan must post publicly each year.",
            "/compliance/cms-0057f", Icons.Material.Filled.Policy),
        new(9, "Batch adjudication",
            "Benchmark runs: claim counts, throughput and dead letters for each run on this environment.",
            "/mass-adjudication-runs", Icons.Material.Filled.Speed),
    ];
}
