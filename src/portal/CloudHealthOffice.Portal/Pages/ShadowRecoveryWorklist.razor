@page "/shadow-adjudication/findings"
@attribute [Authorize]
@using CloudHealthOffice.Portal.Infrastructure
@using CloudHealthOffice.Portal.Services
@using System.Globalization
@inject IShadowFindingsClient Findings
@inject IUserContextService UserContextService
@inject ISnackbar Snackbar

@*
    The recovery worklist: payment differences from shadow runs, one per claim,
    with the plan's review of each, provider roll-ups, the recoupment lookback
    and the CSV for the plan's own mass adjustment. CHO never writes to the core
    and never contacts a provider. Reading needs claims:import; reviewing needs
    claims:adjust. See docs/integration/SHADOW-ADJUDICATION.md#recovery-worklist.
*@

<PageTitle>Recovery worklist - Cloud Health Office</PageTitle>

<PermissionGate Permission="claims:import" RoleName="Claims Import">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
        Recovery worklist
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Every claim where a shadow run says your core paid the wrong amount, for your claims and payment-integrity teams to review.
        Approved findings go through your core's own mass-adjustment process (export below); record here what came back.
        Cloud Health Office never changes a claim in your core and never contacts a provider. <MudLink Href="/shadow-adjudication">Shadow runs</MudLink>
    </MudText>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _error = null" data-testid="findings-error">@_error</MudAlert>
    }
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (_summary is { } s)
    {
        <MudGrid Spacing="2" Class="mb-3" data-testid="findings-tiles">
            @Tile("Possible overpayments", Money(s.Overpayments.Amount), $"{s.Overpayments.Findings:N0} claims, not rejected")
            @Tile("Possible underpayments", Money(s.Underpayments.Amount), $"{s.Underpayments.Findings:N0} claims, not rejected")
            @Tile("Confirmed by review", Money(s.Confirmed.Amount), $"{s.Confirmed.Findings:N0} approved, in recovery, appealed or recovered")
            @Tile("Recovered", Money(s.Recovered.Recovered), s.RecoveryRate is { } rate ? $"{rate:P0} of confirmed overpayments" : "None recorded yet")
            @Tile("Past the lookback", Money(s.PastLookback.Amount), $"{s.PastLookback.Findings:N0} open overpayments; {s.LookbackDueSoon.Findings:N0} due within 30 days")
        </MudGrid>
        @if (s.LookbackUnknown.Findings > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3" data-testid="findings-lookback-unknown">
                @s.LookbackUnknown.Findings.ToString("N0", CultureInfo.InvariantCulture) open overpayments (@Money(s.LookbackUnknown.Amount)) have no recoupment
                lookback: enter your provider contracts' limits under Recoupment lookback below.
            </MudAlert>
        }
    }

    <MudPaper Elevation="0" Class="pa-4 mb-3" Style="@PaperStyle" data-testid="findings-list">
        <div class="d-flex align-center flex-wrap gap-2">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="flex-grow-1">Findings</MudText>
            <MudSelect T="string" Value="_status" ValueChanged="FilterStatusAsync" Label="Status" Dense="true" Style="max-width: 180px;" data-testid="findings-status-filter">
                <MudSelectItem T="string" Value="@string.Empty">Every status</MudSelectItem>
                @foreach (var st in ShadowFindingStatuses.All)
                {
                    <MudSelectItem T="string" Value="@st">@ShadowFindingStatuses.Label(st)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Value="_lookback" ValueChanged="FilterLookbackAsync" Label="Lookback" Dense="true" Style="max-width: 180px;">
                <MudSelectItem T="string" Value="@string.Empty">Any</MudSelectItem>
                <MudSelectItem T="string" Value="@("Past")">Past</MudSelectItem>
                <MudSelectItem T="string" Value="@("DueSoon")">Due within 30 days</MudSelectItem>
                <MudSelectItem T="string" Value="@("Unknown")">Not entered</MudSelectItem>
            </MudSelect>
            <MudButton Href="@ShadowFindingsExportEndpoint.PathFor([ShadowFindingStatuses.Approved])" Target="_blank" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download" data-testid="findings-export">Export approved (CSV)</MudButton>
        </div>
        @if (_rows.Count == 0 && !_loading)
        {
            <MudText Typo="Typo.body2" Class="my-2" data-testid="findings-empty">
                No findings here yet. Each shadow run adds the claims where the core paid more or less than Cloud Health Office would have.
            </MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-2" data-testid="findings-table">
                <thead>
                    <tr><th>Claim</th><th>Provider</th><th>Paid</th><th>Direction</th><th>Amount</th><th>Why</th><th>Lookback</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var v in _rows)
                    {
                        var f = v.Finding;
                        <tr>
                            <td style="font-family: monospace;">@(f.SourceClaimId ?? f.ClaimNumber)</td>
                            <td style="font-family: monospace;">@f.BillingProviderNpi</td>
                            <td>@(f.CorePaidDate?.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture) ?? "-")</td>
                            <td>@(f.Direction == "CorePaidMore" ? "Core paid more" : "Core paid less")</td>
                            <td>@Money(f.Amount)</td>
                            <td style="font-size: 0.85em;">@(f.AuthorizationFinding ?? f.Reason ?? f.Stage)@(f.StillDiffers ? "" : " (no longer differs)")</td>
                            <td data-testid="finding-lookback">@LookbackText(v)</td>
                            <td data-testid="finding-status">
                                @ShadowFindingStatuses.Label(f.Status)
                                @if (f.RecoveredAmount is { } rec)
                                {
                                    <span> (@Money(rec))</span>
                                }
                            </td>
                            <td>
                                @if (_canReview && v.NextStatuses.Count > 0)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Open(v)" data-testid="finding-review">Review</MudButton>
                                }
                            </td>
                        </tr>
                        @if (_editing?.Finding.Id == f.Id)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="d-flex flex-wrap gap-2 align-center pa-2" data-testid="finding-editor">
                                        <MudSelect T="string" @bind-Value="_next" Label="Move to" Dense="true" Style="max-width: 180px;">
                                            @foreach (var next in v.NextStatuses)
                                            {
                                                <MudSelectItem T="string" Value="@next">@ShadowFindingStatuses.Label(next)</MudSelectItem>
                                            }
                                        </MudSelect>
                                        @if (_next == ShadowFindingStatuses.Recovered)
                                        {
                                            <MudNumericField T="decimal?" @bind-Value="_recovered" Label="Recovered" Format="0.00" Min="0" Max="f.Amount" Style="max-width: 160px;" data-testid="finding-recovered" />
                                        }
                                        <MudTextField T="string" @bind-Value="_note" Label="Note" Class="flex-grow-1" MaxLength="2000" data-testid="finding-note" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || string.IsNullOrEmpty(_next))" OnClick="SaveAsync" data-testid="finding-save">Save</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="() => _editing = null">Cancel</MudButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    @if (_summary is { ByProvider.Count: > 0 } sum)
    {
        <MudPaper Elevation="0" Class="pa-4 mb-3" Style="@PaperStyle" data-testid="findings-providers">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">By billing provider</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-2">
                <thead><tr><th>NPI</th><th>Contract</th><th>Findings</th><th>Core paid more</th><th>Core paid less</th><th>Open overpayments</th><th>Confirmed</th><th>Recovered</th><th>Past lookback</th><th>Next deadline</th></tr></thead>
                <tbody>
                    @foreach (var p in sum.ByProvider)
                    {
                        <tr>
                            <td style="font-family: monospace;">@p.BillingProviderNpi</td>
                            <td>@p.ContractNumber</td>
                            <td>@p.Findings.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td>@Money(p.CorePaidMore)</td>
                            <td>@Money(p.CorePaidLess)</td>
                            <td>@Money(p.OpenOverpayments)</td>
                            <td>@Money(p.Confirmed)</td>
                            <td>@Money(p.Recovered)</td>
                            <td>@(p.PastLookback > 0 ? p.PastLookback.ToString("N0", CultureInfo.InvariantCulture) : "")</td>
                            <td>@(p.NextDeadline?.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture))</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudPaper Elevation="0" Class="pa-4 mb-3" Style="@PaperStyle" data-testid="findings-lookback">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Recoupment lookback</MudText>
        <MudText Typo="Typo.body2" Class="my-2">
            How far back, from the core's paid date, your provider contracts and state rules let you recoup an overpayment.
            Cloud Health Office does not know these limits on its own: enter a default for the plan and any provider whose contract differs.
        </MudText>
        <div class="d-flex flex-wrap gap-3 align-start">
            <MudNumericField T="int?" @bind-Value="_defaultDays" Label="Default (days)" Min="1" Max="3650" Disabled="!_canReview" Style="max-width: 180px;" data-testid="lookback-default" />
            <MudTextField T="string" @bind-Value="_providerLines" Label="Providers: NPI, contract number, days (one per line)" Lines="4" Class="flex-grow-1"
                          Disabled="!_canReview" Placeholder="1234567890, K-1007, 180" data-testid="lookback-providers" />
            @if (_canReview)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveLookbackAsync" data-testid="lookback-save">Save</MudButton>
            }
        </div>
        @foreach (var e in _lookbackErrors)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Style="display: block;">@e</MudText>
        }
    </MudPaper>
</MudContainer>
</PermissionGate>

@code {
    private const string PaperStyle = "background: var(--cb-surface-bg-90); border: 1px solid var(--cb-accent-border-15); border-radius: 8px;";
    private static readonly CultureInfo Us = CultureInfo.GetCultureInfo("en-US");

    private ShadowFindingSummary? _summary;
    private List<ShadowFindingView> _rows = new();
    private string _status = string.Empty;
    private string _lookback = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _canReview;
    private string? _error;

    private ShadowFindingView? _editing;
    private string? _next;
    private string? _note;
    private decimal? _recovered;

    private int? _defaultDays;
    private string? _providerLines;
    private List<string> _lookbackErrors = new();

    protected override async Task OnInitializedAsync()
    {
        _canReview = UserContextService.HasPermission("claims:adjust");
        _loading = true;
        try
        {
            await ReloadAsync();
            if (await Findings.GetLookbackAsync() is { } lookback)
                ShowLookback(lookback);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        _summary = await Findings.GetSummaryAsync();
        _rows = await Findings.ListAsync(
            string.IsNullOrEmpty(_status) ? null : _status, null, string.IsNullOrEmpty(_lookback) ? null : _lookback);
    }

    private async Task FilterStatusAsync(string status)
    {
        _status = status;
        await SafeAsync(ReloadAsync);
    }

    private async Task FilterLookbackAsync(string lookback)
    {
        _lookback = lookback;
        await SafeAsync(ReloadAsync);
    }

    private void Open(ShadowFindingView v)
    {
        _editing = v;
        _next = v.NextStatuses.FirstOrDefault();
        _note = v.Finding.Note;
        _recovered = v.Finding.Amount;
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrEmpty(_next)) return;
        _saving = true;
        try
        {
            var result = await Findings.SetStatusAsync(_editing.Finding.Id, new ShadowFindingStatusRequest
            {
                Status = _next,
                Note = _note,
                RecoveredAmount = _next == ShadowFindingStatuses.Recovered ? _recovered : null,
            });
            if (result.Succeeded)
            {
                Snackbar.Add($"{_editing.Finding.SourceClaimId ?? _editing.Finding.ClaimNumber}: {ShadowFindingStatuses.Label(_next)}.", Severity.Success);
                _editing = null;
                await ReloadAsync();
            }
            else
            {
                _error = string.Join(" ", result.Errors);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowLookback(ShadowRecoveryLookback lookback)
    {
        _defaultDays = lookback.DefaultDays;
        _providerLines = string.Join("\n", lookback.Providers.Select(p =>
            string.IsNullOrWhiteSpace(p.ContractNumber) ? $"{p.Npi}, , {p.Days}" : $"{p.Npi}, {p.ContractNumber}, {p.Days}"));
    }

    /// <summary>"NPI, contract, days" per line; contract may be blank, and "NPI, days" works too.</summary>
    public static (List<ShadowProviderLookback> Providers, List<string> Errors) ParseProviders(string? text)
    {
        var providers = new List<ShadowProviderLookback>();
        var errors = new List<string>();
        var lineNo = 0;
        foreach (var raw in (text ?? string.Empty).Split('\n'))
        {
            lineNo++;
            var line = raw.Trim();
            if (line.Length == 0) continue;
            var parts = line.Split(',').Select(p => p.Trim()).ToArray();
            var (npi, contract, days) = parts.Length switch
            {
                2 => (parts[0], null, parts[1]),
                3 => (parts[0], string.IsNullOrEmpty(parts[1]) ? null : parts[1], parts[2]),
                _ => (null, null, null),
            };
            if (npi is null || !int.TryParse(days, NumberStyles.Integer, CultureInfo.InvariantCulture, out var d))
            {
                errors.Add($"Line {lineNo}: write NPI, contract number, days.");
                continue;
            }
            providers.Add(new ShadowProviderLookback { Npi = npi, ContractNumber = contract, Days = d });
        }
        return (providers, errors);
    }

    private async Task SaveLookbackAsync()
    {
        var (providers, errors) = ParseProviders(_providerLines);
        _lookbackErrors = errors;
        if (errors.Count > 0) return;
        _saving = true;
        try
        {
            var result = await Findings.SaveLookbackAsync(new ShadowRecoveryLookback { DefaultDays = _defaultDays, Providers = providers });
            if (result.Succeeded)
            {
                ShowLookback(result.Value!);
                Snackbar.Add("Recoupment lookback saved.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                _lookbackErrors = result.Errors.ToList();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SafeAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    public static string LookbackText(ShadowFindingView v) => v.LookbackState switch
    {
        "Past" => $"Past ({v.LookbackDeadline?.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture)})",
        "DueSoon" => $"{v.DaysLeft} days left",
        "Within" => $"Until {v.LookbackDeadline?.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture)}",
        "NotApplicable" => "",
        _ => "Not entered",
    };

    private static string Money(decimal value) => value.ToString("C2", Us);

    private static RenderFragment Tile(string label, string value, string note) => __builder =>
    {
        <MudItem xs="12" sm="6" md="2" Style="min-width: 200px;">
            <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--cb-accent-border-15); border-radius: 8px;">
                <MudText Typo="Typo.caption" Style="color: var(--cb-fg-text-55);">@label</MudText>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">@value</MudText>
                <MudText Typo="Typo.caption" Style="color: var(--cb-fg-text-55);">@note</MudText>
            </MudPaper>
        </MudItem>
    };
}
