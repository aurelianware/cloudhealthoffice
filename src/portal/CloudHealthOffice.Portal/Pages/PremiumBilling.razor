@page "/premium-billing"
@attribute [Authorize]
@using CloudHealthOffice.Portal.Services
@inject IPremiumBillingService BillingService
@inject IUserContextService UserContextService

<PageTitle>Premium Billing — Cloud Health Office</PageTitle>

@* Billing runs in premium-billing-service: reads billing:read, create /
   execute / cancel billing:run. *@
<PermissionGate Permission="billing:read" RoleName="Finance">
<PremiumBillingNav Active="runs" />
<BillingError Error="_error" OnClose="() => _error = null" />

@if (_canRun)
{
    <MudPaper Class="pa-4 mb-4" data-testid="create-run-form"
              Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 12px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2" Style="color: #00ffff; font-weight: 600;">New billing run</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <div data-testid="run-period">
                    <MudTextField @bind-Value="_newPeriod" Label="Billing period (YYYY-MM)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" HelperText="Invoices cover this month" />
                </div>
            </MudItem>
            <MudItem xs="12" sm="4">
                <div data-testid="run-groups">
                    <MudTextField @bind-Value="_newGroups" Label="Group numbers (optional)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" HelperText="Comma-separated; empty bills every active sponsor" />
                </div>
            </MudItem>
            <MudItem xs="12" sm="5">
                <div data-testid="run-description">
                    <MudTextField @bind-Value="_newDescription" Label="Description (optional)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </div>
            </MudItem>
        </MudGrid>
        <div class="d-flex justify-end mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateRun" Disabled="_busy" data-testid="create-run">Create billing run</MudButton>
        </div>
        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">
            A new run is Pending until it is executed. Whoever creates or executes a run cannot release its sponsor debits
            (separation of duties).
        </MudText>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}

<MudTable Items="_runs" Dense="true" Hover="true" T="BillingRun" data-testid="billing-runs"
          Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 12px;">
    <HeaderContent>
        <MudTh>Run #</MudTh>
        <MudTh>Period</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Invoices</MudTh>
        <MudTh>Members</MudTh>
        <MudTh>Total premium</MudTh>
        <MudTh>Created by</MudTh>
        <MudTh>Executed by</MudTh>
        <MudTh>Issues</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Run #"><span style="font-family: monospace; color: #00ffff;">@context.BillingRunNumber</span></MudTd>
        <MudTd DataLabel="Period">@context.BillingPeriod.ToString("yyyy-MM")</MudTd>
        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@RunStatusColor(context.Status)">@context.Status</MudChip></MudTd>
        <MudTd DataLabel="Invoices">@context.TotalInvoices</MudTd>
        <MudTd DataLabel="Members">@context.TotalMembers</MudTd>
        <MudTd DataLabel="Total premium"><span style="font-family: monospace;">@context.TotalPremiumAmount.ToString("C2")</span></MudTd>
        <MudTd DataLabel="Created by">@(context.CreatedBy ?? "—")</MudTd>
        <MudTd DataLabel="Executed by">@(context.ExecutedBy ?? "—")</MudTd>
        <MudTd DataLabel="Issues">
            @if (context.Errors.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.Errors.Count errors</MudChip>
            }
            @if (context.Warnings.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Warnings.Count warnings</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <div class="d-flex gap-1">
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ViewRun(context.Id))"
                           data-testid="@($"run-view-{context.Id}")">View</MudButton>
                @if (_canRun && context.Status == "Pending")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="@(() => ExecuteRun(context))" Disabled="_busy"
                               data-testid="@($"run-execute-{context.Id}")">Execute</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               OnClick="@(() => CancelRun(context))" Disabled="_busy"
                               data-testid="@($"run-cancel-{context.Id}")">Cancel</MudButton>
                }
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4" Style="color: rgba(255,255,255,0.4);">No billing runs yet</MudText>
    </NoRecordsContent>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>

@if (_selected != null)
{
    var run = _selected;
    <MudPaper Class="pa-4 mt-4" data-testid="run-detail"
              Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.25); border-radius: 12px;">
        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.h6" Style="color: #00ffff;">@run.BillingRunNumber</MudText>
            <MudChip T="string" Size="Size.Small" Color="@RunStatusColor(run.Status)">@run.Status</MudChip>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _selected = null" />
        </div>
        @if (!string.IsNullOrWhiteSpace(run.Description))
        {
            <MudText Typo="Typo.body2" Class="mb-2">@run.Description</MudText>
        }
        <MudSimpleTable Dense="true" Style="background: transparent;">
            <tbody>
                <tr><td>Billing period</td><td>@run.BillingPeriod.ToString("MMMM yyyy")</td></tr>
                <tr><td>Sponsors</td><td>@(run.Criteria.GroupNumbers.Count == 0 ? "All active sponsors" : string.Join(", ", run.Criteria.GroupNumbers))</td></tr>
                <tr><td>Invoices</td><td>@run.TotalInvoices</td></tr>
                <tr><td>Members</td><td>@run.TotalMembers</td></tr>
                <tr><td>Total premium</td><td>@run.TotalPremiumAmount.ToString("C2")</td></tr>
                <tr><td>Total adjustments</td><td>@run.TotalAdjustmentAmount.ToString("C2")</td></tr>
                <tr><td>Created</td><td>@run.CreatedAt.ToLocalTime().ToString("g") by @(run.CreatedBy ?? "—")@(run.CreatedByIsService ? " (service)" : "")</td></tr>
                <tr><td>Executed</td><td>@(run.ExecutionCompletedAt?.ToLocalTime().ToString("g") ?? "—") by @(run.ExecutedBy ?? "—")@(run.ExecutedByIsService ? " (service)" : "")@(run.ExecutionDurationSeconds is double s ? $" in {s:0.#}s" : "")</td></tr>
                @if (run.CancelledBy != null)
                {
                    <tr><td>Cancelled by</td><td>@run.CancelledBy</td></tr>
                }
            </tbody>
        </MudSimpleTable>

        @if (run.Errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true" data-testid="run-errors">
                <strong>Errors</strong>
                <ul>@foreach (var e in run.Errors) { <li>@e</li> }</ul>
            </MudAlert>
        }
        @if (run.Warnings.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" data-testid="run-warnings">
                <strong>Needs attention</strong> — these sponsors were not invoiced or not debited as expected:
                <ul>@foreach (var w in run.Warnings) { <li>@w</li> }</ul>
            </MudAlert>
        }
        @if (run.Errors.Count == 0 && run.Warnings.Count == 0 && run.Status == "Completed")
        {
            <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">Completed without warnings.</MudAlert>
        }

        @if (run.InvoiceIds.Count > 0)
        {
            <div class="d-flex gap-2 mt-3">
                <MudButton Href="@($"/premium-billing/invoices?run={Uri.EscapeDataString(run.Id)}")" Variant="Variant.Outlined"
                           Size="Size.Small" StartIcon="@Icons.Material.Filled.Receipt">Invoices of this run</MudButton>
                <MudButton Href="@($"/premium-billing/eft?run={Uri.EscapeDataString(run.Id)}")" Variant="Variant.Outlined"
                           Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountBalance">Auto-debit for this run</MudButton>
            </div>
        }
    </MudPaper>
}
</PermissionGate>

@code {
    private List<BillingRun> _runs = new();
    private BillingRun? _selected;
    private bool _loading = true;
    private bool _busy;
    private bool _canRun;
    private Exception? _error;

    private string? _newPeriod = DateTime.Today.AddMonths(1).ToString("yyyy-MM");
    private string? _newGroups;
    private string? _newDescription;

    protected override async Task OnInitializedAsync()
    {
        await UserContextService.GetCurrentUserAsync();
        _canRun = UserContextService.HasPermission("billing:run");
        if (UserContextService.HasPermission("billing:read"))
            await LoadRuns();
        _loading = false;
    }

    private async Task LoadRuns()
    {
        _loading = true;
        try
        {
            _runs = (await BillingService.GetBillingRunsAsync()).OrderByDescending(r => r.CreatedAt).ToList();
        }
        catch (Exception ex) when (ex is BillingApiException or ServiceUnavailableException)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ViewRun(string id)
    {
        try
        {
            _selected = await BillingService.GetBillingRunAsync(id);
            if (_selected == null) _error = new BillingApiException(404, null, "That billing run no longer exists.");
        }
        catch (Exception ex) when (ex is BillingApiException or ServiceUnavailableException)
        {
            _error = ex;
        }
    }

    private async Task CreateRun()
    {
        if (!TryParsePeriod(_newPeriod, out var period))
        {
            _error = new BillingApiException(400, null, "Enter the billing period as YYYY-MM, for example 2026-03.");
            return;
        }

        var request = new CreateBillingRunRequest
        {
            BillingPeriod = period,
            Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
            Criteria = new BillingRunCriteria
            {
                GroupNumbers = (_newGroups ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Distinct(StringComparer.OrdinalIgnoreCase).ToList()
            }
        };

        await Act(async () =>
        {
            var created = await BillingService.CreateBillingRunAsync(request);
            _runs.Insert(0, created);
            _selected = created;
            _newGroups = null;
            _newDescription = null;
        });
    }

    private Task ExecuteRun(BillingRun run) => Act(async () =>
    {
        var executed = await BillingService.ExecuteBillingRunAsync(run.Id);
        Replace(executed);
        _selected = executed;
    });

    private Task CancelRun(BillingRun run) => Act(async () =>
    {
        await BillingService.CancelBillingRunAsync(run.Id);
        Replace(await BillingService.GetBillingRunAsync(run.Id) ?? run);
        if (_selected?.Id == run.Id) _selected = null;
    });

    private async Task Act(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is BillingApiException or ServiceUnavailableException)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Replace(BillingRun run)
    {
        var i = _runs.FindIndex(r => r.Id == run.Id);
        if (i >= 0) _runs[i] = run; else _runs.Insert(0, run);
    }

    internal static bool TryParsePeriod(string? text, out DateTime period)
    {
        period = default;
        return DateTime.TryParseExact((text ?? string.Empty).Trim(), "yyyy-MM",
                   System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out period);
    }

    private static Color RunStatusColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Running" => Color.Info,
        "Pending" => Color.Default,
        "Failed" => Color.Error,
        "Cancelled" => Color.Dark,
        _ => Color.Default
    };
}
