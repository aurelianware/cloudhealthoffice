@page "/premium-billing"
@attribute [Authorize]
@using CloudHealthOffice.Portal.Services
@inject IPremiumBillingService BillingService
@inject ISponsorService SponsorService
@inject IBenefitPlanService BenefitPlanService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Premium Billing — Cloud Health Office</PageTitle>

<PermissionGate Permission="billing:read" RoleName="Finance">
<MudText Typo="Typo.h4" Class="mb-1" Style="color: #00ffff; font-weight: 700; letter-spacing: -0.5px;">
    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Class="mr-2" Style="vertical-align: middle;" />
    Premium Billing
</MudText>
<MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);" Class="mb-4">
    Manage billing cycles, premium rates, and collections across all plan sponsors
</MudText>

@if (_serviceError != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
}

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TAB 1: Billing Cycles -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <MudTabPanel Text="Billing Cycles" Icon="@Icons.Material.Filled.CalendarMonth">
        <div class="pt-4">
            <!-- KPI Summary -->
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 d-flex flex-column" Style="background: rgba(255,0,85,0.05); border: 1px solid rgba(255,0,85,0.2); border-radius: 12px;">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">Outstanding</MudText>
                        <MudText Typo="Typo.h5" Style="color: #ff0055; font-weight: 700; font-family: monospace;">
                            @_cycles.Where(c => c.Status is "Sent" or "Overdue").Sum(c => c.TotalPremium).ToString("C0")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 d-flex flex-column" Style="background: rgba(255,170,0,0.05); border: 1px solid rgba(255,170,0,0.2); border-radius: 12px;">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">Overdue</MudText>
                        <MudText Typo="Typo.h5" Style="color: #ffaa00; font-weight: 700; font-family: monospace;">
                            @_cycles.Where(c => c.Status == "Overdue").Sum(c => c.TotalPremium).ToString("C0")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 d-flex flex-column" Style="background: rgba(0,255,136,0.05); border: 1px solid rgba(0,255,136,0.2); border-radius: 12px;">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">Paid This Month</MudText>
                        <MudText Typo="Typo.h5" Style="color: #00ff88; font-weight: 700; font-family: monospace;">
                            @_cycles.Where(c => c.Status == "Paid" && c.PaidDate?.Month == DateTime.Today.Month).Sum(c => c.TotalPremium).ToString("C0")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 d-flex flex-column" Style="background: rgba(0,255,255,0.05); border: 1px solid rgba(0,255,255,0.2); border-radius: 12px;">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);">Draft Invoices</MudText>
                        <MudText Typo="Typo.h5" Style="color: #00ffff; font-weight: 700;">
                            @_cycles.Count(c => c.Status == "Draft")
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Filters + Action -->
            <div class="d-flex align-center flex-wrap gap-3 mb-4">
                <MudSelect @bind-Value="_cyclesSponsorFilter" Label="Sponsor" Variant="Variant.Outlined"
                           Style="min-width: 200px;" Clearable="true" Dense="true">
                    @foreach (var s in _sponsors)
                    {
                        <MudSelectItem Value="@s.SponsorId">@s.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="_cyclesStatusFilter" Label="Status" Variant="Variant.Outlined"
                           Style="min-width: 160px;" Clearable="true" Dense="true">
                    <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                    <MudSelectItem Value="@("Sent")">Sent</MudSelectItem>
                    <MudSelectItem Value="@("Paid")">Paid</MudSelectItem>
                    <MudSelectItem Value="@("Overdue")">Overdue</MudSelectItem>
                    <MudSelectItem Value="@("Void")">Void</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="LoadCycles" Disabled="_loadingCycles">
                    Apply
                </MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenGenerateInvoice">
                    Generate Invoice
                </MudButton>
            </div>

            @if (_loadingCycles)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
            }

            <MudTable Items="FilteredCycles" Dense="true" Hover="true" T="BillingCycle"
                      Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 12px;">
                <HeaderContent>
                    <MudTh>Invoice #</MudTh>
                    <MudTh>Sponsor</MudTh>
                    <MudTh>Period</MudTh>
                    <MudTh>Due Date</MudTh>
                    <MudTh>Members</MudTh>
                    <MudTh>Total Premium</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Invoice #">
                        <MudText Typo="Typo.body2" Style="font-family: monospace; color: #00ffff;">@context.InvoiceNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Sponsor">@context.SponsorName</MudTd>
                    <MudTd DataLabel="Period">
                        <MudText Typo="Typo.body2">@context.BillingPeriod</MudText>
                    </MudTd>
                    <MudTd DataLabel="Due Date">
                        <MudText Typo="Typo.body2"
                                 Style="@(context.Status == "Overdue" ? "color: #ff0055; font-weight: 600;" : "")">
                            @context.DueDate.ToString("MM/dd/yyyy")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Members">@context.MemberCount</MudTd>
                    <MudTd DataLabel="Total Premium">
                        <MudText Style="font-family: monospace; font-weight: 600;">@context.TotalPremium.ToString("C2")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetCycleStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <div class="d-flex gap-1">
                            @if (context.Status is "Draft" or "Sent" or "Overdue")
                            {
                                <MudTooltip Text="Mark as Paid">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Size="Size.Small" Color="Color.Success"
                                                   OnClick="@(() => MarkPaid(context))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Download Invoice PDF">
                                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                               Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => DownloadInvoice(context))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-6 text-center">
                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.4);">No billing cycles match the selected filters</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </MudTabPanel>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TAB 2: Premium Rates -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <MudTabPanel Text="Premium Rates" Icon="@Icons.Material.Filled.PriceChange">
        <div class="pt-4">
            <div class="d-flex align-center gap-3 mb-4">
                <MudSelect @bind-Value="_ratesPlanFilter" Label="Filter by Plan" Variant="Variant.Outlined"
                           Style="min-width: 240px;" Clearable="true" Dense="true"
                           AdornmentIcon="@Icons.Material.Filled.HealthAndSafety">
                    @foreach (var p in _plans)
                    {
                        <MudSelectItem Value="@p.PlanId">@p.PlanName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="LoadRates" Disabled="_loadingRates">
                    Apply
                </MudButton>
            </div>

            @if (_loadingRates)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
            }

            @foreach (var planGroup in _rates.GroupBy(r => r.PlanName))
            {
                <MudPaper Class="pa-0 mb-4" Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 12px; overflow: hidden;">
                    <div class="pa-3" Style="background: rgba(0,255,255,0.05); border-bottom: 1px solid rgba(0,255,255,0.15);">
                        <MudText Typo="Typo.subtitle1" Style="color: #00ffff; font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-1" Size="Size.Small" />
                            @planGroup.Key
                        </MudText>
                    </div>
                    <MudTable Items="planGroup.ToList()" Dense="true" Hover="true" T="PremiumRate" Elevation="0"
                              Style="background: transparent;">
                        <HeaderContent>
                            <MudTh>Coverage Level</MudTh>
                            <MudTh>Age Band</MudTh>
                            <MudTh>Monthly Rate</MudTh>
                            <MudTh>Effective Date</MudTh>
                            <MudTh>End Date</MudTh>
                            <MudTh>Edit</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @if (_editingRateId == context.RateId)
                            {
                                <MudTd DataLabel="Coverage Level">@context.CoverageLevel</MudTd>
                                <MudTd DataLabel="Age Band">@(context.AgeBand ?? "—")</MudTd>
                                <MudTd DataLabel="Monthly Rate">
                                    <MudNumericField @bind-Value="_editRate" Format="C2" HideSpinButtons="true"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Style="width: 120px;" />
                                </MudTd>
                                <MudTd DataLabel="Effective Date">
                                    <MudDatePicker @bind-Date="_editEffectiveDate" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Style="width: 150px;" />
                                </MudTd>
                                <MudTd DataLabel="End Date">@(context.TerminationDate?.ToString("MM/dd/yyyy") ?? "Active")</MudTd>
                                <MudTd DataLabel="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Success"
                                                   OnClick="@(() => SaveRate(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                                   OnClick="CancelEditRate" />
                                </MudTd>
                            }
                            else
                            {
                                <MudTd DataLabel="Coverage Level">@context.CoverageLevel</MudTd>
                                <MudTd DataLabel="Age Band">@(context.AgeBand ?? "—")</MudTd>
                                <MudTd DataLabel="Monthly Rate">
                                    <MudText Style="font-family: monospace; font-weight: 600; color: #00ff88;">
                                        @context.Rate.ToString("C2")
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="Effective Date">@context.EffectiveDate.ToString("MM/dd/yyyy")</MudTd>
                                <MudTd DataLabel="End Date">
                                    @if (context.TerminationDate.HasValue)
                                    {
                                        <MudText Style="color: rgba(255,255,255,0.5);">@context.TerminationDate.Value.ToString("MM/dd/yyyy")</MudText>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => StartEditRate(context))" />
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            @if (!_rates.Any() && !_loadingRates)
            {
                <MudAlert Severity="Severity.Info">No premium rates found. Select a plan or contact your administrator.</MudAlert>
            }
        </div>
    </MudTabPanel>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TAB 3: Collections -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <MudTabPanel Text="Collections" Icon="@Icons.Material.Filled.Warning">
        <div class="pt-4">
            <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
                The following invoices are past due. Contact sponsors immediately to prevent coverage disruption.
            </MudAlert>

            <MudTable Items="OverdueCycles" Dense="true" Hover="true" T="BillingCycle"
                      Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(255,0,85,0.3); border-radius: 12px;">
                <HeaderContent>
                    <MudTh>Invoice #</MudTh>
                    <MudTh>Sponsor</MudTh>
                    <MudTh>Period</MudTh>
                    <MudTh>Due Date</MudTh>
                    <MudTh>Days Overdue</MudTh>
                    <MudTh>Amount Due</MudTh>
                    <MudTh>Members at Risk</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var daysOverdue = (int)(DateTime.Today - context.DueDate).TotalDays;
                        var overdueColor = daysOverdue > 60 ? "color: #ff0055; font-weight: 700;" :
                                           daysOverdue > 30 ? "color: #ff4400; font-weight: 600;" :
                                                              "color: #ffaa00; font-weight: 500;";
                    }
                    <MudTd DataLabel="Invoice #">
                        <MudText Style="font-family: monospace; color: #00ffff;">@context.InvoiceNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Sponsor">
                        <MudText Style="font-weight: 600;">@context.SponsorName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Period">@context.BillingPeriod</MudTd>
                    <MudTd DataLabel="Due Date">
                        <MudText Style="@overdueColor">@context.DueDate.ToString("MM/dd/yyyy")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Days Overdue">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(daysOverdue > 60 ? Color.Error : daysOverdue > 30 ? Color.Error : Color.Warning)">
                            @daysOverdue days
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Amount Due">
                        <MudText Style="@("font-family: monospace; font-weight: 700; " + overdueColor)">
                            @context.TotalPremium.ToString("C2")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Members at Risk">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.People">
                            @context.MemberCount
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <div class="d-flex gap-1">
                            <MudTooltip Text="Mark as Paid">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small" Color="Color.Success"
                                               OnClick="@(() => MarkPaid(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Download Invoice">
                                <MudIconButton Icon="@Icons.Material.Filled.Download"
                                               Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => DownloadInvoice(context))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-6 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 2.5rem; color: #00ff88;" />
                        <MudText Typo="Typo.body1" Class="mt-2" Style="color: #00ff88;">No overdue invoices</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </MudTabPanel>

</MudTabs>
</PermissionGate>

@code {
    private int _activeTab = 0;

    // Billing Cycles
    private List<BillingCycle> _cycles = new();
    private bool _loadingCycles = true;
    private string? _cyclesSponsorFilter;
    private string? _cyclesStatusFilter;

    // Premium Rates
    private List<PremiumRate> _rates = new();
    private bool _loadingRates = true;
    private string? _ratesPlanFilter;
    private string? _editingRateId;
    private decimal _editRate;
    private DateTime? _editEffectiveDate;

    // Shared
    private List<SponsorSummary> _sponsors = new();
    private List<BenefitPlanListItem> _plans = new();
    private string? _serviceError;

    private IEnumerable<BillingCycle> FilteredCycles => _cycles.Where(c =>
        (string.IsNullOrEmpty(_cyclesSponsorFilter) || c.SponsorId == _cyclesSponsorFilter) &&
        (string.IsNullOrEmpty(_cyclesStatusFilter) || c.Status == _cyclesStatusFilter));

    private IEnumerable<BillingCycle> OverdueCycles => _cycles.Where(c => c.Status == "Overdue")
        .OrderByDescending(c => (DateTime.Today - c.DueDate).TotalDays);

    protected override async Task OnInitializedAsync()
    {
        var cyclesTask = LoadCycles();
        var ratesTask = LoadRates();
        await Task.WhenAll(cyclesTask, ratesTask);

        try { _sponsors = await SponsorService.SearchSponsorsAsync(""); } catch { }
        try { _plans = await BenefitPlanService.SearchBenefitPlansAsync(); } catch { }
    }

    private async Task LoadCycles()
    {
        _loadingCycles = true;
        try
        {
            _cycles = await BillingService.GetBillingCyclesAsync(_cyclesSponsorFilter, _cyclesStatusFilter);
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _cycles = new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading billing cycles: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingCycles = false;
        }
    }

    private async Task LoadRates()
    {
        _loadingRates = true;
        try
        {
            _rates = await BillingService.GetPremiumRatesAsync(_ratesPlanFilter);
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _rates = new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading rates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingRates = false;
        }
    }

    private async Task OpenGenerateInvoice()
    {
        var parameters = new DialogParameters
        {
            ["Sponsors"] = _sponsors
        };
        var dialog = await DialogService.ShowAsync<GenerateInvoiceDialog>("Generate Invoice", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadCycles();
            Snackbar.Add("Invoice generated successfully", Severity.Success);
        }
    }

    private async Task MarkPaid(BillingCycle cycle)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Mark Invoice as Paid",
            $"Confirm payment received for invoice {cycle.InvoiceNumber} ({cycle.TotalPremium:C2})?",
            yesText: "Confirm Payment", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                await BillingService.MarkCycleAsPaidAsync(cycle.CycleId, DateTime.Today);
                cycle.Status = "Paid";
                cycle.PaidDate = DateTime.Today;
                Snackbar.Add($"Invoice {cycle.InvoiceNumber} marked as paid", Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error marking as paid: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DownloadInvoice(BillingCycle cycle)
    {
        try
        {
            var stream = await BillingService.DownloadInvoiceAsync(cycle.CycleId);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadBase64File",
                $"Invoice_{cycle.InvoiceNumber}_{cycle.BillingPeriod}.pdf",
                "application/pdf",
                base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error downloading invoice: {ex.Message}", Severity.Error);
        }
    }

    private void StartEditRate(PremiumRate rate)
    {
        _editingRateId = rate.RateId;
        _editRate = rate.Rate;
        _editEffectiveDate = rate.EffectiveDate;
    }

    private void CancelEditRate()
    {
        _editingRateId = null;
    }

    private async Task SaveRate(PremiumRate rate)
    {
        try
        {
            await BillingService.UpdatePremiumRateAsync(rate.RateId, _editRate, _editEffectiveDate ?? DateTime.Today);
            rate.Rate = _editRate;
            rate.EffectiveDate = _editEffectiveDate ?? DateTime.Today;
            _editingRateId = null;
            Snackbar.Add($"Rate updated for {rate.CoverageLevel} — {_editRate:C2}/month", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating rate: {ex.Message}", Severity.Error);
        }
    }

    private Color GetCycleStatusColor(string status) => status switch
    {
        "Paid"    => Color.Success,
        "Sent"    => Color.Primary,
        "Draft"   => Color.Default,
        "Overdue" => Color.Error,
        "Void"    => Color.Dark,
        _         => Color.Default
    };
}
