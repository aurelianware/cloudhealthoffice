@page "/claims/{ClaimId}"
@page "/claims/{ClaimId}/{Tab}"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject IClaimsService ClaimsService
@inject IWorkQueueService WorkQueueService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IServiceProvider Services

<PageTitle>Claim Details - Cloud Health Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <!-- Breadcrumb -->
    <MudBreadcrumbs Items="_breadcrumbItems" Class="mb-4"></MudBreadcrumbs>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    @if (_loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_claim != null)
    {
        <!-- Header with Claim Status and Actions -->
        <MudPaper Class="pa-6 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" GutterBottom="true">
                        Claim @_claim.ClaimNumber
                        <OpenInNewTabButton Href="@RecordTabs.Href(ClaimBaseHref, ActiveTab, TabQuery)" />
                        <PinButton Kind="Claim" RecordId="@ClaimId" Label="@($"Claim {_claim.ClaimNumber}")" />
                        @if (!string.IsNullOrEmpty(_claim.PriorAuthorizationNumber))
                        {
                            <MudChip Size="Size.Medium" Variant="Variant.Outlined" Class="ml-2"
                                     Icon="@Icons.Material.Filled.OpenInNew" OnClick="OpenAuthorizationAsync"
                                     data-testid="open-authorization" title="Open the authorization">
                                Auth: @_claim.PriorAuthorizationNumber
                            </MudChip>
                        }
                    </MudText>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Color="Color.Secondary">Status</MudText>
                            <MudChip Size="Size.Large"
                                    Color="@GetStatusColor(_claim.Status)"
                                    Variant="Variant.Filled"
                                    Class="mt-2">
                                @ClaimStatusDisplay.Label(_claim.Status, _claim.ServiceLines)
                            </MudChip>
                            @if (ClaimStatusDisplay.PhaseHint(_claim.Status) is { } phase)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1" data-testid="claim-phase-hint">@phase</MudText>
                            }
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Color="Color.Secondary">Claim Type</MudText>
                            <MudChip Size="Size.Large"
                                    Color="@(_claim.ClaimType == "Professional" ? Color.Info : Color.Warning)"
                                    Variant="Variant.Filled"
                                    Class="mt-2">
                                @_claim.ClaimType
                            </MudChip>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" md="4">
                    <!-- Action Buttons -->
                    @if (CanResolvePendedClaim)
                    {
                        <MudStack Spacing="2">
                            @if (!string.Equals(_claim.Status, "Pended", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Not yet remitted: an examiner can still change this decision before the payment cycle.
                                </MudText>
                            }
                            @if (EditLevelReview)
                            {
                                <MudButton Variant="Variant.Filled"
                                          Color="Color.Success"
                                          FullWidth="true"
                                          StartIcon="@Icons.Material.Filled.CheckCircle"
                                          OnClick="@(() => _confirmingFinish = true)"
                                          data-testid="finish">
                                    Finish
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled"
                                          Color="Color.Success"
                                          FullWidth="true"
                                          StartIcon="@Icons.Material.Filled.CheckCircle"
                                          OnClick="@(() => ApproveClaimAsync())">
                                    Pay
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled"
                                      Color="Color.Error"
                                      FullWidth="true"
                                      StartIcon="@Icons.Material.Filled.Cancel"
                                      OnClick="@(() => DenyClaimAsync())">
                                Deny
                            </MudButton>
                        </MudStack>
                    }
                    else if (ClaimStatusDisplay.IsFinalized(_claim.Status))
                    {
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Info">
                                @(ClaimStatusDisplay.IsReversible(_claim.Status)
                                    ? "Finalized by the payment cycle: correct it with an adjustment, or reverse it."
                                    : "Finalized: correct it with an adjustment.")
                            </MudAlert>
                            @if (ClaimStatusDisplay.IsReversible(_claim.Status))
                            {
                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Warning"
                                          FullWidth="true"
                                          StartIcon="@Icons.Material.Filled.Undo"
                                          OnClick="@(() => ReversalFlowAsync())">
                                    Initiate Reversal
                                </MudButton>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            This claim is not awaiting an examiner disposition.
                        </MudAlert>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_claim.Status == "Pended")
        {
            <MudPaper Class="pa-5 mb-4" Elevation="2" Style="border-left: 4px solid var(--mud-palette-warning);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h6">Manual Review Required</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(_claim.PendDetails?.PendReason ?? "This claim requires examiner review before final disposition.")
                        </MudText>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_claim.PendDetails?.PendCode))
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-auto">
                            @_claim.PendDetails.PendCode
                        </MudChip>
                    }
                </MudStack>

                @if (_claim.PendDetails?.EditFailures.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Review @_claim.PendDetails.EditFailures.Count deterministic edit
                        @(_claim.PendDetails.EditFailures.Count == 1 ? "failure" : "failures") before resolving the claim.
                    </MudText>
                }
            </MudPaper>
        }

        <PossibleDuplicatesPanel Matches="_duplicateMatches" />

        @if (HasExaminerDispositionRecord)
        {
            <MudPaper Class="pa-5 mb-4" Elevation="2" Style="border-left: 4px solid var(--mud-palette-success);">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Success" Size="Size.Large" />
                            <div>
                                <MudText Typo="Typo.h6">Examiner Disposition Record</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display: block;">
                                    Human review completed; the original pend evidence remains attached to this claim.
                                </MudText>
                            </div>
                        </MudStack>
                        <MudText Typo="Typo.subtitle2">Original review reason</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">@_claim.PendDetails!.PendReason</MudText>
                        @if (!string.IsNullOrWhiteSpace(_claim.ClaimNotes))
                        {
                            <MudText Typo="Typo.subtitle2">Examiner notes</MudText>
                            <MudText Typo="Typo.body2">@_claim.ClaimNotes</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4" Elevation="0" Style="background: rgba(0,255,136,0.05);">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Final disposition</MudText>
                            <MudChip T="string"
                                     Color="@GetStatusColor(_claim.Status)"
                                     Variant="Variant.Filled"
                                     Size="Size.Large"
                                     Class="my-2">
                                @ClaimStatusDisplay.Label(_claim.Status, _claim.ServiceLines)
                            </MudChip>
                            @if (_claim.AdjudicatedDate.HasValue)
                            {
                                <MudText Typo="Typo.body2">Recorded @_claim.AdjudicatedDate.Value.ToString("MMM d, yyyy HH:mm 'UTC'")</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_claim.PendDetails?.PendCode))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">Pend code: <code>@_claim.PendDetails.PendCode</code></MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_claim.AiExamination?.ExaminerAgreement))
                            {
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">AI advisory feedback</MudText>
                                <MudText Typo="Typo.body2">@_claim.AiExamination.ExaminerAgreement</MudText>
                                @if (!string.IsNullOrWhiteSpace(_claim.AiExamination.ExaminerUserId))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">by @_claim.AiExamination.ExaminerUserId</MudText>
                                }
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @if (_claim.AiExamination is { } aiExamination)
        {
            <MudPaper Class="pa-5 mb-4" Elevation="2" Style="border: 1px solid rgba(0,255,255,0.35);">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Info" Size="Size.Large" />
                            <div>
                                <MudText Typo="Typo.h6">AI Claims Examiner Advisory</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Decision support only — a human examiner remains responsible for the claim disposition.
                                </MudText>
                            </div>
                        </MudStack>
                        <MudText Typo="Typo.body1" Class="mb-3">
                            @(string.IsNullOrWhiteSpace(aiExamination.Rationale)
                                ? "No rationale was supplied with this recommendation."
                                : aiExamination.Rationale)
                        </MudText>
                        @if (aiExamination.PolicyCitations.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Policy evidence</MudText>
                            @foreach (var citation in aiExamination.PolicyCitations)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                    &bull; @citation
                                </MudText>
                            }
                        }
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4" Elevation="0" Style="background: rgba(0,255,255,0.05);">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Recommended disposition</MudText>
                            <MudChip T="string"
                                     Color="@GetAiRecommendationColor(aiExamination.RecommendedDisposition)"
                                     Variant="Variant.Filled"
                                     Size="Size.Large"
                                     Class="my-2">
                                @aiExamination.RecommendedDisposition
                            </MudChip>
                            <MudText Typo="Typo.body2">
                                Confidence: @aiExamination.ConfidenceScore.ToString("P0")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(aiExamination.ExaminerAgreement))
                            {
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Human feedback</MudText>
                                <MudText Typo="Typo.body2">@aiExamination.ExaminerAgreement</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }


        <!-- Financial Summary Cards -->
        var aboveAllowed = ClaimMoneySummary.AboveAllowed(_claim);
        <div class="mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total Charges</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@_claim.TotalChargeAmount.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1" data-testid="money-above-allowed">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="money-above-allowed-label">@aboveAllowed.Label</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2" data-testid="money-above-allowed-amount">@(aboveAllowed.Amount is { } gap ? gap.ToString("C") : "—")</MudText>
                    <MudChip T="string" Size="Size.Small" Class="ml-0 mt-1"
                             Color="@(aboveAllowed.Network switch { ClaimNetwork.InNetwork => Color.Success, ClaimNetwork.Unknown => Color.Default, _ => Color.Warning })"
                             data-testid="money-network">@aboveAllowed.NetworkLabel</MudChip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display: block;" data-testid="money-above-allowed-explanation">@aboveAllowed.Explanation</MudText>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Allowed Amount</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@_claim.AllowedAmount.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Payer Payment</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2" Color="Color.Success">@_claim.PaidAmount.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Patient Responsibility</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2" Color="Color.Warning">@_claim.PatientResponsibility.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </div>
        @if (string.Equals(_claim.Status, "Pended", StringComparison.OrdinalIgnoreCase) && aboveAllowed.Amount is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4" Style="display: block; margin-top: -8px;" data-testid="money-pended-note">
                Amounts are before review: they change if the reviewer denies or overrides an edit.
            </MudText>
        }

        <RecordTabBar Tabs="ClaimTabs" ActiveKey="@ActiveTab" BaseHref="@ClaimBaseHref" Query="@TabQuery" />

        @if (ActiveTab == "summary")
        {
            <div data-testid="claim-tab-summary">
            <!-- Member and Provider Information -->
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6" GutterBottom="true">Member Information</MudText>
                        <MudDivider Class="my-3" />
                        <MudStack Spacing="2">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Subscriber</MudText>
                                <MudText Typo="Typo.body2">@_claim.SubscriberName (@_claim.SubscriberId)</MudText>
                            </div>
                            @if (_claim.PatientName != _claim.SubscriberName)
                            {
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Patient</MudText>
                                    <MudText Typo="Typo.body2">@_claim.PatientName (@_claim.PatientRelationship)</MudText>
                                </div>
                            }
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Member ID</MudText>
                                <MudLink Typo="Typo.body2" OnClick="OpenMemberAsync" data-testid="open-member">@_claim.MemberId</MudLink>
                            </div>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6" GutterBottom="true">Provider Information</MudText>
                        <MudDivider Class="my-3" />
                        <MudStack Spacing="2">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Billing Provider</MudText>
                                <MudLink Typo="Typo.body2" OnClick="@(() => OpenProviderAsync(_claim.BillingProviderNPI))" data-testid="open-billing-provider">@_claim.BillingProviderName</MudLink>
                                <MudText Typo="Typo.caption">NPI: @_claim.BillingProviderNPI</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(_claim.RenderingProviderName))
                            {
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rendering Provider</MudText>
                                    <MudLink Typo="Typo.body2" OnClick="@(() => OpenProviderAsync(_claim.RenderingProviderNPI))">@_claim.RenderingProviderName</MudLink>
                                    <MudText Typo="Typo.caption">NPI: @_claim.RenderingProviderNPI</MudText>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_claim.FacilityName))
                            {
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Facility</MudText>
                                    <MudText Typo="Typo.body2">@_claim.FacilityName (@_claim.PlaceOfService)</MudText>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Service Dates and Key Info -->
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6" GutterBottom="true">Important Dates</MudText>
                        <MudDivider Class="my-3" />
                        <MudTable Items="@GetImportantDates()" Dense="true" Elevation="0" Hover="false" Striped="false">
                            <HeaderContent>
                                <MudTh>Date Type</MudTh>
                                <MudTh>Date</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date Type">@context.Key</MudTd>
                                <MudTd DataLabel="Date">
                                    @if (context.Value.HasValue)
                                    {
                                        @context.Value.Value.ToString("MM/dd/yyyy")
                                    }
                                    else
                                    {
                                        <em>Pending</em>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6" GutterBottom="true">Cost Breakdown</MudText>
                        <MudDivider Class="my-3" />
                        <MudTable Items="@GetCostBreakdown()" Dense="true" Elevation="0" Hover="false" Striped="false">
                            <HeaderContent>
                                <MudTh>Component</MudTh>
                                <MudTh Style="text-align: right;">Amount</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Component">@context.Key</MudTd>
                                <MudTd DataLabel="Amount" Style="text-align: right; font-weight: 600;">@context.Value.ToString("C")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Diagnosis Codes Section -->
            @if (_claim.DiagnosisCodes.Count > 0)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="mr-2" />
                        Diagnosis Codes (ICD-10)
                    </MudText>
                    <MudDivider Class="my-3" />
                    <MudTable Items="@_claim.DiagnosisCodes" Dense="true" Elevation="0" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Pointer</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Code">
                                <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: 600;">@context.Code</MudText>
                            </MudTd>
                            <MudTd DataLabel="Description">
                                <MudText Typo="Typo.body2">
                                    @(string.IsNullOrWhiteSpace(context.Description) ? "Description unavailable" : context.Description)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip Size="Size.Small" Variant="Variant.Outlined">@context.Type</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Pointer">
                                <MudText Typo="Typo.body2">@context.PointerNumber</MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            </div>
        }
        else if (ActiveTab == "lines")
        {
            <div data-testid="claim-tab-lines">
            <!-- Service Lines / Claim Detail Section -->
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" />
                    Service Lines (@_claim.ServiceLines.Count)
                </MudText>
                <MudDivider Class="my-3" />
                <MudExpansionPanels Elevation="0">
                    @foreach (var line in _claim.ServiceLines)
                    {
                        <MudExpansionPanel Class="mb-2">
                            <TitleContent>
                                <MudGrid Spacing="0" Class="w-100">
                                    <MudItem xs="2">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Line @line.LineNumber</MudText>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@line.ProcedureCode</MudText>
                                        <MudText Typo="Typo.caption">@line.ProcedureDescription</MudText>
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudText Typo="Typo.body2" Style="text-align: right;">@line.Units @(line.Units > 1 ? "units" : "unit")</MudText>
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudText Typo="Typo.body2" Style="text-align: right;">@line.ChargeAmount.ToString("C")</MudText>
                                    </MudItem>
                                    @{ var review = ClaimLineReview.Evaluate(_claim, line); }
                                    <MudItem xs="2">
                                        <MudChip Size="Size.Small" Color="@OutcomeColor(review.Outcome)" Variant="Variant.Filled"
                                                 data-testid="@($"line-{line.LineNumber}-outcome")">
                                            @review.Label
                                        </MudChip>
                                    </MudItem>
                                    @if (review.Summary is { } summary)
                                    {
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Color="@(review.Outcome == LineOutcome.Pay ? Color.Secondary : OutcomeColor(review.Outcome))"
                                                     data-testid="@($"line-{line.LineNumber}-summary")">
                                                @summary
                                            </MudText>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </TitleContent>
                            <ChildContent>
                                @{ var detail = ClaimLineReview.Evaluate(_claim, line); }
                                <MudGrid>
                                    @if (detail.Edits.Count > 0)
                                    {
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Edits on this line</MudText>
                                            @foreach (var edit in detail.Edits)
                                            {
                                                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-1">
                                                    <b>@edit.Type</b>@(string.IsNullOrWhiteSpace(edit.RuleId) ? "" : $" {edit.RuleId}"): @edit.Text
                                                    @if (edit.OtherLines.Count > 0)
                                                    {
                                                        <span> · also on line@(edit.OtherLines.Count > 1 ? "s" : "") @string.Join(", ", edit.OtherLines)</span>
                                                    }
                                                    @if (edit.ModifierPresent)
                                                    {
                                                        <span> · a bypass modifier is present</span>
                                                    }
                                                </MudAlert>
                                            }
                                        </MudItem>
                                    }
                                    @if (detail.Reasons.Count > 0)
                                    {
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Why</MudText>
                                            <MudSimpleTable Dense="true" Elevation="0" data-testid="@($"line-{line.LineNumber}-reasons")">
                                                <tbody>
                                                    @foreach (var reason in detail.Reasons)
                                                    {
                                                        <tr>
                                                            <td style="font-family: monospace; white-space: nowrap;">@reason.Code</td>
                                                            <td style="@(reason.IsDenial ? "color: var(--mud-palette-error);" : "")">@reason.Text</td>
                                                            <td style="text-align: right;">@(reason.Amount is { } amount ? amount.ToString("C") : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                        </MudItem>
                                    }
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">Amounts</MudText>
                                        <MudTable Items="@GetLineDetails(line)" Dense="true" Elevation="0" Hover="false" Striped="false">
                                            <RowTemplate>
                                                <MudTd>@context.Key</MudTd>
                                                <MudTd Style="text-align: right; font-weight: 600;">@context.Value.ToString("C")</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudItem>

                                    @if (line.Modifiers.Count > 0)
                                    {
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Modifiers</MudText>
                                            @foreach (var modifier in line.Modifiers)
                                            {
                                                <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="mr-2">@modifier</MudChip>
                                            }
                                        </MudItem>
                                    }

                                    @if (line.DiagnosisPointers.Count > 0)
                                    {
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Related Diagnoses</MudText>
                                            @foreach (var pointer in line.DiagnosisPointers)
                                            {
                                                <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="mr-2">Diagnosis @pointer</MudChip>
                                            }
                                        </MudItem>
                                    }

                                    @if (!string.IsNullOrEmpty(line.RevenueCode))
                                    {
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">Revenue Code (Institutional)</MudText>
                                            <MudText Typo="Typo.body2">@line.RevenueCode</MudText>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </MudPaper>

            </div>
        }
        else if (ActiveTab == "edits")
        {
            <div data-testid="claim-tab-edits">
            @if (EditLevelReview && _review is { } review)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1" data-testid="edits-panel">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Rule" Class="mr-2" />
                        Edits to decide
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Every edit stands unless you override it. Nothing is saved until you press Finish.
                    </MudText>
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr><th>Edit</th><th>Lines</th><th>Policy</th><th>Decision</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var edit in review.Edits)
                            {
                                <tr data-testid="edit-row">
                                    <td>
                                        <MudText Typo="Typo.body2"><strong>@edit.RuleId</strong> @edit.Message</MudText>
                                    </td>
                                    <td>@edit.Lines</td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Color="@PolicyColor(edit.OverrideLevel)" data-testid="edit-policy">@PolicyLabel(edit)</MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">@edit.PolicyDescription</MudText>
                                    </td>
                                    <td style="min-width: 260px;">
                                        @if (edit.CanOverride)
                                        {
                                            <MudSwitch T="bool" Value="@review.IsOverridden(edit)" ValueChanged="@(v => { review.SetOverride(edit, v); })"
                                                       Color="Color.Warning" Label="@(review.IsOverridden(edit) ? "Override" : "Uphold")" data-testid="edit-override" />
                                            @if (review.IsOverridden(edit))
                                            {
                                                <MudTextField T="string" Value="@review.OverrideReason(edit)" ValueChanged="@(v => review.SetOverrideReason(edit, v))"
                                                              Label="@(edit.RequiresDocumentation ? "Reason (cite the documentation)" : "Reason")"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" data-testid="edit-override-reason" />
                                            }
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">Uphold</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(edit.OverrideLevel == "Never" ? "Can't be overridden." : "Needs a supervisor to override.")</MudText>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (review.View.DenialReasons.Count > 0 && _claim.ServiceLines.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4">Deny a line</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSelect T="int" @bind-Value="_denyLine" Label="Line" Dense="true" Variant="Variant.Outlined" Style="max-width:110px;" data-testid="deny-line-number">
                                @foreach (var line in _claim.ServiceLines)
                                {
                                    <MudSelectItem T="int" Value="@line.LineNumber">@line.LineNumber</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_denyCode" Label="Reason code" Dense="true" Variant="Variant.Outlined" Style="min-width:260px;" data-testid="deny-line-code">
                                @foreach (var reason in review.View.DenialReasons)
                                {
                                    <MudSelectItem T="string" Value="@reason.Code">@reason.Code — @reason.Description</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_denyReason" Label="Why" Dense="true" Variant="Variant.Outlined" Immediate="true" data-testid="deny-line-reason" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="AddLineDenial" data-testid="deny-line-add">Deny line</MudButton>
                        </MudStack>
                        @if (_denyError is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@_denyError</MudText>
                        }
                        @foreach (var denial in review.LineDenials)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1" data-testid="deny-line-entry">
                                <MudText Typo="Typo.body2">Line @denial.LineNumber: @denial.GroupCode-@denial.Carc — @denial.Reason</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => review.RemoveLineDenial(denial.LineNumber))" />
                            </MudStack>
                        }
                    }

                    @if (_confirmingFinish)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4" data-testid="finish-summary">
                            <MudText Typo="Typo.subtitle2">@review.Summary</MudText>
                            <ul class="mt-1 mb-2">
                                @foreach (var effect in review.Effects())
                                {
                                    <li><MudText Typo="Typo.body2">@effect</MudText></li>
                                }
                            </ul>
                            @foreach (var problem in review.Problems)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error" data-testid="finish-problem">@problem</MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Upheld edits are recorded as upheld by you. The claim is re-adjudicated once with these decisions.
                            </MudText>
                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(review.Problems.Count > 0 || _finishing)"
                                           OnClick="FinishAsync" data-testid="finish-confirm">Confirm and finish</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => _confirmingFinish = false)">Keep reviewing</MudButton>
                            </MudStack>
                        </MudAlert>
                    }
                </MudPaper>
            }
            </div>
        }
        else if (ActiveTab == "adjudication")
        {
            <div data-testid="claim-tab-adjudication">
            @if (_loadingAdjudication)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_adjudicationData == null)
            {
                <MudAlert Severity="Severity.Info">
                    No adjudication trace was captured for this claim. The disposition and amounts are shown above; step and calculation telemetry may be unavailable for batch adjudication run claims.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-3">Pipeline</MudText>
                <!-- Pipeline Steps -->
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: #00ffff;">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-1" Size="Size.Small" />
                    Processing Pipeline
                </MudText>
                <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-6">
                    @foreach (var step in _adjudicationData.Steps.OrderBy(s => s.StepNumber))
                    {
                        <MudTimelineItem Color="@GetStepColor(step.Status)"
                                         Size="Size.Small"
                                         Variant="@(step.Status == "Passed" ? Variant.Filled : Variant.Outlined)">
                            <ItemOpposite>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.4); font-family: monospace;">
                                    @(step.DurationMs.HasValue ? $"{step.DurationMs} ms" : "—")
                                </MudText>
                            </ItemOpposite>
                            <ItemContent>
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Step @step.StepNumber: @step.StepName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStepColor(step.Status)">@step.Status</MudChip>
                                </div>
                                @if (!string.IsNullOrEmpty(step.Summary))
                                {
                                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">@step.Summary</MudText>
                                }
                                @if (!string.IsNullOrEmpty(step.ErrorDetail))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">@step.ErrorDetail</MudAlert>
                                }
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>

                <!-- NCCI Edit Results -->
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: #00ffff;">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-1" Size="Size.Small" />
                    NCCI / MUE Edit Results
                </MudText>
                @if (!_adjudicationData.NcciResults.Any())
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        No NCCI or MUE edit failures — all procedure code combinations passed.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_adjudicationData.NcciResults" Dense="true" Hover="true" Class="mb-4"
                              Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 8px;"
                              T="NcciEditResult">
                        <HeaderContent>
                            <MudTh>Edit Code</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Procedure</MudTh>
                            <MudTh>Result</MudTh>
                            <MudTh>Resolution</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Edit Code">
                                <MudText Style="font-family: monospace; color: #00ffff;">@context.EditCode</MudText>
                            </MudTd>
                            <MudTd DataLabel="Type">@context.EditType</MudTd>
                            <MudTd DataLabel="Description">@context.Description</MudTd>
                            <MudTd DataLabel="Procedure">
                                <MudText Style="font-family: monospace;">@context.AffectedProcedureCode</MudText>
                            </MudTd>
                            <MudTd DataLabel="Result">
                                <MudChip T="string" Size="Size.Small" Color="@(context.Passed ? Color.Success : Color.Error)">
                                    @(context.Passed ? "Passed" : "Failed")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Resolution">@(context.ResolutionApplied ?? "—")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                <MudText Typo="Typo.h6" Class="mt-6 mb-3">Benefit calculation</MudText>
                <!-- Fee Schedule Results -->
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: #00ffff;">
                    <MudIcon Icon="@Icons.Material.Filled.PriceChange" Class="mr-1" Size="Size.Small" />
                    Fee Schedule — Rate Resolution
                </MudText>
                <MudTable Items="_adjudicationData.FeeScheduleResults" Dense="true" Hover="true" Class="mb-6"
                          Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 8px;"
                          T="FeeScheduleResult">
                    <HeaderContent>
                        <MudTh>Proc Code</MudTh>
                        <MudTh>Fee Schedule</MudTh>
                        <MudTh>Billed</MudTh>
                        <MudTh>Allowed</MudTh>
                        <MudTh>Rate Basis</MudTh>
                        <MudTh>Network Tier</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Proc Code">
                            <MudText Style="font-family: monospace; color: #00ffff; font-weight: 600;">@context.ProcedureCode</MudText>
                        </MudTd>
                        <MudTd DataLabel="Fee Schedule">@context.FeeScheduleName</MudTd>
                        <MudTd DataLabel="Billed">
                            <MudText Style="font-family: monospace;">@context.BilledAmount.ToString("C2")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Allowed">
                            <MudText Style="font-family: monospace; color: #00ff88; font-weight: 600;">@context.AllowedAmount.ToString("C2")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Rate Basis">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.RateBasis</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Network Tier">@context.NetworkTier</MudTd>
                    </RowTemplate>
                </MudTable>

                <!-- Benefit Calculation -->
                @if (_adjudicationData.BenefitCalculation != null)
                {
                    var bc = _adjudicationData.BenefitCalculation;
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: #00ffff;">
                        <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-1" Size="Size.Small" />
                        Benefit Calculation
                    </MudText>
                    <MudGrid Spacing="3" Class="mb-6">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 8px;">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Service Type</MudText>
                                        <MudText Typo="Typo.body2">@bc.ServiceType</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Benefit Rule Applied</MudText>
                                        <MudText Typo="Typo.body2">@bc.BenefitRuleApplied</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Network Tier</MudText>
                                        <MudText Typo="Typo.body2">@bc.NetworkTier</MudText>
                                    </div>
                                    <MudDivider Style="border-color: rgba(0,255,255,0.15);" />
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Allowed Amount</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.AllowedAmount.ToString("C2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Deductible Applied</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.DeductibleApplied.ToString("C2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Deductible Remaining</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.DeductibleRemaining.ToString("C2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Copay</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.CopayAmount.ToString("C2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Coinsurance</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.CoinsuranceAmount.ToString("C2")</MudText>
                                    </div>
                                    <MudDivider Style="border-color: rgba(0,255,136,0.2);" />
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.subtitle2" Style="color: #00ff88;">Plan Payment</MudText>
                                        <MudText Typo="Typo.subtitle2" Style="color: #00ff88; font-family: monospace;">@bc.PlanPayment.ToString("C2")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.5);">Member Responsibility</MudText>
                                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@bc.MemberResponsibility.ToString("C2")</MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(0,255,255,0.15); border-radius: 8px;">
                                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color: rgba(255,255,255,0.5);">Accumulator Progress</MudText>
                                <div class="d-flex flex-column gap-3">
                                    <div>
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2">Deductible</MudText>
                                            <MudText Typo="Typo.body2" Style="@(bc.DeductibleMet ? "color: #00ff88;" : "color: #ffaa00;")">
                                                @(bc.DeductibleMet ? "Met ✓" : $"${bc.IndividualDeductibleBalance:N0} applied")
                                            </MudText>
                                        </div>
                                        <MudProgressLinear Value="@(bc.IndividualDeductibleLimit > 0 ? (double)(bc.IndividualDeductibleBalance / bc.IndividualDeductibleLimit * 100) : 0)"
                                                           Color="@(bc.DeductibleMet ? Color.Success : Color.Warning)"
                                                           Rounded="true" Style="height: 8px;" />
                                    </div>
                                    <div>
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2">Out-of-Pocket Max</MudText>
                                            <MudText Typo="Typo.body2" Style="@(bc.OopMaxMet ? "color: #00ff88;" : "color: #00ffff;")">
                                                @(bc.OopMaxMet ? "Met ✓" : "In Progress")
                                            </MudText>
                                        </div>
                                        <MudProgressLinear Value="@(bc.IndividualOopLimit > 0 ? (double)(bc.IndividualOopBalance / bc.IndividualOopLimit * 100) : 0)"
                                                           Color="@(bc.OopMaxMet ? Color.Success : Color.Primary)"
                                                           Rounded="true" Style="height: 8px;" />
                                    </div>
                                </div>

                                @if (bc.AccumulatorUpdates.Any())
                                {
                                    <MudDivider Class="my-3" Style="border-color: rgba(0,255,255,0.15);" />
                                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.5);" Class="mb-2">Accumulator Updates This Claim</MudText>
                                    @foreach (var acc in bc.AccumulatorUpdates)
                                    {
                                        var pct = acc.Limit > 0 ? (double)(acc.NewBalance / acc.Limit * 100) : 0;
                                        <div class="d-flex justify-space-between mb-1 mt-2">
                                            <MudText Typo="Typo.caption">@acc.AccumulatorType</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(pct >= 100 ? Color.Success : pct >= 75 ? Color.Warning : Color.Default)">
                                                @pct.ToString("N0")% of @acc.Limit.ToString("C0")
                                            </MudChip>
                                        </div>
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.4);">
                                            Applied: @acc.AmountApplied.ToString("C2") → Balance: @acc.NewBalance.ToString("C2")
                                        </MudText>
                                    }
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            }
            </div>
        }
        else if (ActiveTab == "history")
        {
            <div data-testid="claim-tab-history">
            <!-- Adjustment Information (if applicable) -->
            @if (_claim.AdjustmentInfo != null)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                        Claim Adjustment History
                    </MudText>
                    <MudDivider Class="my-3" />
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adjustment Type</MudText>
                                <MudText Typo="Typo.body2">@_claim.AdjustmentInfo.AdjustmentType</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(_claim.AdjustmentInfo.OriginalClaimId))
                            {
                                <div Class="mt-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Original Claim</MudText>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => ViewClaimDetails(_claim.AdjustmentInfo.OriginalClaimId))">
                                        @_claim.AdjustmentInfo.OriginalClaimId
                                    </MudButton>
                                </div>
                            }
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adjustment Amount</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_claim.AdjustmentInfo.AdjustmentAmount.ToString("C")</MudText>
                            </div>
                            @if (_claim.AdjustmentInfo.AdjustmentDate.HasValue)
                            {
                                <div Class="mt-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Adjustment Date</MudText>
                                    <MudText Typo="Typo.body2">@_claim.AdjustmentInfo.AdjustmentDate.Value.ToString("MM/dd/yyyy")</MudText>
                                </div>
                            }
                        </MudItem>
                    </MudGrid>
                    @if (!string.IsNullOrEmpty(_claim.AdjustmentInfo.Reason))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">Reason</MudText>
                        <MudText Typo="Typo.body2">@_claim.AdjustmentInfo.Reason</MudText>
                    }
                </MudPaper>
            }

            <!-- Audit Trail -->
            @if (_claim.AuditTrail.Count > 0)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                        Change History
                    </MudText>
                    <MudDivider Class="my-3" />
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @foreach (var audit in _claim.AuditTrail.OrderByDescending(a => a.Timestamp))
                        {
                            <MudTimelineItem Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@audit.Action</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @audit.Timestamp.ToString("MM/dd/yyyy HH:mm:ss")
                                        by @audit.ChangedBy
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(audit.OldValue) || !string.IsNullOrEmpty(audit.NewValue))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1" Style="display: block;">
                                            @if (!string.IsNullOrEmpty(audit.OldValue))
                                            {
                                                <span class="mr-3">From: <code>@audit.OldValue</code></span>
                                            }
                                            @if (!string.IsNullOrEmpty(audit.NewValue))
                                            {
                                                <span> To: <code>@audit.NewValue</code></span>
                                            }
                                        </MudText>
                                    }
                                    @if (!string.IsNullOrEmpty(audit.Notes))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1" Style="display: block;"><em>@audit.Notes</em></MudText>
                                    }
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudPaper>
            }

            @if (_claim.AdjustmentInfo == null && _claim.AuditTrail.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="claim-history-empty">No adjustments or history events recorded for this claim.</MudText>
            }
            </div>
        }
        else if (ActiveTab == "notes")
        {
            <div data-testid="claim-tab-notes">
            <!-- Notes Section -->
            <MudPaper Class="pa-4 mb-4" Elevation="1" data-testid="claim-notes">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Notes" Class="mr-2" />
                    Notes
                </MudText>
                <MudDivider Class="my-3" />
                @if (!string.IsNullOrEmpty(_claim.ClaimNotes))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">From the claim submission</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">@_claim.ClaimNotes</MudText>
                }
                @if (_notesError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_notesError</MudAlert>
                }
                else if (_notes.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3" data-testid="claim-notes-empty">No notes on this claim yet.</MudText>
                }
                else
                {
                    <MudStack Spacing="2" Class="mb-3">
                        @foreach (var note in _notes)
                        {
                            <MudPaper Outlined="true" Class="pa-3" data-testid="claim-note">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                                    <MudChip T="string" Size="Size.Small" Color="@NoteColor(note.Category)" data-testid="claim-note-category">@ClaimNoteCategory.Label(note.Category)</MudChip>
                                    <MudText Typo="Typo.caption"><strong>@note.Author</strong> · @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@note.Text</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                }
                @if (_canAddNotes)
                {
                    <MudSelect T="string" @bind-Value="_noteCategory" Label="Category" Variant="Variant.Outlined" Dense="true" Class="mt-2" Style="max-width: 240px;" data-testid="claim-note-category-select">
                        @foreach (var (value, label) in ClaimNoteCategory.All)
                        {
                            <MudSelectItem T="string" Value="@value">@label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_noteInput"
                                 Label="Add a note"
                                 Variant="Variant.Outlined"
                                 Multiline="true"
                                 Lines="3"
                                 MaxLength="ClaimNoteCategory.MaxLength"
                                 Placeholder="Why you decided, who you called, what the next person needs to know"
                                 Class="mt-3" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  OnClick="AddNoteAsync"
                                  Disabled="@(_savingNote || string.IsNullOrWhiteSpace(_noteInput))"
                                  data-testid="add-note">
                            Add Note
                        </MudButton>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Notes can't be edited or deleted once added.</MudText>
                    </MudStack>
                }
            </MudPaper>

            </div>
        }
        else if (ActiveTab == "access-log")
        {
            <div data-testid="claim-tab-access-log">
                <ClaimAccessLogPanel Entries="_accessLog" Error="@_accessLogError" />
            </div>
        }

        <!-- Back, print, export -->
        <MudPaper Class="pa-4 d-flex justify-space-between align-center mt-4" Elevation="0">
            <MudButton Variant="Variant.Outlined"
                      Color="Color.Default"
                      StartIcon="@Icons.Material.Filled.ArrowBack"
                      OnClick="@(() => NavigationManager.NavigateTo(BackHref))">
                @BackLabel
            </MudButton>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintClaimAsync">
                    Print
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_exportingEob"
                           OnClick="ExportEobAsync">
                    @(_exportingEob ? "Exporting..." : "Export EOB")
                </MudButton>
            </MudStack>
        </MudPaper>


    }
    else
    {
        <MudAlert Severity="Severity.Error">
            Claim not found or failed to load.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" 
                  Color="Color.Default"
                  StartIcon="@Icons.Material.Filled.ArrowBack"
                  OnClick="@(() => NavigationManager.NavigateTo(BackHref))"
                  Class="mt-4">
            @BackLabel
        </MudButton>
    }
</MudContainer>

@code {
    [Parameter]
    public string ClaimId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "fromRun")]
    public string? FromRun { get; set; }

    /// <summary>The tab in the URL (<c>/claims/{id}/{tab}</c>); none means the default tab.</summary>
    [Parameter]
    public string? Tab { get; set; }

    // Tabs (docs/architecture/portal-navigation.md §4). Fixed order; a tab
    // with nothing to show, or that the user may not see, is hidden.
    private IReadOnlyList<RecordTab> ClaimTabs =>
    [
        new("summary", "Summary", Icons.Material.Filled.Receipt),
        new("lines", "Lines", Icons.Material.Filled.FormatListNumbered, _claim?.ServiceLines.Count),
        new("edits", "Edits", Icons.Material.Filled.Rule, _review?.Edits.Count, Visible: EditLevelReview && _review is not null),
        new("adjudication", "Adjudication", Icons.Material.Filled.AccountTree),
        new("history", "History", Icons.Material.Filled.History),
        new("notes", "Notes", Icons.Material.Filled.StickyNote2, _notes.Count > 0 ? _notes.Count : null),
        new("access-log", "Access log", Icons.Material.Filled.Visibility, Visible: _canReadAccessLog),
    ];

    // A claim waiting on edit decisions opens on Edits; anything else on Summary.
    private string DefaultTab => EditLevelReview && _review is not null ? "edits" : "summary";
    private string ActiveTab => RecordTabs.Resolve(ClaimTabs, Tab, DefaultTab);
    private string ClaimBaseHref => $"/claims/{Uri.EscapeDataString(ClaimId)}";
    private string? TabQuery => string.IsNullOrWhiteSpace(FromRun) ? null : $"?fromRun={Uri.EscapeDataString(FromRun)}";

    private bool _canReadAccessLog;
    private List<ClaimAccessEntry>? _accessLog;
    private string? _accessLogError;

    private ClaimDetails? _claim;
    private bool _loading = true;
    private bool _loadingAdjudication = false;
    private AdjudicationTransparencyData? _adjudicationData;
    private List<BreadcrumbItem> _breadcrumbItems = new();
    private string _noteInput = string.Empty;
    private EditReviewDraft? _review;
    private bool _confirmingFinish;
    private bool _finishing;
    private int _denyLine = 1;
    private string? _denyCode;
    private string? _denyReason;
    private string? _denyError;
    private string _noteCategory = ClaimNoteCategory.Internal;
    private List<ClaimNoteView> _notes = new();
    private string? _notesError;
    private bool _savingNote;
    private bool _canAddNotes;
    private string? _serviceError;
    private bool _exportingEob;
    private string BackHref => string.IsNullOrWhiteSpace(FromRun)
        ? "/claims"
        : $"/batch-adjudication?run={Uri.EscapeDataString(FromRun)}";
    private string BackLabel => string.IsNullOrWhiteSpace(FromRun)
        ? "Back to Claims"
        : "Back to Adjudication Run";

    private List<ClaimDuplicateMatch> _duplicateMatches = new();
    private string? _loadedClaimId;

    // Loads on parameter set (not just init) so following a "Possible
    // duplicates" link from /claims/{a} to /claims/{b} reloads the page
    // instead of keeping claim a's data under claim b's URL.
    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedClaimId, ClaimId, StringComparison.Ordinal))
        {
            // Same claim, maybe another tab: load what that tab needs.
            await LoadActiveTabAsync(ClaimId);
            return;
        }

        var claimId = ClaimId;
        _loadedClaimId = claimId;
        ResetClaimScopedState();
        BuildBreadcrumbs();

        await LoadClaimDetails();
        if (!IsCurrentClaim(claimId))
        {
            return; // superseded by a newer ClaimId while loading
        }

        BuildBreadcrumbs();
        // Load adjudication data in background (fire-and-forget, non-blocking)
        _ = LoadAdjudicationDataAsync(claimId);
        _ = LoadDuplicateMatchesAsync(claimId);
        _ = LoadNotesAsync(claimId);
        _ = LoadEditsAsync(claimId);
        await LoadPermissionsAsync();
        await LoadActiveTabAsync(claimId);
    }

    private async Task LoadPermissionsAsync()
    {
        try
        {
            await UserContextService.GetCurrentUserAsync();
            _canReadAccessLog = UserContextService.HasPermission("audit:read");
        }
        catch
        {
            _canReadAccessLog = false;
        }
    }

    // Tabs load their own data the first time they are shown.
    private async Task LoadActiveTabAsync(string claimId)
    {
        if (ActiveTab == "access-log" && _accessLog is null && _claim is not null)
        {
            try
            {
                var entries = await ClaimsService.GetClaimAccessLogAsync(_claim.ClaimId is { Length: > 0 } id ? id : claimId);
                if (IsCurrentClaim(claimId))
                {
                    _accessLog = entries ?? new();
                    _accessLogError = null;
                }
            }
            catch (Exception ex)
            {
                if (IsCurrentClaim(claimId))
                {
                    _accessLogError = $"The access log couldn't be loaded: {ex.Message}";
                }
            }
        }
    }

    // Everything that belongs to one claim. Cleared when ClaimId changes so
    // nothing from the previous claim (notably a draft note, which AddNoteAsync
    // would otherwise post to the new claim) carries over.
    // _exportingEob is left alone: an in-flight export clears it itself.
    private void ResetClaimScopedState()
    {
        _claim = null;
        _adjudicationData = null;
        _loadingAdjudication = false;
        _duplicateMatches = new();
        _noteInput = string.Empty;
        _noteCategory = ClaimNoteCategory.Internal;
        _notes = new();
        _notesError = null;
        _review = null;
        _confirmingFinish = false;
        _denyError = null;
        _serviceError = null;
        _accessLog = null;
        _accessLogError = null;
    }

    private bool IsCurrentClaim(string claimId) =>
        string.Equals(_loadedClaimId, claimId, StringComparison.Ordinal);

    private async Task LoadDuplicateMatchesAsync(string claimId)
    {
        // Only DUPLICATE-pended claims carry findings; skip the call otherwise.
        if (_claim?.PendDetails?.DuplicateFindings is not { Count: > 0 })
        {
            return;
        }

        try
        {
            var matches = await ClaimsService.GetDuplicateMatchesAsync(_claim.ClaimId is { Length: > 0 } id ? id : claimId);
            if (IsCurrentClaim(claimId))
            {
                _duplicateMatches = matches;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* duplicate matches are supplementary to the claim detail */ }
    }

    private void BuildBreadcrumbs()
    {
        var currentClaimLabel = _claim?.ClaimNumber is { Length: > 0 }
            ? $"Claim {_claim.ClaimNumber}"
            : $"Claim {ClaimId}";

        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new("Home", href: "/")
        };

        if (!string.IsNullOrWhiteSpace(FromRun))
        {
            _breadcrumbItems.Add(new BreadcrumbItem("Batch Adjudication", href: BackHref));
        }
        else
        {
            _breadcrumbItems.Add(new BreadcrumbItem("Claims", href: "/claims"));
        }

        _breadcrumbItems.Add(new BreadcrumbItem(currentClaimLabel, href: null, disabled: true));
    }

    // Scoped to the claim that started it: if ClaimId changes while the
    // request is in flight, the late result and loading flag are dropped so
    // they can't overwrite the newer claim's state.
    private async Task LoadAdjudicationDataAsync(string claimId)
    {
        _loadingAdjudication = true;
        AdjudicationTransparencyData? data = null;
        try
        {
            data = await ClaimsService.GetAdjudicationDataAsync(claimId);
        }
        catch { /* adjudication detail is optional */ }
        finally
        {
            if (IsCurrentClaim(claimId))
            {
                _adjudicationData = data;
                _loadingAdjudication = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private Color GetStepColor(string status) => status switch
    {
        "Passed"  => Color.Success,
        "Failed"  => Color.Error,
        "Warning" => Color.Warning,
        "Skipped" => Color.Default,
        _         => Color.Default
    };

    private async Task LoadClaimDetails()
    {
        var claimId = ClaimId;
        _loading = true;
        StateHasChanged();

        ClaimDetails? claim = null;
        string? serviceError = null;
        try
        {
            claim = await ClaimsService.GetClaimByIdAsync(claimId);
        }
        catch (ServiceUnavailableException ex)
        {
            serviceError = ex.Message;
        }
        catch (Exception ex)
        {
            if (IsCurrentClaim(claimId))
            {
                Snackbar.Add($"Error loading claim: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            // A newer ClaimId may have started its own load meanwhile; only
            // the load for the claim now on screen commits its result.
            if (IsCurrentClaim(claimId))
            {
                _claim = claim;
                if (serviceError is not null) _serviceError = serviceError;
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private Color GetStatusColor(string status) => ClaimStatusDisplay.Color(status);

    private static Color OutcomeColor(LineOutcome outcome) => outcome switch
    {
        LineOutcome.Pay => Color.Success,
        LineOutcome.Deny => Color.Error,
        LineOutcome.Pend => Color.Warning,
        _ => Color.Default
    };

    private ProviderDetailsDialog? _providerDialog;
    private bool _providerDialogRequested;

    private async Task OpenMemberAsync()
    {
        if (string.IsNullOrWhiteSpace(_claim?.MemberId)) return;
        // Peek: the member's coverage on the date of service, without leaving the claim.
        var parameters = new DialogParameters
        {
            { nameof(MemberPeekDialog.MemberId), _claim.MemberId },
            { nameof(MemberPeekDialog.AsOf), _claim.ServiceDateFrom == default ? (DateTime?)null : _claim.ServiceDateFrom },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<MemberPeekDialog>("Member", parameters, options);
    }

    private async Task OpenProviderAsync(string? npi)
    {
        if (string.IsNullOrWhiteSpace(npi)) return;
        var providers = Services.GetService<IProviderService>();
        if (providers is null) return;
        try
        {
            var match = (await providers.SearchProvidersAsync(searchTerm: npi))
                .FirstOrDefault(p => string.Equals(p.NPI, npi, StringComparison.Ordinal));
            if (match is null)
            {
                Snackbar.Add($"No provider record found for NPI {npi}.", Severity.Info);
                return;
            }
            if (_providerDialog is null)
            {
                _providerDialogRequested = true;
                StateHasChanged();
                await Task.Yield();
            }
            if (_providerDialog is not null)
                await _providerDialog.OpenAsync(match.ProviderId);
        }
        catch (ServiceUnavailableException)
        {
            Snackbar.Add("The provider service is unavailable right now.", Severity.Warning);
        }
    }

    private async Task OpenAuthorizationAsync()
    {
        if (string.IsNullOrWhiteSpace(_claim?.PriorAuthorizationNumber)) return;
        var parameters = new DialogParameters { { "AuthorizationId", _claim.PriorAuthorizationNumber } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<AuthorizationDetailsDialog>("Authorization Details", parameters, options);
    }

    private static Color GetAiRecommendationColor(string recommendation) => recommendation switch
    {
        "Approve" => Color.Success,
        "Deny" => Color.Error,
        "RequestInfo" => Color.Warning,
        _ => Color.Info
    };

    private List<KeyValuePair<string, DateTime?>> GetImportantDates()
    {
        if (_claim == null) return new();

        return new()
        {
            KeyValuePair.Create("Service Date From", _claim.ServiceDateFrom as DateTime?),
            KeyValuePair.Create("Service Date To", _claim.ServiceDateTo as DateTime?),
            KeyValuePair.Create("Submitted", _claim.SubmittedDate as DateTime?),
            KeyValuePair.Create("Received", _claim.ReceivedDate as DateTime?),
            KeyValuePair.Create("Adjudicated", _claim.AdjudicatedDate),
            KeyValuePair.Create("Paid", _claim.PaidDate)
        };
    }

    private List<KeyValuePair<string, decimal>> GetCostBreakdown()
    {
        if (_claim == null) return new();

        return new()
        {
            KeyValuePair.Create("Total Charges", _claim.TotalChargeAmount),
            KeyValuePair.Create("Allowed Amount", _claim.AllowedAmount),
            KeyValuePair.Create("Deductible", _claim.DeductibleAmount),
            KeyValuePair.Create("Coinsurance", _claim.CoinsuranceAmount),
            KeyValuePair.Create("Copay", _claim.CopayAmount),
            KeyValuePair.Create("Patient Responsibility", _claim.PatientResponsibility),
            KeyValuePair.Create("Payer Amount", _claim.PaidAmount)
        };
    }

    private List<KeyValuePair<string, decimal>> GetLineDetails(ClaimServiceLine line)
    {
        return new()
        {
            KeyValuePair.Create("Charge Amount", line.ChargeAmount),
            KeyValuePair.Create("Allowed Amount", line.AllowedAmount),
            KeyValuePair.Create("Patient Responsibility", line.PatientResponsibility),
            KeyValuePair.Create("Paid Amount", line.PaidAmount)
        };
    }

    private void ViewClaimDetails(string claimId)
    {
        NavigationManager.NavigateTo($"/claims/{claimId}");
    }

    private async Task PrintClaimAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportEobAsync()
    {
        if (_claim == null || _exportingEob) return;

        _exportingEob = true;
        try
        {
            var eobJson = await ClaimsService.GetExplanationOfBenefitJsonAsync(_claim.ClaimId);
            if (string.IsNullOrWhiteSpace(eobJson))
            {
                Snackbar.Add("No Explanation of Benefit is available for this claim.", Severity.Warning);
                return;
            }

            var claimNumber = string.IsNullOrWhiteSpace(_claim.ClaimNumber)
                ? _claim.ClaimId
                : _claim.ClaimNumber;
            var fileName = $"EOB_{SanitizeFileName(claimNumber)}.json";
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(eobJson));
            await JS.InvokeVoidAsync("downloadBase64File", fileName, "application/fhir+json", base64);
            Snackbar.Add("EOB exported.", Severity.Success);
        }
        catch (ServiceUnavailableException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting EOB: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exportingEob = false;
        }
    }

    private static string SanitizeFileName(string value)
    {
        foreach (var invalid in System.IO.Path.GetInvalidFileNameChars())
        {
            value = value.Replace(invalid, '-');
        }

        return string.IsNullOrWhiteSpace(value) ? "claim" : value;
    }

    /// <summary>
    /// The claim has edits to decide: Pay becomes Finish, and the approval
    /// carries the reviewer's edit decisions (workbench step 2).
    /// </summary>
    private bool EditLevelReview => CanResolvePendedClaim && _review?.HasAnythingToDecide == true;

    private async Task LoadEditsAsync(string claimId)
    {
        if (!CanResolvePendedClaim) return;
        try
        {
            var view = await ClaimsService.GetClaimEditsAsync(_claim?.ClaimId is { Length: > 0 } id ? id : claimId);
            if (IsCurrentClaim(claimId))
            {
                _review = view is null ? null : new EditReviewDraft(view);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            // Without the edits view the page falls back to whole-claim Pay.
            if (IsCurrentClaim(claimId)) _review = null;
        }
    }

    private void AddLineDenial()
    {
        if (_review is null) return;
        _denyError = _review.AddLineDenial(_denyLine, _denyCode ?? string.Empty, _denyReason ?? string.Empty);
        if (_denyError is null)
        {
            _denyReason = null;
        }
    }

    private async Task FinishAsync()
    {
        if (_review is null || _review.Problems.Count > 0) return;
        _finishing = true;
        try
        {
            await ApproveClaimAsync(_review);
            _confirmingFinish = false;
        }
        finally
        {
            _finishing = false;
        }
    }

    private static Color PolicyColor(string level) => level switch
    {
        "Examiner" => Color.Success,
        "Supervisor" => Color.Warning,
        _ => Color.Default,
    };

    private static string PolicyLabel(ClaimEditItem edit) => edit.OverrideLevel switch
    {
        "Never" => "Can't override",
        "Supervisor" => edit.RequiresDocumentation ? "Supervisor, documentation" : "Supervisor",
        _ => edit.RequiresReason ? "Examiner, reason" : "Examiner",
    };

    private async Task ApproveClaimAsync(EditReviewDraft? review = null)
    {
        if (_claim == null) return;
        
        // A COB pend — the routing pend or an additional one — needs the
        // payer order the examiner confirmed.
        int? payerSequence = null;
        var reason = "Claim approved by claims examiner";
        if (CobPend.On(_claim.PendDetails))
        {
            var dialog = await DialogService.ShowAsync<CobPayerOrderDialog>("Confirm payer order");
            var choice = await dialog.Result;
            if (choice is null || choice.Canceled || choice.Data is not CobPayerOrderDialog.CobPayerOrderChoice picked) return;
            payerSequence = picked.PayerSequence;
            reason = picked.Reason;
        }

        try
        {
            if (review is not null)
            {
                reason = $"Finished review: {review.Summary}";
            }
            var result = await ResolvePendedClaimAsync("Approved", reason, payerSequence, review);
            Snackbar.Add(result.AwaitingSecondApproval
                ? result.Message ?? "Waiting for a second approver."
                : "Claim approved successfully",
                result.AwaitingSecondApproval ? Severity.Info : Severity.Success);
            await LoadClaimDetails();
        }
        catch (ClaimResolutionRefusedException ex)
        {
            // The service's own reason (e.g. a COB pend without a payer order,
            // a new pend found on re-adjudication), not "service unavailable".
            Snackbar.Add(ex.ToDisplayText(), Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error approving claim: {ex.Message}", Severity.Error);
        }
    }

    private async Task DenyClaimAsync()
    {
        if (_claim == null) return;

        var parameters = new DialogParameters<DenyClaimDialog>();
        var dialog = await DialogService.ShowAsync<DenyClaimDialog>("Deny Claim", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string denialReason)
        {
            try
            {
                await ResolvePendedClaimAsync("Denied", denialReason);
                Snackbar.Add("Claim denied successfully", Severity.Success);
                await LoadClaimDetails();
            }
            catch (ClaimResolutionRefusedException ex)
            {
                Snackbar.Add(ex.ToDisplayText(), Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error denying claim: {ex.Message}", Severity.Error);
            }
        }
    }

    /// <summary>Pended, Pay or Deny: not yet remitted, so an examiner may still resolve it (Pay / Deny).</summary>
    private bool CanResolvePendedClaim => ClaimStatusDisplay.IsReprocessable(_claim?.Status);

    private bool HasExaminerDispositionRecord =>
        _claim?.PendDetails is not null
        && (ClaimStatusDisplay.IsPayOutcome(_claim.Status) || ClaimStatusDisplay.IsDenied(_claim.Status));

    private async Task<ClaimResolutionResult> ResolvePendedClaimAsync(
        string disposition, string reason, int? payerSequence = null, EditReviewDraft? review = null)
    {
        if (_claim is null) return ClaimResolutionResult.Resolved;

        string? agreement = null;
        if (_claim.AiExamination is not null)
        {
            agreement = string.Equals(
                NormalizeDisposition(_claim.AiExamination.RecommendedDisposition),
                disposition,
                StringComparison.OrdinalIgnoreCase)
                ? "Accepted"
                : "Overridden";
        }

        var user = await UserContextService.GetCurrentUserAsync();
        var examinerUserId = user?.UserId ?? user?.Email ?? "portal-examiner";

        return await WorkQueueService.ResolvePendedClaimAsync(
            _claim.ClaimId,
            disposition,
            reason,
            agreement,
            examinerUserId,
            payerSequence,
            // The pends this page showed: the approval applies to exactly those.
            _claim.PendDetails?.Fingerprint,
            // Edit-level approval: overrides only; every other edit is upheld by the service.
            review?.Decisions(),
            review?.LineDenials.ToList());
    }

    private static string NormalizeDisposition(string disposition) => disposition switch
    {
        "Approve" => "Approved",
        "Deny" => "Denied",
        _ => disposition,
    };

    private async Task ReversalFlowAsync()
    {
        if (_claim == null) return;

        var parameters = new DialogParameters<ReversalDialog>();
        parameters.Add("ClaimId", _claim.ClaimId);
        var dialog = await DialogService.ShowAsync<ReversalDialog>("Initiate Claim Reversal", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Reversal initiated successfully", Severity.Success);
            await LoadClaimDetails();
        }
    }

    private async Task LoadNotesAsync(string claimId)
    {
        try
        {
            await UserContextService.GetCurrentUserAsync();
            var canAdd = UserContextService.HasPermission("claims:note");
            var notes = await ClaimsService.GetClaimNotesAsync(_claim?.ClaimId is { Length: > 0 } id ? id : claimId);
            if (IsCurrentClaim(claimId))
            {
                _canAddNotes = canAdd;
                _notes = notes ?? new();
                _notesError = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (IsCurrentClaim(claimId))
            {
                _notesError = $"Notes couldn't be loaded: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_noteInput) || _claim == null || _savingNote) return;

        var claimId = _loadedClaimId;
        _savingNote = true;
        try
        {
            var note = await ClaimsService.AddClaimNoteAsync(_claim.ClaimId, _noteCategory, _noteInput.Trim());
            if (claimId is not null && IsCurrentClaim(claimId))
            {
                _notes.Add(note);
                _noteInput = string.Empty;
                Snackbar.Add("Note added", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingNote = false;
        }
    }

    private static Color NoteColor(string? category) => category switch
    {
        ClaimNoteCategory.Decision => Color.Primary,
        ClaimNoteCategory.ProviderContact or ClaimNoteCategory.MemberContact => Color.Info,
        ClaimNoteCategory.HandOff => Color.Warning,
        _ => Color.Default,
    };
}

