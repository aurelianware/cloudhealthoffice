@page "/eligibility"
@page "/eligibility-simulator"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject IEligibilityService EligibilityService
@inject IMemberService MemberService

<PageTitle>270/271 Eligibility Simulator - Cloud Health Office</PageTitle>

<PermissionGate Permission="eligibility:check" RoleName="MemberServices">
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="mr-2" />
        270/271 Eligibility Simulator
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-2">
        Shows exactly what a provider or clearinghouse would receive in a 271 for a given 270 request.
        Use it for EDI and trading-partner testing and troubleshooting.
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        Looking up a member's coverage for a call or a claim? Open the member on
        <MudLink Href="/members" Typo="Typo.body2">Members</MudLink>; the Coverage &amp; Benefits tab is the everyday view.
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">270 Request &mdash; Subscriber</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Search by Member ID, Member ID + name, or Last Name + First Name + Date of Birth.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudAutocomplete T="MemberSummary"
                                     Value="_pickedMember"
                                     ValueChanged="OnMemberPicked"
                                     SearchFunc="SearchMembers"
                                     Label="Find member (optional)"
                                     Placeholder="Search by name or ID to fill the request"
                                     ToStringFunc="@(m => m == null ? null : $"{m.FirstName} {m.LastName} ({m.MemberId})")"
                                     Variant="Variant.Outlined"
                                     ResetValueOnEmptyText="true"
                                     AnchorOrigin="Origin.BottomCenter"
                                     MaxItems="10"
                                     Class="mb-3">
                        <ItemTemplate>
                            <div>
                                <MudText Typo="Typo.body2">@context.FirstName @context.LastName</MudText>
                                <MudText Typo="Typo.caption">ID: @context.MemberId | DOB: @context.DateOfBirth.ToString("MM/dd/yyyy")</MudText>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>

                    <MudForm @ref="_form">
                        <MudTextField @bind-Value="_request.SubscriberId" Label="Member ID"
                                      HelperText="Optional when Last Name + First Name + Date of Birth are given"
                                      Immediate="true" Variant="Variant.Outlined" Class="mb-3"
                                      UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "subscriber-id" })" />

                        <MudTextField @bind-Value="_request.LastName" Label="Last Name"
                                      Immediate="true" Variant="Variant.Outlined" Class="mb-3"
                                      UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "last-name" })" />

                        <MudTextField @bind-Value="_request.FirstName" Label="First Name"
                                      Immediate="true" Variant="Variant.Outlined" Class="mb-3"
                                      UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "first-name" })" />

                        <MudDatePicker @bind-Date="_request.DateOfBirth" Label="Date of Birth"
                                       Editable="true" Placeholder="MM/DD/YYYY" DateFormat="MM/dd/yyyy"
                                       Variant="Variant.Outlined" Class="mb-3"
                                       UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "dob" })" />

                        <MudDatePicker @bind-Date="_request.ServiceDate" Label="Service Date"
                                       Variant="Variant.Outlined" Class="mb-3" />

                        @if (_validationError != null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="criteria-error">@_validationError</MudAlert>
                        }

                        @if (_candidates.Count > 1)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="ambiguous-matches">
                                @_candidates.Count members match that name and date of birth. Pick one to send the 270.
                            </MudAlert>
                            <div class="mb-3">
                                @foreach (var candidate in _candidates)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                                               Style="justify-content: flex-start; text-transform: none;"
                                               OnClick="@(() => PickCandidate(candidate))"
                                               data-testid="@($"candidate-{candidate.MemberId}")">
                                        @candidate.FirstName @candidate.LastName &middot; @candidate.MemberId &middot; DOB @candidate.DateOfBirth.ToString("MM/dd/yyyy")
                                    </MudButton>
                                }
                            </div>
                        }

                        <MudSelect @bind-Value="_request.ServiceType" Label="Service Type"
                                   Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("30")">Health Benefit Coverage</MudSelectItem>
                            <MudSelectItem Value="@("33")">Chiropractic</MudSelectItem>
                            <MudSelectItem Value="@("35")">Dental Care</MudSelectItem>
                            <MudSelectItem Value="@("47")">Diagnostic Services</MudSelectItem>
                            <MudSelectItem Value="@("86")">Emergency Services</MudSelectItem>
                            <MudSelectItem Value="@("88")">Pharmacy</MudSelectItem>
                        </MudSelect>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   DisableElevation="true" FullWidth="true"
                                   OnClick="CheckEligibility" Disabled="@_checking"
                                   data-testid="send-270">
                            @if (_checking)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Checking...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                                <span>Send 270</span>
                            }
                        </MudButton>
                    </MudForm>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="7">
            @if (_response != null)
            {
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">Eligibility Response (271)</MudText>
                                @if (!string.IsNullOrEmpty(_response.LineOfBusiness))
                                {
                                    <MudChip Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@GetLobColor(_response.LineOfBusiness)">
                                        @_response.LineOfBusiness
                                    </MudChip>
                                }
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @* ── Coverage Status ── *@
                        <MudAlert Severity="@(_response.IsCovered ? Severity.Success : Severity.Error)" Class="mb-4">
                            <MudText Typo="Typo.h6">
                                @if (_response.IsCovered)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                                    <span>ACTIVE COVERAGE</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-2" />
                                    <span>NO ACTIVE COVERAGE</span>
                                }
                            </MudText>
                            @if (!string.IsNullOrEmpty(_response.RejectionReason))
                            {
                                <MudText Typo="Typo.body2">@_response.RejectionReason</MudText>
                            }
                        </MudAlert>

                        @if (_response.IsCovered)
                        {
                            @* ── Plan Information ── *@
                            <MudText Typo="Typo.h6" Class="mb-2">Plan Information</MudText>
                            <MudSimpleTable Dense="true" Class="mb-4">
                                <tbody>
                                    <tr>
                                        <td><strong>Plan Name:</strong></td>
                                        <td>@_response.InsurancePlanName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Group Number:</strong></td>
                                        <td>@_response.GroupNumber</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Coverage Level:</strong></td>
                                        <td>@FormatCoverageLevel(_response.CoverageLevel)</td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(_response.InsuranceType))
                                    {
                                        <tr>
                                            <td><strong>Insurance Type:</strong></td>
                                            <td>@FormatInsuranceType(_response.InsuranceType)</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td><strong>Effective Date:</strong></td>
                                        <td>@_response.CoverageBeginDate?.ToString("MM/dd/yyyy")</td>
                                    </tr>
                                    @if (_response.CoverageEndDate.HasValue)
                                    {
                                        <tr>
                                            <td><strong>Termination Date:</strong></td>
                                            <td>@_response.CoverageEndDate.Value.ToString("MM/dd/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>

                            @* ── Deductible ── *@
                            @if (_response.Deductible != null)
                            {
                                <MudText Typo="Typo.h6" Class="mb-2">
                                    Deductible
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display:inline;">
                                        @_response.Deductible.TimePeriod
                                    </MudText>
                                </MudText>
                                <MudGrid Class="mb-4">
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Individual</MudText>
                                        <MudProgressLinear Color="Color.Primary"
                                                           Value="@GetProgress(_response.Deductible.IndividualMet, _response.Deductible.IndividualAmount)"
                                                           Class="mb-1" />
                                        <MudText Typo="Typo.caption">
                                            @_response.Deductible.IndividualMet.ToString("C") met of @_response.Deductible.IndividualAmount.ToString("C")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @_response.Deductible.IndividualRemaining.ToString("C") remaining
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Family</MudText>
                                        <MudProgressLinear Color="Color.Primary"
                                                           Value="@GetProgress(_response.Deductible.FamilyMet, _response.Deductible.FamilyAmount)"
                                                           Class="mb-1" />
                                        <MudText Typo="Typo.caption">
                                            @_response.Deductible.FamilyMet.ToString("C") met of @_response.Deductible.FamilyAmount.ToString("C")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @_response.Deductible.FamilyRemaining.ToString("C") remaining
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            }

                            @* ── Out-of-Pocket Maximum ── *@
                            @if (_response.OutOfPocket != null)
                            {
                                <MudText Typo="Typo.h6" Class="mb-2">
                                    Out-of-Pocket Maximum
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display:inline;">
                                        @_response.OutOfPocket.TimePeriod
                                    </MudText>
                                </MudText>
                                <MudGrid Class="mb-4">
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Individual</MudText>
                                        <MudProgressLinear Color="Color.Success"
                                                           Value="@GetProgress(_response.OutOfPocket.IndividualMet, _response.OutOfPocket.IndividualAmount)"
                                                           Class="mb-1" />
                                        <MudText Typo="Typo.caption">
                                            @_response.OutOfPocket.IndividualMet.ToString("C") met of @_response.OutOfPocket.IndividualAmount.ToString("C")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @_response.OutOfPocket.IndividualRemaining.ToString("C") remaining
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Family</MudText>
                                        <MudProgressLinear Color="Color.Success"
                                                           Value="@GetProgress(_response.OutOfPocket.FamilyMet, _response.OutOfPocket.FamilyAmount)"
                                                           Class="mb-1" />
                                        <MudText Typo="Typo.caption">
                                            @_response.OutOfPocket.FamilyMet.ToString("C") met of @_response.OutOfPocket.FamilyAmount.ToString("C")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @_response.OutOfPocket.FamilyRemaining.ToString("C") remaining
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            }

                            @* ── Benefits ── *@
                            @if (_response.Benefits?.Any() == true)
                            {
                                <MudText Typo="Typo.h6" Class="mb-2">Benefits</MudText>
                                <MudTable Items="@_response.Benefits" Dense="true" Hover="true" Class="mb-4">
                                    <HeaderContent>
                                        <MudTh>Service</MudTh>
                                        <MudTh>Network</MudTh>
                                        <MudTh Style="text-align:right">Copay</MudTh>
                                        <MudTh Style="text-align:right">Coinsurance</MudTh>
                                        <MudTh Style="text-align:right">Limit</MudTh>
                                        <MudTh>Auth</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Service">@context.ServiceTypeName</MudTd>
                                        <MudTd DataLabel="Network">
                                            @if (context.NetworkIndicator == "Y")
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Text">In-Network</MudChip>
                                            }
                                            else if (context.NetworkIndicator == "N")
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Out-of-Network</MudChip>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Copay" Style="text-align:right">@(context.MonetaryAmount?.ToString("C") ?? "—")</MudTd>
                                        <MudTd DataLabel="Coinsurance" Style="text-align:right">@(context.Percentage?.ToString("P0") ?? "—")</MudTd>
                                        <MudTd DataLabel="Limit" Style="text-align:right">
                                            @if (context.Quantity.HasValue)
                                            {
                                                @($"{context.Quantity:F0} {FormatQuantityQualifier(context.QuantityQualifier)}/{FormatTimePeriod(context.TimePeriod)}")
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Auth">
                                            @if (context.AuthorizationRequired)
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Warning">Required</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Success">Not Required</MudChip>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }

                            @* ── Coordination of Benefits ── *@
                            @if (_response.AdditionalInsurances?.Any() == true)
                            {
                                <MudText Typo="Typo.h6" Class="mb-2">Coordination of Benefits (COB)</MudText>
                                <MudTable Items="@_response.AdditionalInsurances" Dense="true" Hover="true" Class="mb-4">
                                    <HeaderContent>
                                        <MudTh>Payer</MudTh>
                                        <MudTh>Sequence</MudTh>
                                        <MudTh>Group</MudTh>
                                        <MudTh>Effective</MudTh>
                                        <MudTh>Type</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Payer">@context.PayerName</MudTd>
                                        <MudTd DataLabel="Sequence">
                                            <MudChip Size="Size.Small" Variant="Variant.Outlined"
                                                     Color="@(context.CoverageSequence == "P" ? Color.Primary : Color.Default)">
                                                @FormatCoverageSequence(context.CoverageSequence)
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Group">@(context.GroupNumber ?? "—")</MudTd>
                                        <MudTd DataLabel="Effective">@context.CoverageBeginDate?.ToString("MM/dd/yyyy")</MudTd>
                                        <MudTd DataLabel="Type">
                                            @if (context.IsMedicare)
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Medicare</MudChip>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2">Commercial</MudText>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            }
            else if (!_checking)
            {
                <MudPaper Elevation="0" Class="d-flex align-center justify-center" Style="height: 400px;">
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        Enter a 270 request to see the 271 response
                    </MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudContainer>
</PermissionGate>

@code {
    private MudForm? _form;
    private bool _checking = false;
    private string? _serviceError;
    private string? _validationError;
    private Eligibility270Criteria _request = new();
    private EligibilityResponse? _response;
    private MemberSummary? _pickedMember;
    private List<MemberSummary> _candidates = new();

    private async Task<IEnumerable<MemberSummary>> SearchMembers(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<MemberSummary>();

        try
        {
            return await MemberService.SearchMembersAsync(value);
        }
        catch
        {
            return new List<MemberSummary>();
        }
    }

    private Task OnMemberPicked(MemberSummary? member)
    {
        _pickedMember = member;
        if (member != null)
        {
            FillFrom(member);
        }
        return Task.CompletedTask;
    }

    private void FillFrom(MemberSummary member)
    {
        _request.SubscriberId = member.MemberId;
        _request.FirstName = member.FirstName;
        _request.LastName = member.LastName;
        _request.DateOfBirth = member.DateOfBirth == default ? null : member.DateOfBirth.Date;
        _validationError = null;
    }

    private async Task PickCandidate(MemberSummary candidate)
    {
        _candidates = new();
        FillFrom(candidate);
        await SendInquiryAsync(candidate.MemberId);
    }

    private async Task CheckEligibility()
    {
        _candidates = new();
        _validationError = EligibilitySimulator.Validate(_request);
        if (_validationError != null)
        {
            _response = null;
            return;
        }

        if (_request.HasId)
        {
            await SendInquiryAsync(_request.SubscriberId.Trim());
            return;
        }

        // Name + DOB without an ID. eligibility-service keys its coverage
        // lookup on SubscriberId, so resolve the member here first.
        _checking = true;
        _response = null;
        MemberSummary? resolved;
        try
        {
            var resolution = await EligibilitySimulator.ResolveByNameAndDobAsync(
                MemberService, _request.FirstName, _request.LastName, _request.DateOfBirth!.Value);
            switch (resolution.Status)
            {
                case MemberResolutionStatus.NotFound:
                    _response = EligibilitySimulator.SubscriberNotFound();
                    return;
                case MemberResolutionStatus.Ambiguous:
                    _candidates = resolution.Candidates.ToList();
                    return;
            }
            resolved = resolution.Member;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Member search is currently unavailable: {ex.Message}";
            return;
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred searching for the member: {ex.Message}";
            return;
        }
        finally
        {
            _checking = false;
        }

        await SendInquiryAsync(resolved!.MemberId);
    }

    private async Task SendInquiryAsync(string subscriberId)
    {
        _checking = true;
        _response = null;

        try
        {
            _response = await EligibilityService.CheckEligibilityAsync(
                EligibilitySimulator.BuildInquiry(_request, subscriberId));
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Eligibility service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred checking eligibility: {ex.Message}";
        }
        finally
        {
            _checking = false;
        }
    }

    private static double GetProgress(decimal met, decimal total) =>
        total > 0 ? (double)(met / total * 100) : 0;

    private static string FormatCoverageLevel(string? level) => level switch
    {
        "EMP" => "Employee Only",
        "ESP" => "Employee + Spouse",
        "ECH" => "Employee + Children",
        "FAM" => "Family",
        "IND" => "Individual",
        "E1" => "Employee + One",
        _ => level ?? ""
    };

    private static string FormatInsuranceType(string? type) => type switch
    {
        "HLT" => "Health",
        "DEN" => "Dental",
        "VIS" => "Vision",
        "LIF" => "Life",
        _ => type ?? ""
    };

    private static string FormatQuantityQualifier(string? qualifier) => qualifier switch
    {
        "VS" => "visits",
        "DA" => "days",
        "UN" => "units",
        "MN" => "months",
        _ => qualifier ?? "units"
    };

    private static string FormatTimePeriod(string? period) => period switch
    {
        "26" => "visit",
        "27" => "day",
        "29" => "year",
        "30" => "month",
        "23" => "episode",
        _ => period ?? "year"
    };

    private static string FormatCoverageSequence(string? seq) => seq switch
    {
        "P" => "Primary",
        "S" => "Secondary",
        "T" => "Tertiary",
        _ => seq ?? ""
    };

    private static Color GetLobColor(string? lob) => lob?.ToLowerInvariant() switch
    {
        "commercial" => Color.Primary,
        "medicare" => Color.Info,
        "medicaid" => Color.Success,
        "exchange" => Color.Warning,
        _ => Color.Default
    };
}
