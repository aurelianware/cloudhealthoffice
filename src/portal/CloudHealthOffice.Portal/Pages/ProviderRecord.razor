@page "/providers/{ProviderId}"
@page "/providers/{ProviderId}/{Tab}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Provider - Cloud Health Office</PageTitle>

<PermissionGate Permission="providers:read" RoleName="ProviderRelations">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />
    <ProviderRecordView @key="ProviderId" ProviderId="@ProviderId" Tab="@Tab" BaseHref="@BaseHref" />
</MudContainer>
</PermissionGate>

@code {
    [Parameter] public string ProviderId { get; set; } = string.Empty;
    [Parameter] public string? Tab { get; set; }

    private string BaseHref => $"/providers/{Uri.EscapeDataString(ProviderId)}";

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnParametersSet() =>
        _breadcrumbs =
        [
            new("Home", href: "/"),
            new("Providers", href: "/providers"),
            new("Provider", href: null, disabled: true),
        ];
}
