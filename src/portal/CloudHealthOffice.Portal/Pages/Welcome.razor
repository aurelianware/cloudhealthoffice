@page "/welcome"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Welcome to Cloud Health Office</PageTitle>

<HeadContent>
    @* Temporarily disabled analytics to debug portal crash
    <script async src="https://plausible.io/js/pa-DSFLxN3jN3PVX0eGzs8vx.js"></script>
    *@
</HeadContent>

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <img src="/images/logo-cloudhealthoffice-sentinel-primary.svg" alt="Cloud Health Office" class="hero-logo" />
        <h1 class="display-4">Cloud Health Office</h1>
        <p class="lead">The #1 Open-Source Cloud-Native Payer Platform. Production-ready FHIR APIs, &lt;500ms claims adjudication, CMS-compliant.</p>
        <div style="margin-top: 32px;">
            <a href="/signup" class="btn btn-light btn-lg" style="margin-right: 16px;">Start Free Trial</a>
            <a href="/demo" class="btn btn-outline-light btn-lg" style="margin-right: 16px;">View Demo</a>
            <a href="/docs" class="btn btn-outline-light btn-lg">Documentation</a>
        </div>
    </div>
</section>

<!-- Key Links -->
<section class="py-4" style="background: rgba(0, 255, 255, 0.05); border-bottom: 1px solid rgba(0, 255, 255, 0.2);">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3">
                <a href="/apis" style="text-decoration: none; color: inherit;">
                    <div style="padding: 20px;">
                        <div style="font-size: 36px; margin-bottom: 8px;">🔌</div>
                        <h5 style="color: #00ffff;">FHIR APIs</h5>
                        <p style="font-size: 14px; color: rgba(255, 255, 255, 0.7);">CMS-compliant REST APIs</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/docs" style="text-decoration: none; color: inherit;">
                    <div style="padding: 20px;">
                        <div style="font-size: 36px; margin-bottom: 8px;">📖</div>
                        <h5 style="color: #00ffff;">Docs</h5>
                        <p style="font-size: 14px; color: rgba(255, 255, 255, 0.7);">Integration guides & examples</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/pricing" style="text-decoration: none; color: inherit;">
                    <div style="padding: 20px;">
                        <div style="font-size: 36px; margin-bottom: 8px;">💰</div>
                        <h5 style="color: #00ffff;">Pricing</h5>
                        <p style="font-size: 14px; color: rgba(255, 255, 255, 0.7);">$499-$1,499/mo, 14-day trial</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="https://github.com/aurelianware/cloudhealthoffice" target="_blank" style="text-decoration: none; color: inherit;">
                    <div style="padding: 20px;">
                        <div style="font-size: 36px; margin-bottom: 8px;">⭐</div>
                        <h5 style="color: #00ffff;">GitHub</h5>
                        <p style="font-size: 14px; color: rgba(255, 255, 255, 0.7);">BSL 1.1, 42K+ clones</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Production-Ready Platform</h2>
        <div class="row">
            <div class="col-md-4 text-center">
                <div class="feature-icon">⚡</div>
                <h4>Claims Processing</h4>
                <p>837/835 Professional & Institutional claims with &lt;500ms adjudication. 10-step intelligent workflow.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon">✓</div>
                <h4>Eligibility Verification</h4>
                <p>270/271 real-time eligibility inquiries with benefit coverage details and plan information.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon">🔐</div>
                <h4>Prior Authorization</h4>
                <p>278 authorization with CDS Hooks for coverage requirements discovery (CMS-0057-F compliant).</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon">📎</div>
                <h4>Medical Attachments</h4>
                <p>275/277 attachments with RFAI workflows. Automated document delivery and tracking.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon">👥</div>
                <h4>Member Enrollment</h4>
                <p>834 enrollment transactions with member demographics, coverage updates, and sponsor management.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon">🔌</div>
                <h4>FHIR R4 APIs</h4>
                <p>Patient Access, Prior Auth, Provider Directory APIs. CMS-9115-F and CMS-0057-F compliant.</p>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Modern Architecture, Proven Results</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="testimonial">
                    <p>"Reduced prior authorization turnaround from 12 days to under 2 minutes"</p>
                    <p><strong>— Regional Health Plan</strong></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial">
                    <p>"99.9% faster than our previous system. Claims adjudication now &lt;500ms"</p>
                    <p><strong>— Medicare Advantage Plan</strong></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial">
                    <p>"From signup to first claim processed in 47 minutes. Incredible."</p>
                    <p><strong>— Startup Health Plan</strong></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Signup Section -->
<section id="signup" class="signup-section">
    <div class="container">
        <h2 class="text-center mb-4">Start Your 14-Day Free Trial</h2>
        <p class="text-center mb-5">No credit card required for trial. Secure billing powered by Stripe.</p>
        
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <a href="/signup" class="btn btn-light btn-lg" style="margin-right: 16px; margin-bottom: 16px;">
                    Sign Up Now
                </a>
                <a href="/pricing" class="btn btn-outline-light btn-lg" style="margin-right: 16px; margin-bottom: 16px;">
                    View Pricing
                </a>
                <a href="/contact-sales" class="btn btn-outline-light btn-lg" style="margin-bottom: 16px;">
                    Contact Sales
                </a>
                
                <div class="mt-5 pt-4" style="border-top: 1px solid rgba(255, 255, 255, 0.2);">
                    <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 16px;">
                        <strong>Quick Links:</strong>
                    </p>
                    <a href="/docs" style="color: #00ffff; margin-right: 24px;">Documentation</a>
                    <a href="/apis" style="color: #00ffff; margin-right: 24px;">FHIR APIs</a>
                    <a href="/demo" style="color: #00ffff; margin-right: 24px;">Live Demo</a>
                    <a href="/legal" style="color: #00ffff;">Legal & Compliance</a>
                </div>
            </div>
        </div>
    </div>
</section>
