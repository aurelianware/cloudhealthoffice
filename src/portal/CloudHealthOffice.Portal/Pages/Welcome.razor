@page "/welcome"
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Cloud Health Office — The Sentinel Platform</PageTitle>

<!-- Hero Section -->
<section class="w-hero">
    <div class="w-hero-circuit"></div>
    <div class="w-hero-scan"></div>
    <div class="w-hero-content">
        <div class="w-hero-badge">THE SENTINEL PLATFORM</div>
        <h1 class="w-hero-headline">Cloud Health Office</h1>
        <p class="w-hero-sub">
            The #1 Source-Available Cloud-Native Payer Platform. Production-ready FHIR APIs,
            &lt;500ms claims adjudication, CMS-compliant.
        </p>
        <div class="w-hero-cta">
            <MudButton Href="/signup"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="w-btn-primary">
                Start Free Trial
            </MudButton>
            <MudButton Href="/demo"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Large">
                View Demo
            </MudButton>
            <MudButton Href="/docs"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Large">
                Documentation
            </MudButton>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="w-stats-bar">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="6" sm="3">
            <a href="/apis" class="w-stat-link">
                <div class="w-stat-icon">🔌</div>
                <div class="w-stat-title">FHIR APIs</div>
                <div class="w-stat-desc">CMS-compliant REST APIs</div>
            </a>
        </MudItem>
        <MudItem xs="6" sm="3">
            <a href="/docs" class="w-stat-link">
                <div class="w-stat-icon">📖</div>
                <div class="w-stat-title">Docs</div>
                <div class="w-stat-desc">Integration guides &amp; examples</div>
            </a>
        </MudItem>
        <MudItem xs="6" sm="3">
            <a href="/pricing" class="w-stat-link">
                <div class="w-stat-icon">💡</div>
                <div class="w-stat-title">Pricing</div>
                <div class="w-stat-desc">Contact sales for pricing</div>
            </a>
        </MudItem>
        <MudItem xs="6" sm="3">
            <a href="https://github.com/aurelianware/cloudhealthoffice" target="_blank" class="w-stat-link">
                <div class="w-stat-icon">⭐</div>
                <div class="w-stat-title">GitHub</div>
                <div class="w-stat-desc">BSL 1.1 · 250K+ clones</div>
            </a>
        </MudItem>
    </MudGrid>
</section>

<!-- Platform Features -->
<section class="w-section">
    <div class="w-section-inner">
        <div class="w-section-label">PLATFORM CAPABILITIES</div>
        <h2 class="w-section-title">Production-Ready Platform</h2>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">⚡</div>
                    <h3 class="w-feature-title">Claims Processing</h3>
                    <p class="w-feature-desc">837/835 Professional &amp; Institutional claims with &lt;500ms adjudication. 10-step intelligent workflow.</p>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">✓</div>
                    <h3 class="w-feature-title">Eligibility Verification</h3>
                    <p class="w-feature-desc">270/271 real-time eligibility inquiries with benefit coverage details and plan information.</p>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">🔐</div>
                    <h3 class="w-feature-title">Prior Authorization</h3>
                    <p class="w-feature-desc">278 authorization with CDS Hooks for coverage requirements discovery (CMS-0057-F compliant).</p>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">📎</div>
                    <h3 class="w-feature-title">Medical Attachments</h3>
                    <p class="w-feature-desc">275/277 attachments with RFAI workflows. Automated document delivery and tracking.</p>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">👥</div>
                    <h3 class="w-feature-title">Member Enrollment</h3>
                    <p class="w-feature-desc">834 enrollment transactions with member demographics, coverage updates, and sponsor management.</p>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="w-feature-card">
                    <div class="w-feature-icon">🔌</div>
                    <h3 class="w-feature-title">FHIR R4 APIs</h3>
                    <p class="w-feature-desc">Patient Access, Prior Auth, Provider Directory APIs. CMS-9115-F and CMS-0057-F compliant.</p>
                </div>
            </MudItem>
        </MudGrid>
    </div>
</section>

<!-- Results / Testimonials -->
<section class="w-testimonials-section">
    <div class="w-section-inner">
        <div class="w-section-label">CUSTOMER RESULTS</div>
        <h2 class="w-section-title">Modern Architecture, Proven Results</h2>
        <MudGrid>
            <MudItem xs="12" md="4">
                <div class="w-testimonial">
                    <p class="w-testimonial-quote">"Reduced prior authorization turnaround from 12 days to under 2 minutes"</p>
                    <p class="w-testimonial-author">— Regional Health Plan</p>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="w-testimonial">
                    <p class="w-testimonial-quote">"99.9% faster than our previous system. Claims adjudication now &lt;500ms"</p>
                    <p class="w-testimonial-author">— Medicare Advantage Plan</p>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="w-testimonial">
                    <p class="w-testimonial-quote">"From signup to first claim processed in 47 minutes. Incredible."</p>
                    <p class="w-testimonial-author">— Startup Health Plan</p>
                </div>
            </MudItem>
        </MudGrid>
    </div>
</section>

<!-- CTA Section -->
<section class="w-cta-section">
    <div class="w-section-inner" style="text-align: center;">
        <h2 class="w-cta-headline">Start Your <span class="w-cta-accent">14-Day Free Trial</span></h2>
        <p class="w-cta-sub">Secure billing powered by Stripe.</p>
        <div class="w-cta-buttons">
            <MudButton Href="/signup"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="w-btn-primary">
                Sign Up Now
            </MudButton>
            <MudButton Href="/contact-sales"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Large">
                Contact Sales
            </MudButton>
        </div>
        <div class="w-cta-links">
            <a href="/docs">Documentation</a>
            <a href="/apis">FHIR APIs</a>
            <a href="/demo">Live Demo</a>
            <a href="/legal">Legal &amp; Compliance</a>
        </div>
    </div>
</section>
