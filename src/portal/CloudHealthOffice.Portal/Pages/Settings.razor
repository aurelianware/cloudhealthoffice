@page "/settings"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject HttpClient Http
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject ITenantContextService TenantContextService
@inject IOperatingModeService OperatingModeService

<PageTitle>Settings - Cloud Health Office</PageTitle>

<PermissionGate Permission="settings:manage" RoleName="TenantAdmin">
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
        Tenant Settings
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mt-4">
        <!-- Billing & Subscription Tab -->
        <MudTabPanel Text="Billing & Subscription" Icon="@Icons.Material.Filled.CreditCard">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h5" GutterBottom="true">Current Subscription</MudText>
                
                @if (isLoadingSubscription)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (subscription != null)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudCard Outlined="true" Class="mb-4">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">Plan Details</MudText>
                                    <MudDivider Class="my-2" />
                                    
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                        <MudText>Current Plan:</MudText>
                                        <MudChip Color="Color.Primary">@subscription.Tier</MudChip>
                                    </MudStack>
                                    
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                        <MudText>Status:</MudText>
                                        <MudChip Color="@GetStatusColor(subscription.Status)">@subscription.Status</MudChip>
                                    </MudStack>
                                    
                                    @if (subscription.TrialEnd != null && subscription.Status == "trialing")
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                            <MudText>Trial Ends:</MudText>
                                            <MudText Typo="Typo.body2">@subscription.TrialEnd?.ToString("MMM dd, yyyy")</MudText>
                                        </MudStack>
                                    }
                                    
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                        <MudText>Monthly Cost:</MudText>
                                        <MudText Typo="Typo.body1"><strong>@GetPriceDisplay(subscription.Tier)</strong></MudText>
                                    </MudStack>
                                    
                                    @if (subscription.CurrentPeriodEnd != null)
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                            <MudText>Next Billing Date:</MudText>
                                            <MudText Typo="Typo.body2">@subscription.CurrentPeriodEnd?.ToString("MMM dd, yyyy")</MudText>
                                        </MudStack>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton StartIcon="@Icons.Material.Filled.Upgrade" Color="Color.Primary" Variant="Variant.Text" OnClick="ShowUpgradeDialog">
                                        Change Plan
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Error" Variant="Variant.Text" OnClick="ShowCancelDialog">
                                        Cancel Subscription
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                        
                        <MudItem xs="12" md="6">
                            <MudCard Outlined="true" Class="mb-4">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">Payment Method</MudText>
                                    <MudDivider Class="my-2" />
                                    
                                    @if (!string.IsNullOrEmpty(subscription.PaymentMethodLast4))
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
                                                <MudText>•••• •••• •••• @subscription.PaymentMethodLast4</MudText>
                                            </MudStack>
                                            <MudChip Size="Size.Small">@subscription.PaymentMethodBrand</MudChip>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning">No payment method on file</MudAlert>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton StartIcon="@Icons.Material.Filled.Edit" Color="Color.Primary" Variant="Variant.Text" OnClick="UpdatePaymentMethod">
                                        Update Payment Method
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                            
                            <MudCard Outlined="true">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">Billing History</MudText>
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        View your invoices and payment history
                                    </MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton StartIcon="@Icons.Material.Filled.Receipt" Color="Color.Primary" Variant="Variant.Text" Href="@GetStripeBillingPortalUrl()" Target="_blank">
                                        View Billing Portal
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">No active subscription found</MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
        
        <!-- General Tab -->
        <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Business">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h5" GutterBottom="true">Tenant Information</MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3" Icon="@Icons.Material.Filled.AdminPanelSettings">
                    Configuration managed by your administrator. Contact support for changes to your organization details.
                </MudAlert>
            </MudPaper>
        </MudTabPanel>

        <!-- Users & Permissions Tab -->
        <MudTabPanel Text="Users & Permissions" Icon="@Icons.Material.Filled.People">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h5" GutterBottom="true">User Management</MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3" Icon="@Icons.Material.Filled.Security">
                    User management is configured through your Azure AD tenant. Use the Azure portal to manage user access and role assignments.
                </MudAlert>
            </MudPaper>
        </MudTabPanel>

        <!-- Integration Tab -->
        <MudTabPanel Text="Integrations" Icon="@Icons.Material.Filled.IntegrationInstructions">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h5" GutterBottom="true">API Keys & Integrations</MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3" Icon="@Icons.Material.Filled.IntegrationInstructions">
                    Contact your account manager to configure API keys, webhooks, and external integrations.
                </MudAlert>
            </MudPaper>
        </MudTabPanel>

        <!-- Operating Mode Tab -->
        <MudTabPanel Text="Operating Mode" Icon="@Icons.Material.Filled.Tune">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h5" GutterBottom="true">Operating Mode Configuration</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Controls how Cloud Health Office engines interact with your existing core admin system
                </MudText>

                @if (isLoadingOperatingMode)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (operatingModeConfig != null)
                {
                    @if (isUsingDefaults)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Info">
                            Operating mode configuration loaded from defaults. Contact support or your account team to customize engine modes for your tenant.
                        </MudAlert>
                    }

                    <MudSimpleTable Hover="true" Striped="true" Dense="false" Class="mb-4" Elevation="0" Style="border: 1px solid var(--mud-palette-table-lines);">
                        <thead>
                            <tr>
                                <th>Engine</th>
                                <th>Current Mode</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var engine in operatingModeConfig.Engines)
                            {
                                <tr>
                                    <td><strong>@FormatEngineName(engine.Key)</strong></td>
                                    <td>
                                        @if (engine.Value.Equals("augment", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <MudChip Color="Color.Warning" Size="Size.Small">Augment</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip Color="Color.Success" Size="Size.Small">Replace</MudChip>
                                        }
                                    </td>
                                    <td><MudText Typo="Typo.body2">@GetEngineDescription(engine.Key, engine.Value)</MudText></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Mode Definitions</MudText>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CompareArrows" NoIcon="false">
                                <strong>Augment</strong> — Cloud Health Office runs alongside your existing system. Both results are computed and compared, but your legacy system remains authoritative.
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle" NoIcon="false">
                                <strong>Replace</strong> — Cloud Health Office is the authoritative system for this function. Your legacy system is no longer used for this engine.
                            </MudAlert>
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4">
                        @if (operatingModeConfig.UpdatedAt.HasValue)
                        {
                            <span>Last updated: @operatingModeConfig.UpdatedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt") UTC. </span>
                        }
                        Operating mode changes are managed by your account team.
                    </MudText>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudContainer>
</PermissionGate>

@code {
    private SubscriptionInfo? subscription;
    private bool isLoadingSubscription = true;
    private OperatingModeConfiguration? operatingModeConfig;
    private bool isLoadingOperatingMode = true;
    private bool isUsingDefaults;
    private string? _serviceError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSubscriptionInfo(), LoadOperatingModeAsync());
    }

    private async Task LoadSubscriptionInfo()
    {
        isLoadingSubscription = true;
        
        try
        {
            // TODO: Replace with actual API call to tenant service
            var tenantServiceUrl = Configuration["Services:TenantService"] ?? "http://tenant-service.cho-svcs/api";
            // var response = await Http.GetAsync($"{tenantServiceUrl}/v1/tenants/current/subscription");
            
            // Mock data for now
            await Task.Delay(500); // Simulate API call
            subscription = new SubscriptionInfo
            {
                Tier = "Professional",
                Status = "trialing",
                TrialEnd = DateTime.UtcNow.AddDays(10),
                CurrentPeriodEnd = DateTime.UtcNow.AddDays(10),
                PaymentMethodLast4 = "4242",
                PaymentMethodBrand = "Visa",
                CustomerId = "cus_test123",
                SubscriptionId = "sub_test456"
            };
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load subscription: {ex.Message}");
        }
        finally
        {
            isLoadingSubscription = false;
        }
    }

    private Color GetStatusColor(string status) => status.ToLower() switch
    {
        "active" => Color.Success,
        "trialing" => Color.Info,
        "past_due" => Color.Warning,
        "canceled" => Color.Error,
        _ => Color.Default
    };

    private string GetPriceDisplay(string tier) => tier.ToLower() switch
    {
        "starter" => "Contact sales",
        "professional" => "Contact sales",
        "enterprise" => "Contact sales",
        _ => "N/A"
    };

    private string GetStripeBillingPortalUrl()
    {
        // TODO: Create billing portal session via API
        return "https://billing.stripe.com/p/login/test_123";
    }

    private Task ShowUpgradeDialog()
    {
        // TODO: Implement plan change dialog
        Snackbar.Add("Please contact your account manager to change your plan.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ShowCancelDialog()
    {
        // TODO: Implement cancellation dialog
        Snackbar.Add("Please contact your account manager to manage your subscription.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task UpdatePaymentMethod()
    {
        // TODO: Implement payment method update via Stripe Elements
        Snackbar.Add("Please contact your account manager to update payment details.", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task LoadOperatingModeAsync()
    {
        isLoadingOperatingMode = true;
        try
        {
            var tenantId = await TenantContextService.GetTenantIdAsync();
            if (string.IsNullOrEmpty(tenantId))
            {
                isUsingDefaults = true;
                operatingModeConfig = new OperatingModeConfiguration
                {
                    TenantId = "unknown",
                    Engines = new Dictionary<string, string>(OperatingModeConfiguration.DefaultEngines, StringComparer.OrdinalIgnoreCase),
                    UpdatedAt = null
                };
                return;
            }

            operatingModeConfig = await OperatingModeService.GetOperatingModeAsync(tenantId);

            // The service sets UpdatedAt = null when returning defaults (service unreachable).
            // A real API response will always have a non-null UpdatedAt.
            isUsingDefaults = !operatingModeConfig.UpdatedAt.HasValue;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            isUsingDefaults = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load operating mode: {ex.Message}");
            isUsingDefaults = true;
        }
        finally
        {
            isLoadingOperatingMode = false;
        }
    }

    private static string FormatEngineName(string key) => key switch
    {
        "benefitCalculation" => "Benefit Calculation",
        "rateResolution" => "Rate Resolution",
        "ncciEdits" => "NCCI Edits",
        "eligibilityVerification" => "Eligibility Verification",
        "claimsAdjudication" => "Claims Adjudication",
        _ => System.Text.RegularExpressions.Regex.Replace(key, "([a-z])([A-Z])", "$1 $2")
    };

    private static string GetEngineDescription(string key, string mode)
    {
        var isAugment = mode.Equals("augment", StringComparison.OrdinalIgnoreCase);
        return key switch
        {
            "benefitCalculation" => isAugment
                ? "Benefit calculations run in parallel with your legacy system for comparison."
                : "Cloud Health Office is the sole engine computing member benefit amounts.",
            "rateResolution" => isAugment
                ? "Rate lookups are performed by both systems; legacy rates are authoritative."
                : "Cloud Health Office resolves all provider and procedure rates directly.",
            "ncciEdits" => isAugment
                ? "NCCI compliance edits are applied by both systems; legacy edits take precedence."
                : "Cloud Health Office applies all NCCI bundling and compliance edits.",
            "eligibilityVerification" => isAugment
                ? "Eligibility checks run through both systems; your existing system is the source of truth."
                : "Cloud Health Office handles all member eligibility verification.",
            "claimsAdjudication" => isAugment
                ? "Claims are adjudicated by both engines; your legacy system's decisions are authoritative."
                : "Cloud Health Office is the authoritative claims adjudication engine.",
            _ => isAugment
                ? "Running alongside your existing system in comparison mode."
                : "Cloud Health Office is the authoritative system for this function."
        };
    }

    private class SubscriptionInfo
    {
        public string Tier { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? TrialEnd { get; set; }
        public DateTime? CurrentPeriodEnd { get; set; }
        public string? PaymentMethodLast4 { get; set; }
        public string? PaymentMethodBrand { get; set; }
        public string? CustomerId { get; set; }
        public string? SubscriptionId { get; set; }
    }
}

