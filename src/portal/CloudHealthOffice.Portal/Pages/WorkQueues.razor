@page "/work-queues"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject IWorkQueueService WorkQueueService
@inject IWorkManagementService WorkManagement
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Work Queues - Cloud Health Office</PageTitle>

<PermissionGate Permission="claims:read,claims:work" RoleName="ClaimsExaminer">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Queue" Class="mr-2" />
        Claims Work Queues
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Claims requiring manual review or intervention
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @* ─── Queue Summary Cards ─── *@
    @if (_summary != null)
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("NCCI")" Style="cursor: pointer;" @onclick='() => FilterByQueue("NCCI")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Error" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.NcciEditFailures</MudText>
                        <MudText Typo="Typo.caption">NCCI/MUE Edit Failures</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("AUTH")" Style="cursor: pointer;" @onclick='() => FilterByQueue("AUTH")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.MissingAuth</MudText>
                        <MudText Typo="Typo.caption">Missing Prior Auth</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("OON")" Style="cursor: pointer;" @onclick='() => FilterByQueue("OON")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Info" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.ProviderNotContracted</MudText>
                        <MudText Typo="Typo.caption">Provider Not Contracted</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("COB")" Style="cursor: pointer;" @onclick='() => FilterByQueue("COB")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Secondary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.CobRequired</MudText>
                        <MudText Typo="Typo.caption">COB/Other Payer</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("MED")" Style="cursor: pointer;" @onclick='() => FilterByQueue("MED")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Tertiary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.MedicalReview</MudText>
                        <MudText Typo="Typo.caption">Medical Review</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass(null)" Style="cursor: pointer;" @onclick='() => FilterByQueue(null)'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Default" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@TotalCount</MudText>
                        <MudText Typo="Typo.caption">All Queues</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ─── Work-management queues (routing, counts, leases) ─── *@
    @if (_workError != null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" data-testid="work-management-unavailable">
            Work assignment is unavailable: @_workError The claims below are still shown, but cannot be reassigned.
        </MudAlert>
    }
    @if (_workQueues.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Work queues (open / in progress)</MudText>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var q in _workQueues.Where(q => q.IsActive && q.WorkType == "Claim"))
                {
                    <MudChip T="string" Variant="Variant.Outlined" Color="@(q.Open > 0 ? Color.Primary : Color.Default)" data-testid="work-queue-count">
                        @q.Name: @q.Open / @q.Leased
                    </MudChip>
                }
            </div>
        </MudPaper>
    }

    @* ─── Examiner Filter ─── *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect Value="_selectedExaminer"
                           ValueChanged="@((string val) => { _selectedExaminer = val; ApplyFilters(); })"
                           Label="Assigned To"
                           Variant="Variant.Outlined"
                           T="string"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">All Examiners</MudSelectItem>
                    <MudSelectItem Value="@(UnassignedFilter)">Unassigned</MudSelectItem>
                    @foreach (var user in _assignees)
                    {
                        <MudSelectItem Value="@user">@user</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect Value="_selectedQueueFilter"
                           ValueChanged="@((string val) => { _selectedQueueFilter = val; ApplyFilters(); })"
                           Label="Queue Type"
                           Variant="Variant.Outlined"
                           T="string"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@((string?)null)">All Queue Types</MudSelectItem>
                    <MudSelectItem Value="@("NCCI")">NCCI/MUE Edit Failures</MudSelectItem>
                    <MudSelectItem Value="@("AUTH")">Missing Prior Authorization</MudSelectItem>
                    <MudSelectItem Value="@("OON")">Provider Not Contracted</MudSelectItem>
                    <MudSelectItem Value="@("COB")">COB/Other Payer Required</MudSelectItem>
                    <MudSelectItem Value="@("MED")">Medical Review Required</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="RefreshQueue"
                           Disabled="_loading"
                           Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                    Refresh
                </MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="align-self-center">
                    @_filteredItems.Count item(s) shown
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ─── Work Queue Table ─── *@
    <MudTable Items="@_filteredItems"
              Hover="true"
              Striped="true"
              Dense="true"
              Elevation="2"
              Loading="_loading"
              LoadingProgressColor="Color.Primary"
              SortLabel="Sort By">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.DisplayClaimNumber)">Claim</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.MemberName)">Member</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.ProviderName)">Provider</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.ServiceDate)">Service Date</MudTableSortLabel></MudTh>
            <MudTh>Queue Reason</MudTh>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<WorkQueueItem, object>(x => x.DaysInQueue)">Days in Queue</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => WorkOf(x)?.PriorityScore ?? 0)">Priority</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.TotalCharged)">Charged</MudTableSortLabel></MudTh>
            <MudTh>AI Advisory</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => AssignedOf(x))">Assigned To</MudTableSortLabel></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Claim ID">
                <MudLink Href="@($"/claims/{Uri.EscapeDataString(context.ClaimId)}")" Typo="Typo.body2" Style="white-space: nowrap;">@context.DisplayClaimNumber</MudLink>
            </MudTd>
            <MudTd DataLabel="Member">
                <MudText Typo="Typo.body2">@context.MemberName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MemberId</MudText>
            </MudTd>
            <MudTd DataLabel="Provider">@context.ProviderName</MudTd>
            <MudTd DataLabel="Service Date">@context.ServiceDate.ToString("MM/dd/yyyy")</MudTd>
            <MudTd DataLabel="Queue Reason">
                <MudChip T="string" Size="Size.Small" Color="@GetReasonColor(context.QueueReasonCode)" Variant="Variant.Filled">
                    @context.QueueReason
                </MudChip>
                @if (context.DuplicateMatchedClaimNumbers.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" data-testid="work-queue-duplicate-of">
                        Possible duplicate of @string.Join(", ", context.DuplicateMatchedClaimNumbers)
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Days in Queue">
                <MudText Typo="Typo.body2" Color="@(context.DaysInQueue > 7 ? Color.Error : context.DaysInQueue > 3 ? Color.Warning : Color.Default)">
                    @context.DaysInQueue
                </MudText>
            </MudTd>
            <MudTd DataLabel="Priority">
                @if (WorkOf(context) is { } work)
                {
                    <MudTooltip Text="@work.PriorityReason">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" data-testid="work-priority">
                            @work.PriorityScore.ToString("0.#")
                        </MudChip>
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@(work.QueueName ?? "Unrouted")</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)" Variant="Variant.Filled">
                        @context.Priority
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Charged">@context.TotalCharged.ToString("C")</MudTd>
            <MudTd DataLabel="AI Advisory">
                @if (!string.IsNullOrWhiteSpace(context.AiRecommendedDisposition))
                {
                    <MudTooltip Text="@(context.AiRationale ?? "Open the claim to review the advisory rationale and policy evidence.")">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetAiRecommendationColor(context.AiRecommendedDisposition)"
                                 Variant="Variant.Outlined">
                            @GetAiRecommendationLabel(context)
                        </MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not available</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Assigned To">
                @if (_canAssign && WorkOf(context) is { } work)
                {
                    <MudSelect T="string" Value="@(work.AssignedTo ?? UnassignedFilter)"
                               ValueChanged="@(val => OnReassign(context.ClaimId, val))"
                               Variant="Variant.Text" Dense="true" Margin="Margin.Dense" Style="min-width: 140px;"
                               data-testid="reassign">
                        <MudSelectItem Value="@(UnassignedFilter)">Unassigned</MudSelectItem>
                        @foreach (var user in AssigneeOptions(work))
                        {
                            <MudSelectItem Value="@user">@user</MudSelectItem>
                        }
                    </MudSelect>
                    @if (work.LeaseExpiresAt is { } until && work.AssignedTo != null)
                    {
                        <MudText Typo="Typo.caption" Color="@(work.LeaseActive ? Color.Secondary : Color.Warning)">
                            @(work.LeaseActive ? "until " : "lease expired ")@until.ToLocalTime().ToString("t")
                        </MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(AssignedOf(context)) ? "Unassigned" : AssignedOf(context))</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton Color="Color.Primary"
                               OnClick="@(() => NavigationManager.NavigateTo($"/claims/{context.ClaimId}"))">
                        Work Claim
                    </MudButton>
                    @if (context.QueueReasonCode == "NCCI")
                    {
                        <MudButton Color="Color.Warning"
                                   OnClick="@(() => OnOverride(context.ClaimId))">
                            Override
                        </MudButton>
                    }
                </MudButtonGroup>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                No claims in this queue — all caught up!
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudContainer>
</PermissionGate>

@code {
    private bool _loading = true;
    private string? _serviceError;
    private WorkQueueSummary? _summary;
    private List<WorkQueueItem> _allItems = new();
    private List<WorkQueueItem> _filteredItems = new();
    private string? _selectedQueueFilter;
    private string _selectedExaminer = "All";

    /// <summary>Select value standing for "no one".</summary>
    private const string UnassignedFilter = "(unassigned)";

    // work-management-service: the work item behind each pended claim
    // (queue, priority, assignee, lease), the queue counts and who work can
    // be pushed to. Optional: the claims list works without it.
    private Dictionary<string, WorkItemView> _workByClaim = new(StringComparer.Ordinal);
    private List<WorkQueueCounts> _workQueues = new();
    private List<string> _assignees = new();
    private string? _workError;
    private bool _canAssign;

    private WorkItemView? WorkOf(WorkQueueItem item) => _workByClaim.GetValueOrDefault(item.ClaimId);

    private string AssignedOf(WorkQueueItem item) => WorkOf(item)?.AssignedTo ?? string.Empty;

    private IEnumerable<string> AssigneeOptions(WorkItemView work) =>
        work.AssignedTo is { } current && !_assignees.Contains(current) ? _assignees.Append(current) : _assignees;

    private int TotalCount => _summary == null ? 0
        : _summary.NcciEditFailures + _summary.MissingAuth + _summary.ProviderNotContracted
          + _summary.CobRequired + _summary.MedicalReview;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var summaryTask = WorkQueueService.GetQueueSummaryAsync();
            var itemsTask = WorkQueueService.GetQueueItemsAsync();
            await Task.WhenAll(summaryTask, itemsTask);

            _summary = await summaryTask;
            _allItems = await itemsTask;
            await LoadWorkAsync();
            ApplyFilters();
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Work queue service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred loading work queues: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWorkAsync()
    {
        _workError = null;
        _canAssign = UserContextService.HasPermission("workqueue:assign");
        try
        {
            _workQueues = await WorkManagement.GetQueuesAsync() ?? new();
            if (_canAssign)
            {
                var page = await WorkManagement.ListAsync(pageSize: 500);
                _workByClaim = (page?.Items ?? new())
                    .Where(w => w.WorkType == "Claim")
                    .GroupBy(w => w.SourceId)
                    .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
                _assignees = await WorkManagement.GetAssigneesAsync() ?? new();
            }
        }
        catch (Exception ex)
        {
            // Work assignment is an addition to this page: whatever goes wrong
            // with it, the pended claims (from claims-service) still show.
            _workError = ex is ServiceUnavailableException or WorkManagementRefusedException
                ? ex.Message
                : "the work management service did not answer as expected.";
            _canAssign = false;
        }
    }

    private void ApplyFilters()
    {
        var items = _allItems.AsEnumerable();
        if (!string.IsNullOrEmpty(_selectedQueueFilter))
            items = items.Where(i => i.QueueReasonCode == _selectedQueueFilter);
        if (_selectedExaminer == UnassignedFilter)
            items = items.Where(i => string.IsNullOrEmpty(AssignedOf(i)));
        else if (_selectedExaminer != "All")
            items = items.Where(i => AssignedOf(i) == _selectedExaminer);
        _filteredItems = items.OrderByDescending(i => i.DaysInQueue).ToList();
    }

    private void FilterByQueue(string? queueCode)
    {
        _selectedQueueFilter = queueCode;
        ApplyFilters();
    }

    private async Task RefreshQueue()
    {
        await LoadData();
    }

    /// <summary>
    /// Supervisor push through work-management-service: assign / reassign the
    /// claim's work item (it is leased to the assignee) or put it back in its
    /// queue. The stored assignment is what the page shows afterwards.
    /// </summary>
    private async Task OnReassign(string claimId, string newAssignee)
    {
        if (!_workByClaim.TryGetValue(claimId, out var work))
        {
            Snackbar.Add($"Claim {claimId} has no work item yet; it appears after the next sync.", Severity.Warning);
            return;
        }
        try
        {
            var updated = newAssignee == UnassignedFilter
                ? await WorkManagement.UnassignAsync(work.Id)
                : await WorkManagement.AssignAsync(work.Id, newAssignee);
            _workByClaim[claimId] = updated;
            ApplyFilters();
            Snackbar.Add(updated.AssignedTo is null
                    ? $"Claim {work.DisplayNumber} returned to its queue"
                    : $"Claim {work.DisplayNumber} assigned to {updated.AssignedTo}",
                Severity.Success);
        }
        catch (Exception ex) when (ex is ServiceUnavailableException or WorkManagementRefusedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnOverride(string claimId)
    {
        var item = _allItems.FirstOrDefault(i => i.ClaimId == claimId);
        var agreement = item?.AiRecommendedDisposition is null
            ? null
            : string.Equals(item.AiRecommendedDisposition, "Approve", StringComparison.OrdinalIgnoreCase)
                ? "Accepted"
                : "Overridden";
        var user = await UserContextService.GetCurrentUserAsync();

        // A COB pend — the routing pend or an additional one — needs the
        // payer order the examiner confirmed.
        int? payerSequence = null;
        var reason = "Examiner override — reviewed and approved";
        if (CobPend.On(item))
        {
            var dialog = await DialogService.ShowAsync<CobPayerOrderDialog>("Confirm payer order");
            var choice = await dialog.Result;
            if (choice is null || choice.Canceled || choice.Data is not CobPayerOrderDialog.CobPayerOrderChoice picked) return;
            payerSequence = picked.PayerSequence;
            reason = picked.Reason;
        }

        try
        {
            var result = await WorkQueueService.ResolvePendedClaimAsync(
                claimId,
                "Approved",
                reason,
                agreement,
                user?.UserId ?? user?.Email ?? "portal-examiner",
                payerSequence,
                item?.PendFingerprint);
            if (result.AwaitingSecondApproval)
            {
                Snackbar.Add(result.Message ?? $"Claim {claimId} is waiting for a second approver.", Severity.Info);
                return;
            }
        }
        catch (ClaimResolutionRefusedException ex)
        {
            Snackbar.Add(ex.ToDisplayText(), Severity.Warning);
            return;
        }
        catch (ServiceUnavailableException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        _allItems.RemoveAll(i => i.ClaimId == claimId);
        if (_summary != null && string.Equals(item?.QueueReasonCode, "NCCI", StringComparison.OrdinalIgnoreCase))
            _summary.NcciEditFailures = Math.Max(0, _summary.NcciEditFailures - 1);
        ApplyFilters();
        Snackbar.Add($"Override applied to {claimId}", Severity.Success);
    }

    private string GetCardClass(string? queueCode)
    {
        return _selectedQueueFilter == queueCode ? "border-2 mud-border-primary" : "";
    }

    private static Color GetReasonColor(string reasonCode) => reasonCode switch
    {
        "NCCI" => Color.Error,
        "DUPLICATE" => Color.Error,
        "AUTH" => Color.Warning,
        "OON" => Color.Info,
        "COB" => Color.Secondary,
        "MED" => Color.Tertiary,
        _ => Color.Default
    };

    private static Color GetPriorityColor(string priority) => priority switch
    {
        "High" => Color.Error,
        "Medium" => Color.Warning,
        _ => Color.Default
    };

    private static Color GetAiRecommendationColor(string recommendation) => recommendation switch
    {
        "Approve" => Color.Success,
        "Deny" => Color.Error,
        "RequestInfo" => Color.Warning,
        _ => Color.Info
    };

    private static string GetAiRecommendationLabel(WorkQueueItem item)
    {
        var disposition = item.AiRecommendedDisposition switch
        {
            "RequestInfo" => "Request Info",
            "EscalateToHuman" => "Escalate",
            var value => value
        };

        return item.AiConfidenceScore.HasValue
            ? $"{disposition} · {item.AiConfidenceScore.Value:P0}"
            : disposition ?? "Advisory";
    }
}
