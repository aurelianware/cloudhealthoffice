@page "/work-queues"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject IWorkQueueService WorkQueueService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Work Queues - Cloud Health Office</PageTitle>

<PermissionGate Permission="claims:read,claims:work" RoleName="ClaimsExaminer">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Queue" Class="mr-2" />
        Claims Work Queues
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Claims requiring manual review or intervention
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @* ─── Queue Summary Cards ─── *@
    @if (_summary != null)
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("NCCI")" Style="cursor: pointer;" @onclick='() => FilterByQueue("NCCI")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Error" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.NcciEditFailures</MudText>
                        <MudText Typo="Typo.caption">NCCI/MUE Edit Failures</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("AUTH")" Style="cursor: pointer;" @onclick='() => FilterByQueue("AUTH")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.MissingAuth</MudText>
                        <MudText Typo="Typo.caption">Missing Prior Auth</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("OON")" Style="cursor: pointer;" @onclick='() => FilterByQueue("OON")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Info" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.ProviderNotContracted</MudText>
                        <MudText Typo="Typo.caption">Provider Not Contracted</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("COB")" Style="cursor: pointer;" @onclick='() => FilterByQueue("COB")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Secondary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.CobRequired</MudText>
                        <MudText Typo="Typo.caption">COB/Other Payer</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass("MED")" Style="cursor: pointer;" @onclick='() => FilterByQueue("MED")'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Tertiary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.MedicalReview</MudText>
                        <MudText Typo="Typo.caption">Medical Review</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Class="@GetCardClass(null)" Style="cursor: pointer;" @onclick='() => FilterByQueue(null)'>
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Default" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@TotalCount</MudText>
                        <MudText Typo="Typo.caption">All Queues</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ─── Examiner Filter ─── *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect Value="_selectedExaminer"
                           ValueChanged="@((string val) => { _selectedExaminer = val; ApplyFilters(); })"
                           Label="Assigned To"
                           Variant="Variant.Outlined"
                           T="string"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">All Examiners</MudSelectItem>
                    <MudSelectItem Value="@("Sarah Williams")">Sarah Williams (My Queue)</MudSelectItem>
                    <MudSelectItem Value="@("James Martinez")">James Martinez</MudSelectItem>
                    <MudSelectItem Value="@("Priya Kapoor")">Priya Kapoor</MudSelectItem>
                    <MudSelectItem Value="@("David Chen")">David Chen</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect Value="_selectedQueueFilter"
                           ValueChanged="@((string val) => { _selectedQueueFilter = val; ApplyFilters(); })"
                           Label="Queue Type"
                           Variant="Variant.Outlined"
                           T="string"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@((string?)null)">All Queue Types</MudSelectItem>
                    <MudSelectItem Value="@("NCCI")">NCCI/MUE Edit Failures</MudSelectItem>
                    <MudSelectItem Value="@("AUTH")">Missing Prior Authorization</MudSelectItem>
                    <MudSelectItem Value="@("OON")">Provider Not Contracted</MudSelectItem>
                    <MudSelectItem Value="@("COB")">COB/Other Payer Required</MudSelectItem>
                    <MudSelectItem Value="@("MED")">Medical Review Required</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="RefreshQueue"
                           Disabled="_loading"
                           Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                    Refresh
                </MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="align-self-center">
                    @_filteredItems.Count item(s) shown
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ─── Work Queue Table ─── *@
    <MudTable Items="@_filteredItems"
              Hover="true"
              Striped="true"
              Dense="true"
              Elevation="2"
              Loading="_loading"
              LoadingProgressColor="Color.Primary"
              SortLabel="Sort By">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.ClaimId)">Claim ID</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.MemberName)">Member</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.ProviderName)">Provider</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.ServiceDate)">Service Date</MudTableSortLabel></MudTh>
            <MudTh>Queue Reason</MudTh>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<WorkQueueItem, object>(x => x.DaysInQueue)">Days in Queue</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.Priority)">Priority</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.TotalCharged)">Charged</MudTableSortLabel></MudTh>
            <MudTh>AI Advisory</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<WorkQueueItem, object>(x => x.AssignedTo)">Assigned To</MudTableSortLabel></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Claim ID">
                <MudLink Href="@($"/claims/{context.ClaimId}")" Typo="Typo.body2">@context.ClaimId</MudLink>
            </MudTd>
            <MudTd DataLabel="Member">
                <MudText Typo="Typo.body2">@context.MemberName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MemberId</MudText>
            </MudTd>
            <MudTd DataLabel="Provider">@context.ProviderName</MudTd>
            <MudTd DataLabel="Service Date">@context.ServiceDate.ToString("MM/dd/yyyy")</MudTd>
            <MudTd DataLabel="Queue Reason">
                <MudChip T="string" Size="Size.Small" Color="@GetReasonColor(context.QueueReasonCode)" Variant="Variant.Filled">
                    @context.QueueReason
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Days in Queue">
                <MudText Typo="Typo.body2" Color="@(context.DaysInQueue > 7 ? Color.Error : context.DaysInQueue > 3 ? Color.Warning : Color.Default)">
                    @context.DaysInQueue
                </MudText>
            </MudTd>
            <MudTd DataLabel="Priority">
                <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)" Variant="Variant.Filled">
                    @context.Priority
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Charged">@context.TotalCharged.ToString("C")</MudTd>
            <MudTd DataLabel="AI Advisory">
                @if (!string.IsNullOrWhiteSpace(context.AiRecommendedDisposition))
                {
                    <MudTooltip Text="@(context.AiRationale ?? "Open the claim to review the advisory rationale and policy evidence.")">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetAiRecommendationColor(context.AiRecommendedDisposition)"
                                 Variant="Variant.Outlined">
                            @GetAiRecommendationLabel(context)
                        </MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not available</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Assigned To">
                <MudSelect T="string" Value="@context.AssignedTo" ValueChanged="@(val => OnReassign(context.ClaimId, val))"
                           Variant="Variant.Text" Dense="true" Margin="Margin.Dense" Style="min-width: 140px;">
                    <MudSelectItem Value="@("Sarah Williams")">Sarah Williams</MudSelectItem>
                    <MudSelectItem Value="@("James Martinez")">James Martinez</MudSelectItem>
                    <MudSelectItem Value="@("Priya Kapoor")">Priya Kapoor</MudSelectItem>
                    <MudSelectItem Value="@("David Chen")">David Chen</MudSelectItem>
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton Color="Color.Primary"
                               OnClick="@(() => NavigationManager.NavigateTo($"/claims/{context.ClaimId}"))">
                        Work Claim
                    </MudButton>
                    @if (context.QueueReasonCode == "NCCI")
                    {
                        <MudButton Color="Color.Warning"
                                   OnClick="@(() => OnOverride(context.ClaimId))">
                            Override
                        </MudButton>
                    }
                </MudButtonGroup>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                No claims in this queue — all caught up!
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudContainer>
</PermissionGate>

@code {
    private bool _loading = true;
    private string? _serviceError;
    private WorkQueueSummary? _summary;
    private List<WorkQueueItem> _allItems = new();
    private List<WorkQueueItem> _filteredItems = new();
    private string? _selectedQueueFilter;
    private string _selectedExaminer = "All";

    private int TotalCount => _summary == null ? 0
        : _summary.NcciEditFailures + _summary.MissingAuth + _summary.ProviderNotContracted
          + _summary.CobRequired + _summary.MedicalReview;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var summaryTask = WorkQueueService.GetQueueSummaryAsync();
            var itemsTask = WorkQueueService.GetQueueItemsAsync();
            await Task.WhenAll(summaryTask, itemsTask);

            _summary = summaryTask.Result;
            _allItems = itemsTask.Result;
            ApplyFilters();
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Work queue service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred loading work queues: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        var items = _allItems.AsEnumerable();
        if (!string.IsNullOrEmpty(_selectedQueueFilter))
            items = items.Where(i => i.QueueReasonCode == _selectedQueueFilter);
        if (_selectedExaminer != "All")
            items = items.Where(i => i.AssignedTo == _selectedExaminer);
        _filteredItems = items.OrderByDescending(i => i.DaysInQueue).ToList();
    }

    private void FilterByQueue(string? queueCode)
    {
        _selectedQueueFilter = queueCode;
        ApplyFilters();
    }

    private async Task RefreshQueue()
    {
        await LoadData();
    }

    private async Task OnReassign(string claimId, string newAssignee)
    {
        await WorkQueueService.AssignClaimAsync(claimId, newAssignee);
        var item = _allItems.FirstOrDefault(i => i.ClaimId == claimId);
        if (item != null)
        {
            item.AssignedTo = newAssignee;
            ApplyFilters();
        }
        Snackbar.Add($"Claim {claimId} reassigned to {newAssignee}", Severity.Success);
    }

    private async Task OnOverride(string claimId)
    {
        var item = _allItems.FirstOrDefault(i => i.ClaimId == claimId);
        var agreement = item?.AiRecommendedDisposition is null
            ? null
            : string.Equals(item.AiRecommendedDisposition, "Approve", StringComparison.OrdinalIgnoreCase)
                ? "Accepted"
                : "Overridden";
        var user = await UserContextService.GetCurrentUserAsync();

        await WorkQueueService.ResolvePendedClaimAsync(
            claimId,
            "Approved",
            "Examiner override — reviewed and approved",
            agreement,
            user?.UserId ?? user?.Email ?? "portal-examiner");
        _allItems.RemoveAll(i => i.ClaimId == claimId);
        if (_summary != null) _summary.NcciEditFailures = Math.Max(0, _summary.NcciEditFailures - 1);
        ApplyFilters();
        Snackbar.Add($"NCCI override applied to {claimId}", Severity.Success);
    }

    private string GetCardClass(string? queueCode)
    {
        return _selectedQueueFilter == queueCode ? "border-2 mud-border-primary" : "";
    }

    private static Color GetReasonColor(string reasonCode) => reasonCode switch
    {
        "NCCI" => Color.Error,
        "AUTH" => Color.Warning,
        "OON" => Color.Info,
        "COB" => Color.Secondary,
        "MED" => Color.Tertiary,
        _ => Color.Default
    };

    private static Color GetPriorityColor(string priority) => priority switch
    {
        "High" => Color.Error,
        "Medium" => Color.Warning,
        _ => Color.Default
    };

    private static Color GetAiRecommendationColor(string recommendation) => recommendation switch
    {
        "Approve" => Color.Success,
        "Deny" => Color.Error,
        "RequestInfo" => Color.Warning,
        _ => Color.Info
    };

    private static string GetAiRecommendationLabel(WorkQueueItem item)
    {
        var disposition = item.AiRecommendedDisposition switch
        {
            "RequestInfo" => "Request Info",
            "EscalateToHuman" => "Escalate",
            var value => value
        };

        return item.AiConfidenceScore.HasValue
            ? $"{disposition} · {item.AiConfidenceScore.Value:P0}"
            : disposition ?? "Advisory";
    }
}
