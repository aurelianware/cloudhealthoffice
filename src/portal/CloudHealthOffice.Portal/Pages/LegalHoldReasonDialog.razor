@using CloudHealthOffice.Portal.Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(Place ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)" Class="mr-2" />
            @(Place ? "Place legal hold" : "Release legal hold")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(Place
                ? "While held, this document cannot be changed. Record why the hold is being placed."
                : "Record why the hold is being released. The reason is kept in the document's hold history.")
        </MudText>
        <MudTextField @bind-Value="_reason" Label="Reason" Required="true" Immediate="true"
                      Lines="3" MaxLength="@MaxReasonLength" Counter="@MaxReasonLength" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="@string.IsNullOrWhiteSpace(_reason)">
            @(Place ? "Place hold" : "Release hold")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Matches member-document-service's LegalHoldRequest.MaxReasonLength.</summary>
    public const int MaxReasonLength = 500;

    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>True to place a hold, false to release one.</summary>
    [Parameter] public bool Place { get; set; }

    private string _reason = string.Empty;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason.Trim()));
    private void Cancel() => MudDialog.Cancel();
}
