@page "/correspondence"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject ICorrespondenceService CorrespondenceService

<PageTitle>Correspondence - Cloud Health Office</PageTitle>

@* Letters rendered by correspondence-service (docs/architecture/correspondence.md).
   The service returns only letters with a subject the user may read. Delivery
   (mail, portal inbox) arrives in later build steps, so there is no sent or
   returned status yet. *@

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Mail" Class="mr-2" />
        Correspondence
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Letters rendered from approved templates, and the templates themselves
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (_summary != null)
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2">@_summary.RenderedToday</MudText>
                        <MudText Typo="Typo.caption">Rendered today (UTC)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2" Color="Color.Success">@_summary.RenderedLast7Days</MudText>
                        <MudText Typo="Typo.caption">Rendered, last 7 days</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent Class="text-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                        <MudText Typo="Typo.h4" Class="mt-2" Color="Color.Error">@_summary.CheckFailedLast7Days</MudText>
                        <MudText Typo="Typo.caption">Failed a pre-release check, last 7 days</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    <MudText Typo="Typo.h5" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
        Recent letters
    </MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="_filterType" Label="Letter type" Variant="Variant.Outlined" T="string" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@((string?)null)">All types</MudSelectItem>
                    @foreach (var type in _letterTypes)
                    {
                        <MudSelectItem Value="@type.Code">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="_filterStatus" Label="Status" Variant="Variant.Outlined" T="string" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@((string?)null)">All statuses</MudSelectItem>
                    <MudSelectItem Value="@("Rendered")">Rendered</MudSelectItem>
                    <MudSelectItem Value="@("CheckFailed")">Check failed</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters" Disabled="_loading" Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-1" />
                    Filter
                </MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="align-self-center">@_letters.Count letter(s)</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_letters" Hover="true" Striped="true" Dense="true" Elevation="2" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Letter</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Recipient</MudTh>
            <MudTh>About</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<CorrespondenceLetter, object>(x => x.CreatedAt)" InitialDirection="SortDirection.Descending">Created</MudTableSortLabel></MudTh>
            <MudTh>Template</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Letter">
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Id</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Dated @context.LetterDate.ToString("MM/dd/yyyy")</MudText>
            </MudTd>
            <MudTd DataLabel="Type">@TypeName(context.LetterTypeCode)</MudTd>
            <MudTd DataLabel="Recipient">
                <MudText Typo="Typo.body2">@context.Recipient.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Recipient.Party</MudText>
            </MudTd>
            <MudTd DataLabel="About">
                @foreach (var subject in context.Subjects)
                {
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">@subject.Kind</MudText>
                        @if (SubjectLink(subject) is { } href)
                        {
                            <MudLink Href="@href" Typo="Typo.body2" Style="font-family: monospace;">@subject.Id</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Inline="true" Style="font-family: monospace;">@subject.Id</MudText>
                        }
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</MudTd>
            <MudTd DataLabel="Template">
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.TemplateId v@(context.TemplateVersion)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Language, @context.PageCount page(s)</MudText>
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.Status == "CheckFailed")
                {
                    <MudTooltip Text="@FailedChecks(context)">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Check failed</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Rendered</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8">No letters match the selected filters.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>

    <MudText Typo="Typo.h5" Class="mb-3 mt-8">
        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
        Templates
    </MudText>

    <MudTable Items="@_templates" Hover="true" Dense="true" Elevation="2" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Template</MudTh>
            <MudTh>Letter type</MudTh>
            <MudTh>Kind</MudTh>
            <MudTh>Version</MudTh>
            <MudTh>Language / format</MudTh>
            <MudTh>Effective</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Template">
                <MudText Typo="Typo.body2">@context.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family: monospace;">@context.TemplateId</MudText>
            </MudTd>
            <MudTd DataLabel="Letter type">@TypeName(context.LetterTypeCode)</MudTd>
            <MudTd DataLabel="Kind">
                @context.Kind
                @if (!string.IsNullOrEmpty(context.FormNumber))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Form @context.FormNumber</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Version">v@(context.Version)</MudTd>
            <MudTd DataLabel="Language / format">@context.Language, @context.Format</MudTd>
            <MudTd DataLabel="Effective">
                @context.EffectiveFrom.ToString("MM/dd/yyyy")@(context.EffectiveTo is { } to ? $" to {to:MM/dd/yyyy}" : "")
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(context.Status switch { "Approved" => Color.Success, "Draft" => Color.Warning, _ => Color.Default })">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8">No templates yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private bool _loading = true;
    private string? _serviceError;
    private CorrespondenceSummary? _summary;
    private List<CorrespondenceLetter> _letters = new();
    private List<CorrespondenceLetterType> _letterTypes = new();
    private List<CorrespondenceTemplate> _templates = new();
    private string? _filterType;
    private string? _filterStatus;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var summary = CorrespondenceService.GetSummaryAsync();
            var letters = CorrespondenceService.GetRecentLettersAsync();
            var types = CorrespondenceService.GetLetterTypesAsync();
            var templates = CorrespondenceService.GetTemplatesAsync();
            await Task.WhenAll(summary, letters, types, templates);

            _summary = await summary;
            _letters = await letters;
            _letterTypes = (await types).OrderBy(t => t.Name).ToList();
            _templates = (await templates).OrderBy(t => t.Name).ThenByDescending(t => t.Version).ToList();
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Correspondence service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred loading correspondence: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _loading = true;
        try
        {
            _letters = await CorrespondenceService.GetRecentLettersAsync(_filterType, _filterStatus);
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Correspondence service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred filtering correspondence: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string TypeName(string code) =>
        _letterTypes.FirstOrDefault(t => t.Code == code)?.Name ?? code;

    private static string FailedChecks(CorrespondenceLetter letter) =>
        string.Join("; ", letter.Checks.Where(c => !c.Passed).Select(c => c.Detail ?? c.Name));

    /// <summary>The portal page for a letter's subject, when there is one.</summary>
    internal static string? SubjectLink(CorrespondenceSubject subject)
    {
        var id = Uri.EscapeDataString(subject.Id);
        return subject.Kind switch
        {
            "Member" => $"/members/{id}",
            "Claim" => $"/claims/{id}",
            "Authorization" => $"/authorizations/{id}",
            "Appeal" => $"/appeals/{id}",
            "Provider" => $"/providers/{id}",
            _ => null,
        };
    }
}
