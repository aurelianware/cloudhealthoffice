@page "/authorizations"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [Authorize]
@inject CloudHealthOffice.Portal.Services.IAuthorizationService AuthorizationService
@inject IDialogService DialogService

<PageTitle>Authorizations - Cloud Health Office</PageTitle>

<PermissionGate Permission="authorizations:read" RoleName="UMCoordinator">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
        Prior Authorizations
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Real-time prior authorization management • Avg decision time: &lt;2 minutes
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    <!-- Search Form -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_authIdSearch"
                             Label="Auth ID"
                             Placeholder="Exact match"
                             Variant="Variant.Outlined"
                             OnKeyUp="OnSearchKeyUp" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_memberIdSearch"
                             Label="Member ID"
                             Placeholder="Exact match"
                             Variant="Variant.Outlined"
                             OnKeyUp="OnSearchKeyUp" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect @bind-Value="_statusFilter"
                          Label="Status"
                          Variant="Variant.Outlined"
                          T="string"
                          AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                    <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
                    <MudSelectItem Value="@("Denied")">Denied</MudSelectItem>
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                    <MudSelectItem Value="@("Review Required")">Review Required</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudGrid Spacing="1">
                    <MudItem xs="7">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  OnClick="SearchAuthorizations"
                                  Disabled="_loading">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                            Search
                        </MudButton>
                    </MudItem>
                    <MudItem xs="5">
                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Default"
                                  FullWidth="true"
                                  OnClick="ClearSearch"
                                  Disabled="_loading">
                            Clear
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Filled"
                          Color="Color.Secondary"
                          FullWidth="true"
                          OnClick="OpenSubmitDialog">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
                    New Request
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_showValidationMessage)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                Please enter at least one search criterion.
            </MudAlert>
        }
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_hasSearched)
    {
        <!-- Stats Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Requests</MudText>
                        <MudText Typo="Typo.h4">@_filteredAuthorizations.Count</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Approved</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success">@_filteredAuthorizations.Count(a => a.StatusText == "Approved" || a.StatusText == "Modified")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Pending Review</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Warning">@_filteredAuthorizations.Count(a => a.StatusText == "Pended" || a.StatusText == "InReview")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Avg Decision Time</MudText>
                        <MudText Typo="Typo.h4">@GetAverageProcessingTime()</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (_filteredAuthorizations.Any())
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Showing @_filteredAuthorizations.Count authorization(s)
            </MudText>

            <!-- Authorizations Table -->
            <MudPaper Elevation="2">
                <MudTable Items="_filteredAuthorizations"
                         Hover="true"
                         Breakpoint="Breakpoint.Sm"
                         Dense="true"
                         Striped="true">
                    <HeaderContent>
                        <MudTh>Auth ID</MudTh>
                        <MudTh>Member</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh>Service Type</MudTh>
                        <MudTh>Request Date</MudTh>
                        <MudTh>Decision</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Auth ID">
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.AuthorizationId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Member">
                            <MudText Typo="Typo.body2">@context.MemberName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Provider">
                            <MudText Typo="Typo.body2">@context.ProviderName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Service Type">
                            <MudText Typo="Typo.body2">@context.ServiceType</MudText>
                        </MudTd>
                        <MudTd DataLabel="Request Date">
                            <MudText Typo="Typo.body2">@context.RequestDate.ToString("MM/dd/yyyy")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Decision">
                            <MudText Typo="Typo.body2">
                                @if (context.DecisionDate.HasValue)
                                {
                                    @context.DecisionDate.Value.ToString("MM/dd/yyyy")
                                }
                                else
                                {
                                    <span style="color: var(--mud-palette-text-disabled);">Pending</span>
                                }
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip Size="Size.Small"
                                    Color="@GetStatusColor(context.StatusText)">
                                @context.StatusText
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                          Color="Color.Primary"
                                          Size="Size.Small"
                                          OnClick="@(() => ViewAuthorizationDetails(context.AuthorizationId))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-8 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No authorizations found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Try adjusting your search criteria</MudText>
            </MudPaper>
        }
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">Search for an authorization to view details</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Enter an Auth ID or Member ID to begin</MudText>
        </MudPaper>
    }
</MudContainer>
</PermissionGate>

@code {
    private List<AuthorizationSummary> _allAuthorizations = new();
    private List<AuthorizationSummary> _filteredAuthorizations = new();
    private bool _loading = false;
    private bool _hasSearched = false;
    private bool _showValidationMessage = false;
    private string? _serviceError;

    private string _authIdSearch = string.Empty;
    private string _memberIdSearch = string.Empty;
    private string _statusFilter = "All";

    private bool HasCriteria =>
        !string.IsNullOrWhiteSpace(_authIdSearch) ||
        !string.IsNullOrWhiteSpace(_memberIdSearch);

    private async Task SearchAuthorizations()
    {
        if (!HasCriteria)
        {
            _showValidationMessage = true;
            return;
        }

        _showValidationMessage = false;
        _loading = true;
        StateHasChanged();

        try
        {
            var memberFilter = string.IsNullOrWhiteSpace(_memberIdSearch) ? null : _memberIdSearch.Trim();
            _allAuthorizations = await AuthorizationService.GetAuthorizationsAsync(memberFilter);
            ApplyFilters();
            _hasSearched = true;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _allAuthorizations = new();
            _filteredAuthorizations = new();
            _hasSearched = true;
        }
        catch
        {
            _allAuthorizations = new();
            _filteredAuthorizations = new();
            _hasSearched = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        _filteredAuthorizations = _allAuthorizations.ToList();

        if (!string.IsNullOrWhiteSpace(_authIdSearch))
        {
            var id = _authIdSearch.ToLowerInvariant();
            _filteredAuthorizations = _filteredAuthorizations.Where(a =>
                a.AuthorizationId.ToLowerInvariant().Contains(id)).ToList();
        }

        // Member ID filtering is handled server-side by the API call.
        // No client-side filter needed for member ID.

        if (_statusFilter != "All")
        {
            _filteredAuthorizations = _filteredAuthorizations.Where(a => a.StatusText == _statusFilter).ToList();
        }
    }

    private void ClearSearch()
    {
        _authIdSearch = string.Empty;
        _memberIdSearch = string.Empty;
        _statusFilter = "All";
        _allAuthorizations = new();
        _filteredAuthorizations = new();
        _hasSearched = false;
        _showValidationMessage = false;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAuthorizations();
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Approved" => Color.Success,
            "Denied" => Color.Error,
            "Pending" => Color.Warning,
            "Review Required" => Color.Info,
            _ => Color.Default
        };
    }

    private double GetProcessingTimeMs(AuthorizationSummary a) =>
        a.ReviewedDate.HasValue ? (a.ReviewedDate.Value - a.SubmittedDate).TotalMilliseconds : 0;

    private string GetAverageProcessingTime()
    {
        if (!_filteredAuthorizations.Any(a => GetProcessingTimeMs(a) > 0))
            return "N/A";

        var avg = _filteredAuthorizations
            .Where(a => GetProcessingTimeMs(a) > 0)
            .Average(a => GetProcessingTimeMs(a));

        if (avg < 1000)
            return $"{avg:F0}ms";
        else if (avg < 60000)
            return $"{avg / 1000:F1}s";
        else
            return $"{avg / 60000:F1}m";
    }

    private async Task ViewAuthorizationDetails(string authorizationId)
    {
        var parameters = new DialogParameters
        {
            { "AuthorizationId", authorizationId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<AuthorizationDetailsDialog>("Authorization Details", parameters, options);
    }

    private async Task OpenSubmitDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<SubmitAuthorizationDialog>("Submit Prior Authorization", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            // Re-run search to refresh results after new request
            await SearchAuthorizations();
        }
    }
}
