@page "/pricing"

<PageTitle>Pricing - Cloud Health Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div style="text-align: center; margin-bottom: 48px;">
        <MudText Typo="Typo.h3" Class="mb-2" Style="font-weight: 700; background: linear-gradient(135deg, #00ffff, #00ff88); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            💰 Simple, Transparent Pricing
        </MudText>
        <MudText Typo="Typo.body1" Style="color: rgba(255, 255, 255, 0.7);">
            No hidden fees. No vendor lock-in. Cancel anytime. 14-day free trial on all plans.
        </MudText>
    </div>

    <MudGrid Justify="Justify.Center">
        <!-- Starter Plan -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.3); display: flex; flex-direction: column;">
                <MudCardContent Style="flex: 1;">
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600; color: #00ffff;">
                        Starter
                    </MudText>
                    <MudText Typo="Typo.h3" Class="mb-1" Style="font-weight: 700;">
                        $499<MudText Typo="Typo.body1" Inline="true" Style="color: rgba(255, 255, 255, 0.5);">/month</MudText>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: rgba(255, 255, 255, 0.6);">
                        Perfect for small health plans and pilots
                    </MudText>
                    
                    <MudDivider Class="mb-4" Style="border-color: rgba(0, 255, 255, 0.2);" />
                    
                    <MudList Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2"><strong>10,000</strong> claims/month</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Core EDI (837, 835)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Claims adjudication <500ms</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Multi-tenant portal access</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Email support</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Community forum access</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">14-day free trial</MudText>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions Class="pa-4">
                    <MudButton Href="/signup" 
                               Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               FullWidth="true" 
                               Size="Size.Large">
                        Start Free Trial
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Professional Plan -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="8" Style="height: 100%; border: 2px solid #00ffff; display: flex; flex-direction: column; position: relative; background: linear-gradient(180deg, rgba(0, 255, 255, 0.08) 0%, rgba(0, 0, 0, 0) 100%);">
                <div style="position: absolute; top: -12px; right: 20px;">
                    <MudChip Color="Color.Primary" Size="Size.Small" Style="font-weight: 700;">MOST POPULAR</MudChip>
                </div>
                <MudCardContent Style="flex: 1;">
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600; color: #00ffff;">
                        Professional
                    </MudText>
                    <MudText Typo="Typo.h3" Class="mb-1" Style="font-weight: 700;">
                        $1,499<MudText Typo="Typo.body1" Inline="true" Style="color: rgba(255, 255, 255, 0.5);">/month</MudText>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: rgba(255, 255, 255, 0.6);">
                        For growing health plans and MAOs
                    </MudText>
                    
                    <MudDivider Class="mb-4" Style="border-color: rgba(0, 255, 255, 0.2);" />
                    
                    <MudList Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2"><strong>50,000</strong> claims/month</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">All EDI transactions (270/271/275/276/277/278/834/835/837)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">FHIR R4 APIs (CMS-compliant)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Prior authorization workflows</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Medical attachments (275/277 RFAI)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Priority support (24h SLA)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Dedicated Slack channel</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">14-day free trial</MudText>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions Class="pa-4">
                    <MudButton Href="/signup" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true" 
                               Size="Size.Large"
                               Style="box-shadow: 0 0 20px rgba(0, 255, 255, 0.4);">
                        Start Free Trial
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Enterprise Plan -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.3); display: flex; flex-direction: column;">
                <MudCardContent Style="flex: 1;">
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600; color: #00ffff;">
                        Enterprise
                    </MudText>
                    <MudText Typo="Typo.h3" Class="mb-1" Style="font-weight: 700;">
                        Custom
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: rgba(255, 255, 255, 0.6);">
                        For large health plans and payers
                    </MudText>
                    
                    <MudDivider Class="mb-4" Style="border-color: rgba(0, 255, 255, 0.2);" />
                    
                    <MudList Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2"><strong>Unlimited</strong> claims</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Dedicated infrastructure</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">White-label portal</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">SLA guarantees (99.95%+)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">24/7 phone support</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Dedicated CSM</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">Custom integrations</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">BAA & compliance support</MudText>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions Class="pa-4">
                    <MudButton Href="/contact-sales" 
                               Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               FullWidth="true" 
                               Size="Size.Large">
                        Contact Sales
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Feature Comparison -->
    <MudText Typo="Typo.h5" Class="mt-12 mb-4" Style="font-weight: 600; text-align: center;">
        Feature Comparison
    </MudText>

    <MudPaper Elevation="3" Style="border: 1px solid rgba(0, 255, 255, 0.2);">
        <MudSimpleTable Hover="true" Dense="true" Style="background: transparent;">
            <thead>
                <tr>
                    <th>Feature</th>
                    <th style="text-align: center;">Starter</th>
                    <th style="text-align: center;">Professional</th>
                    <th style="text-align: center;">Enterprise</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Claims per month</td>
                    <td style="text-align: center;">10,000</td>
                    <td style="text-align: center;">50,000</td>
                    <td style="text-align: center;">Unlimited</td>
                </tr>
                <tr>
                    <td>837/835 Claims EDI</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>270/271 Eligibility</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>278 Prior Authorization</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>275/277 Attachments & RFAI</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>FHIR R4 APIs</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>Adjudication SLA</td>
                    <td style="text-align: center;"><500ms</td>
                    <td style="text-align: center;"><500ms</td>
                    <td style="text-align: center;">Custom</td>
                </tr>
                <tr>
                    <td>Support</td>
                    <td style="text-align: center;">Email</td>
                    <td style="text-align: center;">Priority (24h)</td>
                    <td style="text-align: center;">24/7 Phone</td>
                </tr>
                <tr>
                    <td>White-label portal</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
                <tr>
                    <td>Dedicated infrastructure</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <!-- FAQ -->
    <MudText Typo="Typo.h5" Class="mt-12 mb-4" Style="font-weight: 600; text-align: center;">
        Frequently Asked Questions
    </MudText>

    <MudExpansionPanels MultiExpansion="true">
        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">What's included in the 14-day free trial?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    Full access to all features in your selected tier. Process real claims, test APIs, and configure your tenant. 
                    No credit card charge until the trial ends. Cancel anytime before February 23, 2026.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">Can I change plans later?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    Yes. Upgrade or downgrade anytime through the portal. Changes take effect immediately, 
                    and billing is prorated for the current month.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">What happens if I exceed my claim limit?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    We'll notify you when you reach 80% of your limit. Additional claims are billed at $0.05 per claim (Starter) 
                    or $0.03 per claim (Professional). Enterprise plans have unlimited claims.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">Is there vendor lock-in?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    No. Cloud Health Office is Apache 2.0 licensed. Your data is exportable anytime in standard formats 
                    (FHIR R4, X12 EDI). You can also self-host the entire platform.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">Do you offer annual billing discounts?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    Yes. Annual plans receive 15% discount (2 months free). Contact sales for multi-year agreements 
                    with additional discounts.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">What compliance certifications do you have?</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2">
                    HIPAA compliant with BAA available. SOC 2 Type II certification in progress (Q2 2026). 
                    CMS-9115-F and CMS-0057-F aligned for Interoperability Final Rules.
                </MudText>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <!-- CTA -->
    <MudPaper Class="mt-12 pa-6" Elevation="3" Style="border: 1px solid rgba(0, 255, 255, 0.3); background: rgba(0, 255, 255, 0.05); text-align: center;">
        <MudText Typo="Typo.h5" Class="mb-3" Style="font-weight: 700;">
            Ready to Get Started?
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-4" Style="color: rgba(255, 255, 255, 0.7);">
            Start your 14-day free trial today. No credit card required.
        </MudText>
        <MudButton Href="/signup" 
                   Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   Size="Size.Large"
                   Style="margin-right: 16px;">
            Start Free Trial
        </MudButton>
        <MudButton Href="/contact-sales" 
                   Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   Size="Size.Large">
            Contact Sales
        </MudButton>
    </MudPaper>
</MudContainer>
