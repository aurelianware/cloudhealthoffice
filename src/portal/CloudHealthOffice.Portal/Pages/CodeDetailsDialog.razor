@using CloudHealthOffice.Portal.Services
@inject IReferenceDataService ReferenceDataService

@* The version of a code effective today, from reference-data-service. *@

<MudDialog>
    <DialogContent>
        @if (_serviceError != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_serviceError</MudAlert>
        }
        else if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_code == null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @CodeSystem @Code has no version effective today.
            </MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td><strong>Code system</strong></td><td>@_code.CodeSystem @(_code.Coding.Version is { } v ? $"({v})" : "")</td></tr>
                    <tr><td><strong>Code</strong></td><td style="font-family: monospace;">@_code.Code</td></tr>
                    <tr><td><strong>Description</strong></td><td>@_code.Text</td></tr>
                    @if (!string.IsNullOrEmpty(_code.Category))
                    {
                        <tr><td><strong>Category</strong></td><td>@_code.Category</td></tr>
                    }
                    <tr><td><strong>Effective</strong></td><td>@_code.EffectiveFrom.ToString("MM/dd/yyyy")@(_code.EffectiveTo is { } to ? $" to {to:MM/dd/yyyy}" : " onward")</td></tr>
                    <tr><td><strong>Status</strong></td><td>@(_code.Active ? "Active" : "Inactive")</td></tr>
                    <tr><td><strong>Source</strong></td><td>@_code.SourceId @_code.SourceVersion, imported @_code.ImportedAt.ToString("MM/dd/yyyy")</td></tr>
                    <tr><td><strong>Licence</strong></td><td>@_code.LicenseClassification@(_code.TenantId is null ? ", shared by all tenants" : ", this tenant only")</td></tr>
                    @if (!string.IsNullOrEmpty(_code.Coding.CodeSystemUri))
                    {
                        <tr><td><strong>System URI</strong></td><td style="font-family: monospace;">@_code.Coding.CodeSystemUri</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string CodeSystem { get; set; } = string.Empty;
    [Parameter] public string Code { get; set; } = string.Empty;

    private ReferenceCodeRecord? _code;
    private bool _loading = true;
    private string? _serviceError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _code = await ReferenceDataService.GetCodeAsync(CodeSystem, Code);
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Reference data service is currently unavailable: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close() => MudDialog.Close();
}
