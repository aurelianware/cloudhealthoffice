@page "/appeals/{AppealId}"
@page "/appeals/{AppealId}/{Tab}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Appeal @AppealId - Cloud Health Office</PageTitle>

<PermissionGate Permission="appeals:read" RoleName="UMCoordinator">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />
    <AppealRecordView @key="AppealId" AppealId="@AppealId" Tab="@Tab" BaseHref="@BaseHref" />
</MudContainer>
</PermissionGate>

@code {
    [Parameter] public string AppealId { get; set; } = string.Empty;
    [Parameter] public string? Tab { get; set; }

    private string BaseHref => $"/appeals/{Uri.EscapeDataString(AppealId)}";

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnParametersSet() =>
        _breadcrumbs =
        [
            new("Home", href: "/home"),
            new("Appeals & Grievances", href: "/appeals"),
            new($"Appeal {AppealId}", href: null, disabled: true),
        ];
}
