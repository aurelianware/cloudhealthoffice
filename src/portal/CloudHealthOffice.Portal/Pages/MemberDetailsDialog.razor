    // Coverage tab Sponsor sub-section — lazy per group number on panel
    // expansion. The expanded-changed event fires on both expand and
    // collapse, so we only fetch when opening and dedupe with
    // _sponsorLoadedOnce to avoid refetching on re-expand.
    private async Task OnSponsorPanelToggled(string groupNumber, bool expanded)
    {
        if (!expanded) return;
        if (string.IsNullOrWhiteSpace(groupNumber)) return;
        if (_sponsorLoadedOnce.Contains(groupNumber)) return;
        if (_loadingSponsor.Contains(groupNumber)) return;

        _loadingSponsor.Add(groupNumber);
        StateHasChanged();
        try
        {
            var view = await SponsorService.GetSponsorMemberViewAsync(groupNumber);
            _sponsorByGroup[groupNumber] = view;
        }
        catch (Exception)
        {
            _sponsorByGroup[groupNumber] = null;
        }
        finally
        {
            _loadingSponsor.Remove(groupNumber);
            _sponsorLoadedOnce.Add(groupNumber);
            StateHasChanged();
        }
    }

