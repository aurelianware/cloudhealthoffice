    private static double GetPercent(decimal used, decimal limit) =>
        limit == 0 ? 0 : Math.Min(100, (double)(used / limit * 100));

    private static double GetPercent(int used, int limit) =>
        limit == 0 ? 0 : Math.Min(100, (double)used / limit * 100);

    private static Color GetAccumColor(decimal used, decimal limit)
    {
        if (limit == 0) return Color.Default;
        var pct = used / limit;
        return pct >= 1m ? Color.Success : pct >= 0.9m ? Color.Warning : Color.Primary;
    }

    private static Color GetAccumColor(int used, int limit)
    {
        if (limit == 0) return Color.Default;
        var pct = (double)used / limit;
        return pct >= 1.0 ? Color.Success : pct >= 0.9 ? Color.Warning : Color.Primary;
    }

