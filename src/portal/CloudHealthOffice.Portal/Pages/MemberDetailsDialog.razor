@using CloudHealthOffice.Portal.Services
@using CloudHealthOffice.Portal.Formatters
@using CloudHealthOffice.Portal.Shared
@inject IMemberService MemberService
@inject ICoverageService CoverageService
@inject IBenefitPlanService BenefitPlanService
@inject IFamilyRelationshipService FamilyRelationshipService
@inject IMemberNoteService MemberNoteService
@inject IMemberDocumentService MemberDocumentService
@inject IIdCardService IdCardService
@inject IClaimsService ClaimsService
@inject IArService ArService
@inject IPremiumBillingService PremiumBillingService
@inject ISponsorService SponsorService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog Style="min-width: 800px; max-width: 1100px;">
    <DialogContent>
        @if (_serviceError != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
        }

        @if (_loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_member != null)
        {
            <div class="d-flex align-center gap-3 mb-4 pa-2" style="border: 1px solid rgba(0,255,255,0.2); border-radius: 8px; background: rgba(0,255,255,0.03);">
                <MudAvatar Size="Size.Large" Color="Color.Primary">
                    @(_member.FirstName[0])@(_member.LastName[0])
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">@_member.FirstName @_member.LastName</MudText>
                    <div class="d-flex align-center gap-2 mt-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">@_member.MemberId</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetCoverageStatusColor(_member.DisplayStatus)">@_member.DisplayStatus</MudChip>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">DOB: @_member.DateOfBirth.ToString("MM/dd/yyyy")</MudText>
                    </div>
                </div>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           OnClick="@(() => Navigation.NavigateTo($"/claims?memberId={_member.MemberId}"))">
                    View Claims
                </MudButton>
            </div>

            <MemberAlertBanner MemberId="@MemberId" OnAlertCountChanged="OnAlertCountChanged" />

            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4"
                     @bind-ActivePanelIndex="_activeTab">
                <!-- Personal Information Tab -->
                <MudTabPanel Text="Personal Info" Icon="@Icons.Material.Filled.Person">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member ID" Value="_member.MemberId" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Coverage Status" Value="_member.DisplayStatus" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="First Name" Value="_member.FirstName" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Last Name" Value="_member.LastName" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Date of Birth" Value="@_member.DateOfBirth.ToString("MM/dd/yyyy")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Gender" Value="_member.Gender" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Age" Value="@($"{DateTime.Today.Year - _member.DateOfBirth.Year} years")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Email" Value="_member.Email" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Phone" Value="_member.Phone" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        @if (_member.Address != null)
                        {
                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Mailing Address</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField Label="Street" Value="_member.Address" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField Label="City" Value="_member.City" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField Label="State" Value="_member.State" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Label="ZIP Code" Value="_member.ZipCode" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <!-- Accumulators Tab -->
                <MudTabPanel Text="Accumulators" Icon="@Icons.Material.Filled.BarChart">
                    <div>
                        @if (_loadingAccumulators)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_accumulators != null)
                        {
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />
                                Plan Year Accumulators
                            </MudText>

                            <MudGrid Class="mb-4">
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Individual Deductible</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.IndividualDeductibleUsed.ToString("C") of @_accumulators.IndividualDeductibleLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit)"
                                                           Color="@GetAccumColor(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Family Deductible</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.FamilyDeductibleUsed.ToString("C") of @_accumulators.FamilyDeductibleLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit)"
                                                           Color="@GetAccumColor(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Individual Out-of-Pocket Max</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.IndividualOopUsed.ToString("C") of @_accumulators.IndividualOopLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit)"
                                                           Color="@GetAccumColor(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Family Out-of-Pocket Max</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.FamilyOopUsed.ToString("C") of @_accumulators.FamilyOopLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit)"
                                                           Color="@GetAccumColor(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            @if (_accumulators.ServiceAccumulators.Any())
                            {
                                <MudText Typo="Typo.subtitle1" Class="mb-3 mt-4" Style="font-weight: 600;">
                                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
                                    Service-Specific Accumulators
                                </MudText>
                                <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="mb-4">
                                    <thead>
                                        <tr>
                                            <th>Service Type</th>
                                            <th>Used</th>
                                            <th>Limit</th>
                                            <th>Remaining</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var svc in _accumulators.ServiceAccumulators)
                                        {
                                            <tr>
                                                <td>@svc.BenefitCategory</td>
                                                <td>@svc.Used @svc.Unit</td>
                                                <td>@svc.Limit @svc.Unit</td>
                                                <td>@(svc.Limit - svc.Used) @svc.Unit</td>
                                                <td style="min-width: 150px;">
                                                    <MudProgressLinear Value="@GetPercent(svc.Used, svc.Limit)"
                                                                       Color="@GetAccumColor(svc.Used, svc.Limit)"
                                                                       Rounded="true" Size="Size.Small" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }

                            @if (_accumulators.RecentActivity.Any())
                            {
                                <MudText Typo="Typo.subtitle1" Class="mb-3 mt-4" Style="font-weight: 600;">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1" />
                                    Recent Accumulator Activity
                                </MudText>
                                <MudSimpleTable Dense="true" Hover="true" Elevation="1">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Event</th>
                                            <th>Source</th>
                                            <th style="text-align: right;">Deductible Δ</th>
                                            <th style="text-align: right;">OOP Δ</th>
                                            <th>Actor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var act in _accumulators.RecentActivity)
                                        {
                                            <tr>
                                                <td>@act.OccurredAt.ToString("MM/dd/yyyy")</td>
                                                <td>@act.EventType</td>
                                                <td>
                                                    @if (act.EventType == "ClaimApplied" && !string.IsNullOrEmpty(act.SourceReference))
                                                    {
                                                        <MudLink Href="@($"/claims/{act.SourceReference}")" Typo="Typo.body2" Style="font-family: monospace;">@act.SourceReference</MudLink>
                                                    }
                                                    else
                                                    {
                                                        <span style="font-family: monospace;">@act.SourceReference</span>
                                                    }
                                                </td>
                                                <td style="text-align: right;">@act.DeductibleDelta.ToString("C")</td>
                                                <td style="text-align: right;">@act.OopDelta.ToString("C")</td>
                                                <td>@act.ActorId</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No accumulator data available for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Coverage Tab -->
                <MudTabPanel Text="Coverage" Icon="@Icons.Material.Filled.HealthAndSafety">
                    <div>
                        @if (_loadingCoverage)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_coverages.Any())
                        {
                            @foreach (var coverage in _coverages)
                            {
                                <MudCard Class="mb-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.15);">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Small" />
                                                <MudText Typo="Typo.h6">@(coverage.PlanName ?? coverage.PlanId ?? "Coverage")</MudText>
                                            </div>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <div class="d-flex align-center gap-2">
                                                <MudChip T="string" Size="Size.Small" Color="@GetCoverageStatusColor(coverage.StatusText)">
                                                    @coverage.StatusText
                                                </MudChip>
                                                @if (coverage.StatusText == "Active")
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Error"
                                                               StartIcon="@Icons.Material.Filled.PersonOff"
                                                               OnClick="@(() => OpenTerminateDialog(coverage))">
                                                        Terminate
                                                    </MudButton>
                                                }
                                            </div>
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudGrid>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">COVERAGE ID</MudText>
                                                <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.8);">@coverage.CoverageId</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">GROUP NUMBER</MudText>
                                                <MudText Typo="Typo.body2">@coverage.GroupNumber</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">PLAN ID</MudText>
                                                <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.8);">@coverage.PlanId</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">STATUS</MudText>
                                                <MudText Typo="Typo.body2">@coverage.StatusText</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">EFFECTIVE DATE</MudText>
                                                <MudText Typo="Typo.body2">@coverage.EffectiveDate.ToString("MM/dd/yyyy")</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">TERMINATION DATE</MudText>
                                                <MudText Typo="Typo.body2">@(coverage.TerminationDate?.ToString("MM/dd/yyyy") ?? "Active")</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">DURATION</MudText>
                                                <MudText Typo="Typo.body2">
                                                    @{
                                                        var end = coverage.TerminationDate ?? DateTime.Today;
                                                        var months = (int)((end - coverage.EffectiveDate).TotalDays / 30);
                                                    }
                                                    @months month@(months != 1 ? "s" : "")
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>

                                        @if (!string.IsNullOrWhiteSpace(coverage.GroupNumber))
                                        {
                                            <MudExpansionPanels Elevation="0" Class="mt-3">
                                                <MudExpansionPanel Text="Sponsor"
                                                                    Icon="@Icons.Material.Filled.Business"
                                                                    IsExpandedChanged="@(expanded => OnSponsorPanelToggled(coverage.GroupNumber!, expanded))">
                                                    @if (_loadingSponsor.Contains(coverage.GroupNumber!))
                                                    {
                                                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                                                    }
                                                    else if (_sponsorByGroup.TryGetValue(coverage.GroupNumber!, out var sponsor) && sponsor != null)
                                                    {
                                                        <MudGrid>
                                                            <MudItem xs="12" md="6">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">SPONSOR</MudText>
                                                                <MudText Typo="Typo.body2">@sponsor.SponsorName</MudText>
                                                            </MudItem>
                                                            <MudItem xs="12" md="6">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">TYPE</MudText>
                                                                <MudText Typo="Typo.body2">@sponsor.LineOfBusiness · @sponsor.Status</MudText>
                                                            </MudItem>
                                                            @if (sponsor.PrimaryContact != null)
                                                            {
                                                                <MudItem xs="12" md="6">
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">CONTACT</MudText>
                                                                    <MudText Typo="Typo.body2">@sponsor.PrimaryContact.Name</MudText>
                                                                    <MudText Typo="Typo.caption">@sponsor.PrimaryContact.Phone · @sponsor.PrimaryContact.Email</MudText>
                                                                </MudItem>
                                                            }
                                                            @if (sponsor.Broker != null)
                                                            {
                                                                <MudItem xs="12" md="6">
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">BROKER</MudText>
                                                                    <MudText Typo="Typo.body2">@sponsor.Broker.Name @(string.IsNullOrEmpty(sponsor.Broker.AgencyName) ? "" : $"· {sponsor.Broker.AgencyName}")</MudText>
                                                                    <MudText Typo="Typo.caption">@sponsor.Broker.Phone · @sponsor.Broker.Email</MudText>
                                                                </MudItem>
                                                            }
                                                            @if (sponsor.OpenEnrollment != null)
                                                            {
                                                                <MudItem xs="12">
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">OPEN ENROLLMENT</MudText>
                                                                    <MudText Typo="Typo.body2">
                                                                        @sponsor.OpenEnrollment.Start.ToString("MM/dd/yyyy") – @sponsor.OpenEnrollment.End.ToString("MM/dd/yyyy")
                                                                        <MudChip T="string" Size="Size.Small" Color="@GetOeStatusColor(sponsor.OpenEnrollment.Status)" Class="ml-2">@sponsor.OpenEnrollment.Status</MudChip>
                                                                    </MudText>
                                                                </MudItem>
                                                            }
                                                        </MudGrid>
                                                    }
                                                    else if (_sponsorLoadedOnce.Contains(coverage.GroupNumber!))
                                                    {
                                                        <MudAlert Severity="Severity.Info" Dense="true">Sponsor details unavailable.</MudAlert>
                                                    }
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No coverage information available for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Benefits Tab -->
                <MudTabPanel Text="Benefits" Icon="@Icons.Material.Filled.MedicalInformation">
                    <div>
                        @{
                            var eligibleCoverages = _coverages
                                .Where(c => !string.IsNullOrEmpty(c.PlanId)
                                            && c.StatusText == "Active"
                                            && c.EffectiveDate <= DateTime.Today
                                            && (c.TerminationDate == null || c.TerminationDate >= DateTime.Today))
                                .ToList();
                        }

                        @if (_loadingCoverage)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (!eligibleCoverages.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                No active coverage as of @DateTime.Today.ToString("MM/dd/yyyy") — benefits cannot be resolved.
                            </MudAlert>
                        }
                        else
                        {
                            @if (eligibleCoverages.Count > 1)
                            {
                                <MudSelect T="string" Label="Coverage"
                                           Value="_selectedBenefitPlanId"
                                           ValueChanged="OnCoverageSelectionChanged"
                                           Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                    @foreach (var cov in eligibleCoverages)
                                    {
                                        <MudSelectItem T="string" Value="@cov.PlanId">
                                            @cov.PlanName (@cov.EffectiveDate.ToString("MM/dd/yyyy")
                                            — @(cov.TerminationDate?.ToString("MM/dd/yyyy") ?? "present"))
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (_loadingBenefits)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                            }
                            else if (_benefitView != null)
                            {
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@_benefitView.PlanName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@_benefitView.PlanType</MudChip>
                                    @if (!string.IsNullOrEmpty(_benefitView.MetalLevel))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@_benefitView.MetalLevel</MudChip>
                                    }
                                    <MudSpacer />
                                    <MudTooltip Text="@($"Plan version {_benefitView.PlanVersion}")">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            As of @_benefitView.AsOfDate.ToString("MM/dd/yyyy") · v@_benefitView.PlanVersion
                                        </MudText>
                                    </MudTooltip>
                                </div>

                                @if (_benefitView.Categories.Any())
                                {
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="mb-3">
                                        <thead>
                                            <tr>
                                                <th>Benefit</th>
                                                <th>In-Network</th>
                                                <th>Out-of-Network</th>
                                                <th>Deductible</th>
                                                <th>OOP</th>
                                                <th>Prior Auth</th>
                                                <th>Limits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in _benefitView.Categories)
                                            {
                                                <tr>
                                                    <td>
                                                        <div style="font-weight: 500;">@cat.DisplayName</div>
                                                        @if (cat.Pharmacy != null)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.Pharmacy.TierLabel@(cat.Pharmacy.IsSpecialty ? " (specialty)" : "")</MudText>
                                                        }
                                                        else if (!string.IsNullOrEmpty(cat.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.Description</MudText>
                                                        }
                                                    </td>
                                                    <td>@BenefitCostShareFormatter.Format(cat.InNetwork)</td>
                                                    <td>@(cat.OutOfNetwork != null ? BenefitCostShareFormatter.Format(cat.OutOfNetwork) : "—")</td>
                                                    <td>@(cat.DeductibleApplies ? "Applies" : "Waived")</td>
                                                    <td>@(cat.OopApplies ? "Applies" : "Excluded")</td>
                                                    <td>
                                                        @if (cat.PriorAuthRequired)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Required</MudChip>
                                                        }
                                                        else
                                                        {
                                                            <text>—</text>
                                                        }
                                                    </td>
                                                    <td>@FormatLimits(cat)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info">This plan has no configured benefits.</MudAlert>
                                }

                                @if (_benefitView.Documents.Any())
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2" Style="font-weight: 600;">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                                        Plan Documents
                                    </MudText>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var doc in _benefitView.Documents)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                                       Href="@doc.Location" Target="_blank">
                                                @(string.IsNullOrEmpty(doc.DisplayName) ? doc.DocType : doc.DisplayName)
                                            </MudButton>
                                        }
                                    </div>
                                }
                            }
                            else if (_benefitsError != null)
                            {
                                <MudAlert Severity="Severity.Warning">@_benefitsError</MudAlert>
                            }
                        }
                    </div>
                </MudTabPanel>

                <!-- PCP Tab -->
                <MudTabPanel Text="Primary Care Physician" Icon="@Icons.Material.Filled.MedicalServices"
                             @ref="_pcpTab">
                    <div>
                        @if (_loadingPcp)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_pcp != null)
                        {
                            <MudCard Elevation="2" Style="border: 1px solid rgba(0,255,136,0.3);">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Success" />
                                            <MudText Typo="Typo.h6">@_pcp.ProviderName</MudText>
                                        </div>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(_pcp.NetworkStatus == "In-Network" ? Color.Success : Color.Warning)">
                                            @_pcp.NetworkStatus
                                        </MudChip>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">PROVIDER ID</MudText>
                                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@_pcp.ProviderId</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">NPI</MudText>
                                            <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.8);">@_pcp.NPI</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">SPECIALTY</MudText>
                                            <MudText Typo="Typo.body2">@_pcp.Specialty</MudText>
                                        </MudItem>
                                        @if (!string.IsNullOrEmpty(_pcp.PracticeName))
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">PRACTICE</MudText>
                                                <MudText Typo="Typo.body2">@_pcp.PracticeName</MudText>
                                            </MudItem>
                                        }
                                        @if (!string.IsNullOrEmpty(_pcp.Phone))
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">PHONE</MudText>
                                                <MudText Typo="Typo.body2">@_pcp.Phone</MudText>
                                            </MudItem>
                                        }
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">ASSIGNED DATE</MudText>
                                            <MudText Typo="Typo.body2">@_pcp.AssignedDate.ToString("MM/dd/yyyy")</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.SyncAlt"
                                               OnClick="OpenChangePcpDialog">
                                        Change PCP
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-4">No PCP currently assigned to this member.</MudAlert>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenChangePcpDialog">
                                Assign PCP
                            </MudButton>
                        }

                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" Size="Size.Small" />
                            Assignment History
                        </MudText>
                        @if (_loadingPcpHistory)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                        }
                        else if (_pcpHistory.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No prior PCP assignments recorded.</MudText>
                        }
                        else
                        {
                            <MudTable Items="_pcpHistory" Dense="true" Hover="true" T="PcpAssignmentHistoryItem">
                                <HeaderContent>
                                    <MudTh>Provider</MudTh>
                                    <MudTh>NPI</MudTh>
                                    <MudTh>Effective</MudTh>
                                    <MudTh>End</MudTh>
                                    <MudTh>Source</MudTh>
                                    <MudTh>Network at Assignment</MudTh>
                                    <MudTh>Reason</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Provider">@(string.IsNullOrEmpty(context.ProviderName) ? context.ProviderNpi : context.ProviderName)</MudTd>
                                    <MudTd DataLabel="NPI"><span style="font-family: monospace;">@context.ProviderNpi</span></MudTd>
                                    <MudTd DataLabel="Effective">@context.EffectiveDate.ToString("MM/dd/yyyy")</MudTd>
                                    <MudTd DataLabel="End">@(context.EndDate.HasValue ? context.EndDate.Value.ToString("MM/dd/yyyy") : "—")</MudTd>
                                    <MudTd DataLabel="Source">
                                        <MudChip T="string" Size="Size.Small">@context.AssignmentSource</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Network at Assignment">
                                        @* Snapshot value — never updated. Live status is fetched separately. *@
                                        <MudChip T="string" Size="Size.Small">@context.NetworkStatusAtAssignment</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Reason">@(context.AssignmentReason ?? "—")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>
                </MudTabPanel>

                <!-- Documents Tab -->
                <MudTabPanel Text="Documents" Icon="@Icons.Material.Filled.Description">
                    <div>
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudSelect T="string" Label="Category Filter" Dense="true" Variant="Variant.Outlined"
                                       Value="_documentCategoryFilter" ValueChanged="OnDocumentCategoryChanged"
                                       Style="min-width: 220px;">
                                <MudSelectItem Value="@string.Empty">All Categories</MudSelectItem>
                                <MudSelectItem Value="@("Lab")">Lab</MudSelectItem>
                                <MudSelectItem Value="@("Authorization")">Authorization</MudSelectItem>
                                <MudSelectItem Value="@("Appeal")">Appeal</MudSelectItem>
                                <MudSelectItem Value="@("EOB")">EOB</MudSelectItem>
                                <MudSelectItem Value="@("Eligibility")">Eligibility</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="LoadDocumentsAsync" Disabled="_loadingDocuments">
                                Refresh
                            </MudButton>
                        </div>

                        @if (_loadingDocuments)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_memberDocuments.Any())
                        {
                            <MudTable Items="_memberDocuments" Dense="true" Hover="true" T="MemberDocumentSummary">
                                <HeaderContent>
                                    <MudTh>Uploaded</MudTh>
                                    <MudTh>Category</MudTh>
                                    <MudTh>Subtype</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh style="text-align: right;">Size</MudTh>
                                    <MudTh>Retention Until</MudTh>
                                    <MudTh>Legal Hold</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Uploaded">
                                        <MudText Typo="Typo.body2">@context.UploadedDate.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.UploadedBy</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Category">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Category</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Subtype">
                                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Subcategory) ? "-" : context.Subcategory)</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudText Typo="Typo.body2">@context.ContentType</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Size" Style="text-align: right;">
                                        <MudText Typo="Typo.body2">@FormatBytes(context.SizeBytes)</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Retention Until">
                                        <MudText Typo="Typo.body2">@context.RetentionUntilDate.ToString("MM/dd/yyyy")</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.RetentionPolicyId</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Legal Hold">
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="@(context.LegalHold ? Color.Warning : Color.Default)"
                                                   StartIcon="@(context.LegalHold ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                                   OnClick="@(() => ToggleLegalHoldAsync(context))">
                                            @(context.LegalHold ? "Held" : "Not Held")
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No member documents found for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="ID Cards" Icon="@Icons.Material.Filled.Badge">
                    <div>
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCard"
                                       OnClick="OpenIdCardOrderDialogAsync">
                                Order New Card
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="LoadIdCardsAsync" Disabled="_loadingIdCards">
                                Refresh
                            </MudButton>
                        </div>

                        @if (_loadingIdCards)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_idCards.Any())
                        {
                            <MudTable Items="_idCards" Dense="true" Hover="true" T="IdCardHistoryView">
                                <HeaderContent>
                                    <MudTh>Issued</MudTh>
                                    <MudTh>Card ID</MudTh>
                                    <MudTh>Plan</MudTh>
                                    <MudTh>Sponsor</MudTh>
                                    <MudTh>Lang</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh style="text-align: right;">Scans</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Issued">
                                        <MudText Typo="Typo.body2">@context.IssuedAt.ToLocalTime().ToString("MM/dd/yyyy")</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Card ID">
                                        <MudText Typo="Typo.caption">@context.CardId</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Plan">@(context.PlanId ?? "-")</MudTd>
                                    <MudTd DataLabel="Sponsor">@(context.SponsorId ?? "-")</MudTd>
                                    <MudTd DataLabel="Lang">@(context.LanguageCode ?? "en-US")</MudTd>
                                    <MudTd DataLabel="Status">
                                        @if (context.RevokedAt.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                                Revoked (@context.RevocationReason)
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Scans" Style="text-align: right;">@context.ScanCount</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudLink Href="@IdCardService.BuildDocumentDownloadUrl(context.DocumentId)" Target="_blank">
                                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf">PDF</MudButton>
                                        </MudLink>
                                        @if (!string.IsNullOrEmpty(context.PreviewDocumentId))
                                        {
                                            <MudLink Href="@IdCardService.BuildDocumentDownloadUrl(context.PreviewDocumentId!)" Target="_blank">
                                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Image">PNG</MudButton>
                                            </MudLink>
                                        }
                                        @if (!context.RevokedAt.HasValue)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Warning"
                                                       StartIcon="@Icons.Material.Filled.Block"
                                                       OnClick="@(() => RevokeIdCardAsync(context))">
                                                Revoke
                                            </MudButton>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No ID cards have been issued for this member yet.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Enrollment History Tab — backed by the per-member EnrollmentEvent stream -->
                <MudTabPanel Text="Enrollment History" Icon="@Icons.Material.Filled.Timeline">
                    <div>
                        <MudGrid Class="mb-3">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Event type" Dense="true" Variant="Variant.Outlined"
                                           Value="@_eventTypeFilter" ValueChanged="OnEventTypeChanged" Clearable="true">
                                    <MudSelectItem T="string" Value="@(string.Empty)">All</MudSelectItem>
                                    @foreach (var t in EnrollmentEventTypes)
                                    {
                                        <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <MudDatePicker Label="From" Date="_eventFromFilter" DateChanged="OnEventFromChanged"
                                               Variant="Variant.Outlined" Clearable="true" />
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <MudDatePicker Label="To" Date="_eventToFilter" DateChanged="OnEventToChanged"
                                               Variant="Variant.Outlined" Clearable="true" />
                            </MudItem>
                        </MudGrid>

                        @if (_loadingEvents)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_enrollmentEvents.Any())
                        {
                            <MudExpansionPanels MultiExpansion="true" Dense="true">
                                @foreach (var evt in _enrollmentEvents)
                                {
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <div class="d-flex align-center" style="width:100%;">
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@GetEventColor(evt.EventType)" Class="mr-2">
                                                    @evt.EventType
                                                </MudChip>
                                                <MudText Typo="Typo.body2" Style="font-weight:500;">
                                                    @(evt.EventDate?.ToString("MMM dd, yyyy") ?? evt.OccurredAt.ToString("MMM dd, yyyy HH:mm"))
                                                </MudText>
                                                <MudSpacer />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                         Style="font-family: monospace;">
                                                    v@(evt.Version) · @(evt.Source ?? "edi834")
                                                </MudText>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudGrid>
                                                <MudItem xs="6" md="3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Maintenance type</MudText>
                                                    <MudText Typo="Typo.body2">@(evt.MaintenanceType ?? "—")</MudText>
                                                </MudItem>
                                                <MudItem xs="6" md="3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Maintenance reason</MudText>
                                                    <MudText Typo="Typo.body2">@(evt.MaintenanceReason ?? "—")</MudText>
                                                </MudItem>
                                                <MudItem xs="6" md="3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Batch ID</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                                        @(evt.SourceBatchId ?? "—")
                                                    </MudText>
                                                </MudItem>
                                                <MudItem xs="6" md="3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Transaction ID</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                                        @(evt.TransactionId ?? "—")
                                                    </MudText>
                                                </MudItem>
                                                @if (evt.RetroEffectiveDate.HasValue)
                                                {
                                                    <MudItem xs="12">
                                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                                            Retro-adjusted to @evt.RetroEffectiveDate.Value.ToString("MMM dd, yyyy")
                                                        </MudAlert>
                                                    </MudItem>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(evt.RawSegment))
                                                {
                                                    <MudItem xs="12">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                                                            Raw 834 / manual snippet
                                                        </MudText>
                                                        <pre style="white-space: pre-wrap; word-break: break-word;
                                                                    background: rgba(0,0,0,0.4); padding: 8px;
                                                                    border-radius: 4px; font-size: 0.75rem; max-height: 240px;
                                                                    overflow: auto;">@evt.RawSegment</pre>
                                                    </MudItem>
                                                }
                                            </MudGrid>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>

                            @if (!string.IsNullOrEmpty(_eventsContinuationToken))
                            {
                                <div class="d-flex justify-center mt-3">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="LoadMoreEventsAsync">
                                        Load more
                                    </MudButton>
                                </div>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No enrollment events found for the selected filters.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- 834 Transactions Tab -->
                <MudTabPanel Text="834 Transactions" Icon="@Icons.Material.Filled.Receipt">
                    <div>
                        @if (_loading834)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_transactions834.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                EDI 834 enrollment transactions for this member.
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_transactions834.Count(t => t.Status == "Accepted") Accepted</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@_transactions834.Count(t => t.Status == "Rejected") Rejected</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_transactions834.Count(t => t.Status == "Pending") Pending</MudChip>
                            </MudText>
                            <MudTable Items="_transactions834" Dense="true" Hover="true"
                                      T="Enrollment834Record" @ref="_834Table">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Batch ID</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Reason</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Errors</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">
                                        <MudText Typo="Typo.body2">@context.TransactionDate.ToString("MM/dd/yyyy")</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Batch ID">
                                        <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.7);">@context.BatchId</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudTooltip Text="@context.TransactionSetPurpose">
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(context.MaintenanceTypeCode == "021" ? Color.Success : context.MaintenanceTypeCode == "024" ? Color.Error : Color.Info)">
                                                @(context.MaintenanceTypeCode == "021" ? "Add" : context.MaintenanceTypeCode == "024" ? "Cancel" : "Change")
                                            </MudChip>
                                        </MudTooltip>
                                    </MudTd>
                                    <MudTd DataLabel="Reason">
                                        <MudText Typo="Typo.body2">@context.MaintenanceReasonCode</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(context.Status == "Accepted" ? Color.Success : context.Status == "Rejected" ? Color.Error : Color.Warning)">
                                            @context.Status
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Errors">
                                        @if (context.Errors.Any())
                                        {
                                            <MudTooltip>
                                                <TooltipContent>
                                                    @foreach (var err in context.Errors)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="d-block">@err</MudText>
                                                    }
                                                </TooltipContent>
                                                <ChildContent>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Error">
                                                        @context.Errors.Count error@(context.Errors.Count != 1 ? "s" : "")
                                                    </MudChip>
                                                </ChildContent>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                                        }
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText>No 834 transactions found</MudText>
                                </NoRecordsContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No 834 enrollment transactions found for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Family Tab -->
                <MudTabPanel Text="Family" Icon="@Icons.Material.Filled.FamilyRestroom">
                    <div>
                        <div class="d-flex align-center mb-3">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-1" />
                                Family Relationships
                            </MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddDependentDialog">
                                Add Dependent
                            </MudButton>
                        </div>

                        @if (_loadingFamily)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else
                        {
                            @if (_subscriberRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="Subscriber" IsInitiallyExpanded="true">
                                        <FamilyRelationshipTable Rows="_subscriberRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (_dependentRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="@($"Dependents ({_dependentRows.Count})")" IsInitiallyExpanded="true">
                                        <FamilyRelationshipTable Rows="_dependentRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (_otherRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="@($"Other ({_otherRows.Count})")">
                                        <FamilyRelationshipTable Rows="_otherRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (!_subscriberRows.Any() && !_dependentRows.Any() && !_otherRows.Any())
                            {
                                <MudAlert Severity="Severity.Info">No family relationships recorded for this member.</MudAlert>
                            }
                        }
                    </div>
                </MudTabPanel>

                <!-- Notes Tab -->
                <MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.Notes" OnClick="@(_ => OnNotesTabActivated())">
                    <div>
                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Category"
                                           Value="_noteCategoryFilter"
                                           ValueChanged="OnNoteCategoryChanged"
                                           Variant="Variant.Outlined" Dense="true">
                                    <MudSelectItem Value="@string.Empty">All</MudSelectItem>
                                    @foreach (var cat in NoteCategories)
                                    {
                                        <MudSelectItem Value="@cat">@cat</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="8" Class="d-flex align-center justify-end">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.NoteAdd"
                                           OnClick="ToggleNoteEntry">
                                    @(_showNoteEntry ? "Cancel" : "Add Note")
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_showNoteEntry)
                        {
                            <MudPaper Class="pa-3 mb-3" Elevation="1">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="string" Label="Category"
                                                   @bind-Value="_newNoteCategory"
                                                   Variant="Variant.Outlined" Dense="true">
                                            @foreach (var cat in NoteCategories)
                                            {
                                                <MudSelectItem Value="@cat">@cat</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="8">
                                        <MudTextField @bind-Value="_newNoteSubject"
                                                      Label="Subject" Variant="Variant.Outlined"
                                                      MaxLength="200" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_newNoteBody"
                                                      Label="Body" Variant="Variant.Outlined"
                                                      Lines="4" MaxLength="8000" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" Class="d-flex justify-end">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                                   Disabled="@(_savingNote || string.IsNullOrWhiteSpace(_newNoteSubject) || string.IsNullOrWhiteSpace(_newNoteBody))"
                                                   OnClick="SubmitNoteAsync">
                                            @(_savingNote ? "Saving…" : "Save Note")
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }

                        @if (_loadingNotes)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                        }
                        else if (!_notes.Any())
                        {
                            <MudAlert Severity="Severity.Info">No notes recorded for this member.</MudAlert>
                        }
                        else
                        {
                            <div class="d-flex flex-column">
                                @foreach (var note in _notes)
                                {
                                    <MudPaper Class="pa-3 mb-2" Elevation="1">
                                        <div class="d-flex align-center gap-2 mb-1">
                                            <MudChip T="string" Size="Size.Small" Color="@GetNoteCategoryColor(note.Category)">@note.Category</MudChip>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@note.Subject</MudText>
                                            <MudSpacer />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @note.Author · @note.CreatedDate.ToLocalTime().ToString("MM/dd/yyyy HH:mm")
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@note.Body</MudText>
                                        @if (!string.IsNullOrEmpty(note.LinkedResourceType))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                                Linked: @note.LinkedResourceType / @note.LinkedResourceId
                                            </MudText>
                                        }
                                    </MudPaper>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_notesContinuationToken))
                            {
                                <div class="d-flex justify-center mt-2">
                                    <MudButton Variant="Variant.Outlined" OnClick="LoadMoreNotesAsync">Load more</MudButton>
                                </div>
                            }
                        }
                    </div>
                </MudTabPanel>

                <!-- Claims Tab — summary counts only; full grid lives on /claims?memberId=X -->
                <MudTabPanel Text="Claims" Icon="@Icons.Material.Filled.Receipt" OnClick="@(_ => OnClaimsTabActivated())">
                    <div>
                        @if (_loadingClaims)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_claimsError != null)
                        {
                            <MudAlert Severity="Severity.Error" Class="my-2">Claims service unavailable: @_claimsError</MudAlert>
                        }
                        else if (_memberClaimsSummary != null)
                        {
                            <MudGrid>
                                <MudItem xs="12" md="4">
                                    <MudCard Elevation="1">
                                        <MudCardContent>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL CLAIMS</MudText>
                                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@_memberClaimsSummary.Total</MudText>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudCard Elevation="1">
                                        <MudCardContent>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">SHOWING</MudText>
                                            <MudText Typo="Typo.h6">@_memberClaimsSummary.Resources.Count of @_memberClaimsSummary.Total</MudText>
                                            <MudText Typo="Typo.caption">page @_memberClaimsSummary.Page · pageSize @_memberClaimsSummary.PageSize</MudText>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                                <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.OpenInNew"
                                               OnClick="@(() => Navigation.NavigateTo($"/claims?memberId={MemberId}"))">
                                        View all claims
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                Claims grid intentionally lives on <strong>/claims</strong>; this tab links out to avoid duplicate rendering.
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No claims activity for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- AR Tab — read-only, no payment actions -->
                <MudTabPanel Text="AR" Icon="@Icons.Material.Filled.AccountBalance" OnClick="@(_ => OnArTabActivated())">
                    <div>
                        @if (_loadingAr)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_arError != null)
                        {
                            <MudAlert Severity="Severity.Error" Class="my-2">AR service unavailable: @_arError</MudAlert>
                        }
                        else if (_arSummary != null)
                        {
                            <MudCard Elevation="1" Class="mb-3">
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">CURRENT BALANCE</MudText>
                                            <MudText Typo="Typo.h4" Color="@(_arSummary.CurrentBalance > 0 ? Color.Warning : Color.Success)">
                                                @_arSummary.CurrentBalance.ToString("C")
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="8">
                                            <MudSimpleTable Dense="true" Hover="false" Bordered="true">
                                                <thead>
                                                    <tr>
                                                        <th>0-30</th><th>31-60</th><th>61-90</th><th>91+</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>@_arSummary.Aged.Bucket0_30.ToString("C")</td>
                                                        <td>@_arSummary.Aged.Bucket31_60.ToString("C")</td>
                                                        <td>@_arSummary.Aged.Bucket61_90.ToString("C")</td>
                                                        <td>@_arSummary.Aged.Bucket91Plus.ToString("C")</td>
                                                    </tr>
                                                </tbody>
                                            </MudSimpleTable>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>

                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudText Typo="Typo.h6" Class="mb-2">Recent charges</MudText>
                                    @if (_arSummary.RecentCharges.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                                    }
                                    else
                                    {
                                        <MudTable Items="_arSummary.RecentCharges" Dense="true" Hover="true">
                                            <HeaderContent>
                                                <MudTh>Posted</MudTh><MudTh>Source</MudTh><MudTh>Reference</MudTh><MudTh Style="text-align:right">Amount</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.PostedAt.ToLocalTime().ToString("MM/dd/yyyy")</MudTd>
                                                <MudTd>@context.Source</MudTd>
                                                <MudTd>@context.SourceReferenceNumber</MudTd>
                                                <MudTd Style="text-align:right">@context.Amount.ToString("C")</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudText Typo="Typo.h6" Class="mb-2">Recent payments</MudText>
                                    @if (_arSummary.RecentPayments.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                                    }
                                    else
                                    {
                                        <MudTable Items="_arSummary.RecentPayments" Dense="true" Hover="true">
                                            <HeaderContent>
                                                <MudTh>Posted</MudTh><MudTh>Source</MudTh><MudTh>Reference</MudTh><MudTh Style="text-align:right">Amount</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.PostedAt.ToLocalTime().ToString("MM/dd/yyyy")</MudTd>
                                                <MudTd>@context.Source</MudTd>
                                                <MudTd>@context.SourceReferenceNumber</MudTd>
                                                <MudTd Style="text-align:right">@context.Amount.ToString("C")</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No AR activity for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Premium Tab — current invoice, next bill, APTC-aware grace banner, last 12 -->
                <MudTabPanel Text="Premium" Icon="@Icons.Material.Filled.CreditCard" OnClick="@(_ => OnPremiumTabActivated())">
                    <div>
                        @if (_loadingPremium)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_premiumError != null)
                        {
                            <MudAlert Severity="Severity.Error" Class="my-2">Premium billing service unavailable: @_premiumError</MudAlert>
                        }
                        else if (_premiumSummary?.CurrentInvoice != null)
                        {
                            @if (_premiumSummary.Grace.IsInGrace)
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    @if (_premiumSummary.Grace.GraceType == "AptcThreeMonth")
                                    {
                                        <text><strong>ACA APTC 3-month grace</strong> — @_premiumSummary.Grace.DaysRemaining days remaining (expires @_premiumSummary.Grace.ExpiresOn?.ToString("MM/dd/yyyy")).</text>
                                    }
                                    else
                                    {
                                        <text><strong>Grace period</strong> — @_premiumSummary.Grace.DaysRemaining days remaining (expires @_premiumSummary.Grace.ExpiresOn?.ToString("MM/dd/yyyy")).</text>
                                    }
                                </MudAlert>
                            }

                            <MudCard Elevation="1" Class="mb-3">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Current invoice · @_premiumSummary.CurrentInvoice.InvoiceNumber</MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudChip T="string" Size="Size.Small">@_premiumSummary.CurrentInvoice.Status</MudChip>
                                        @if (_premiumSummary.CurrentInvoice.IsAptcSubsidized)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">APTC</MudChip>
                                        }
                                        @if (_premiumSummary.AutopayEnabled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Autopay</MudChip>
                                        }
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="6" md="3">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">PERIOD</MudText>
                                            <MudText Typo="Typo.body2">@_premiumSummary.CurrentInvoice.BillingPeriodStart.ToString("MM/dd/yyyy") – @_premiumSummary.CurrentInvoice.BillingPeriodEnd.ToString("MM/dd/yyyy")</MudText>
                                        </MudItem>
                                        <MudItem xs="6" md="3">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">DUE DATE</MudText>
                                            <MudText Typo="Typo.body2">@_premiumSummary.CurrentInvoice.DueDate.ToString("MM/dd/yyyy")</MudText>
                                        </MudItem>
                                        <MudItem xs="6" md="3">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">NEXT BILL</MudText>
                                            <MudText Typo="Typo.body2">@(_premiumSummary.NextBillDate?.ToString("MM/dd/yyyy") ?? "–")</MudText>
                                        </MudItem>
                                        <MudItem xs="6" md="3">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">BALANCE DUE</MudText>
                                            <MudText Typo="Typo.h6" Color="@(_premiumSummary.CurrentInvoice.BalanceDue > 0 ? Color.Warning : Color.Success)">
                                                @_premiumSummary.CurrentInvoice.BalanceDue.ToString("C")
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>

                            <MudExpansionPanels Elevation="0">
                                <MudExpansionPanel Text="Last 12 invoices">
                                    <MudTable Items="_premiumSummary.Last12" Dense="true" Hover="true">
                                        <HeaderContent>
                                            <MudTh>Invoice</MudTh><MudTh>Period</MudTh><MudTh>Due</MudTh>
                                            <MudTh>Status</MudTh><MudTh Style="text-align:right">Total</MudTh>
                                            <MudTh Style="text-align:right">Paid</MudTh><MudTh Style="text-align:right">Balance</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd Style="font-family:monospace">@context.InvoiceNumber</MudTd>
                                            <MudTd>@context.BillingPeriodStart.ToString("MM/yyyy")</MudTd>
                                            <MudTd>@context.DueDate.ToString("MM/dd/yyyy")</MudTd>
                                            <MudTd>@context.Status</MudTd>
                                            <MudTd Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
                                            <MudTd Style="text-align:right">@context.TotalPaid.ToString("C")</MudTd>
                                            <MudTd Style="text-align:right">@context.BalanceDue.ToString("C")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No premium invoices for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Failed to load member details. Please try again.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string MemberId { get; set; } = string.Empty;

    private MemberDetails? _member;
    private List<Coverage> _coverages = new();
    private MemberPcp? _pcp;
    private List<PcpAssignmentHistoryItem> _pcpHistory = new();
    private bool _loadingPcpHistory;
    private List<CoverageHistoryEvent> _coverageHistory = new();
    private List<Enrollment834Record> _transactions834 = new();
    private List<MemberDocumentSummary> _memberDocuments = new();
    private List<IdCardHistoryView> _idCards = new();
    private bool _loadingIdCards;
    private List<CloudHealthOffice.Portal.Services.EnrollmentEvent> _enrollmentEvents = new();
    private string? _eventsContinuationToken;
    private string _eventTypeFilter = string.Empty;
    private DateTime? _eventFromFilter;
    private DateTime? _eventToFilter;
    private MemberAccumulators? _accumulators;
    private MemberBenefitView? _benefitView;
    private string? _selectedBenefitPlanId;
    private string? _benefitsError;

    private static readonly string[] EnrollmentEventTypes =
    {
        "Enrolled", "Terminated", "PlanChanged", "AddressChanged", "PcpChanged",
        "SepTriggered", "CobraElected", "CobraTerminated", "RetroAdjusted", "ReinstatementApproved"
    };

    private bool _loading = true;
    private bool _loadingCoverage = true;
    private bool _loadingPcp = false;
    private bool _loadingHistory = false;
    private bool _loading834 = false;
    private bool _loadingEvents = false;
    private bool _loadingAccumulators = false;
    private bool _loadingBenefits = false;
    private bool _loadingFamily = false;
    private bool _loadingDocuments = false;
    private int _activeTab = 0;
    private string _documentCategoryFilter = string.Empty;
    private string? _serviceError;

    // Alerts banner — count is bubbled up so other UI can react (e.g.,
    // disable terminate when LitigationHold is active). Counted, not enumerated,
    // because the banner owns the alert content rendering.
    private int _activeAlertCount;

    // Notes tab state
    private static readonly string[] NoteCategories =
    {
        "CustomerService", "CareManagement", "Appeals", "Billing", "Clinical"
    };
    private List<MemberNoteView> _notes = new();
    private string? _notesContinuationToken;
    private string _noteCategoryFilter = string.Empty;
    private bool _loadingNotes;
    private bool _notesLoadedOnce;
    private bool _showNoteEntry;
    private bool _savingNote;
    private string _newNoteCategory = "CustomerService";
    private string _newNoteSubject = string.Empty;
    private string _newNoteBody = string.Empty;

    // Member-linkage tabs (Claims / AR / Premium) — lazy loaded on first
    // activation, cached for the lifetime of the dialog. "LoadedOnce" flags
    // prevent redundant fetches when the user clicks between tabs. An
    // explicit error flag per tab lets the UI distinguish "service failed"
    // from "no data" — otherwise both render the same empty-state alert.
    private EobSearchResponse? _memberClaimsSummary;
    private MemberArSummary? _arSummary;
    private MemberPremiumSummary? _premiumSummary;
    private bool _loadingClaims, _loadingAr, _loadingPremium;
    private bool _claimsLoadedOnce, _arLoadedOnce, _premiumLoadedOnce;
    private string? _claimsError, _arError, _premiumError;

    // Coverage tab Sponsor sub-section — one fetch per distinct group number
    // on first panel expansion. _loadingSponsor is a set of in-flight keys.
    private readonly Dictionary<string, SponsorMemberView?> _sponsorByGroup = new();
    private readonly HashSet<string> _loadingSponsor = new();
    private readonly HashSet<string> _sponsorLoadedOnce = new();

    private List<FamilyRelationshipRow> _subscriberRows = new();
    private List<FamilyRelationshipRow> _dependentRows = new();
    private List<FamilyRelationshipRow> _otherRows = new();

    // Codes whose inverse is "G8" (Parent / Other) — these are the true
    // directional dependent→subscriber edges. Self-inverse codes like "01"
    // (Spouse), "53" (Life Partner), "22" (Handicapped Dep.), "29" (Significant
    // Other) are symmetric and don't identify a subscriber; they land in "Other".
    private static readonly HashSet<string> DependentToSubscriberCodes = new() { "19", "17", "10" };

    private MudTabPanel? _pcpTab;
    private MudTable<Enrollment834Record>? _834Table;

    protected override async Task OnInitializedAsync()
    {
        await LoadMemberData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Lazy load tab data when tab is activated
    }

    private async Task LoadMemberData()
    {
        _loading = true;
        _loadingCoverage = true;

        try
        {
            var memberTask = MemberService.GetMemberByIdAsync(MemberId);
            var coverageTask = CoverageService.GetCoverageByMemberIdAsync(MemberId);
            await Task.WhenAll(memberTask, coverageTask);
            _member = await memberTask;
            _coverages = await coverageTask;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _member = null;
            _coverages = new();
        }
        catch (Exception ex)
        {
            _member = null;
            _coverages = new();
        }
        finally
        {
            _loading = false;
            _loadingCoverage = false;
            StateHasChanged();
        }

        // Kick off secondary data loads in background
        _ = LoadAccumulatorsAsync();
        _ = LoadPcpAsync();
        _ = LoadHistoryAsync();
        _ = Load834Async();
        _ = LoadEnrollmentEventsAsync(reset: true);
        _ = LoadBenefitsForActiveCoverageAsync();
        _ = LoadFamilyAsync();
        _ = LoadDocumentsAsync();
        _ = LoadIdCardsAsync();
    }

    private async Task LoadIdCardsAsync()
    {
        _loadingIdCards = true;
        try
        {
            _idCards = await IdCardService.ListForMemberAsync(MemberId);
        }
        catch (Exception)
        {
            _idCards = new();
        }
        finally
        {
            _loadingIdCards = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenIdCardOrderDialogAsync()
    {
        var parameters = new DialogParameters { ["MemberId"] = MemberId };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<IdCardOrderDialog>("Order ID Card", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadIdCardsAsync();
        }
    }

    private async Task RevokeIdCardAsync(IdCardHistoryView card)
    {
        var confirmed = await DialogService.ShowMessageBox(
            title: "Revoke ID Card",
            message: $"Revoke card {card.CardId}? This cannot be undone.",
            yesText: "Revoke",
            cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            await IdCardService.RevokeAsync(card.CardId, "Replaced");
            Snackbar.Add("Card revoked", Severity.Success);
            await LoadIdCardsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Revoke failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadEnrollmentEventsAsync(bool reset)
    {
        _loadingEvents = true;
        if (reset)
        {
            _enrollmentEvents = new();
            _eventsContinuationToken = null;
        }
        await InvokeAsync(StateHasChanged);

        try
        {
            var page = await MemberService.GetEnrollmentEventsAsync(
                MemberId,
                new EnrollmentEventFilter(
                    Type: string.IsNullOrWhiteSpace(_eventTypeFilter) ? null : _eventTypeFilter,
                    // MudDatePicker hands back midnight with DateTimeKind.Unspecified —
                    // ToUniversalTime() on that would silently shift the intended date
                    // by the local offset. Instead, treat the picker date as a calendar
                    // day and extend the window to inclusive end-of-day on the To side
                    // so events later the same day aren't excluded.
                    From: NormalizeFilterFromUtc(_eventFromFilter),
                    To: NormalizeFilterToUtc(_eventToFilter),
                    Limit: 50,
                    ContinuationToken: reset ? null : _eventsContinuationToken));

            _enrollmentEvents.AddRange(page.Items);
            _eventsContinuationToken = page.ContinuationToken;
        }
        catch
        {
            if (reset) _enrollmentEvents = new();
        }
        finally
        {
            _loadingEvents = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task LoadMoreEventsAsync() => LoadEnrollmentEventsAsync(reset: false);

    private static DateTime? NormalizeFilterFromUtc(DateTime? picked) =>
        picked.HasValue
            ? DateTime.SpecifyKind(picked.Value.Date, DateTimeKind.Utc)
            : null;

    private static DateTime? NormalizeFilterToUtc(DateTime? picked) =>
        picked.HasValue
            ? DateTime.SpecifyKind(picked.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc)
            : null;

