@using CloudHealthOffice.Portal.Services
@using CloudHealthOffice.Portal.Formatters
@inject IMemberService MemberService
@inject ICoverageService CoverageService
@inject IBenefitPlanService BenefitPlanService
@inject IFamilyRelationshipService FamilyRelationshipService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog Style="min-width: 800px; max-width: 1100px;">
    <DialogContent>
        @if (_serviceError != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
        }

        @if (_loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_member != null)
        {
            <div class="d-flex align-center gap-3 mb-4 pa-2" style="border: 1px solid rgba(0,255,255,0.2); border-radius: 8px; background: rgba(0,255,255,0.03);">
                <MudAvatar Size="Size.Large" Color="Color.Primary">
                    @(_member.FirstName[0])@(_member.LastName[0])
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">@_member.FirstName @_member.LastName</MudText>
                    <div class="d-flex align-center gap-2 mt-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">@_member.MemberId</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetCoverageStatusColor(_member.CoverageStatus)">@_member.CoverageStatus</MudChip>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">DOB: @_member.DateOfBirth.ToString("MM/dd/yyyy")</MudText>
                    </div>
                </div>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           OnClick="@(() => Navigation.NavigateTo($"/claims?memberId={_member.MemberId}"))">
                    View Claims
                </MudButton>
            </div>

            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4"
                     @bind-ActivePanelIndex="_activeTab">
                <!-- Personal Information Tab -->
                <MudTabPanel Text="Personal Info" Icon="@Icons.Material.Filled.Person">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member ID" Value="_member.MemberId" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Coverage Status" Value="_member.CoverageStatus" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="First Name" Value="_member.FirstName" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Last Name" Value="_member.LastName" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Date of Birth" Value="@_member.DateOfBirth.ToString("MM/dd/yyyy")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Gender" Value="_member.Gender" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Age" Value="@($"{DateTime.Today.Year - _member.DateOfBirth.Year} years")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Email" Value="_member.Email" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Phone" Value="_member.Phone" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        @if (_member.Address != null)
                        {
                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Mailing Address</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField Label="Street" Value="_member.Address" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField Label="City" Value="_member.City" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField Label="State" Value="_member.State" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Label="ZIP Code" Value="_member.ZipCode" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <!-- Accumulators Tab -->
                <MudTabPanel Text="Accumulators" Icon="@Icons.Material.Filled.BarChart">
                    <div>
                        @if (_loadingAccumulators)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_accumulators != null)
                        {
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />
                                Plan Year Accumulators
                            </MudText>

                            <MudGrid Class="mb-4">
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Individual Deductible</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.IndividualDeductibleUsed.ToString("C") of @_accumulators.IndividualDeductibleLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit)"
                                                           Color="@GetAccumColor(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.IndividualDeductibleUsed, _accumulators.IndividualDeductibleLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Family Deductible</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.FamilyDeductibleUsed.ToString("C") of @_accumulators.FamilyDeductibleLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit)"
                                                           Color="@GetAccumColor(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.FamilyDeductibleUsed, _accumulators.FamilyDeductibleLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Individual Out-of-Pocket Max</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.IndividualOopUsed.ToString("C") of @_accumulators.IndividualOopLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit)"
                                                           Color="@GetAccumColor(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.IndividualOopUsed, _accumulators.IndividualOopLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                        <div class="d-flex justify-space-between mb-1">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Family Out-of-Pocket Max</MudText>
                                            <MudText Typo="Typo.body2">@_accumulators.FamilyOopUsed.ToString("C") of @_accumulators.FamilyOopLimit.ToString("C")</MudText>
                                        </div>
                                        <MudProgressLinear Value="@GetPercent(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit)"
                                                           Color="@GetAccumColor(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit)"
                                                           Rounded="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@GetPercent(_accumulators.FamilyOopUsed, _accumulators.FamilyOopLimit).ToString("F1")% met</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            @if (_accumulators.ServiceAccumulators.Any())
                            {
                                <MudText Typo="Typo.subtitle1" Class="mb-3 mt-4" Style="font-weight: 600;">
                                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
                                    Service-Specific Accumulators
                                </MudText>
                                <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="mb-4">
                                    <thead>
                                        <tr>
                                            <th>Service Type</th>
                                            <th>Used</th>
                                            <th>Limit</th>
                                            <th>Remaining</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var svc in _accumulators.ServiceAccumulators)
                                        {
                                            <tr>
                                                <td>@svc.BenefitCategory</td>
                                                <td>@svc.Used @svc.Unit</td>
                                                <td>@svc.Limit @svc.Unit</td>
                                                <td>@(svc.Limit - svc.Used) @svc.Unit</td>
                                                <td style="min-width: 150px;">
                                                    <MudProgressLinear Value="@GetPercent(svc.Used, svc.Limit)"
                                                                       Color="@GetAccumColor(svc.Used, svc.Limit)"
                                                                       Rounded="true" Size="Size.Small" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }

                            @if (_accumulators.RecentActivity.Any())
                            {
                                <MudText Typo="Typo.subtitle1" Class="mb-3 mt-4" Style="font-weight: 600;">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1" />
                                    Recent Accumulator Activity
                                </MudText>
                                <MudSimpleTable Dense="true" Hover="true" Elevation="1">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Event</th>
                                            <th>Source</th>
                                            <th style="text-align: right;">Deductible Δ</th>
                                            <th style="text-align: right;">OOP Δ</th>
                                            <th>Actor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var act in _accumulators.RecentActivity)
                                        {
                                            <tr>
                                                <td>@act.OccurredAt.ToString("MM/dd/yyyy")</td>
                                                <td>@act.EventType</td>
                                                <td>
                                                    @if (act.EventType == "ClaimApplied" && !string.IsNullOrEmpty(act.SourceReference))
                                                    {
                                                        <MudLink Href="@($"/claims/{act.SourceReference}")" Typo="Typo.body2" Style="font-family: monospace;">@act.SourceReference</MudLink>
                                                    }
                                                    else
                                                    {
                                                        <span style="font-family: monospace;">@act.SourceReference</span>
                                                    }
                                                </td>
                                                <td style="text-align: right;">@act.DeductibleDelta.ToString("C")</td>
                                                <td style="text-align: right;">@act.OopDelta.ToString("C")</td>
                                                <td>@act.ActorId</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No accumulator data available for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Coverage Tab -->
                <MudTabPanel Text="Coverage" Icon="@Icons.Material.Filled.HealthAndSafety">
                    <div>
                        @if (_loadingCoverage)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_coverages.Any())
                        {
                            @foreach (var coverage in _coverages)
                            {
                                <MudCard Class="mb-3" Elevation="1" Style="border: 1px solid rgba(0,255,255,0.15);">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Small" />
                                                <MudText Typo="Typo.h6">@coverage.PlanName</MudText>
                                            </div>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <div class="d-flex align-center gap-2">
                                                <MudChip T="string" Size="Size.Small" Color="@GetCoverageStatusColor(coverage.StatusText)">
                                                    @coverage.StatusText
                                                </MudChip>
                                                @if (coverage.StatusText == "Active")
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Error"
                                                               StartIcon="@Icons.Material.Filled.PersonOff"
                                                               OnClick="@(() => OpenTerminateDialog(coverage))">
                                                        Terminate
                                                    </MudButton>
                                                }
                                            </div>
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudGrid>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">COVERAGE ID</MudText>
                                                <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.8);">@coverage.CoverageId</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">GROUP NUMBER</MudText>
                                                <MudText Typo="Typo.body2">@coverage.GroupNumber</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">STATUS</MudText>
                                                <MudText Typo="Typo.body2">@coverage.StatusText</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">EFFECTIVE DATE</MudText>
                                                <MudText Typo="Typo.body2">@coverage.EffectiveDate.ToString("MM/dd/yyyy")</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">TERMINATION DATE</MudText>
                                                <MudText Typo="Typo.body2">@(coverage.TerminationDate?.ToString("MM/dd/yyyy") ?? "Active")</MudText>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">DURATION</MudText>
                                                <MudText Typo="Typo.body2">
                                                    @{
                                                        var end = coverage.TerminationDate ?? DateTime.Today;
                                                        var months = (int)((end - coverage.EffectiveDate).TotalDays / 30);
                                                    }
                                                    @months month@(months != 1 ? "s" : "")
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No coverage information available for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Benefits Tab -->
                <MudTabPanel Text="Benefits" Icon="@Icons.Material.Filled.MedicalInformation">
                    <div>
                        @{
                            var eligibleCoverages = _coverages
                                .Where(c => !string.IsNullOrEmpty(c.PlanId)
                                            && c.StatusText == "Active"
                                            && c.EffectiveDate <= DateTime.Today
                                            && (c.TerminationDate == null || c.TerminationDate >= DateTime.Today))
                                .ToList();
                        }

                        @if (_loadingCoverage)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (!eligibleCoverages.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                No active coverage as of @DateTime.Today.ToString("MM/dd/yyyy") — benefits cannot be resolved.
                            </MudAlert>
                        }
                        else
                        {
                            @if (eligibleCoverages.Count > 1)
                            {
                                <MudSelect T="string" Label="Coverage"
                                           Value="_selectedBenefitPlanId"
                                           ValueChanged="OnCoverageSelectionChanged"
                                           Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                    @foreach (var cov in eligibleCoverages)
                                    {
                                        <MudSelectItem T="string" Value="@cov.PlanId">
                                            @cov.PlanName (@cov.EffectiveDate.ToString("MM/dd/yyyy")
                                            — @(cov.TerminationDate?.ToString("MM/dd/yyyy") ?? "present"))
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (_loadingBenefits)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                            }
                            else if (_benefitView != null)
                            {
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@_benefitView.PlanName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@_benefitView.PlanType</MudChip>
                                    @if (!string.IsNullOrEmpty(_benefitView.MetalLevel))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@_benefitView.MetalLevel</MudChip>
                                    }
                                    <MudSpacer />
                                    <MudTooltip Text="@($"Plan version {_benefitView.PlanVersion}")">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            As of @_benefitView.AsOfDate.ToString("MM/dd/yyyy") · v@_benefitView.PlanVersion
                                        </MudText>
                                    </MudTooltip>
                                </div>

                                @if (_benefitView.Categories.Any())
                                {
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="mb-3">
                                        <thead>
                                            <tr>
                                                <th>Benefit</th>
                                                <th>In-Network</th>
                                                <th>Out-of-Network</th>
                                                <th>Deductible</th>
                                                <th>OOP</th>
                                                <th>Prior Auth</th>
                                                <th>Limits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in _benefitView.Categories)
                                            {
                                                <tr>
                                                    <td>
                                                        <div style="font-weight: 500;">@cat.DisplayName</div>
                                                        @if (cat.Pharmacy != null)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.Pharmacy.TierLabel@(cat.Pharmacy.IsSpecialty ? " (specialty)" : "")</MudText>
                                                        }
                                                        else if (!string.IsNullOrEmpty(cat.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.Description</MudText>
                                                        }
                                                    </td>
                                                    <td>@BenefitCostShareFormatter.Format(cat.InNetwork)</td>
                                                    <td>@(cat.OutOfNetwork != null ? BenefitCostShareFormatter.Format(cat.OutOfNetwork) : "—")</td>
                                                    <td>@(cat.DeductibleApplies ? "Applies" : "Waived")</td>
                                                    <td>@(cat.OopApplies ? "Applies" : "Excluded")</td>
                                                    <td>
                                                        @if (cat.PriorAuthRequired)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Required</MudChip>
                                                        }
                                                        else
                                                        {
                                                            <text>—</text>
                                                        }
                                                    </td>
                                                    <td>@FormatLimits(cat)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info">This plan has no configured benefits.</MudAlert>
                                }

                                @if (_benefitView.Documents.Any())
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2" Style="font-weight: 600;">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                                        Plan Documents
                                    </MudText>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var doc in _benefitView.Documents)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                                       Href="@doc.Location" Target="_blank">
                                                @(string.IsNullOrEmpty(doc.DisplayName) ? doc.DocType : doc.DisplayName)
                                            </MudButton>
                                        }
                                    </div>
                                }
                            }
                            else if (_benefitsError != null)
                            {
                                <MudAlert Severity="Severity.Warning">@_benefitsError</MudAlert>
                            }
                        }
                    </div>
                </MudTabPanel>

                <!-- PCP Tab -->
                <MudTabPanel Text="Primary Care Physician" Icon="@Icons.Material.Filled.MedicalServices"
                             @ref="_pcpTab">
                    <div>
                        @if (_loadingPcp)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_pcp != null)
                        {
                            <MudCard Elevation="2" Style="border: 1px solid rgba(0,255,136,0.3);">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Success" />
                                            <MudText Typo="Typo.h6">@_pcp.ProviderName</MudText>
                                        </div>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(_pcp.NetworkStatus == "In-Network" ? Color.Success : Color.Warning)">
                                            @_pcp.NetworkStatus
                                        </MudChip>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">PROVIDER ID</MudText>
                                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@_pcp.ProviderId</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">NPI</MudText>
                                            <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.8);">@_pcp.NPI</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">SPECIALTY</MudText>
                                            <MudText Typo="Typo.body2">@_pcp.Specialty</MudText>
                                        </MudItem>
                                        @if (!string.IsNullOrEmpty(_pcp.PracticeName))
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">PRACTICE</MudText>
                                                <MudText Typo="Typo.body2">@_pcp.PracticeName</MudText>
                                            </MudItem>
                                        }
                                        @if (!string.IsNullOrEmpty(_pcp.Phone))
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">PHONE</MudText>
                                                <MudText Typo="Typo.body2">@_pcp.Phone</MudText>
                                            </MudItem>
                                        }
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">ASSIGNED DATE</MudText>
                                            <MudText Typo="Typo.body2">@_pcp.AssignedDate.ToString("MM/dd/yyyy")</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.SyncAlt"
                                               OnClick="OpenChangePcpDialog">
                                        Change PCP
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-4">No PCP currently assigned to this member.</MudAlert>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenChangePcpDialog">
                                Assign PCP
                            </MudButton>
                        }
                    </div>
                </MudTabPanel>

                <!-- Enrollment History Tab -->
                <MudTabPanel Text="Enrollment History" Icon="@Icons.Material.Filled.Timeline">
                    <div>
                        @if (_loadingHistory)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_coverageHistory.Any())
                        {
                            <MudTimeline TimelinePosition="TimelinePosition.Start">
                                @foreach (var evt in _coverageHistory.OrderByDescending(e => e.EventDate))
                                {
                                    <MudTimelineItem Color="@GetEventColor(evt.EventType)" Size="Size.Small">
                                        <ItemContent>
                                            <MudCard Elevation="1" Class="mb-1" Style="border: 1px solid rgba(0,255,255,0.1);">
                                                <MudCardContent Class="py-2">
                                                    <div class="d-flex justify-space-between align-center">
                                                        <MudText Typo="Typo.body1" Style="font-weight: 500;">@evt.Description</MudText>
                                                        <MudChip T="string" Size="Size.Small" Color="@GetEventColor(evt.EventType)">@evt.EventType</MudChip>
                                                    </div>
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                        @evt.EventDate.ToString("MMM dd, yyyy") @if (!string.IsNullOrEmpty(evt.ChangedBy)) { <text>— @evt.ChangedBy</text> }
                                                    </MudText>
                                                    @if (!string.IsNullOrEmpty(evt.OldValue) || !string.IsNullOrEmpty(evt.NewValue))
                                                    {
                                                        <div class="mt-1">
                                                            @if (!string.IsNullOrEmpty(evt.OldValue))
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">From: @evt.OldValue</MudText>
                                                            }
                                                            @if (!string.IsNullOrEmpty(evt.NewValue))
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Primary">To: @evt.NewValue</MudText>
                                                            }
                                                        </div>
                                                    }
                                                </MudCardContent>
                                            </MudCard>
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No enrollment history available.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- 834 Transactions Tab -->
                <MudTabPanel Text="834 Transactions" Icon="@Icons.Material.Filled.Receipt">
                    <div>
                        @if (_loading834)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else if (_transactions834.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                EDI 834 enrollment transactions for this member.
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_transactions834.Count(t => t.Status == "Accepted") Accepted</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@_transactions834.Count(t => t.Status == "Rejected") Rejected</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_transactions834.Count(t => t.Status == "Pending") Pending</MudChip>
                            </MudText>
                            <MudTable Items="_transactions834" Dense="true" Hover="true"
                                      T="Enrollment834Record" @ref="_834Table">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Batch ID</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Reason</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Errors</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">
                                        <MudText Typo="Typo.body2">@context.TransactionDate.ToString("MM/dd/yyyy")</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Batch ID">
                                        <MudText Typo="Typo.body2" Style="font-family: monospace; color: rgba(0,255,255,0.7);">@context.BatchId</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudTooltip Text="@context.TransactionSetPurpose">
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(context.MaintenanceTypeCode == "021" ? Color.Success : context.MaintenanceTypeCode == "024" ? Color.Error : Color.Info)">
                                                @(context.MaintenanceTypeCode == "021" ? "Add" : context.MaintenanceTypeCode == "024" ? "Cancel" : "Change")
                                            </MudChip>
                                        </MudTooltip>
                                    </MudTd>
                                    <MudTd DataLabel="Reason">
                                        <MudText Typo="Typo.body2">@context.MaintenanceReasonCode</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(context.Status == "Accepted" ? Color.Success : context.Status == "Rejected" ? Color.Error : Color.Warning)">
                                            @context.Status
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Errors">
                                        @if (context.Errors.Any())
                                        {
                                            <MudTooltip>
                                                <TooltipContent>
                                                    @foreach (var err in context.Errors)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="d-block">@err</MudText>
                                                    }
                                                </TooltipContent>
                                                <ChildContent>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Error">
                                                        @context.Errors.Count error@(context.Errors.Count != 1 ? "s" : "")
                                                    </MudChip>
                                                </ChildContent>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                                        }
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText>No 834 transactions found</MudText>
                                </NoRecordsContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No 834 enrollment transactions found for this member.</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- Family Tab -->
                <MudTabPanel Text="Family" Icon="@Icons.Material.Filled.FamilyRestroom">
                    <div>
                        <div class="d-flex align-center mb-3">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-1" />
                                Family Relationships
                            </MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddDependentDialog">
                                Add Dependent
                            </MudButton>
                        </div>

                        @if (_loadingFamily)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else
                        {
                            @if (_subscriberRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="Subscriber" IsInitiallyExpanded="true">
                                        <FamilyRelationshipTable Rows="_subscriberRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (_dependentRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="@($"Dependents ({_dependentRows.Count})")" IsInitiallyExpanded="true">
                                        <FamilyRelationshipTable Rows="_dependentRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (_otherRows.Any())
                            {
                                <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                    <MudExpansionPanel Text="@($"Other ({_otherRows.Count})")">
                                        <FamilyRelationshipTable Rows="_otherRows" OnEnd="EndRelationshipAsync" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @if (!_subscriberRows.Any() && !_dependentRows.Any() && !_otherRows.Any())
                            {
                                <MudAlert Severity="Severity.Info">No family relationships recorded for this member.</MudAlert>
                            }
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Failed to load member details. Please try again.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string MemberId { get; set; } = string.Empty;

    private MemberDetails? _member;
    private List<Coverage> _coverages = new();
    private MemberPcp? _pcp;
    private List<CoverageHistoryEvent> _coverageHistory = new();
    private List<Enrollment834Record> _transactions834 = new();
    private MemberAccumulators? _accumulators;
    private MemberBenefitView? _benefitView;
    private string? _selectedBenefitPlanId;
    private string? _benefitsError;

    private bool _loading = true;
    private bool _loadingCoverage = true;
    private bool _loadingPcp = false;
    private bool _loadingHistory = false;
    private bool _loading834 = false;
    private bool _loadingAccumulators = false;
    private bool _loadingBenefits = false;
    private bool _loadingFamily = false;
    private int _activeTab = 0;
    private string? _serviceError;

    private List<FamilyRelationshipRow> _subscriberRows = new();
    private List<FamilyRelationshipRow> _dependentRows = new();
    private List<FamilyRelationshipRow> _otherRows = new();

    // X12 INS02 codes meaning "the counterparty is this member's subscriber"
    private static readonly HashSet<string> DependentToSubscriberCodes = new() { "19", "17", "10", "01", "53", "22", "29" };

    private MudTabPanel? _pcpTab;
    private MudTable<Enrollment834Record>? _834Table;

    protected override async Task OnInitializedAsync()
    {
        await LoadMemberData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Lazy load tab data when tab is activated
    }

    private async Task LoadMemberData()
    {
        _loading = true;
        _loadingCoverage = true;

        try
        {
            var memberTask = MemberService.GetMemberByIdAsync(MemberId);
            var coverageTask = CoverageService.GetCoverageByMemberIdAsync(MemberId);
            await Task.WhenAll(memberTask, coverageTask);
            _member = await memberTask;
            _coverages = await coverageTask;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _member = null;
            _coverages = new();
        }
        catch (Exception ex)
        {
            _member = null;
            _coverages = new();
        }
        finally
        {
            _loading = false;
            _loadingCoverage = false;
            StateHasChanged();
        }

        // Kick off secondary data loads in background
        _ = LoadAccumulatorsAsync();
        _ = LoadPcpAsync();
        _ = LoadHistoryAsync();
        _ = Load834Async();
        _ = LoadBenefitsForActiveCoverageAsync();
        _ = LoadFamilyAsync();
    }

    private async Task LoadFamilyAsync()
    {
        _loadingFamily = true;
        try
        {
            var rows = await FamilyRelationshipService.ListForMemberAsync(MemberId);

            // Bucket rows into subscriber / dependents / other based on INS02 direction.
            // Each row is already subject-perspective (SubjectMemberId == this member).
            _subscriberRows = rows.Where(r => DependentToSubscriberCodes.Contains(r.RelationshipCode)).ToList();
            _dependentRows  = rows.Where(r => r.RelationshipCode == "G8").ToList();
            _otherRows      = rows.Except(_subscriberRows).Except(_dependentRows).ToList();
        }
        catch (ServiceUnavailableException) { ResetFamily(); }
        catch { ResetFamily(); }
        finally
        {
            _loadingFamily = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetFamily()
    {
        _subscriberRows = new();
        _dependentRows = new();
        _otherRows = new();
    }

    private async Task EndRelationshipAsync(FamilyRelationshipRow row)
    {
        try
        {
            await FamilyRelationshipService.EndRelationshipAsync(MemberId, row.Id);
            Snackbar.Add("Relationship ended.", Severity.Success);
            await LoadFamilyAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to end relationship: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddDependentDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(AddDependentDialog.SubscriberMemberId)] = MemberId,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDependentDialog>("Add Dependent", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            Snackbar.Add("Dependent added.", Severity.Success);
            await LoadFamilyAsync();
        }
    }

    private async Task LoadBenefitsForActiveCoverageAsync()
    {
        var eligible = _coverages
            .Where(c => !string.IsNullOrEmpty(c.PlanId)
                        && c.StatusText == "Active"
                        && c.EffectiveDate <= DateTime.Today
                        && (c.TerminationDate == null || c.TerminationDate >= DateTime.Today))
            .ToList();

        if (!eligible.Any())
        {
            return;
        }

        _selectedBenefitPlanId = eligible.First().PlanId;
        await LoadBenefitsAsync();
    }

    private async Task LoadAccumulatorsAsync()
    {
        _loadingAccumulators = true;
        try
        {
            _accumulators = await MemberService.GetAccumulatorsAsync(MemberId);
        }
        catch { _accumulators = null; }
        finally
        {
            _loadingAccumulators = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPcpAsync()
    {
        _loadingPcp = true;
        try
        {
            _pcp = await MemberService.GetMemberPcpAsync(MemberId);
        }
        catch { _pcp = null; }
        finally
        {
            _loadingPcp = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadHistoryAsync()
    {
        _loadingHistory = true;
        try
        {
            _coverageHistory = await MemberService.GetCoverageHistoryAsync(MemberId);
        }
        catch { _coverageHistory = new(); }
        finally
        {
            _loadingHistory = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Load834Async()
    {
        _loading834 = true;
        try
        {
            _transactions834 = await MemberService.GetMember834TransactionsAsync(MemberId);
        }
        catch { _transactions834 = new(); }
        finally
        {
            _loading834 = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenChangePcpDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(AssignPcpDialog.MemberId)] = MemberId,
            [nameof(AssignPcpDialog.CurrentPcp)] = _pcp
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AssignPcpDialog>("Assign PCP", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is MemberPcp newPcp)
        {
            _pcp = newPcp;
            StateHasChanged();
        }
    }

    private async Task OpenTerminateDialog(Coverage coverage)
    {
        var parameters = new DialogParameters
        {
            [nameof(TerminateEnrollmentDialog.MemberId)] = MemberId,
            [nameof(TerminateEnrollmentDialog.MemberName)] = $"{_member?.FirstName} {_member?.LastName}",
            [nameof(TerminateEnrollmentDialog.CoverageId)] = coverage.CoverageId,
            [nameof(TerminateEnrollmentDialog.PlanName)] = coverage.PlanName
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TerminateEnrollmentDialog>("Terminate Enrollment", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            // Reload coverage to reflect termination
            _loadingCoverage = true;
            StateHasChanged();
            try
            {
                _coverages = await CoverageService.GetCoverageByMemberIdAsync(MemberId);
                var memberData = await MemberService.GetMemberByIdAsync(MemberId);
                if (memberData != null) _member = memberData;
            }
            finally
            {
                _loadingCoverage = false;
                StateHasChanged();
            }
        }
    }

    private Color GetCoverageStatusColor(string status) =>
        status.ToLowerInvariant() switch
        {
            "active" => Color.Success,
            "pending" => Color.Warning,
            "inactive" => Color.Error,
            "terminated" => Color.Default,
            _ => Color.Info
        };

    private Color GetEventColor(string eventType) =>
        eventType switch
        {
            "Enrolled" => Color.Success,
            "Reinstated" => Color.Success,
            "PlanChange" => Color.Info,
            "PcpChange" => Color.Primary,
            "Terminated" => Color.Error,
            _ => Color.Default
        };

    private static double GetPercent(decimal used, decimal limit) =>
        limit == 0 ? 0 : Math.Min(100, (double)(used / limit * 100));

    private static double GetPercent(int used, int limit) =>
        limit == 0 ? 0 : Math.Min(100, (double)used / limit * 100);

    private static Color GetAccumColor(decimal used, decimal limit)
    {
        if (limit == 0) return Color.Default;
        var pct = used / limit;
        return pct >= 1m ? Color.Success : pct >= 0.9m ? Color.Warning : Color.Primary;
    }

    private static Color GetAccumColor(int used, int limit)
    {
        if (limit == 0) return Color.Default;
        var pct = (double)used / limit;
        return pct >= 1.0 ? Color.Success : pct >= 0.9 ? Color.Warning : Color.Primary;
    }

    private async Task OnCoverageSelectionChanged(string planId)
    {
        _selectedBenefitPlanId = planId;
        await LoadBenefitsAsync();
    }

    private async Task LoadBenefitsAsync()
    {
        if (string.IsNullOrEmpty(_selectedBenefitPlanId))
        {
            return;
        }

        _loadingBenefits = true;
        _benefitsError = null;
        StateHasChanged();
        try
        {
            _benefitView = await BenefitPlanService.GetMemberViewAsync(_selectedBenefitPlanId, DateTime.Today);
            if (_benefitView == null)
            {
                _benefitsError = $"No plan configuration found for {_selectedBenefitPlanId}.";
            }
        }
        catch (ServiceUnavailableException ex)
        {
            _benefitView = null;
            _benefitsError = ex.Message;
        }
        catch (Exception ex)
        {
            _benefitView = null;
            _benefitsError = $"Failed to load benefits: {ex.Message}";
        }
        finally
        {
            _loadingBenefits = false;
            StateHasChanged();
        }
    }

    private static string FormatLimits(CategorizedBenefit cat)
    {
        var parts = new List<string>();
        if (cat.VisitLimit.HasValue)
        {
            parts.Add($"{cat.VisitLimit} visits" + (string.IsNullOrEmpty(cat.VisitLimitPeriod) ? "" : $"/{cat.VisitLimitPeriod}"));
        }
        if (cat.AnnualMaximum.HasValue)
        {
            parts.Add($"${cat.AnnualMaximum.Value:N0}/yr");
        }
        if (cat.LifetimeMaximum.HasValue)
        {
            parts.Add($"${cat.LifetimeMaximum.Value:N0} lifetime");
        }
        if (!string.IsNullOrEmpty(cat.Limitations))
        {
            parts.Add(cat.Limitations!);
        }
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private void Close() => MudDialog.Close();
}
