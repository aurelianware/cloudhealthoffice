@page "/dashboard"
@using CloudHealthOffice.Portal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ILogger<Dashboard> Logger
@inject IMetricsService MetricsService
@inject IClaimsService ClaimsService
@inject CloudHealthOffice.Portal.Services.IAuthorizationService AuthorizationService
@inject ITenantContextService TenantContextService
@inject IUserContextService UserContextService

<PageTitle>Dashboard - Cloud Health Office</PageTitle>

<PermissionGate>
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">

    @* ── Top Bar: Welcome + Tenant ── *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">
                Welcome back@(_userContext != null ? $", {_userContext.DisplayName}" : tenantContext != null ? $", {tenantContext.TenantName}" : "")
            </MudText>
            @if (_userContext != null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_userContext.PrimaryRoleDisplayName — @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                </MudText>
            }
        </MudStack>
        @if (tenantContext != null)
        {
            <MudChip Color="@GetTierColor(tenantContext.SubscriptionTier)"
                      Size="Size.Small"
                      Variant="Variant.Outlined">
                @tenantContext.SubscriptionTier
                @if (tenantContext.IsDemo)
                {
                    <span>&nbsp;(Demo)</span>
                }
            </MudChip>
        }
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (_metricsError)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
            Connecting to services...
        </MudAlert>
    }

    @if (metrics != null)
    {
        @* ── KPI Row ── *@
        <MudGrid Class="mb-4">
            @* Total Claims *@
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Claims</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                        </MudStack>
                        <MudText Typo="Typo.h4" Class="mt-2">@metrics.TotalClaims.ToString("N0")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                            @if (metrics.ClaimsTrend >= 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Success">+@((metrics.ClaimsTrend * 100).ToString("F1"))%</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Error">@((metrics.ClaimsTrend * 100).ToString("F1"))%</MudText>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Approval Rate *@
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Approval Rate</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="@GetApprovalRateColor()" />
                        </MudStack>
                        <MudText Typo="Typo.h4" Class="mt-2" Color="@GetApprovalRateColor()">
                            @((metrics.ApprovalRate * 100).ToString("F1"))%
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @metrics.ApprovedClaims approved of @metrics.TotalClaims
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Average Processing Time *@
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Avg Processing Time</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Info" />
                        </MudStack>
                        <MudText Typo="Typo.h4" Class="mt-2">@metrics.AvgProcessingTimeMs ms</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            Per claim average
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Total Plan Paid *@
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Plan Paid</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" />
                        </MudStack>
                        <MudText Typo="Typo.h4" Class="mt-2">@metrics.TotalPayerAmount.ToString("C0")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            All-time payer amount
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* ── Claims by Status Chart + Recent Authorizations ── *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="5">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Claims by Status</MudText>
                        <MudChart ChartType="ChartType.Donut"
                                  InputData="@_chartData"
                                  InputLabels="@_chartLabels"
                                  Width="250px"
                                  Height="250px"
                                  ChartOptions="@_chartOptions" />
                        <MudStack Row="true" Justify="Justify.Center" Spacing="4" Class="mt-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Approved (@metrics.ApprovedClaims)</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Denied (@metrics.DeniedClaims)</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Pending (@metrics.PendingClaims)</MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Recent Authorizations</MudText>
                        @if (recentAuthorizations == null)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        }
                        else if (recentAuthorizations.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No recent authorizations</MudText>
                        }
                        else
                        {
                            <MudTable Items="@recentAuthorizations" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Auth ID</MudTh>
                                    <MudTh>Member</MudTh>
                                    <MudTh>Service</MudTh>
                                    <MudTh>Status</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Auth ID">
                                        <MudText Typo="Typo.body2">@context.AuthorizationId</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Member">@context.MemberName</MudTd>
                                    <MudTd DataLabel="Service">@context.ServiceType</MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                            @context.Status
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ── Recent Claims Table ── *@
    <MudCard Elevation="0" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Recent Claims</MudText>
            @if (recentClaims == null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (recentClaims.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No recent claims</MudText>
            }
            else
            {
                <MudTable Items="@recentClaims" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Claim ID</MudTh>
                        <MudTh>Member</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh Style="text-align:right">Amount</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="text-align:right">Processing Time</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Claim ID">
                            <MudLink Href="@($"/claims/{context.ClaimId}")">@context.ClaimId</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Member">@context.MemberName</MudTd>
                        <MudTd DataLabel="Provider">@context.ProviderName</MudTd>
                        <MudTd DataLabel="Amount" Style="text-align:right">@context.TotalChargeAmount.ToString("C")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Processing Time" Style="text-align:right">@context.ProcessingTimeMs ms</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>

    @* ── Quick Actions ── *@
    <MudCard Elevation="0" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Quick Actions</MudText>
            <MudStack Row="true" Spacing="3" Class="mt-2">
                <MudButton Href="/claims/submit"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.NoteAdd">
                    Submit Claim
                </MudButton>
                <MudButton Href="/eligibility"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.VerifiedUser">
                    Check Eligibility
                </MudButton>
                <MudButton Href="/authorizations"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Assignment">
                    Submit Prior Auth
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @* ── Action Items / Alerts ── *@
    @if (_alerts != null)
    {
        <MudCard Elevation="0" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Action Items</MudText>
                <MudStack Spacing="2">
                    @if (_alerts.WorkQueueCount > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" NoIcon="false">
                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                <MudText Typo="Typo.body2"><strong>@_alerts.WorkQueueCount</strong> claims in work queue requiring manual review</MudText>
                                <MudButton Href="/work-queues" Variant="Variant.Text" Color="Color.Warning" Size="Size.Small">View Queue</MudButton>
                            </div>
                        </MudAlert>
                    }
                    @if (_alerts.PendingRfais > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" NoIcon="false">
                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                <MudText Typo="Typo.body2"><strong>@_alerts.PendingRfais</strong> outstanding RFAIs awaiting provider response</MudText>
                                <MudButton Href="/correspondence" Variant="Variant.Text" Color="Color.Info" Size="Size.Small">View RFAIs</MudButton>
                            </div>
                        </MudAlert>
                    }
                    @if (_alerts.AppealsDueThisWeek > 0)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" NoIcon="false">
                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                <MudText Typo="Typo.body2"><strong>@_alerts.AppealsDueThisWeek</strong> appeals due this week — regulatory deadline approaching</MudText>
                                <MudButton Href="/appeals" Variant="Variant.Text" Color="Color.Error" Size="Size.Small">View Appeals</MudButton>
                            </div>
                        </MudAlert>
                    }
                    @if (_alerts.ApproachingFilingLimit > 0)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" NoIcon="false">
                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                <MudText Typo="Typo.body2"><strong>@_alerts.ApproachingFilingLimit</strong> claims approaching 365-day filing limit (&gt;330 days from DOS)</MudText>
                                <MudButton Href="/work-queues" Variant="Variant.Text" Color="Color.Error" Size="Size.Small">Review Claims</MudButton>
                            </div>
                        </MudAlert>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    }

    @* ── EDI Transaction Volume ── *@
    @if (_ediVolume != null)
    {
        <MudCard Elevation="0" Class="mb-4">
            <MudCardContent>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">Today's EDI Volume</MudText>
                    <MudButton Href="/edi-operations" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.ArrowForward">View Details</MudButton>
                </MudStack>
                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Receipt">
                        837 Claims: @_ediVolume.Claims837Received
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Payments">
                        835 ERA: @_ediVolume.Era835Generated
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.VerifiedUser">
                        270/271 Eligibility: @_ediVolume.Eligibility270271
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Gavel">
                        278 Prior Auth: @_ediVolume.PriorAuth278
                    </MudChip>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }

    @* ── System Health ── *@
    <MudCard Elevation="0" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">System Health</MudText>
            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                @foreach (var svc in _systemHealth)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
                                 Color="@(svc.Value ? Color.Success : Color.Error)"
                                 Style="@(svc.Value ? "" : "animation: pulse 1.5s infinite;")" />
                        <MudText Typo="Typo.body2">@svc.Key</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>

</MudContainer>
</PermissionGate>

@code {
    private DashboardMetrics? metrics;
    private List<ClaimSummary>? recentClaims;
    private List<AuthorizationSummary>? recentAuthorizations;
    private TenantContext? tenantContext;
    private UserContext? _userContext;
    private OperationalAlerts? _alerts;
    private EdiVolumeSummary? _ediVolume;
    private bool _loading = true;
    private bool _metricsError;

    private readonly Dictionary<string, bool> _systemHealth = new()
    {
        ["MongoDB"] = true,
        ["Redis"] = true,
        ["Argo Workflows"] = true,
        ["FHIR API"] = true
    };

    private double[] _chartData = Array.Empty<double>();
    private string[] _chartLabels = { "Approved", "Denied", "Pending" };
    private ChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#00ff88", "#ff0055", "#ffaa00" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tenantContext = await TenantContextService.GetCurrentTenantContextAsync();
            _userContext = await UserContextService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load tenant/user context");
        }

        try
        {
            metrics = await MetricsService.GetDashboardMetricsAsync();
            _chartData = new double[] { metrics.ApprovedClaims, metrics.DeniedClaims, metrics.PendingClaims };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load dashboard metrics");
            _metricsError = true;
        }

        try
        {
            recentClaims = await ClaimsService.GetRecentClaimsAsync(10);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load recent claims");
            recentClaims = new();
        }

        try
        {
            // TODO: Add a server-side "recent authorizations" endpoint with limit/sort
            // to avoid fetching the full list just for the dashboard's 5 most recent.
            var allAuths = await AuthorizationService.GetAuthorizationsAsync();
            recentAuthorizations = allAuths.OrderByDescending(a => a.RequestDate).Take(5).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load recent authorizations");
            recentAuthorizations = new();
        }

        _loading = false;

        // Operational awareness — loaded in background after main dashboard renders
        _ = LoadOperationalDataAsync();
    }

    private async Task LoadOperationalDataAsync()
    {
        try
        {
            var alertsTask = MetricsService.GetOperationalAlertsAsync();
            var ediTask = MetricsService.GetTodayEdiVolumeAsync();
            await Task.WhenAll(alertsTask, ediTask);
            _alerts = alertsTask.Result;
            _ediVolume = ediTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load operational data");
        }
        await InvokeAsync(StateHasChanged);
    }

    private Color GetApprovalRateColor()
    {
        if (metrics == null) return Color.Default;
        return metrics.ApprovalRate switch
        {
            > 0.90 => Color.Success,
            > 0.80 => Color.Warning,
            _ => Color.Error
        };
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Denied" => Color.Error,
        "Pending" => Color.Warning,
        "Review Required" => Color.Info,
        _ => Color.Default
    };

    private Color GetTierColor(string tier) => tier?.ToLowerInvariant() switch
    {
        "enterprise" => Color.Primary,
        "professional" => Color.Info,
        "starter" => Color.Success,
        _ => Color.Default
    };
}
