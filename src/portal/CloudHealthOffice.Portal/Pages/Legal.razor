@page "/legal"

<PageTitle>Legal - Cloud Health Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" Class="mb-2" Style="font-weight: 700; background: linear-gradient(135deg, #00ffff, #00ff88); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        📜 Legal & Compliance
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-6" Style="color: rgba(255, 255, 255, 0.7);">
        Our commitment to transparency, security, and compliance.
    </MudText>

    <MudGrid>
        <!-- Terms of Service -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">📄 Terms of Service</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Href="@TermsOfServiceUrl" 
                                       Target="_blank"
                                       Rel="noopener noreferrer" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Comprehensive terms governing the use of Cloud Health Office platform, including acceptable use, 
                        data ownership, and service limitations.
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.5);">
                        Last updated: February 2026
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@TermsOfServiceUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Text" 
                               Color="Color.Primary">
                        Read Full Terms
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Privacy Policy -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">🔒 Privacy Policy</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Href="@PrivacyPolicyUrl" 
                                       Target="_blank"
                                       Rel="noopener noreferrer" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Details on how we collect, use, and protect your data. HIPAA-compliant with PHI encryption, 
                        audit logging, and strict access controls.
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.5);">
                        Last updated: February 2026
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@PrivacyPolicyUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Text" 
                               Color="Color.Primary">
                        Read Privacy Policy
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- SLA -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">⚡ Service Level Agreement</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Href="@SlaUrl" 
                                       Target="_blank"
                                       Rel="noopener noreferrer" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Uptime guarantees, performance commitments, and service credits. 99.9% uptime SLA for Professional 
                        and custom SLAs for Enterprise customers.
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.5);">
                        Effective: February 2026
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@SlaUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Text" 
                               Color="Color.Primary">
                        Read SLA
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Support Terms -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">🤝 Support Terms</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Href="@SupportTermsUrl" 
                                       Target="_blank"
                                       Rel="noopener noreferrer" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Support scope, response times, and escalation procedures. Includes community support, 
                        email support, and priority support options.
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.5);">
                        Last updated: February 2026
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@SupportTermsUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Text" 
                               Color="Color.Primary">
                        Read Support Terms
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Compliance Section -->
    <MudText Typo="Typo.h5" Class="mt-8 mb-4" Style="font-weight: 600;">
        🛡️ Compliance & Security
    </MudText>

    <MudPaper Elevation="3" Class="pa-6" Style="border: 1px solid rgba(0, 255, 255, 0.2);">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-3">HIPAA Compliance</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ PHI encryption at rest and in transit (AES-256, TLS 1.3)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Audit logging for all PHI access
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Business Associate Agreement (BAA) available
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Azure HIPAA-compliant infrastructure
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-3">CMS Interoperability</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ CMS-9115-F Patient Access API (effective Jan 2026)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ CMS-0057-F Prior Authorization (deadline Jan 2027)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ FHIR R4.0.1 compliant
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ US Core IG v3.1.1+ support
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-3">Security Practices</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ CodeQL automated security scanning
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Dependabot vulnerability monitoring (0 known CVEs)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Azure Key Vault for secrets management
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Penetration testing (annual)
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-3">Source-Available (BSL 1.1)</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ BSL 1.1 License
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ No vendor lock-in
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Public GitHub repository
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    ✅ Community-driven development
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Additional Resources -->
    <MudText Typo="Typo.h5" Class="mt-8 mb-4" Style="font-weight: 600;">
        📚 Additional Resources
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Security Policy</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Vulnerability disclosure process, security contact information, and responsible disclosure guidelines.
                    </MudText>
                    <MudButton Href="@SecurityPolicyUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               FullWidth="true">
                        View Security Policy
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Code of Conduct</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Community guidelines for respectful collaboration, reporting violations, and enforcement procedures.
                    </MudText>
                    <MudButton Href="@CodeOfConductUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               FullWidth="true">
                        View Code of Conduct
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Style="height: 100%; border: 1px solid rgba(0, 255, 255, 0.2);">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Governance</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Project governance model, decision-making process, and community leadership structure.
                    </MudText>
                    <MudButton Href="@GovernanceUrl" 
                               Target="_blank"
                               Rel="noopener noreferrer"
                               Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               FullWidth="true">
                        View Governance
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Contact -->
    <MudPaper Class="mt-8 pa-6" Elevation="3" Style="border: 1px solid rgba(0, 255, 255, 0.3); background: rgba(0, 255, 255, 0.05);">
        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
            Questions about our legal terms?
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            Contact our legal team at <strong>legal@cloudhealthoffice.com</strong> for questions about 
            terms, compliance, or Business Associate Agreements.
        </MudText>
        <MudButton Href="mailto:legal@cloudhealthoffice.com" 
                   Variant="Variant.Outlined" 
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Email">
            Contact Legal Team
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private const string GitHubBaseUrl = "https://github.com/aurelianware/cloudhealthoffice/blob/main/";
    private const string TermsOfServiceUrl = GitHubBaseUrl + "infrastructure/azure/marketplace/legal/terms-of-service.md";
    private const string PrivacyPolicyUrl = GitHubBaseUrl + "infrastructure/azure/marketplace/legal/privacy-policy.md";
    private const string SlaUrl = GitHubBaseUrl + "infrastructure/azure/marketplace/legal/sla.md";
    private const string SupportTermsUrl = GitHubBaseUrl + "infrastructure/azure/marketplace/legal/support-terms.md";
    private const string SecurityPolicyUrl = GitHubBaseUrl + "SECURITY.md";
    private const string CodeOfConductUrl = GitHubBaseUrl + "docs/governance/CODE_OF_CONDUCT.md";
    private const string GovernanceUrl = GitHubBaseUrl + "docs/governance/GOVERNANCE.md";
}
