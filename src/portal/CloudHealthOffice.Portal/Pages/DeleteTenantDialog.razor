@using CloudHealthOffice.Portal.Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="mr-2" />
            Delete Tenant
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Are you sure you want to permanently delete <strong>@OrganizationName</strong>?
            This will remove all tenant data including users, claims, members, and configuration.
            This action cannot be undone.
        </MudAlert>

        <MudText Typo="Typo.body2" Class="mb-2">
            Type <strong>@OrganizationName</strong> to confirm:
        </MudText>
        <MudTextField @bind-Value="_confirmText" Label="Organization Name" Immediate="true"
                      Placeholder="@OrganizationName" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="@(!IsConfirmed)">
            Delete Tenant
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string OrganizationName { get; set; } = string.Empty;

    private string _confirmText = string.Empty;

    private bool IsConfirmed => string.Equals(_confirmText?.Trim(), OrganizationName, StringComparison.Ordinal);

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
