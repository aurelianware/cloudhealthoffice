@page "/claims"
@page "/demo/claims"
@using Microsoft.AspNetCore.Authorization
@using CloudHealthOffice.Portal.Services
@attribute [AllowAnonymous]
@inject IClaimsService ClaimsService
@inject NavigationManager NavigationManager

<PageTitle>Claims - Cloud Health Office</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
        Claims Management
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Search, filter, and manage healthcare claims
    </MudText>

    <!-- Search Form -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_claimIdSearch"
                             Label="Claim ID"
                             Placeholder="Exact match"
                             Variant="Variant.Outlined"
                             OnKeyUp="OnSearchKeyUp" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_memberIdSearch"
                             Label="Member ID"
                             Placeholder="Exact match"
                             Variant="Variant.Outlined"
                             OnKeyUp="OnSearchKeyUp" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_providerNameSearch"
                             Label="Provider Name"
                             Placeholder="Contains..."
                             Variant="Variant.Outlined"
                             OnKeyUp="OnSearchKeyUp" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect @bind-Value="_statusFilter"
                          Label="Status"
                          Variant="Variant.Outlined"
                          T="string"
                          AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                    <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
                    <MudSelectItem Value="@("Denied")">Denied</MudSelectItem>
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudGrid Spacing="1">
                    <MudItem xs="7">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  OnClick="SearchClaims"
                                  Disabled="_loading">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                            Search
                        </MudButton>
                    </MudItem>
                    <MudItem xs="5">
                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Default"
                                  FullWidth="true"
                                  OnClick="ClearSearch"
                                  Disabled="_loading">
                            Clear
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        @if (_showValidationMessage)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                Please enter at least one search criterion.
            </MudAlert>
        }
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_hasSearched)
    {
        <!-- Stats Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Claims</MudText>
                        <MudText Typo="Typo.h4">@_filteredClaims.Count</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Approved</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success">@_filteredClaims.Count(c => c.Status == "Approved")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Denied</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@_filteredClaims.Count(c => c.Status == "Denied")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Amount</MudText>
                        <MudText Typo="Typo.h4">@_filteredClaims.Sum(c => c.TotalChargeAmount).ToString("C0")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (_filteredClaims.Any())
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Showing @_filteredClaims.Count claim(s)
            </MudText>

            <!-- Claims Table -->
            <MudPaper Elevation="2">
                <MudTable Items="_filteredClaims"
                         Hover="true"
                         Breakpoint="Breakpoint.Sm"
                         Dense="true"
                         Striped="true"
                         @bind-SelectedItem="_selectedClaim"
                         OnRowClick="@((TableRowClickEventArgs<ClaimSummary> args) => ViewClaimDetails(args.Item.ClaimId))">
                    <HeaderContent>
                        <MudTh>Claim ID</MudTh>
                        <MudTh>Member</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Processing Time</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Claim ID">
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ClaimId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Member">
                            <MudText Typo="Typo.body2">@context.MemberName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Provider">
                            <MudText Typo="Typo.body2">@context.ProviderName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Amount">
                            <MudText Typo="Typo.body2">@context.TotalChargeAmount.ToString("C")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip Size="Size.Small"
                                    Color="@GetStatusColor(context.Status)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Processing Time">
                            <MudText Typo="Typo.body2">@context.ProcessingTimeMs ms</MudText>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                          Color="Color.Primary"
                                          Size="Size.Small"
                                          OnClick="@(() => ViewClaimDetails(context.ClaimId))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-8 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No claims found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Try adjusting your search criteria</MudText>
            </MudPaper>
        }
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">Search for a claim to view details</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Enter a Claim ID or Member ID to begin</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<ClaimSummary> _allClaims = new();
    private List<ClaimSummary> _filteredClaims = new();
    private ClaimSummary? _selectedClaim;
    private bool _loading = false;
    private bool _hasSearched = false;
    private bool _showValidationMessage = false;

    private string _claimIdSearch = string.Empty;
    private string _memberIdSearch = string.Empty;
    private string _providerNameSearch = string.Empty;
    private string _statusFilter = "All";

    private bool HasCriteria =>
        !string.IsNullOrWhiteSpace(_claimIdSearch) ||
        !string.IsNullOrWhiteSpace(_memberIdSearch);

    private async Task SearchClaims()
    {
        if (!HasCriteria)
        {
            _showValidationMessage = true;
            return;
        }

        _showValidationMessage = false;
        _loading = true;
        StateHasChanged();

        try
        {
            _allClaims = await ClaimsService.GetRecentClaimsAsync(100);
            ApplyFilters();
            _hasSearched = true;
        }
        catch
        {
            _allClaims = new();
            _filteredClaims = new();
            _hasSearched = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        _filteredClaims = _allClaims.ToList();

        if (!string.IsNullOrWhiteSpace(_claimIdSearch))
        {
            var id = _claimIdSearch.ToLowerInvariant();
            _filteredClaims = _filteredClaims.Where(c =>
                c.ClaimId.ToLowerInvariant().Contains(id)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(_memberIdSearch))
        {
            var mid = _memberIdSearch.ToLowerInvariant();
            _filteredClaims = _filteredClaims.Where(c =>
                c.MemberName.ToLowerInvariant().Contains(mid)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(_providerNameSearch))
        {
            var prov = _providerNameSearch.ToLowerInvariant();
            _filteredClaims = _filteredClaims.Where(c =>
                c.ProviderName.ToLowerInvariant().Contains(prov)).ToList();
        }

        if (_statusFilter != "All")
        {
            _filteredClaims = _filteredClaims.Where(c => c.Status == _statusFilter).ToList();
        }
    }

    private void ClearSearch()
    {
        _claimIdSearch = string.Empty;
        _memberIdSearch = string.Empty;
        _providerNameSearch = string.Empty;
        _statusFilter = "All";
        _allClaims = new();
        _filteredClaims = new();
        _hasSearched = false;
        _showValidationMessage = false;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchClaims();
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Approved" => Color.Success,
            "Denied" => Color.Error,
            "Pending" => Color.Warning,
            _ => Color.Info
        };
    }

    private void ViewClaimDetails(string claimId)
    {
        NavigationManager.NavigateTo($"/claims/{claimId}");
    }
}
