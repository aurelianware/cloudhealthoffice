@page "/reference-data"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using CloudHealthOffice.Portal.Services
@inject IReferenceDataService ReferenceDataService
@inject IDialogService DialogService

<PageTitle>Reference Data - Cloud Health Office</PageTitle>

@* Code lookups in reference-data-service (api/reference-data/codes). One code
   system at a time, paged on the server. Licensed sets (CPT, CDT) show only
   what the tenant has loaded. *@

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />
        Reference Data & Code Sets
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Look up diagnosis, procedure, revenue, remittance and other codes loaded for this tenant
    </MudText>

    @if (_serviceError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect @bind-Value="_codeSystem" Label="Code system" Variant="Variant.Outlined" T="string" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var (name, label) in ReferenceCodeSystems.All)
                    {
                        <MudSelectItem Value="@name">@label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect @bind-Value="_mode" Label="Match" Variant="Variant.Outlined" T="ReferenceSearchMode" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="ReferenceSearchMode.Prefix">Code starts with</MudSelectItem>
                    <MudSelectItem Value="ReferenceSearchMode.Exact">Exact code</MudSelectItem>
                    <MudSelectItem Value="ReferenceSearchMode.Text">Description contains</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_searchTerm" Label="Search" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyUp="@(async e => { if (e.Key == "Enter") await SearchAsync(1); })" />
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_activeOnly" Label="Active" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SearchAsync(1))" Disabled="_loading" FullWidth="true">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" />
                    Search
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_page != null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @_page.Total.ToString("N0") @(_page.Total == 1 ? "code" : "codes") in @_searchedSystem
        </MudText>
    }

    <MudTable Items="@(_page?.Items ?? new())" Hover="true" Striped="true" Dense="true" Elevation="2" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Effective</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Source</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code">
                <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: bold;">@context.Code</MudText>
            </MudTd>
            <MudTd DataLabel="Description">@context.Text</MudTd>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Effective">
                @context.EffectiveFrom.ToString("MM/dd/yyyy")@(context.EffectiveTo is { } to ? $" to {to:MM/dd/yyyy}" : "")
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Active ? Color.Success : Color.Default)">@(context.Active ? "Active" : "Inactive")</MudChip>
            </MudTd>
            <MudTd DataLabel="Source">
                <MudText Typo="Typo.caption">@context.SourceId @context.SourceVersion</MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Primary" Title="Details"
                               OnClick="@(() => OpenDetailsDialog(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8">
                @(_page == null ? "Choose a code system and search." : "No codes match. Check the code system, or the set may not be loaded for this tenant.")
            </MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_page is { Total: > 0 } && TotalPages > 1)
    {
        <div class="d-flex justify-center mt-4">
            <MudPagination Count="TotalPages" Selected="_page.PageNumber" SelectedChanged="@(p => SearchAsync(p))" Color="Color.Primary" />
        </div>
    }
</MudContainer>

@code {
    private const int PageSize = 50;

    private string _codeSystem = "ICD-10-CM";
    private ReferenceSearchMode _mode = ReferenceSearchMode.Prefix;
    private string? _searchTerm;
    private bool _activeOnly = true;
    private bool _loading;
    private string? _serviceError;
    private ReferenceCodePage? _page;
    private string _searchedSystem = string.Empty;

    private int TotalPages => _page is null ? 0 : (int)Math.Ceiling(_page.Total / (double)PageSize);

    private async Task SearchAsync(int page)
    {
        _loading = true;
        try
        {
            _page = await ReferenceDataService.SearchCodesAsync(_codeSystem, _searchTerm, _mode, _activeOnly ? true : null, page, PageSize);
            _searchedSystem = _codeSystem;
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = $"Reference data service is currently unavailable: {ex.Message}";
        }
        catch (Exception ex)
        {
            _serviceError = $"An error occurred searching codes: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDetailsDialog(ReferenceCodeRecord code)
    {
        var parameters = new DialogParameters<CodeDetailsDialog>
        {
            { x => x.CodeSystem, code.CodeSystem },
            { x => x.Code, code.Code },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<CodeDetailsDialog>($"{code.CodeSystem} {code.Code}", parameters, options);
    }
}
