@page "/members/{MemberId}"
@page "/members/{MemberId}/{Tab}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Member @MemberId - Cloud Health Office</PageTitle>

<PermissionGate Permission="members:read" RoleName="MemberServices">
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />
    @* Keyed on the member, so following a family link to another member
       starts that member fresh instead of reusing this one's state. *@
    <MemberRecordView @key="MemberId" MemberId="@MemberId" Tab="@Tab" BaseHref="@BaseHref" />
</MudContainer>
</PermissionGate>

@code {
    [Parameter] public string MemberId { get; set; } = string.Empty;
    [Parameter] public string? Tab { get; set; }

    private string BaseHref => $"/members/{Uri.EscapeDataString(MemberId)}";

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnParametersSet() =>
        _breadcrumbs =
        [
            new("Home", href: "/"),
            new("Members", href: "/members"),
            new($"Member {MemberId}", href: null, disabled: true),
        ];
}
