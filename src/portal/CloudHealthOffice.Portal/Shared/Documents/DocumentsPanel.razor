@using Microsoft.AspNetCore.Components.Forms
@using CloudHealthOffice.Portal.Infrastructure
@using CloudHealthOffice.Portal.Services
@inject IDocumentCatalogService DocumentCatalog

<div data-testid="documents-panel">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading"
                   data-testid="documents-refresh">
            Refresh
        </MudButton>
    </MudStack>

    <PermissionGate Permission="documents:write">
        <div class="mb-3">
            <MudTextField @bind-Value="_uploadTitle" Label="Document title" MaxLength="200" />
            <MudSelect T="string" @bind-Value="_uploadType" Label="Document type">
                <MudSelectItem T="string" Value='@("Other")'>Other</MudSelectItem>
                <MudSelectItem T="string" Value='@("Correspondence")'>Correspondence</MudSelectItem>
                <MudSelectItem T="string" Value='@("ClinicalRecord")'>Clinical record</MudSelectItem>
                <MudSelectItem T="string" Value='@("CallTranscript")'>Call transcript</MudSelectItem>
            </MudSelect>
            <label>Upload document (up to 64 MiB; available after scanning)</label>
            <InputFile OnChange="UploadAsync" disabled="@_uploading" data-testid="document-upload" />
            @if (_uploading) { <MudProgressLinear Indeterminate="true" /> }
            @if (_uploadMessage is not null) { <MudAlert Severity="Severity.Info">@_uploadMessage</MudAlert> }
        </div>
    </PermissionGate>
    @if (_preview is not null)
    {
        <MudButton OnClick="@(() => _preview = null)">Close preview</MudButton>
        <iframe src="@PreviewPath(_preview)" title="Document preview" sandbox="" referrerpolicy="no-referrer"
                style="width:100%;height:600px;border:0" data-testid="document-preview"></iframe>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_unavailable)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="documents-unavailable">
            Documents are unavailable right now. Nothing here means the catalog could not be reached, not that
            there is nothing on file.
        </MudAlert>
    }
    else if (_listing.Forbidden)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="documents-forbidden">
            You do not have access to this record's documents.
        </MudAlert>
    }
    else
    {
        @if (_listing.Documents.Count == 0)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" data-testid="documents-empty">
                No documents on file.
            </MudAlert>
        }
        else
        {
            <MudTable Items="_listing.Documents" Dense="true" Hover="true" T="CatalogDocumentSummary"
                      data-testid="documents-table">
                <HeaderContent>
                    <MudTh>Received</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh Style="text-align: right;">Size</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Also linked to</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Received">
                        <MudText Typo="Typo.body2">@context.ReceivedAt.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</MudText>
                        @if (context.DocumentVersion > 1)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">version @context.DocumentVersion</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Type</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Title) ? "-" : context.Title)</MudText>
                        @if (context.Sensitivity.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@string.Join(", ", context.Sensitivity)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Source">
                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Source.Channel) ? "-" : context.Source.Channel)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Size" Style="text-align: right;">
                        <MudText Typo="Typo.body2">@FormatBytes(context.SizeBytes)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.UploadPending)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Upload pending</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="@ScanColor(context.ScanStatus)">@context.ScanStatus</MudChip>
                        }
                        @if (context.LegalHold)
                        {
                            <MudTooltip Text="On legal hold">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Also linked to">
                        <MudText Typo="Typo.body2">@AlsoLinkedTo(context)</MudText>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        @if (context.CanOpen)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       Href="@DocumentDownloadEndpoint.PathFor(context.Id, SubjectKind, SubjectId)"
                                       Target="_blank"
                                       data-testid="@OpenTestId(context)">
                                Open
                            </MudButton>
                                @if (CanPreview(context))
                                {
                                    <MudButton Size="Size.Small" OnClick="@(() => _preview = context)">Preview</MudButton>
                                }

                            @if (IsClinicalDocument(context.ContentType))
                            {
                                @* A C-CDA opens as a file like anything else;
                                   this is the reviewer's shortcut to what is
                                   inside it without leaving the record. *@
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.MedicalInformation"
                                           OnClick="@(() => ShowSummaryAsync(context))"
                                           data-testid="@("document-summary-" + context.Id)">
                                    Clinical summary
                                </MudButton>
                            }
                        }
                        else
                        {
                            @* The reason is visible rather than in a tooltip:
                               somebody scanning a table for the record they
                               need should not have to hover to learn that the
                               file is quarantined. *@
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Not available</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@UnopenableReason(context)</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_summaryFor is not null)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true" data-testid="clinical-summary">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">@SummaryHeading()</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CloseSummary"
                               data-testid="clinical-summary-close">Close</MudButton>
                </MudStack>

                @if (_summaryLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-3" />
                }
                else if (_summaryUnavailable)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                              data-testid="clinical-summary-unavailable">
                        The document service could not be reached, so nothing here says anything about this document.
                    </MudAlert>
                }
                else if (_summary!.Forbidden)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
                              data-testid="clinical-summary-forbidden">
                        You do not have access to this document's contents.
                    </MudAlert>
                }
                else if (!string.IsNullOrWhiteSpace(_summary.Refusal))
                {
                    @* The sender's problem, and a reviewer has to be able to
                       tell them what to send again. *@
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                              data-testid="clinical-summary-refused">
                        CHO could not read this document: @_summary.Refusal
                    </MudAlert>
                }
                else
                {
                    @if (!_summary.MemberLinked)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                                  data-testid="clinical-summary-unlinked">
                            This document is not filed against a member, so its entries are counted but not listed.
                            The sections below are still the sender's own.
                        </MudAlert>
                    }

                    @if (_summary.Sections.Count == 0)
                    {
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true"
                                  data-testid="clinical-summary-empty">
                            The document holds no sections CHO recognises.
                        </MudAlert>
                    }

                    @foreach (var section in _summary.Sections)
                    {
                        <div class="mb-4" data-testid="@("clinical-section-" + section.Kind)">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.subtitle2">@SectionHeading(section)</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@EntryCount(section)</MudChip>
                                @if (!section.Mapped)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Not read by CHO</MudChip>
                                }
                            </MudStack>

                            @if (section.Items.Count > 0)
                            {
                                <MudSimpleTable Dense="true" Striped="true" Class="mt-2">
                                    <tbody>
                                        @foreach (var item in section.Items)
                                        {
                                            <tr>
                                                <td>@item.Display</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Detail) ? "-" : item.Detail)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else if (section.Mapped && section.EntryCount > 0 && _summary.MemberLinked)
                            {
                                @* The entries were there and carried nothing
                                   codeable. Silence here would read as "the
                                   section was empty", which it was not. *@
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1"
                                         data-testid="@("clinical-section-nothing-coded-" + section.Kind)">
                                    CHO found nothing coded in this section's entries. Read the sender's own text below.
                                </MudText>
                            }

                            @if (NarrativeText(section) is { Length: > 0 } narrative)
                            {
                                <MudExpansionPanels Class="mt-2" Elevation="0">
                                    <MudExpansionPanel Text="What the sender wrote">
                                        @* Rendered as text, never as markup: it
                                           is another organisation's HTML. *@
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@narrative</MudText>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                        </div>
                    }
                }
            </MudPaper>
        }

        @if (_listing.Withheld > 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3"
                      data-testid="documents-withheld">
                @WithheldMessage(_listing.Withheld)
            </MudAlert>
        }
    }
</div>

@code {
    private string _uploadTitle = string.Empty;
    private string _uploadType = "Other";
    private bool _uploading;
    private string? _uploadMessage;
    private CatalogDocumentSummary? _preview;
    private static bool CanPreview(CatalogDocumentSummary d) => d.CanOpen && d.ContentType is "application/pdf" or "image/png" or "image/jpeg";
    private string PreviewPath(CatalogDocumentSummary d) => DocumentDownloadEndpoint.PathFor(d.Id, SubjectKind, SubjectId).Replace("/download?", "/preview?");
    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        _uploading = true;
        try
        {
            if (args.File.Size > 64L * 1024 * 1024) { _uploadMessage = "The document exceeds 64 MiB."; return; }
            await using var content = args.File.OpenReadStream(64L * 1024 * 1024);
            _uploadMessage = await DocumentCatalog.UploadAsync(SubjectKind, SubjectId,
                _uploadTitle, _uploadType, content, args.File.Name, args.File.ContentType)
                ?? "Document filed. It can be opened once its scan is clean.";
            await LoadAsync();
        }
        catch (ServiceUnavailableException) { _uploadMessage = "Document service is unavailable. Refresh before retrying."; }
        catch (IOException) { _uploadMessage = "The file could not be read. Select it again to retry."; }
        finally { _uploading = false; }
    }

    // The one Documents panel (docs/architecture/document-store.md §7), shown
    // on the claim, authorization, appeal and provider records. It asks the
    // catalog for "documents for <subject>" and shows what comes back; it
    // applies no access rule of its own, because the catalog decides, audits
    // and withholds, and a panel that filtered too would only disagree with it.

    /// <summary>The subject whose documents these are.</summary>
    [Parameter, EditorRequired] public DocumentSubjectKind SubjectKind { get; set; }

    [Parameter, EditorRequired] public string SubjectId { get; set; } = string.Empty;

    [Parameter] public string Title { get; set; } = "Documents";

    private DocumentSubjectListing _listing = DocumentSubjectListing.Empty;
    private CatalogDocumentSummary? _summaryFor;
    private ClinicalSummaryView? _summary;
    private bool _summaryLoading;
    private bool _summaryUnavailable;
    private bool _loading = true;
    private bool _unavailable;
    private string? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        // The subject arrives after the parent's own fetch, and can change
        // without the panel being rebuilt, so this reloads on the subject
        // rather than only on first render.
        var key = SubjectKind + ":" + SubjectId;
        if (key == _loadedFor) return;
        _loadedFor = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(SubjectId))
        {
            _listing = DocumentSubjectListing.Empty;
            _loading = false;
            return;
        }

        _loading = true;
        _unavailable = false;
        try
        {
            _listing = await DocumentCatalog.GetForSubjectAsync(SubjectKind, SubjectId);
        }
        catch (ServiceUnavailableException)
        {
            // An unreachable catalog must not read as "no documents" to
            // somebody deciding a claim or an appeal.
            _listing = DocumentSubjectListing.Empty;
            _unavailable = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color ScanColor(DocumentScanStatus status) => status switch
    {
        DocumentScanStatus.Clean => Color.Success,
        DocumentScanStatus.Pending => Color.Default,
        _ => Color.Error,
    };

    /// <summary>Why a row has no Open link, rather than a button that would be refused.</summary>
    private static string UnopenableReason(CatalogDocumentSummary document)
    {
        if (document.UploadPending) return "The upload has not finished.";
        if (document.ScanStatus == DocumentScanStatus.Pending) return "Waiting for the virus scan.";
        if (document.ScanStatus == DocumentScanStatus.Infected) return "Quarantined: the virus scan found something.";
        return "The virus scan could not complete.";
    }

    /// <summary>Counted in words, because a filtered list must not read as "nothing on file".</summary>
    private static string WithheldMessage(int withheld) => withheld == 1
        ? "One more document on this record is withheld from you because of its sensitivity."
        : withheld + " more documents on this record are withheld from you because of their sensitivity.";

    private static string OpenTestId(CatalogDocumentSummary document) => "document-open-" + document.Id;

    /// <summary>
    /// The other subjects this document supports, so an examiner can see that
    /// what is in front of them is also an appeal's evidence. Subjects the
    /// caller may not read are counted by the catalog, never named.
    /// </summary>
    private string AlsoLinkedTo(CatalogDocumentSummary document)
    {
        var others = document.Links
            .Where(l => !(l.Kind == SubjectKind && string.Equals(l.Id, SubjectId, StringComparison.OrdinalIgnoreCase)))
            .Select(l => l.Kind + " " + l.Id)
            .ToList();

        if (document.OtherLinks > 0)
        {
            others.Add(document.OtherLinks + " you cannot see");
        }

        return others.Count == 0 ? "-" : string.Join(", ", others);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.#") + " KB";
        return (bytes / (1024.0 * 1024.0)).ToString("0.#") + " MB";
    }

    // ── The clinical summary of a C-CDA ───────────────────────────────

    /// <summary>
    /// Content types CHO reads clinical structure from. The catalog decides
    /// for itself; this only governs whether the button is worth offering.
    /// </summary>
    private static bool IsClinicalDocument(string? contentType)
    {
        if (string.IsNullOrWhiteSpace(contentType)) return false;
        var separator = contentType.IndexOf(';');
        var bare = (separator >= 0 ? contentType[..separator] : contentType).Trim().ToLowerInvariant();
        return bare is "application/hl7-cda+xml" or "text/xml" or "application/xml";
    }

    private async Task ShowSummaryAsync(CatalogDocumentSummary document)
    {
        _summaryFor = document;
        _summary = null;
        _summaryLoading = true;
        _summaryUnavailable = false;
        try
        {
            _summary = await DocumentCatalog.ClinicalSummaryAsync(document.Id, SubjectKind, SubjectId);
        }
        catch (ServiceUnavailableException)
        {
            _summaryUnavailable = true;
        }
        finally
        {
            _summaryLoading = false;
        }
    }

    private void CloseSummary()
    {
        _summaryFor = null;
        _summary = null;
        _summaryUnavailable = false;
    }

    private string SummaryHeading()
    {
        var title = _summary?.Title;
        if (string.IsNullOrWhiteSpace(title)) title = _summaryFor?.Title;
        return string.IsNullOrWhiteSpace(title) ? "Clinical summary" : "Clinical summary - " + title;
    }

    private static string SectionHeading(ClinicalSummarySectionView section) =>
        string.IsNullOrWhiteSpace(section.Title) ? section.Kind : section.Title!;

    /// <summary>
    /// Counted even where nothing was mapped: a section whose entries CHO
    /// skipped must not look like a section the sender left empty.
    /// </summary>
    private static string EntryCount(ClinicalSummarySectionView section) =>
        section.EntryCount == 1 ? "1 entry" : section.EntryCount + " entries";

    /// <summary>
    /// The sender's narrative as plain text. Their markup is never rendered:
    /// it is another organisation's HTML arriving over an attachment channel.
    /// </summary>
    private static string NarrativeText(ClinicalSummarySectionView section)
    {
        if (string.IsNullOrWhiteSpace(section.NarrativeXml)) return string.Empty;
        try
        {
            var text = System.Xml.Linq.XElement.Parse(section.NarrativeXml).Value;
            return System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        }
        catch (System.Xml.XmlException)
        {
            // Unparseable narrative is the sender's problem, not a reason to
            // hide the rest of the summary.
            return string.Empty;
        }
    }

}
