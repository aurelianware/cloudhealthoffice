@using CloudHealthOffice.Portal.Services

@* NACHA files the service could not send to the bank. They are held
   encrypted for 7 days; only a platform admin can retrieve one (through the
   service, audited), and an approver other than the releaser can retry. *@
@if (Items.Count > 0)
{
    <MudPaper Class="pa-3 mb-4" data-testid="@TestId"
              Style="background: rgba(10,10,10,0.9); border: 1px solid rgba(255,170,0,0.4); border-radius: 12px;">
        <MudText Typo="Typo.subtitle1" Style="color: #ffaa00; font-weight: 600;">NACHA files awaiting retrieval</MudText>
        <MudText Typo="Typo.body2" Class="mb-2" Style="color: rgba(255,255,255,0.6);" data-testid="@($"{TestId}-note")">
            These files did not reach the bank. A platform admin must retrieve the file, or another approver (not the one who
            released it) must retry the transmission. Files are deleted when they expire, and their payments go back to Pending.
        </MudText>
        <MudSimpleTable Dense="true" Style="background: transparent;">
            <thead><tr><th>File</th><th>Entries</th><th>Amount</th><th>Released by</th><th>Expires</th><th>Reason</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Items)
                {
                    <tr data-testid="@($"{TestId}-{f.FileReference}")">
                        <td style="font-family: monospace;">@f.FileReference</td>
                        <td>@f.EntryCount</td>
                        <td>@((f.TotalDebitAmount + f.TotalCreditAmount).ToString("C2"))</td>
                        <td>@f.ReleasedBy</td>
                        <td>@f.ExpiresAt.ToLocalTime().ToString("g")</td>
                        <td>@f.Reason</td>
                        <td>
                            @if (CanRetry(f))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="Busy"
                                           OnClick="@(() => OnRetry.InvokeAsync(f.FileReference))"
                                           data-testid="@($"{TestId}-retry-{f.FileReference}")">Retry</MudButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    [Parameter] public List<NachaHeldFile> Items { get; set; } = new();
    [Parameter] public string TestId { get; set; } = "nacha-awaiting";
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnRetry { get; set; }

    /// <summary>The service refuses the releaser; do not offer it to them.</summary>
    private bool CanRetry(NachaHeldFile f)
        => CanApprove && f.Status == "AwaitingRetrieval"
           && !string.Equals(f.ReleasedBy, UserId, StringComparison.OrdinalIgnoreCase);
}
