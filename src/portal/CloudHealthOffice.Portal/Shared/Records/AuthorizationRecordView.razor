@namespace CloudHealthOffice.Portal.Shared.Records
@using CloudHealthOffice.Portal.Services
@inject CloudHealthOffice.Portal.Services.IAuthorizationService AuthorizationService
@inject IServiceProvider ServiceProvider
@inject ILogger<AuthorizationRecordView> Logger

@* The authorization record (docs/architecture/portal-navigation.md §4):
   status, member and provider in the header, tabs with their own URLs
   (/authorizations/{id}/{tab}). Hosted by the /authorizations/{id} page. *@
<div data-testid="authorization-record">
        @if (_serviceError != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _serviceError = null">@_serviceError</MudAlert>
        }

        @if (_loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_authorization != null)
        {
            <div class="d-flex align-center gap-3 mb-3 pa-2" style="border: 1px solid rgba(0,255,255,0.2); border-radius: 8px; background: rgba(0,255,255,0.03);">
                <MudAvatar Size="Size.Large" Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Gavel" /></MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">Authorization @_authorization.AuthorizationId</MudText>
                    <div class="d-flex align-center gap-3 mt-1 flex-wrap">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_authorization.ServiceType</MudText>
                        @if (!string.IsNullOrWhiteSpace(_authorization.MemberId))
                        {
                            <span>Member <RecordLink Href="@($"/members/{Uri.EscapeDataString(_authorization.MemberId)}")" data-testid="authorization-member">@(string.IsNullOrWhiteSpace(_authorization.MemberName) ? _authorization.MemberId : _authorization.MemberName)</RecordLink></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_authorization.ProviderId))
                        {
                            <span>Provider <RecordLink Href="@ProviderHref(_authorization.ProviderId)" data-testid="authorization-provider">@(string.IsNullOrWhiteSpace(_authorization.ProviderName) ? _authorization.ProviderId : _authorization.ProviderName)</RecordLink></span>
                        }
                    </div>
                </div>
                <OpenInNewTabButton Href="@RecordTabs.Href(BaseHref, ActiveTab)" />
                <PinButton Kind="Authorization" RecordId="@AuthorizationId" Label="@($"Authorization {_authorization.AuthorizationId}")" />
            </div>

            <!-- Status -->
            <MudAlert Severity="@GetSeverity(_authorization.StatusText)" Class="mb-4">
                <MudText Typo="Typo.h6">
                    Status: @_authorization.StatusText
                    @if (_authorization.DecisionDate.HasValue)
                    {
                        <span> • Decision made @_authorization.DecisionDate.Value.ToString("MM/dd/yyyy hh:mm tt")</span>
                    }
                </MudText>
                @{ var processingTimeMs = _authorization.ReviewedDate.HasValue ? (_authorization.ReviewedDate.Value - _authorization.SubmittedDate).TotalMilliseconds : 0; }
                @if (processingTimeMs > 0)
                {
                    <MudText Typo="Typo.body2">
                        Processing time: @FormatProcessingTime((int)processingTimeMs)
                    </MudText>
                }
            </MudAlert>

            <RecordTabBar Tabs="AuthorizationTabs" ActiveKey="@ActiveTab" BaseHref="@BaseHref" />

            @if (ActiveTab == "overview")
            {
                <div data-testid="authorization-tab-overview">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Authorization ID" 
                                        Value="_authorization.AuthorizationId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service Type" 
                                        Value="_authorization.ServiceType" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Request Date" 
                                        Value="@_authorization.RequestDate.ToString("MM/dd/yyyy hh:mm tt")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Decision Date" 
                                        Value="@(_authorization.DecisionDate?.ToString("MM/dd/yyyy hh:mm tt") ?? "Pending")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member ID" 
                                        Value="_authorization.MemberId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member Name" 
                                        Value="_authorization.MemberName" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Provider ID" 
                                        Value="_authorization.ProviderId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Provider Name" 
                                        Value="_authorization.ProviderName" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </div>
            }
            else if (ActiveTab == "services")
            {
                <div data-testid="authorization-tab-services">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Diagnosis Code" 
                                        Value="_authorization.DiagnosisCode" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Diagnosis Description" 
                                        Value="_authorization.DiagnosisDescription" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Procedure Code" 
                                        Value="_authorization.ProcedureCode" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Procedure Description" 
                                        Value="_authorization.ProcedureDescription" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Units Requested" 
                                        Value="_authorization.UnitsRequested.ToString()" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Units Approved" 
                                        Value="@(_authorization.UnitsApproved?.ToString() ?? "N/A")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Approval Rate" 
                                        Value="@GetApprovalRate()" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service Start Date" 
                                        Value="@_authorization.ServiceStartDate.ToString("MM/dd/yyyy")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service End Date" 
                                        Value="@(_authorization.ServiceEndDate?.ToString("MM/dd/yyyy") ?? "N/A")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </div>
            }
            else if (ActiveTab == "review")
            {
                <div data-testid="authorization-tab-review">
                    <div class="mt-4">
                        @if (!string.IsNullOrWhiteSpace(_authorization.ReviewerNotes))
                        {
                            <MudTextField Label="Reviewer Notes" 
                                        Value="_authorization.ReviewerNotes" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined"
                                        Lines="5" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No reviewer notes available</MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(_authorization.DenialReason))
                        {
                            <MudTextField Label="Denial Reason" 
                                        Value="_authorization.DenialReason" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined"
                                        Lines="3"
                                        Class="mt-4" />
                        }
                    </div>
                </div>
            }
            else if (ActiveTab == "documents")
            {
                <div data-testid="authorization-tab-documents">
                    <div class="mt-4">
                        @if (_authorization.Attachments.Any())
                        {
                            <MudTable Items="_authorization.Attachments" 
                                     Hover="true" 
                                     Dense="true"
                                     Elevation="0">
                                <HeaderContent>
                                    <MudTh>File Name</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Size</MudTh>
                                    <MudTh>Uploaded</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="File Name">
                                        <MudIcon Icon="@GetFileIcon(context.ContentType)" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.body2">@context.FileName</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudChip Size="Size.Small" Color="Color.Info">@context.AttachmentType</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Size">
                                        <MudText Typo="Typo.body2">@FormatFileSize(context.FileSizeBytes)</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Uploaded">
                                        <MudText Typo="Typo.body2">@context.UploadedDate.ToString("MM/dd/yyyy")</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">by @context.UploadedBy</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Download" 
                                                      Color="Color.Primary" 
                                                      Size="Size.Small"
                                                      Title="Download" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                                      Color="Color.Info" 
                                                      Size="Size.Small"
                                                      Title="Preview" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" />
                                No attachments uploaded for this authorization
                            </MudAlert>
                        }
                    </div>
                </div>
            }
            else if (ActiveTab == "claims")
            {
                <div data-testid="authorization-tab-claims">
                    <AuthorizationClaimsPanel AuthorizationNumber="@_authorization.AuthorizationNumber" UnitsApproved="@_authorization.UnitsApproved" />
                </div>
            }
            else if (ActiveTab == "access-log")
            {
                <RecordAccessLogTab Kind="Authorization" RecordId="@_authorization.Id" Number="@_authorization.AuthorizationNumber" />
            }
        }
        else
        {
            <MudAlert Severity="Severity.Error">Failed to load authorization details</MudAlert>
        }
</div>

@code {
    [Parameter, EditorRequired]
    public string AuthorizationId { get; set; } = string.Empty;

    /// <summary>The tab in the URL; none means Overview.</summary>
    [Parameter] public string? Tab { get; set; }

    /// <summary>The record's path without a tab, e.g. <c>/authorizations/PA-1</c>.</summary>
    [Parameter, EditorRequired] public string BaseHref { get; set; } = string.Empty;

    // Fixed order (portal-navigation.md §8 decision 3). Decision & Letters,
    // Notes joins when its data is wired. Related claims needs claims:read;
    // Access log is for audit:read holders only.
    private IReadOnlyList<RecordTab> AuthorizationTabs =>
    [
        new("overview", "Overview", Icons.Material.Filled.Info),
        new("services", "Services", Icons.Material.Filled.MedicalServices),
        new("review", "Review", Icons.Material.Filled.Assignment),
        new("documents", "Documents", Icons.Material.Filled.AttachFile, _authorization is { Attachments.Count: > 0 } a ? a.Attachments.Count : null),
        new("claims", "Related claims", Icons.Material.Filled.Receipt, Visible: CanReadClaims),
        new("access-log", "Access log", Icons.Material.Filled.Visibility, Visible: RecordAccessLogTab.CanRead(ServiceProvider)),
    ];

    private string ActiveTab => RecordTabs.Resolve(AuthorizationTabs, Tab, "overview");

    // An authorization's provider may be held as an NPI or as a provider id.
    private static string ProviderHref(string providerId) =>
        providerId.Length == 10 && providerId.All(char.IsDigit)
            ? $"/providers/npi/{providerId}"
            : $"/providers/{Uri.EscapeDataString(providerId)}";

    private AuthorizationDetails? _authorization;

    private bool CanReadClaims =>
        Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetService<IUserContextService>(ServiceProvider)?.HasPermission("claims:read") == true;
    private bool _loading = true;
    private string? _serviceError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorizationDetails();
    }

    private async Task LoadAuthorizationDetails()
    {
        _loading = true;

        try
        {
            _authorization = await AuthorizationService.GetAuthorizationByIdAsync(AuthorizationId);
        }
        catch (ServiceUnavailableException ex)
        {
            _serviceError = ex.Message;
            _authorization = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the authorization record failed");
            _authorization = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Severity GetSeverity(string status)
    {
        return status switch
        {
            "Approved" => Severity.Success,
            "Denied" => Severity.Error,
            "Pending" => Severity.Warning,
            "Review Required" => Severity.Info,
            _ => Severity.Normal
        };
    }

    private string FormatProcessingTime(int ms)
    {
        if (ms < 1000)
            return $"{ms}ms";
        else if (ms < 60000)
            return $"{ms / 1000.0:F1}s";
        else
            return $"{ms / 60000.0:F1}m";
    }

    private string GetApprovalRate()
    {
        if (_authorization?.UnitsApproved == null || _authorization.UnitsRequested == 0)
            return "N/A";

        var rate = (_authorization.UnitsApproved.Value / (double)_authorization.UnitsRequested) * 100;
        return $"{rate:F0}%";
    }

    private string GetFileIcon(string contentType)
    {
        return contentType switch
        {
            "application/pdf" => Icons.Material.Filled.PictureAsPdf,
            "image/jpeg" or "image/jpg" or "image/png" => Icons.Material.Filled.Image,
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Material.Filled.Description,
            _ => Icons.Material.Filled.AttachFile
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        else if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        else
            return $"{bytes / (1024.0 * 1024):F1} MB";
    }

}
