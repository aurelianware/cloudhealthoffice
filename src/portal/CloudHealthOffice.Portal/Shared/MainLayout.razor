@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using CloudHealthOffice.Portal.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantContextService TenantContextService
@inject NavigationManager Navigation
@inject IUserContextService UserContextService
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger
@inject IConfiguration Configuration
@inject CloudHealthOffice.Portal.Theming.ThemeState ThemeState
@inject CloudHealthOffice.Portal.Theming.ITenantBrandingProvider BrandingProvider
@inject IJSRuntime JS
@implements IDisposable
@using CloudHealthOffice.Portal.Theming

<MudThemeProvider Theme="_theme" />
@if (_brandingCss is not null)
{
    @* Tenant accent; validated as #RRGGBB with AA contrast in TenantBrandingStyle. *@
    <style>@((MarkupString)_brandingCss)</style>
}
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="cho-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer"
                       aria-label="Toggle navigation" />

        @if (_logoUrl is not null)
        {
            <img src="@_logoUrl" alt="" class="cho-appbar-logo" />
        }
        <MudText Typo="Typo.h6" Class="appbar-title">
            @(_brandName ?? "Cloud Health Office")
        </MudText>

        <AuthorizeView>
            <Authorized>
                <GlobalSearchBox />
            </Authorized>
        </AuthorizeView>

        <MudSpacer />

        @* Tenant Switcher / Badge *@
        @if (_availableTenants.Count > 1)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudChip T="string"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Class="@GetCurrentTenantChipClass()"
                             Style="cursor: pointer;">
                        @_tenantName
                        @if (_isDemo) { <text> (Demo)</text> }
                        @if (_isImpersonating) { <text> [Impersonating]</text> }
                        <MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" Class="ml-1" />
                    </MudChip>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var tenant in _availableTenants)
                    {
                        <MudMenuItem OnClick="@(() => SwitchToTenant(tenant))">
                            <div class="d-flex align-center gap-2">
                                @if (tenant.TenantId == _currentTenantId)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                             Color="Color.Success" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                }
                                <div>
                                    <MudText Typo="Typo.body2">@tenant.OrganizationName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @tenant.Tier
                                        @if (tenant.IsDemo) { <text> · Demo</text> }
                                    </MudText>
                                </div>
                            </div>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        else if (!string.IsNullOrEmpty(_tenantName))
        {
            @* Single tenant — static badge *@
            <MudChip T="string"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Class="@GetCurrentTenantChipClass()">
                @_tenantName @(_isDemo ? "(Demo)" : "")
            </MudChip>
        }
        else if (_tenantLoadComplete && string.IsNullOrEmpty(_tenantName))
        {
            @* No tenant access *@
            <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                No tenant access
            </MudChip>
        }

        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Style="margin-left: 12px;" aria-label="Notifications" />

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         aria-label="Account">
                    <MudMenuItem>
                        <div class="cho-menu-signedin">
                            <MudText Typo="Typo.caption">Signed in as</MudText>
                            <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="/settings">Settings</MudMenuItem>
                    <MudDivider />
                    @foreach (var themeName in ChoThemeNames.All)
                    {
                        var name = themeName;
                        <MudMenuItem Icon="@(ThemeState.Current == name ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                     OnClick="@(() => SetThemeAsync(name))">
                            @ChoThemeNames.DisplayName(name)
                        </MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@Logout">Sign Out</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Inherit" Href="@PortalAuthMode.SignInPath(Configuration)" aria-label="Sign in" />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="cho-drawer">
        <div class="cho-drawer-heading">Navigation</div>

        <MudNavMenu Style="padding-top: 8px;">
            <AuthorizeView>
                <Authorized>
                    <!-- portal-navigation.md §3: Home, then records, then the work, then run-the-plan. -->
                    <MudNavLink Href="/home" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                        Home
                    </MudNavLink>

                    <!-- RECORDS — find a record and work it from its tabs -->
                    <MudNavGroup Title="Records" Icon="@Icons.Material.Filled.FolderShared" Expanded="true">
                        <MudNavLink Href="/members" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                            Members
                        </MudNavLink>
                        <MudNavLink Href="/providers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalHospital">
                            Providers
                        </MudNavLink>
                        <MudNavLink Href="/claims" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                            Claims
                        </MudNavLink>
                        <MudNavLink Href="/authorizations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">
                            Authorizations
                        </MudNavLink>
                        <MudNavLink Href="/appeals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Balance">
                            Appeals &amp; Grievances
                        </MudNavLink>
                    </MudNavGroup>

                    <!-- SERVICE — the calls, chats and walk-ins (cho-service.md) -->
                    @if (_canTakeContacts)
                    {
                        <MudNavGroup Title="Service" Icon="@Icons.Material.Filled.SupportAgent" Expanded="true">
                            <MudNavLink Href="/service" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Phone">
                                Contacts
                            </MudNavLink>
                        </MudNavGroup>
                    }

                    <!-- WORK — my work and the queues -->
                    <MudNavGroup Title="Work" Icon="@Icons.Material.Filled.Inbox" Expanded="true">
                        @if (_canWork)
                        {
                            <MudNavLink Href="/my-work" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox">
                                My Work
                            </MudNavLink>
                        }
                        <MudNavLink Href="/work-queues" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Queue">
                            Work Queues
                        </MudNavLink>
                    </MudNavGroup>

                    <!-- OPERATIONS — running the plan: batches, EDI, enrollment, monitoring -->
                    <MudNavGroup Title="Operations" Icon="@Icons.Material.Filled.Speed" Expanded="false">
                        <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                            Claims Dashboard
                        </MudNavLink>
                        <MudNavLink Href="/batch-adjudication" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">
                            Batch Adjudication
                        </MudNavLink>
                        <MudNavLink Href="/edi-transactions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHoriz">
                            EDI Transactions
                        </MudNavLink>
                        <MudNavLink Href="/admin/unmatched-attachments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HelpOutline">
                            Held Attachments
                        </MudNavLink>
                        <MudNavLink Href="/providers/verification" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VerifiedUser">
                            Provider Verification
                        </MudNavLink>
                        <MudNavLink Href="/workflows" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">
                            Workflows
                        </MudNavLink>
                        <MudNavLink Href="/eligibility" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">
                            270/271 Eligibility Simulator
                        </MudNavLink>
                    </MudNavGroup>

                    <!-- FINANCE -->
                    <MudNavGroup Title="Finance" Icon="@Icons.Material.Filled.AccountBalance"
                                 Expanded="false">

                        <!-- Accounts Receivable -->
                        <MudNavGroup Title="Accounts Receivable"
                                     Icon="@Icons.Material.Filled.AccountBalanceWallet"
                                     Expanded="false">
                            <MudNavLink Href="/finance/ar/accounts" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.TableChart">GL Accounts</MudNavLink>
                            <MudNavLink Href="/finance/ar/balances" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Balance">Balances</MudNavLink>
                            <MudNavLink Href="/finance/ar/cash-posting" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Payments">Cash Posting</MudNavLink>
                            <MudNavLink Href="/finance/ar/adjustments" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Tune">Adjustments</MudNavLink>
                            <MudNavLink Href="/finance/ar/aging" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Timeline">Aging Report</MudNavLink>
                        </MudNavGroup>

                        <!-- Premium Billing (existing — route unchanged) -->
                        <MudNavLink Href="/premium-billing" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.RequestQuote">Premium Billing</MudNavLink>

                        <!-- Provider Contracts (new master contract page) -->
                        <MudNavGroup Title="Provider Contracts"
                                     Icon="@Icons.Material.Filled.Description"
                                     Expanded="false">
                            <MudNavLink Href="/finance/contracts" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Article">Contracts</MudNavLink>
                            <MudNavLink Href="/finance/contracts/statements" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Receipt">Statements</MudNavLink>
                        </MudNavGroup>

                        <!-- Payments -->
                        <MudNavGroup Title="Payments" Icon="@Icons.Material.Filled.CreditCard"
                                     Expanded="false">
                            <MudNavGroup Title="FFS" Icon="@Icons.Material.Filled.AttachMoney"
                                         Expanded="false">
                                <MudNavLink Href="/payment-runs" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Filled.PlayArrow">Payment Runs</MudNavLink>
                            </MudNavGroup>
                            <MudNavGroup Title="Capitation" Icon="@Icons.Material.Filled.LocalHospital"
                                         Expanded="false">
                                @if (_canReadContracts)
                                {
                                    <MudNavLink Href="/capitation/rate-config" Match="NavLinkMatch.Prefix"
                                        Icon="@Icons.Material.Filled.Settings">Rate Config</MudNavLink>
                                }
                                <MudNavLink Href="/capitation/runs" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Filled.PlayCircle">Capitation Runs</MudNavLink>
                            </MudNavGroup>
                        </MudNavGroup>

                    </MudNavGroup>

                    <!-- CONFIGURATION -->
                    <MudNavGroup Title="Configuration" Icon="@Icons.Material.Filled.Tune" Expanded="false">
                        <MudNavLink Href="/benefit-plans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HealthAndSafety">
                            Benefit Plans
                        </MudNavLink>
                        @if (_canReadSponsors)
                        {
                            <MudNavLink Href="/sponsors" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                                Sponsors
                            </MudNavLink>
                        }
                        <MudNavLink Href="/trading-partners" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHoriz">
                            Trading Partners
                        </MudNavLink>
                        <MudNavLink Href="/reference-data" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Code">
                            Reference Data
                        </MudNavLink>
                        <MudNavLink Href="/terminology/crosswalk" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Translate">
                            Terminology Crosswalk
                        </MudNavLink>
                        <MudNavLink Href="/pricing-api" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Api">
                            Pricing API
                        </MudNavLink>
                    </MudNavGroup>

                    <!-- COMPLIANCE -->
                    <MudNavGroup Title="Compliance" Icon="@Icons.Material.Filled.Policy" Expanded="false">
                        <MudNavLink Href="/compliance/cms-0057f" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Timer">
                            CMS-0057-F Console
                        </MudNavLink>
                        <MudNavLink Href="/compliance/pa-rules" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Checklist">
                            PA Rule Explorer
                        </MudNavLink>
                    </MudNavGroup>

                    <MudDivider Class="cho-nav-divider" />

                    <!-- ADMIN -->
                    <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                        @if (_canReadCorrespondence)
                        {
                            <MudNavLink Href="/correspondence" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Email">
                                Correspondence
                            </MudNavLink>
                        }
                        @if (_canAdminWork)
                        {
                            <MudNavLink Href="/admin/work-management" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">
                                Work Management
                            </MudNavLink>
                        }
                        @if (_canPostNotices)
                        {
                            <MudNavLink Href="/admin/notices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Campaign">
                                Plan Notices
                            </MudNavLink>
                        }
                        @if (_isTenantAdmin)
                        {
                            <MudNavLink Href="/settings/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                                User Management
                            </MudNavLink>
                            <MudNavLink Href="/settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Settings">
                                Settings
                            </MudNavLink>
                        }
                    </MudNavGroup>

                    @if (_isPlatformAdmin)
                    {
                        <MudDivider Class="cho-nav-divider" />

                        <!-- PLATFORM ADMIN -->
                        <MudNavGroup Title="Platform" Icon="@Icons.Material.Filled.Cloud" Expanded="false"
                                     Class="cho-nav-platform">
                            <MudNavLink Href="/platform/tenants" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                                Tenants
                            </MudNavLink>
                            <MudNavLink Href="/platform/inquiries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox">
                                Sales Inquiries
                            </MudNavLink>
                        </MudNavGroup>
                    }
                </Authorized>
                <NotAuthorized>
                    <!-- Public Website Menu -->
                    <MudNavLink Href="/welcome" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Home">
                        Home
                    </MudNavLink>
                    <MudNavLink Href="/docs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">
                        Documentation
                    </MudNavLink>
                    <MudNavLink Href="/apis" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Api">
                        FHIR APIs
                    </MudNavLink>
                    <MudNavLink Href="/pricing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">
                        Pricing
                    </MudNavLink>
                    <MudNavLink Href="/demo" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PlayCircle">
                        Live Demo
                    </MudNavLink>

                    <MudDivider Class="cho-nav-divider" />

                    <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login"
                                Style="border-left: 3px solid var(--cho-accent); color: var(--cho-accent); cursor: pointer;"
                                @onclick="SignIn">
                        Sign In
                    </MudNavLink>
                    <MudNavLink Href="/signup" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">
                        Sign Up
                    </MudNavLink>
                    <MudNavLink Href="/contact-sales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContactMail">
                        Contact Sales
                    </MudNavLink>
                    <MudNavLink Href="/legal" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">
                        Legal
                    </MudNavLink>
                    <MudNavLink Href="https://github.com/aurelianware/cloudhealthoffice" Target="_blank" Icon="@Icons.Material.Filled.Code">
                        GitHub
                    </MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>

        <!-- Footer branding in drawer -->
        <div class="cho-drawer-footer">
            <div>@(_brandName is null ? "Cloud Health Office" : "Powered by Cloud Health Office")</div>
            <div class="cho-version">v6.0</div>
            <div>Source-available (BSL 1.1) · Free for non-production use</div>
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private MudTheme _theme = ChoThemes.Create(ChoThemeNames.Enterprise);
    private string? _brandName;
    private string? _logoUrl;
    private string? _brandAccent;
    private string? _brandingCss;
    private string? _tenantName;
    private string? _currentTenantId;
    private bool _isDemo;
    private bool _isImpersonating;
    private bool _isTenantAdmin;
    private bool _isPlatformAdmin;
    // Sponsors are read through sponsor-service (enrollment:read or billing:read); capitation
    // rate configs are contract data (contracts:read, the page's gate).
    private bool _canReadSponsors;
    private bool _canReadContracts;
    // Work management: My Work (pull) and its configuration (work-management-service).
    private bool _canWork;
    private bool _canAdminWork;
    private bool _canPostNotices;
    private bool _canReadCorrespondence;
    // Call tracking: the contact screen (contact-service).
    private bool _canTakeContacts;
    private bool _tenantLoadComplete;
    private List<TenantSubscription> _availableTenants = new();

    private void SignIn()
    {
        var signInPath = PortalAuthMode.SignInPath(Configuration);
        Navigation.NavigateTo(signInPath, forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += OnThemeChanged;
        RebuildTheme();
        await LoadTenantContextAsync();
        await LoadUserContextAsync();
    }

    private async Task LoadUserContextAsync()
    {
        try
        {
            var userContext = await UserContextService.GetCurrentUserAsync();
            _isTenantAdmin = userContext != null && UserContextService.HasPermission("users:manage");
            _isPlatformAdmin = userContext != null && UserContextService.HasPermission("platform:admin");
            _canReadSponsors = userContext != null
                && (UserContextService.HasPermission("enrollment:read") || UserContextService.HasPermission("billing:read"));
            _canReadContracts = userContext != null && UserContextService.HasPermission("contracts:read");
            _canWork = userContext != null && UserContextService.HasPermission("workqueue:work");
            _canAdminWork = userContext != null && UserContextService.HasPermission("workqueue:admin");
            _canPostNotices = userContext != null && UserContextService.HasPermission("notices:write");
            _canReadCorrespondence = userContext != null && UserContextService.HasPermission("correspondence:read");
            _canTakeContacts = userContext != null && UserContextService.HasPermission("service:contact");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load user context");
        }
    }

    private async Task LoadTenantContextAsync()
    {
        try
        {
            var tenantContext = await TenantContextService.GetCurrentTenantContextAsync();
            if (tenantContext != null)
            {
                _tenantName = tenantContext.TenantName;
                _isDemo = tenantContext.IsDemo;
                _currentTenantId = tenantContext.TenantId;
                _isImpersonating = TenantContextService.IsImpersonating;
                ApplyBranding(_currentTenantId);

                // X-Tenant-ID and the CHO token are added per request by
                // ChoBearerTokenHandler, from the token's own tenant.

                // Load available tenants for the switcher (from the CHO token service)
                _availableTenants = await TenantContextService.GetAvailableTenantsAsync();

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Log error but don't crash the layout
            Console.Error.WriteLine($"Error loading tenant context: {ex.Message}");
        }
        finally
        {
            _tenantLoadComplete = true;
        }
    }

    private async Task SwitchToTenant(TenantSubscription tenant)
    {
        if (tenant.TenantId == _currentTenantId)
            return; // Already on this tenant

        var success = await TenantContextService.SwitchTenantAsync(tenant.TenantId);
        if (success)
        {
            var tenantContext = await TenantContextService.GetCurrentTenantContextAsync();
            if (tenantContext != null)
            {
                _tenantName = tenantContext.TenantName;
                _isDemo = tenantContext.IsDemo;
                _currentTenantId = tenantContext.TenantId;
                _isImpersonating = TenantContextService.IsImpersonating;
                ApplyBranding(_currentTenantId);
            }

            Snackbar.Add($"Switched to {tenant.OrganizationName}", Severity.Success);

            // Navigate to dashboard to reload data for the new tenant
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            Snackbar.Add("Failed to switch tenant. You may not have access.", Severity.Error);
        }
    }

    private string GetCurrentTenantChipClass()
        => _isImpersonating || _isDemo ? "cho-tenant-chip cho-tenant-chip--warn" : "cho-tenant-chip";

    private void ApplyBranding(string? tenantId)
    {
        var branding = BrandingProvider.GetBranding(tenantId);
        _brandName = string.IsNullOrWhiteSpace(branding?.DisplayName) ? null : branding!.DisplayName!.Trim();
        _logoUrl = TenantBrandingStyle.ValidLogoUrl(branding?.LogoUrl);
        _brandAccent = TenantBrandingStyle.ValidAccent(branding?.AccentColor);
        _brandingCss = TenantBrandingStyle.AccentCss(_brandAccent);
        if (branding?.AccentColor is not null && _brandAccent is null)
        {
            Logger.LogWarning(
                "Tenant {TenantId} accent {Accent} ignored: not #RRGGBB or below WCAG AA contrast on white",
                tenantId, branding.AccentColor);
        }
        RebuildTheme();
    }

    private void RebuildTheme() => _theme = ChoThemes.Create(ThemeState.Current, _brandAccent);

    private async Task SetThemeAsync(string themeName) => await ThemeState.SetAsync(themeName, JS);

    private void OnThemeChanged()
    {
        RebuildTheme();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;

    private void Logout()
    {
        var signOutPath = PortalAuthMode.SignOutPath(Configuration);
        Navigation.NavigateTo(signOutPath, forceLoad: true);
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
