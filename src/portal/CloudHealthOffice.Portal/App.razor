@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject CloudHealthOffice.Portal.Theming.ThemeState ThemeState

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <ErrorBoundary>
                <ChildContent>
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            @{
                                var signInPath = PortalAuthMode.SignInPath(Configuration);
                                Navigation.NavigateTo($"{signInPath}?redirectUri={Uri.EscapeDataString(Navigation.Uri)}", forceLoad: true);
                            }
                        </NotAuthorized>
                        <Authorizing>
                            <div class="cho-fullpage">
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            </div>
                        </Authorizing>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="cho-fullpage-error">
                        <h2>An error occurred</h2>
                        <p>Something went wrong loading this page. Please <a href="/">return to the dashboard</a> or reload.</p>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    /// <summary>Theme resolved by _Host.cshtml from the cho-theme cookie.</summary>
    [Parameter] public string? InitialTheme { get; set; }

    protected override void OnInitialized() => ThemeState.Initialize(InitialTheme);
}
