@using CloudHealthOffice.Portal.Services
@inject IClaimsService ClaimsService

@*
    Reverse (void) a paid claim through claims-service POST /claims/{id}/void
    (claims:void). The void is the claim's terminal transition: the claim
    shows as Reversed, its accumulator reversal is saved with the void, and
    the void is recorded on the claim's version history. To pay it
    differently instead, correct it with an adjustment.
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Reversing voids the whole claim: it is marked <strong>Reversed</strong>, the amounts it applied
            to the member's deductible and out-of-pocket are reversed, and the void is recorded in the
            claim's history. Use it for a claim paid in error or a duplicate. To change what was paid,
            correct the claim instead.
        </MudText>

        <MudTextField @bind-Value="_reason"
                      Label="Reason"
                      Variant="Variant.Outlined"
                      Lines="3"
                      MaxLength="500"
                      Placeholder="e.g. Duplicate of claim CLM-1042, paid twice"
                      Required="true"
                      Disabled="_submitting"
                      data-testid="reversal-reason" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" data-testid="reversal-error">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_submitting">Cancel</MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="@(_submitting || string.IsNullOrWhiteSpace(_reason))"
                   data-testid="reversal-submit">
            @(_submitting ? "Reversing…" : "Reverse claim")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string ClaimId { get; set; } = string.Empty;

    private string _reason = string.Empty;
    private string? _error;
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_submitting || string.IsNullOrWhiteSpace(_reason)) return;
        _submitting = true;
        _error = null;
        try
        {
            var refusal = await ClaimsService.VoidClaimAsync(ClaimId, _reason.Trim());
            if (refusal is null)
            {
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }
            _error = refusal;
        }
        catch (Exception ex)
        {
            _error = $"The claim wasn't reversed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
