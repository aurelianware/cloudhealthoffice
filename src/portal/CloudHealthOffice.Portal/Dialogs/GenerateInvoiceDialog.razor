@using CloudHealthOffice.Portal.Services
@inject IPremiumBillingService BillingService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: #00ffff;">
            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Class="mr-2" Style="vertical-align: middle;" />
            Generate Premium Invoice
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudSelect @bind-Value="_request.SponsorId"
                           Label="Sponsor"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Sponsor is required">
                    @foreach (var s in Sponsors)
                    {
                        <MudSelectItem Value="@s.SponsorId">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.BillingPeriod"
                              Label="Billing Period (YYYY-MM)"
                              Variant="Variant.Outlined"
                              Required="true"
                              Placeholder="@DateTime.Today.ToString("yyyy-MM")"
                              HelperText="e.g. 2026-03 for March 2026" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_dueDate"
                               Label="Due Date"
                               Variant="Variant.Outlined"
                               Required="true"
                               MinDate="DateTime.Today"
                               HelperText="Payment due date on the invoice" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_request.Notes"
                              Label="Notes (optional)"
                              Variant="Variant.Outlined"
                              Lines="3"
                              HelperText="Additional notes to include on the invoice" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Generate"
                   Disabled="@(!IsValid() || _generating)">
            @if (_generating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Generate Invoice
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<SponsorSummary> Sponsors { get; set; } = new();

    private CreateInvoiceRequest _request = new()
    {
        BillingPeriod = DateTime.Today.ToString("yyyy-MM")
    };
    private DateTime? _dueDate = DateTime.Today.AddDays(30);
    private bool _generating = false;

    private bool IsValid() =>
        !string.IsNullOrEmpty(_request.SponsorId)
        && !string.IsNullOrEmpty(_request.BillingPeriod)
        && _dueDate.HasValue;

    private async Task Generate()
    {
        if (!IsValid()) return;
        _generating = true;
        try
        {
            _request.DueDate = _dueDate!.Value;
            var cycleId = await BillingService.GenerateInvoiceAsync(_request);
            Snackbar.Add($"Invoice generated (cycle {cycleId})", Severity.Success);
            MudDialog.Close(DialogResult.Ok(cycleId));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating invoice: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generating = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
