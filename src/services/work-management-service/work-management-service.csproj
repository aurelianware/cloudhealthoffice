<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorkManagementService</RootNamespace>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <!-- Exclude test project files when built inside Docker (Dockerfile copies entire directory) -->
  <ItemGroup>
    <Compile Remove="WorkManagementService.Tests/**" />
    <Content Remove="WorkManagementService.Tests/**" />
    <None Remove="WorkManagementService.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorkManagementService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <ProjectReference Include="..\shared\CloudHealthOffice.Events\CloudHealthOffice.Events.csproj" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
