{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "Services": {
    "ClaimsService": "http://claims-service.cloudhealthoffice",
    "EnrollmentImportService": "http://enrollment-import-service.cloudhealthoffice"
  },
  "Kafka": {
    "BootstrapServers": "",
    "ClientId": "work-management-service"
  },
  "WorkManagement": {
    "LeaseMinutes": 30,
    "AssignedLeaseMinutes": 480,
    "CandidatesPerQueue": 25,
    "GetNextRounds": 3,
    "RescoreIntervalMinutes": 15,
    "Reconcile": {
      "_comment": "Enabled: null = automatic (on exactly when Kafka:BootstrapServers is unset, i.e. this service cannot receive claims.work.v1).",
      "Enabled": null,
      "IntervalMinutes": 2,
      "PageSize": 500,
      "Tenants": []
    }
  },
  "Observability": {
    "ServiceName": "work-management-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
