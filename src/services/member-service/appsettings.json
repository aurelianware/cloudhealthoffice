{
  "ChoAuth": {
    "Outbound": {
      "_comment": "CHO hosts this service calls that are neither a Services:* URL nor under *.cloudhealthoffice: the in-cluster names its other base-URL settings and code defaults use. Only these hosts receive CHO tokens (docs/security/service-auth-rollout-playbook.md).",
      "Hosts": [ "coverage-service", "enrollment-import-service", "accumulator-service" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "https://yourtenant.b2clogin.com/yourtenant.onmicrosoft.com/v2.0/",
    "Audience": "api://member-service"
  },
  "CosmosDb": {
    "DatabaseName": "CloudHealthOffice",
    "EventsContainerName": "member-events"
  },
  "MongoDb": {
    "DatabaseName": "CloudHealthOffice",
    "EventsCollectionName": "member-events"
  },
  "Member": {
    "IdentifierEncryption": {
      "KeySecretName": ""
    }
  },
  "Encryption": {
    "IdentifierFingerprintKeySecret": ""
  },
  "Downstream": {
    "CoverageService": {
      "BaseUrl": ""
    },
    "EnrollmentImportService": {
      "BaseUrl": ""
    },
    "AccumulatorService": {
      "BaseUrl": ""
    }
  },
  "Observability": {
    "ServiceName": "member-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
