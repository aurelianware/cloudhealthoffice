{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "TerminologyService": {
    "MongoConnectionString": "mongodb://localhost:27017",
    "MongoDatabaseName": "cho_terminology",
    "CacheMinutes": 15,
    "MaxBatchSize": 500,
    "AutoLoadMaps": [
      {
        "FilePath": "/data/maps/der2_iisssccRefset_ExtendedMapFull_US.txt",
        "Format": "RF2",
        "MapName": "NLM-SNOMED-ICD10CM",
        "Version": "202603",
        "SourceSystem": "http://snomed.info/sct",
        "TargetSystem": "http://hl7.org/fhir/sid/icd-10-cm"
      }
    ]
  },
  "AllowedHosts": "*",
  "Urls": "http://+:5080",
  "Observability": {
    "ServiceName": "CHO.TerminologyService",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
