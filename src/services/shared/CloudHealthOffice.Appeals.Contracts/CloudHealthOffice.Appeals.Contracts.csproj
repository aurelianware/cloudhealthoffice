<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CloudHealthOffice.Appeals.Contracts</RootNamespace>
    <AssemblyName>CloudHealthOffice.Appeals.Contracts</AssemblyName>
    <!--
      Cross-service DTO contract for appeals. Mirrors the domain model in
      appeals-service/Models/Appeal.cs as a parallel type: same property
      names, types, and nullability, but with no Mongo serialization
      attributes, no ValidationAttributes, and no encryption concerns.

      Current dependency direction:
      - fhir-service references this project and consumes AppealDto via
        HttpFhirAppealAdapter.
      - CloudHealthOffice.Appeals.Contracts.Tests references both this
        project and appeals-service to run reflection-based drift checks
        between AppealDto and the domain Appeal aggregate.

      appeals-service does NOT currently reference this project. A future
      PR may move appeals-service's controller-layer request/response shapes
      to consume AppealDto directly, eliminating the shape-translation step
      at the HTTP boundary. Until then, both sides serialize to a
      structurally-equivalent JSON shape enforced by AppealDtoDriftTests.
    -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudHealthOffice.Appeals.Contracts.Tests" />
  </ItemGroup>

</Project>
