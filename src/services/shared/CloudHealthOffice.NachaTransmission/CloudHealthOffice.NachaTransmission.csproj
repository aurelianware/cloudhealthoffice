<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NACHA files go from the service straight to the tenant's bank (SFTP), so
    no person ever holds a file of full account numbers. Kept out of
    CloudHealthOffice.Infrastructure on purpose: SSH.NET would otherwise reach
    every service. premium-billing-service and capitation-service opt in with a
    ProjectReference and AddChoNachaTransmission.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CloudHealthOffice.NachaTransmission</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <ProjectReference Include="..\CloudHealthOffice.FieldProtection\CloudHealthOffice.FieldProtection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SFTP to the bank. Same central version as ProviderEnrollmentService. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudHealthOffice.NachaTransmission.Tests" />
  </ItemGroup>

</Project>
