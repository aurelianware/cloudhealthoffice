<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <!--
    The Web SDK glob picks up every .cs file under the project root. The
    sibling BenefitPlanService.Tests project lives in a subdirectory and
    has its own SDK + test packages; excluding it here keeps the service
    build (and the Dockerfile build that scopes to this csproj) from
    pulling test sources into the service binary.
  -->
  <ItemGroup>
    <Compile Remove="BenefitPlanService.Tests/**" />
    <Content Remove="BenefitPlanService.Tests/**" />
    <EmbeddedResource Remove="BenefitPlanService.Tests/**" />
    <None Remove="BenefitPlanService.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the sibling test project reach internal types like PlanVersionId. -->
    <InternalsVisibleTo Include="BenefitPlanService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.BenefitEngine\CloudHealthOffice.BenefitEngine.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.FeeScheduleEngine\CloudHealthOffice.FeeScheduleEngine.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.ClaimsScrubEngine\CloudHealthOffice.ClaimsScrubEngine.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.NcciEngine\CloudHealthOffice.NcciEngine.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.ProviderEnrollmentService\CloudHealthOffice.ProviderEnrollmentService.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.PriorAuthRuleEngine\CloudHealthOffice.PriorAuthRuleEngine.csproj" />
    <ProjectReference Include="..\..\engines\CloudHealthOffice.OperatingMode\CloudHealthOffice.OperatingMode.csproj" />
  </ItemGroup>

</Project>
