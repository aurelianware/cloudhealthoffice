    "EnableConsole": false
  },
  "Caching": {
    "Backend": "Auto"
  },
  "BenefitPlan": {
    "AllowedDocumentHosts": []
  },
  "EstimateApi": {
    "Enabled": false,
    "EstimateOnly": false,
    "ApiKey": ""
  }
