<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CorrespondenceService</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CorrespondenceService.Tests/**" />
    <Content Remove="CorrespondenceService.Tests/**" />
    <None Remove="CorrespondenceService.Tests/**" />
    <EmbeddedResource Remove="CorrespondenceService.Tests/**" />
  </ItemGroup>

  <!-- The composer's merge model and write-once snapshot are internal; the
       tests assert what goes into them, as the other services' tests do. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CorrespondenceService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <ProjectReference Include="..\shared\CloudHealthOffice.PlanConfiguration\CloudHealthOffice.PlanConfiguration.csproj" />
    <ProjectReference Include="..\shared\CloudHealthOffice.PdfLayout\CloudHealthOffice.PdfLayout.csproj" />
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
