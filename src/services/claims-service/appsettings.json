{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "claims-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  },
  "Adjudication": {
    "Enforcement": {
      "NetworkMode": "FailClosed",
      "CredentialingMode": "FailClosed",
      "NcciMode": "PendForReview",
      "CobMode": "PendForSecondary",
      "AiMode": "BestEffort"
    }
  }
}
