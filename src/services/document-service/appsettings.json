{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "Documents": {
    "_comment": "Pending, infected and failed content remain inaccessible unless the existing Pending-only development allowance is explicitly enabled. Select ClamAv for real scanning.",
    "AllowUnscannedContent": false,
    "MaxUploadBytes": 67108864,
    "Scanner": {
      "Provider": "None",
      "ClamAv": {
        "Host": "",
        "Port": 3310,
        "TimeoutSeconds": 60,
        "MaxBytes": 67108864
      }
    }
  },
  "Observability": {
    "ServiceName": "document-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
