{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProviderApi": {
    "Clients": []
  },
  "HealthcareTransactions": {
    "DefaultGateway": "Stedi",
    "ClaimLifecycle": {
      "Store": "InMemory",
      "AllowInMemoryInNonDevelopment": true
    },
    "Gateways": {
      "Stedi": {
        "BaseUrl": "https://healthcare.us.stedi.com",
        "PayerDirectoryBaseUrl": "https://payers.us.stedi.com",
        "PayerDirectoryPath": "/2024-04-01/payers",
        "ApiKey": "",
        "Environment": "test"
      }
    }
  },
  "PayerReference": {
    "Store": "InMemory",
    "SeedSyntheticPayers": false,
    "Sync": {
      "Enabled": true,
      "OnStartup": true,
      "IntervalHours": 24,
      "AllowOnDemandSync": false
    }
  },
  "Observability": {
    "EnableConsole": false,
    "OtlpEndpoint": ""
  }
}
