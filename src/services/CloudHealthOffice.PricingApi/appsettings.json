{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "PricingApi": {
    "MongoConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "cho_pricing",
    "MedicareFeeSchedulePath": "./Data/FeeSchedules",
    "FreeTierMonthlyLimit": 1000,
    "StarterTierMonthlyLimit": 10000,
    "ProfessionalTierMonthlyLimit": 100000,
    "AdminSecret": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "CloudHealthOffice.PricingApi",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
