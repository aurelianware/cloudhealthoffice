<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProviderContractsService</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ProviderContractsService.Tests/**" />
    <Content Remove="ProviderContractsService.Tests/**" />
    <None Remove="ProviderContractsService.Tests/**" />
    <EmbeddedResource Remove="ProviderContractsService.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <!--
      ADR 016: the reimbursement terms on a contract are the same documents the
      pricing engine evaluates, so this service writes the engine's own
      ReimbursementTerm type rather than a copy of it. Two shapes that have to
      agree is the problem the ADR is fixing.
    -->
    <ProjectReference Include="..\..\engines\CloudHealthOffice.FeeScheduleEngine\CloudHealthOffice.FeeScheduleEngine.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
