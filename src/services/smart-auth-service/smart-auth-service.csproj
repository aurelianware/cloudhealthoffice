<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartAuthService</RootNamespace>
    <AssemblyName>smart-auth-service</AssemblyName>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Using OpenIddict.MongoDb instead of EntityFrameworkCore — the entire CHO stack
      is MongoDB/CosmosDB; no Entity Framework anywhere.  OpenIddict.MongoDb provides
      first-class MongoDB stores for applications, authorizations, scopes, and tokens.
    -->
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.MongoDb" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Security: force patched transitive versions (CVE-2024-30105, CVE-2024-43485, CVE-2024-43483) -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

</Project>
