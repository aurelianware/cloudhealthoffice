{
  "_comment_cors": "Browser origins allowed to call this service (ChoCors). Empty: Portal:BaseUrl if set, otherwise none outside Development. Name each origin (https://host[:port]); \"*\" is refused outside Development; credentials are never allowed.",
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Information"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "SmartAuth": {
    "Issuer": "https://auth.cloudhealthoffice.com",
    "FhirBaseUrl": "https://api.cloudhealthoffice.com/fhir/r4",
