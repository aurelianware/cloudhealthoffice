<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PremiumBillingService</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="PremiumBillingService.Tests/**" />
    <Content Remove="PremiumBillingService.Tests/**" />
    <None Remove="PremiumBillingService.Tests/**" />
    <EmbeddedResource Remove="PremiumBillingService.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rating data (age curves) ships inside the assembly; tables may override it. -->
    <EmbeddedResource Include="Rating/AgeCurves/*.json" LogicalName="PremiumBillingService.Rating.AgeCurves.%(Filename)%(Extension)" />
    <Content Remove="Rating/AgeCurves/*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CloudHealthOffice.Infrastructure\CloudHealthOffice.Infrastructure.csproj" />
    <ProjectReference Include="..\shared\CloudHealthOffice.FieldProtection\CloudHealthOffice.FieldProtection.csproj" />
    <ProjectReference Include="..\shared\CloudHealthOffice.NachaTransmission\CloudHealthOffice.NachaTransmission.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Stripe.net" VersionOverride="46.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
