{
  "ChoAuth": {
    "Outbound": {
      "_comment": "CHO hosts this service calls that are neither a Services:* URL nor under *.cloudhealthoffice: the in-cluster names its other base-URL settings and code defaults use. Only these hosts receive CHO tokens (docs/security/service-auth-rollout-playbook.md).",
      "Hosts": [ "coverage-service", "sponsor-service", "member-service" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "Endpoint": "",
    "Key": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "CoverageService": {
    "BaseUrl": "http://coverage-service:8080"
  },
  "SponsorService": {
    "BaseUrl": "http://sponsor-service:8080"
  },
  "MemberService": {
    "BaseUrl": "http://member-service:8080"
  },
  "PremiumBilling": {
    "RatedBilling": {
      "_comment": "Per-tenant rated billing (rating engine prices invoice lines). A tenant not listed here keeps the original coverage-premium pricing. See docs/operations/PREMIUM-RATED-BILLING-RUNBOOK.md.",
      "Tenants": {}
    }
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "Nacha": {
    "ImmediateDestination": "",
    "ImmediateOrigin": "",
    "ImmediateDestinationName": "",
    "ImmediateOriginName": "",
    "CompanyName": "",
    "CompanyId": "",
    "OriginatingDfi": "",
    "CompanyEntryDescription": "PREMIUM"
  },
  "Observability": {
    "ServiceName": "premium-billing-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  },
  "MongoDb": {
    "DatabaseName": "PremiumBillingDB"
  }
}
