    "oac-317-2-3-5": { "citation": "Okla. Admin. Code 317:2-3-5, 317:2-3-5.1", "url": "https://oklahoma.gov/ohca/policies-and-rules/xpolicy/grievance-procedures-and-process/subchapter-three-member-grievances-and-appeals-provider-complaints-and-state-fair-hearings-in-soonerselect/member-appeals.html" },
    "oac-317-2-3-4": { "citation": "Okla. Admin. Code 317:2-3-4", "url": "https://oklahoma.gov/ohca/policies-and-rules/xpolicy/grievance-procedures-and-process/subchapter-three-member-grievances-and-appeals-provider-complaints-and-state-fair-hearings-in-soonerselect/member-grievances.html" },
    "oac-317-2-3-12": { "citation": "Okla. Admin. Code 317:2-3-12", "url": "https://oklahoma.gov/ohca/policies-and-rules/xpolicy/grievance-procedures-and-process/subchapter-three-member-grievances-and-appeals-provider-complaints-and-state-fair-hearings-in-soonerselect/state-fair-hearing-for-members.html" },
    "oac-317-2-3-10": { "citation": "Okla. Admin. Code 317:2-3-10, 317:2-3-13; 56 O.S. §4002.8", "url": "https://oklahoma.gov/ohca/policies-and-rules/xpolicy/grievance-procedures-and-process/subchapter-three-member-grievances-and-appeals-provider-complaints-and-state-fair-hearings-in-soonerselect/provider-complaint-system.html" },
    "os-4002-8": { "citation": "56 O.S. §4002.8(F)", "url": "https://law.justia.com/codes/oklahoma/title-56/section-56-4002-8/" },
