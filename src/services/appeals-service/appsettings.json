{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "AccountEndpoint": "",
    "AccountKey": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "ClaimsService": {
    "BaseUrl": "http://claims-service:8080"
  },
  "Appeal": {
    "MaxAttachmentSizeMB": 50,
    "AllowedFileTypes": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".tiff",
      ".dcm",
      ".xml"
    ],
    "DefaultAppealLevelTimeLimitDays": 60
  },
  "AppealEncryption": {
    "KeySecretPrefix": "appeal-body-encryption-key",
    "CurrentKeyVersion": "v1",
    "AcceptedKeyVersions": [ "v1" ]
  },
  "Kafka": {
    "BootstrapServers": "",
    "ClientId": "appeals-service",
    "AttachmentsInTopic": "attachments-in",
    "Attachment275ConsumerGroupId": "appeals-service-275-consumer"
  },
  "AppealMigration": {
    "BatchSize": 100
  },
  "Observability": {
    "ServiceName": "appeals-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
