{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "AccountEndpoint": "",
    "AccountKey": "",
    "DatabaseName": "CloudHealthOffice"
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "appeal-attachments"
  },
  "ClaimsService": {
    "BaseUrl": "http://claims-service:8080"
  },
  "Appeal": {
    "MaxAttachmentSizeMB": 50,
