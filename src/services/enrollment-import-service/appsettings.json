{
  "ChoAuth": {
    "Outbound": {
      "_comment": "CHO hosts this service calls that are neither a Services:* URL nor under *.cloudhealthoffice: the in-cluster names its other base-URL settings and code defaults use. Only these hosts receive CHO tokens (docs/security/service-auth-rollout-playbook.md).",
      "Hosts": [ "member-service", "sponsor-service", "benefit-plan-service", "coverage-service" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CosmosDb": {
    "Endpoint": "",
    "Key": "",
    "DatabaseName": "CloudHealthOffice",
    "MembersContainerName": "Members",
    "CoverageContainerName": "Coverage",
    "SponsorsContainerName": "Sponsors",
    "TransactionsContainerName": "enrollment-transactions",
    "EnrollmentEventsContainerName": "enrollment-events"
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "enrollment-import-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  },
  "MongoDb": {
    "DatabaseName": "CloudHealthOffice"
  }
}
