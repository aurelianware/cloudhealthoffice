/*
 * Prepopulation logic for the CHO "Prior Authorization: MRI Imaging" DTR
 * questionnaire (https://cloudhealthoffice.com/fhir/Questionnaire/pa-imaging-mri).
 *
 * Runs in the provider's DTR client against the EHR's data, never in CHO.
 * Every answer is evidence-or-nothing: a define returns true or a date when the
 * record shows it and null otherwise, so a missing record never prepopulates
 * "No" on the clinician's behalf.
 *
 * Deliberately has no FHIRHelpers dependency: element values are read with
 * .value and codings are tested against the value sets explicitly (CodingIn),
 * so the package carries this one Library and its two ValueSets. A terminology
 * retrieve such as [Condition: "Radiculopathy"] would need FHIRHelpers to
 * resolve its membership test; without it an engine may not filter at all.
 *
 * The compiled ELM beside this file is generated by scripts/dtr/compile-cql.sh.
 * Edit this file, then re-run the script; DtrContentLibraryTests fails if the
 * ELM no longer matches this source.
 */
library ChoImagingMriPrepopulation version '1.0.0'

using FHIR version '4.0.1'

valueset "Radiculopathy": 'https://cloudhealthoffice.com/fhir/ValueSet/dtr-radiculopathy' version '1.0.0'
valueset "Physical Therapy Procedures": 'https://cloudhealthoffice.com/fhir/ValueSet/dtr-physical-therapy' version '1.0.0'

context Patient

/* True when any coding of the concept is in the value set. */
define function CodingIn(concept FHIR.CodeableConcept, codes System.ValueSet):
  exists (
    concept.coding X
      where System.Code { code: X.code.value, system: X.system.value } in codes
  )

/* Radiculopathy diagnoses not refuted or entered in error. */
define RadiculopathyConditions:
  [Condition] C
    where CodingIn(C.code, "Radiculopathy")
      and not exists (
        C.verificationStatus.coding V
          where V.code.value in { 'refuted', 'entered-in-error' }
      )

/* Item 2a: true when the record shows radiculopathy, otherwise no answer. */
define HasRadiculopathy:
  if exists RadiculopathyConditions then true else null

/* Item 5: earliest recorded onset of radiculopathy, otherwise no answer. */
define SymptomOnsetDate:
  Min(
    RadiculopathyConditions C
      where C.onset is FHIR.dateTime
      return date from (C.onset as FHIR.dateTime).value
  )

/* Completed physical therapy that started within the last year. */
define RecentPhysicalTherapy:
  [Procedure] P
    where CodingIn(P.code, "Physical Therapy Procedures")
      and P.status.value = 'completed'
      and (
        (P.performed as FHIR.dateTime).value >= Now() - 1 year
          or (P.performed as FHIR.Period).start.value >= Now() - 1 year
      )

/* Item 3: true when the record shows conservative treatment, otherwise no answer. */
define ConservativeTreatmentAttempted:
  if exists RecentPhysicalTherapy then true else null
