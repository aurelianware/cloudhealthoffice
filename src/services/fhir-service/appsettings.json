{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmartAuth": {
    "_comment": "Mode is stated, never inferred. Demo trusts the bundled smart-auth-service and is refused outside a development host. Production sets Mode=ExternalIssuer and populates TrustedIssuers. See docs/architecture/smart-oauth-trust.md.",
    "Mode": "Demo",
    "Issuer": "https://auth.cloudhealthoffice.com",
    "Audience": "fhir-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30,
    "TrustedIssuers": []
  },
  "Fhir": {
    "ServerBaseUrl": "https://api.cloudhealthoffice.com/fhir/r4",
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "ServerName": "CHO FHIR Server",
    "ServerVersion": "1.0.0"
  },
  "FhirAdapters": {
    "Mode": "Demo",
    "DataClassification": "synthetic",
    "TenantId": "demo-tenant",
    "Resources": {
      "Patient": "Demo",
      "Coverage": "Demo",
      "Encounter": "Demo",
      "Claim": "Demo",
      "ExplanationOfBenefit": "Hybrid",
      "Practitioner": "Hybrid",
      "PractitionerRole": "Hybrid",
      "Organization": "Hybrid",
      "InsurancePlan": "Hybrid",
      "Appeal": "Demo",
      "PriorAuthorization": "Demo",
      "CRD": "Demo",
      "DTR": "Demo",
      "BulkExport": "Demo",
      "Consent": "Demo",
      "Clinical": "Demo",
      "PayerToPayer": "OutOfScope"
    }
  },
  "Appeals": {
    "UseMockAdapter": true
  },
  "Cms0057": {
    "CdexAttachments": {
      "ContentContainer": "cdex-attachments",
      "MaxContentLengthBytes": 20971520,
      "AllowedContentTypes": [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/tiff",
        "text/plain",
        "text/rtf",
        "application/rtf",
        "text/xml",
        "application/xml",
        "application/hl7-cda+xml",
        "application/fhir+json",
        "application/json"
      ]
    }
  },
  "Services": {
    "TerminologyServiceUrl": "http://terminology-service.cloudhealthoffice:5010/",
    "ProviderVerificationServiceUrl": "http://provider-verification-service.cloudhealthoffice:5020/",
    "RfaiServiceUrl": "http://rfai-service.cloudhealthoffice/"
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "cloudhealthoffice"
  },
  "Observability": {
    "ServiceName": "fhir-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  },
  "Caching": {
    "Backend": "Auto"
  },
  "Clinical": {
    "PayloadLimits": {
      "MaxResourceBytes": 1048576,
      "MaxDepth": 40
    },
    "Backfill": {
      "Enabled": false,
      "DryRun": false,
      "BatchSize": 50
    }
  }
}
