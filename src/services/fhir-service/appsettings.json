{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmartAuth": {
    "Issuer": "https://auth.cloudhealthoffice.com",
    "Audience": "fhir-api",
    "RequireHttpsMetadata": true
  },
  "Fhir": {
    "ServerBaseUrl": "https://api.cloudhealthoffice.com/fhir/r4",
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "ServerName": "CHO FHIR Server",
    "ServerVersion": "1.0.0"
  },
  "FhirAdapters": {
    "Mode": "Demo",
    "DataClassification": "synthetic",
    "TenantId": "demo-tenant",
    "Resources": {
      "Patient": "Demo",
      "Coverage": "Demo",
      "Encounter": "Demo",
      "Claim": "Demo",
      "ExplanationOfBenefit": "Hybrid",
      "Practitioner": "Hybrid",
      "PractitionerRole": "Hybrid",
      "Organization": "Hybrid",
      "InsurancePlan": "Hybrid",
      "Appeal": "Demo",
      "PriorAuthorization": "Demo",
      "CRD": "Demo",
      "DTR": "Demo",
      "BulkExport": "Demo",
      "Consent": "Demo",
      "PayerToPayer": "OutOfScope"
    }
  },
  "Appeals": {
    "UseMockAdapter": true
  },
  "Cms0057": {
    "PasAutoAdjudication": {
      "Enabled": true,
      "AutoApproveServiceTypes": [],
      "AutoDenyServiceTypes": [],
      "GoldCardThreshold": 0.95,
      "DollarThreshold": 500.00,
      "MaxResponseMs": 12000
    },
    "Crd": {
      "Enabled": true,
      "AuthRequiredCodes": [],
      "AutoApprovedCodes": [],
      "DocumentationRequiredCodes": []
    },
    "Dtr": {
      "Enabled": true,
      "MaxQuestionnaireItems": 500,
      "MaxResponseSizeBytes": 1048576,
      "DtrLaunchUrl": "https://cloudhealthoffice.com/dtr/launch"
    },
    "PayerToPayerOutbound": {
      "LocalPayerId": "cloud-health-office",
      "AllowInsecureTransport": false,
      "PayersByTenant": {},
      "Transport": {
        "TimeoutSeconds": 30,
        "MaxResponseBytes": 8388608
      }
    }
  },
  "Services": {
    "TerminologyServiceUrl": "http://terminology-service.cloudhealthoffice:5010/",
    "ProviderVerificationServiceUrl": "http://provider-verification-service.cloudhealthoffice:5020/",
    "RfaiServiceUrl": "http://rfai-service.cloudhealthoffice/"
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "cloudhealthoffice"
  },
  "Observability": {
    "ServiceName": "fhir-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  },
  "Caching": {
    "Backend": "Auto"
  },
  "Cms0057": {
    "CdexAttachments": {
      "ContentContainer": "cdex-attachments",
      "MaxContentLengthBytes": 20971520,
      "AllowedContentTypes": [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/tiff",
        "text/plain",
        "text/rtf",
        "application/rtf",
        "text/xml",
        "application/xml",
        "application/hl7-cda+xml",
        "application/fhir+json",
        "application/json"
      ]
    }
  }
}
