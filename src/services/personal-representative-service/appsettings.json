{
  "ChoAuth": {
    "Outbound": {
      "_comment": "CHO hosts this service calls that are neither a Services:* URL nor under *.cloudhealthoffice: the in-cluster names its base-URL settings and code defaults use. Only these hosts receive CHO tokens (docs/security/service-auth-rollout-playbook.md).",
      "Hosts": [ "member-document-service", "tenant-service" ]
    }
  },
  "TenantService": {
    "BaseUrl": "http://tenant-service"
  },
  "MemberDocumentService": {
    "BaseUrl": "http://member-document-service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "DatabaseName": "CloudHealthOffice"
  },
  "MongoDb": {
    "DatabaseName": "CloudHealthOffice"
  },
  "PersonalRepEncryption": {
    "KeySecretPrefix": "personal-rep-body-encryption-key",
    "CurrentKeyVersion": "v1",
    "AcceptedKeyVersions": [ "v1" ]
  },
  "Kafka": {
    "BootstrapServers": "",
    "ClientId": "personal-representative-service"
  },
  "Observability": {
    "ServiceName": "personal-representative-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
