{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CloudHealthOffice.ProviderVerificationEngine": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProviderVerification": {
    "NppesApiBaseUrl": "https://npiregistry.cms.hhs.gov/api/",
    "NppesBulkDownloadUrl": "https://download.cms.gov/nppes/NPI_Files.html",
    "NlmClinicalTablesBaseUrl": "https://clinicaltables.nlm.nih.gov/api/",
    "CmsDataApiBaseUrl": "https://data.cms.gov/",
    "OpenPaymentsApiBaseUrl": "https://openpaymentsdata.cms.gov/api/1/",
    "LeieDownloadUrl": "https://oig.hhs.gov/exclusions/downloadables/",
    "SamGovApiBaseUrl": "https://api.sam.gov/entity-information/v3/",
    "SamGovApiKey": "",
    "FsmbApiBaseUrl": null,
    "FsmbClientId": null,
    "FsmbClientSecret": null,
    "DefaultTier": "Standard",
    "ReverificationInterval": "30.00:00:00",
    "MaxConcurrentVerifications": 10,
    "OpenPaymentsConflictThreshold": 25000,
    "ScoringWeights": {
      "NpiValidation": 30,
      "ExclusionScreening": 30,
      "MedicareEnrollment": 15,
      "LicenseVerification": 15,
      "ConflictOfInterest": 10
    }
  },
  "HealthChecks": {
    "EnableExternalNppesCheck": true
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "provider-verification-service",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsole": false
  }
}
