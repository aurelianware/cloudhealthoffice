<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Hl7.Fhir.R4" />
    <!-- PAS persistence seam test: authorization-service runs on a real mongod. -->
    <PackageReference Include="EphemeralMongo" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <ProjectReference Include="..\..\src\services\fhir-service\fhir-service.csproj" />
    <!-- Cross-service seam test (PAS $submit → authorization-service → $inquire).
         Aliased so authorization-service's top-level Program and namespaces do
         not collide with fhir-service's in this assembly. -->
    <ProjectReference Include="..\..\src\services\authorization-service\authorization-service.csproj" Aliases="authsvc" />
    <ProjectReference Include="..\..\src\services\shared\CloudHealthOffice.Infrastructure.Tests\CloudHealthOffice.Infrastructure.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared mongod per collection; see tests/Shared/EphemeralMongo. -->
    <Compile Include="..\Shared\EphemeralMongo\*.cs" Link="Shared\EphemeralMongo\%(Filename)%(Extension)" />
    <!-- fhir-service requires MongoDB; test hosts that never touch it use this. -->
    <Compile Include="..\Shared\FhirService\*.cs" Link="Shared\FhirService\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
