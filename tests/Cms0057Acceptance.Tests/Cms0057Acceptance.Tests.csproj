<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CMS-0057-F Acceptance Scenario Suite
    ====================================
    Executable acceptance harness proving the CMS-0057-F scenario set against
    the REAL Cloud Health Office C# services (fhir-service controllers/services,
    plus the per-engagement source-system adapter stubs in claims/provider/
    benefit-plan/authorization services). Every scenario carries a
    [Trait("Scenario","…")] so the suite can be filtered by scenario id, e.g.
    `dotnet test` with a filter expression of Scenario=PAS-03.

    Tests run in Demo mode by default (the platform default; see
    fhir-service appsettings.json FhirAdapters:Mode = "Demo"). GAP tests assert
    that the QNXT source-system adapters are still NotImplementedException stubs
    — the acceptance suite must not paper over stubs with fake "green" tests.

    The suite deliberately does NOT bootstrap a WebApplicationFactory: it
    follows the existing controller/service unit-test idiom
    (see tests/CloudHealthOffice.FhirService.Tests/Controllers/*ControllerTests.cs)
    so it can reference several service assemblies at once without the ambiguous
    top-level `Program` type that a WebApplicationFactory<Program> would require.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CMS-0057-F scenario manifest is the machine-readable source of truth.
         Copy it next to the test assembly so drift tests can load it at runtime. -->
    <Content Include="scenarios.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Hl7.Fhir.R4" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- CHO product surface: FHIR CRD/DTR/PAS/PatientAccess + compliance + adapter status. -->
    <ProjectReference Include="..\..\src\services\fhir-service\fhir-service.csproj" />

    <!-- Per-engagement source-system adapter stubs (asserted GAP by the harness). -->
    <ProjectReference Include="..\..\src\services\claims-service\claims-service.csproj" />
    <ProjectReference Include="..\..\src\services\provider-service\provider-service.csproj" />
    <ProjectReference Include="..\..\src\services\benefit-plan-service\benefit-plan-service.csproj" />
    <ProjectReference Include="..\..\src\services\authorization-service\authorization-service.csproj" />

    <!-- The additional-information (RFAI/CDex) aggregate. Referenced so PAS-07
         drives the REAL case lifecycle rather than an acceptance-only copy of
         its rules. -->
    <ProjectReference Include="..\..\src\services\rfai-service\rfai-service.csproj" />

    <!-- Consent registry (Provider Access opt-out / P2P opt-in modeling). -->
    <ProjectReference Include="..\..\src\services\consent-service\consent-service.csproj" />
  </ItemGroup>

</Project>
