<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A project may still opt out for a genuine cross-major need via
         VersionOverride="..." on its PackageReference. Those are the only
         places a version lives outside this file; keep them rare and obvious.

         Transitive pinning is deliberately NOT enabled: it forces every
         transitively-resolved package to a central version too, which breaks
         restore here (Azure.Core pulls Microsoft.Extensions.* 10.x while this
         solution targets the 8.x line). Direct references are centralized;
         transitive resolution is left to NuGet. -->
  </PropertyGroup>

  <!--
    Why this file exists.

    Package versions used to be pinned independently in 115 .csproj files. A
    grouped Dependabot bump moved three projects ahead of the rest, which broke
    `main` twice in two different build phases from one root cause: NU1605 at
    restore (benefit-plan-service pinned MongoDB.Driver below what
    CloudHealthOffice.BenefitEngine required) and then NETSDK1152 at publish
    (two Cosmos versions contributing native assets to one output). Counting the
    August MongoDB.Driver break, that is three red-CI incidents from the same
    cause. With one version per package here, that class cannot recur for any
    package without a VersionOverride.

    The overrides below are the remaining exceptions. Each is a genuine
    cross-major difference that could not be unified without a separate
    migration, and each is a candidate for consolidation on its own:

      Azure.* family      Unifying upward forces Azure.Core >= 1.55.0, which
                          pulls Microsoft.Extensions.* 10.x into a net8.0
                          solution. Verified by restore: it fails. Left at the
                          versions that build today.
      MongoDB.Driver      One project remains on 2.x; 2.x -> 3.x is a breaking
                          API change. Every other consumer is unified on 3.11.2.
      Stripe.net          45/46/47 across three projects; major API differences.
      Microsoft.Extensions.*  A few projects sit on 9.x/10.x against an 8.x base.
      FluentAssertions    One project on 7.x; v7 has breaking changes from v6.
      xunit.runner.visualstudio  Four test projects on 3.x, the rest on 2.x.
      System.IdentityModel.Tokens.Jwt / System.Security.Cryptography.Xml
                          Single projects with a transitive floor to satisfy.

    Transitive pinning is deliberately NOT enabled; see the property above.
  -->

  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="8.0.1" />
    <PackageVersion Include="Azure.Core" Version="1.44.1" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageVersion Include="Azure.Identity" Version="1.13.2" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.17.5" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="bunit" Version="1.28.9" />
    <PackageVersion Include="Confluent.Kafka" Version="2.8.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="EphemeralMongo7" Version="2.0.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Hl7.Fhir.R4" Version="5.10.2" />
    <PackageVersion Include="MessagePack" Version="2.5.301" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.25" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.25" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.25" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.11" />
