# =============================================================================
# CHO Secrets Manifest — Azure Key Vault
# =============================================================================
# Format: SECRET_NAME=secret_value
# Secret names use "--" as hierarchy delimiter (mapped to ":" in .NET config).
#
# Usage:
#   ./scripts/populate-keyvault-secrets.sh \
#     --vault-name cho-app-kv \
#     --file scripts/secrets-manifest.example.env
#
# ⚠  Replace ALL placeholder values before running.
# ⚠  NEVER commit this file with real values. Add to .gitignore.
# =============================================================================

# ── Database (CosmosDB / MongoDB) ──────────────────────────────────────────
CosmosDb--ConnectionString=AccountEndpoint=https://ACCOUNT.documents.azure.com:443/;AccountKey=REPLACE_ME;
CosmosDb--Endpoint=https://ACCOUNT.documents.azure.com:443/
CosmosDb--Key=REPLACE_ME
MongoDb--Username=admin
MongoDb--Password=REPLACE_ME

# ── Redis ──────────────────────────────────────────────────────────────────
Redis--ConnectionString=redis-dataprotection.cloudhealthoffice.svc.cluster.local:6379,password=REPLACE_ME

# ── Kafka ──────────────────────────────────────────────────────────────────
Kafka--SaslUsername=REPLACE_ME
Kafka--SaslPassword=REPLACE_ME

# ── Azure Storage ─────────────────────────────────────────────────────────
Azure--StorageConnectionString=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net

# ── Azure AD (Portal Authentication) ──────────────────────────────────────
AzureAd--TenantId=REPLACE_ME
AzureAd--ClientId=REPLACE_ME
AzureAd--ClientSecret=REPLACE_ME
AzureAd--Audience=api://REPLACE_ME

# ── Stripe (Billing) ─────────────────────────────────────────────────────
Stripe--PublishableKey=pk_live_REPLACE_ME
Stripe--SecretKey=sk_live_REPLACE_ME
Stripe--WebhookSecret=whsec_REPLACE_ME
Stripe--Price--Starter=price_REPLACE_ME
Stripe--Price--Professional=price_REPLACE_ME

# ── SFTP (EDI File Transfer) ─────────────────────────────────────────────
Sftp--Host=sftp.example.com
Sftp--Username=logicapp
Sftp--Password=REPLACE_ME

# ── Application Insights / Observability ──────────────────────────────────
ApplicationInsights--ConnectionString=InstrumentationKey=REPLACE_ME;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# ── Service Bus ──────────────────────────────────────────────────────────
ServiceBus--ConnectionString=Endpoint=sb://NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=REPLACE_ME

# ── Pricing API ──────────────────────────────────────────────────────────
PricingApi--AdminSecret=REPLACE_ME

# ── Seed Admin (Initial Tenant Bootstrap) ────────────────────────────────
SeedAdmin--Email=admin@example.com
SeedAdmin--DisplayName=System Administrator

# ── Email / SMTP ─────────────────────────────────────────────────────────
Email--SmtpHost=smtp.example.com
Email--SmtpPort=587
Email--EnableSsl=true
Email--FromAddress=noreply@cloudhealthoffice.com
Email--SalesTeamAddress=sales@cloudhealthoffice.com
Email--Username=REPLACE_ME
Email--Password=REPLACE_ME

# ── Availity (Clearinghouse Integration) ─────────────────────────────────
Availity--Sandbox--ClientId=REPLACE_ME
Availity--Sandbox--ClientSecret=REPLACE_ME
Availity--Sandbox--BaseUrl=https://api.availity.com/availity/v1

Availity--Production--ClientId=REPLACE_ME
Availity--Production--ClientSecret=REPLACE_ME
Availity--Production--BaseUrl=https://api.availity.com/availity/v1

# ── Anthropic (AI Claims Examiner) ───────────────────────────────────────
# Used by claims-examiner-service to call Claude with NCCI bundling context
# for pend-resolution recommendations. Advisory only in v1 — never auto-applies.
# Bound at Program.cs via Configuration.GetSection("Anthropic").Get<AnthropicOptions>()
# after AddAzureKeyVaultConfiguration runs, so the `--` → `:` mapping lands it
# at config key `Anthropic:ApiKey`.
Anthropic--ApiKey=sk-ant-api03-REPLACE_ME
