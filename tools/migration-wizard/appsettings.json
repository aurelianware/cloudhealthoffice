{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MigrationWizard": "Debug"
    }
  },
  "AllowedHosts": "*",

  "TriZetto": {
    "EndpointUrl": "https://qnxt-server.example.com/OpenAccess/Services",
    "Username": "your-username",
    "Password": "your-password",
    "TenantId": "default-tenant",
    "TimeoutSeconds": 120,
    "_comment": "Replace with actual TriZetto Open Access SOAP API credentials. In production, use Azure Key Vault references."
  },

  "CosmosDb": {
    "Endpoint": "https://your-cosmos-account.documents.azure.com:443/",
    "Key": "your-cosmos-primary-key",
    "DatabaseName": "cloudhealthoffice",
    "MembersContainer": "Members",
    "ProvidersContainer": "ProviderDirectory",
    "BenefitPlansContainer": "BenefitPlans",
    "_comment": "Replace with actual Cosmos DB credentials. In production, use Managed Identity or Key Vault."
  },

  "ApiManagement": {
    "ServiceName": "your-apim-service-name",
    "ResourceGroup": "your-resource-group",
    "SubscriptionId": "your-azure-subscription-id",
    "RoutingKeyName": "backend-routing",
    "QnxtBackendId": "qnxt-backend",
    "CloudHealthOfficeBackendId": "cloudhealthoffice-backend",
    "_comment": "Azure API Management configuration for traffic cutover."
  }
}
