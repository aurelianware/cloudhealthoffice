{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MigrationWizard": "Debug"
    }
  },
  "AllowedHosts": "*",

  "TriZetto": {
    "EndpointUrl": "https://qnxt-server.example.com/OpenAccess/Services",
    "Username": "REPLACE_WITH_KEYVAULT_REFERENCE",
    "Password": "REPLACE_WITH_KEYVAULT_REFERENCE",
    "TenantId": "default-tenant",
    "TimeoutSeconds": 120,
    "BypassCertificateValidation": false,
    "_comment_1": "SECURITY: Do NOT store credentials in this file for production.",
    "_comment_2": "Use Azure Key Vault references: @Microsoft.KeyVault(SecretUri=https://your-vault.vault.azure.net/secrets/trizetto-password/)"
  },

  "CosmosDb": {
    "Endpoint": "https://your-cosmos-account.documents.azure.com:443/",
    "Key": "REPLACE_WITH_KEYVAULT_REFERENCE",
    "DatabaseName": "cloudhealthoffice",
    "MembersContainer": "Members",
    "ProvidersContainer": "ProviderDirectory",
    "BenefitPlansContainer": "BenefitPlans",
    "DefaultThroughput": 400,
    "_comment_1": "SECURITY: In production, use Managed Identity instead of access keys.",
    "_comment_2": "Or use Key Vault reference: @Microsoft.KeyVault(SecretUri=https://your-vault.vault.azure.net/secrets/cosmos-key/)"
  },

  "ApiManagement": {
    "ServiceName": "your-apim-service-name",
    "ResourceGroup": "your-resource-group",
    "SubscriptionId": "your-azure-subscription-id",
    "RoutingKeyName": "backend-routing",
    "QnxtBackendId": "qnxt-backend",
    "CloudHealthOfficeBackendId": "cloudhealthoffice-backend",
    "_comment": "Azure API Management configuration for traffic cutover. Uses Azure AD authentication."
  }
}
