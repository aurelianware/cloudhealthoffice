<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProviderContractBackfill</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The legal contract, the term type and the legal → pricing projection. The
      FFS and capitation rate configs are read as BsonDocument instead of by
      project reference: nothing has ever written the FfsRateConfig collection
      (ffs-service has no repository), so a tolerant reader is the right one.
    -->
    <ProjectReference Include="..\..\src\services\provider-contracts-service\provider-contracts-service.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests drive plan and apply through the tool's own entry points. -->
    <InternalsVisibleTo Include="ProviderContractBackfill.Tests" />
  </ItemGroup>

</Project>
