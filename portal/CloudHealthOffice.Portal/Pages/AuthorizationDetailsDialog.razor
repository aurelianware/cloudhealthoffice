@using CloudHealthOffice.Portal.Services
@inject IAuthorizationService AuthorizationService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_authorization != null)
        {
            <!-- Status Header -->
            <MudAlert Severity="@GetSeverity(_authorization.Status)" Class="mb-4">
                <MudText Typo="Typo.h6">
                    Status: @_authorization.Status
                    @if (_authorization.DecisionDate.HasValue)
                    {
                        <span> • Decision made @_authorization.DecisionDate.Value.ToString("MM/dd/yyyy hh:mm tt")</span>
                    }
                </MudText>
                @if (_authorization.ProcessingTimeMs > 0)
                {
                    <MudText Typo="Typo.body2">
                        Processing time: @FormatProcessingTime(_authorization.ProcessingTimeMs)
                    </MudText>
                }
            </MudAlert>

            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
                <!-- General Info Tab -->
                <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Info">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Authorization ID" 
                                        Value="_authorization.AuthorizationId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service Type" 
                                        Value="_authorization.ServiceType" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Request Date" 
                                        Value="_authorization.RequestDate.ToString("MM/dd/yyyy hh:mm tt")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Decision Date" 
                                        Value="@(_authorization.DecisionDate?.ToString("MM/dd/yyyy hh:mm tt") ?? "Pending")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Member Info Tab -->
                <MudTabPanel Text="Member" Icon="@Icons.Material.Filled.Person">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member ID" 
                                        Value="_authorization.MemberId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Member Name" 
                                        Value="_authorization.MemberName" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Provider Info Tab -->
                <MudTabPanel Text="Provider" Icon="@Icons.Material.Filled.LocalHospital">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Provider ID" 
                                        Value="_authorization.ProviderId" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Provider Name" 
                                        Value="_authorization.ProviderName" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Service Details Tab -->
                <MudTabPanel Text="Service Details" Icon="@Icons.Material.Filled.MedicalServices">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Diagnosis Code" 
                                        Value="_authorization.DiagnosisCode" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Diagnosis Description" 
                                        Value="_authorization.DiagnosisDescription" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Procedure Code" 
                                        Value="_authorization.ProcedureCode" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Procedure Description" 
                                        Value="_authorization.ProcedureDescription" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Units Requested" 
                                        Value="_authorization.UnitsRequested.ToString()" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Units Approved" 
                                        Value="@(_authorization.UnitsApproved?.ToString() ?? "N/A")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Approval Rate" 
                                        Value="@GetApprovalRate()" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service Start Date" 
                                        Value="_authorization.ServiceStartDate.ToString("MM/dd/yyyy")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Service End Date" 
                                        Value="@(_authorization.ServiceEndDate?.ToString("MM/dd/yyyy") ?? "N/A")" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Review Notes Tab -->
                <MudTabPanel Text="Review" Icon="@Icons.Material.Filled.Assignment">
                    <div class="mt-4">
                        @if (!string.IsNullOrWhiteSpace(_authorization.ReviewerNotes))
                        {
                            <MudTextField Label="Reviewer Notes" 
                                        Value="_authorization.ReviewerNotes" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined"
                                        Lines="5" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">No reviewer notes available</MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(_authorization.DenialReason))
                        {
                            <MudTextField Label="Denial Reason" 
                                        Value="_authorization.DenialReason" 
                                        ReadOnly="true" 
                                        Variant="Variant.Outlined"
                                        Lines="3"
                                        Class="mt-4" />
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Failed to load authorization details</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        @if (_authorization != null && _authorization.Status == "Approved")
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print">
                Print Approval
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string AuthorizationId { get; set; } = string.Empty;

    private AuthorizationDetails? _authorization;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorizationDetails();
    }

    private async Task LoadAuthorizationDetails()
    {
        _loading = true;

        try
        {
            _authorization = await AuthorizationService.GetAuthorizationByIdAsync(AuthorizationId);
        }
        catch (Exception ex)
        {
            _authorization = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Severity GetSeverity(string status)
    {
        return status switch
        {
            "Approved" => Severity.Success,
            "Denied" => Severity.Error,
            "Pending" => Severity.Warning,
            "Review Required" => Severity.Info,
            _ => Severity.Normal
        };
    }

    private string FormatProcessingTime(int ms)
    {
        if (ms < 1000)
            return $"{ms}ms";
        else if (ms < 60000)
            return $"{ms / 1000.0:F1}s";
        else
            return $"{ms / 60000.0:F1}m";
    }

    private string GetApprovalRate()
    {
        if (_authorization?.UnitsApproved == null || _authorization.UnitsRequested == 0)
            return "N/A";

        var rate = (_authorization.UnitsApproved.Value / (double)_authorization.UnitsRequested) * 100;
        return $"{rate:F0}%";
    }

    private void Close() => MudDialog.Close();
}
