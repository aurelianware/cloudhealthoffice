@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="3" Dense="true" Style="border-bottom: 1px solid rgba(0, 255, 255, 0.3);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        
        <!-- The Sentinel Logo -->
        <img src="/images/logo-cloudhealthoffice-sentinel-primary.svg" 
             alt="Cloud Health Office - The Sentinel" 
             style="height: 32px; margin-left: 12px; margin-right: 16px; filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.4));" />
        
        <MudText Typo="Typo.h6" Style="font-weight: 700; background: linear-gradient(135deg, #00ffff, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            Cloud Health Office
        </MudText>
        
        <MudSpacer />
        
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Style="border: 1px solid rgba(0, 255, 255, 0.4); background: rgba(0, 255, 255, 0.05);">
            Demo Health Plan
        </MudChip>
        
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Primary" Style="margin-left: 12px;" />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" />
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="3" Style="border-right: 1px solid rgba(0, 255, 255, 0.2);">
        <div style="padding: 24px 16px; border-bottom: 1px solid rgba(0, 255, 255, 0.2);">
            <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.5); text-transform: uppercase; letter-spacing: 0.1em;">
                Navigation
            </MudText>
        </div>
        
        <MudNavMenu Style="padding-top: 8px;">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" 
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/claims" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Claims
            </MudNavLink>
            <MudNavLink Href="/eligibility" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VerifiedUser"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Eligibility
            </MudNavLink>
            <MudNavLink Href="/members" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Members
            </MudNavLink>
            <MudNavLink Href="/sponsors" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Sponsors
            </MudNavLink>
            <MudNavLink Href="/benefit-plans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HealthAndSafety"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Benefit Plans
            </MudNavLink>
            <MudNavLink Href="/providers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalHospital"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Providers
            </MudNavLink>
            <MudNavLink Href="/authorizations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Authorizations
            </MudNavLink>
            <MudNavLink Href="/workflows" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Workflows
            </MudNavLink>
            <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Reports
            </MudNavLink>
            
            <MudDivider Style="margin: 16px 0; border-color: rgba(0, 255, 255, 0.2);" />
            
            <MudNavLink Href="/reference-data" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Code"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Reference Data
            </MudNavLink>
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings"
                        Style="border-left: 3px solid transparent; transition: all 0.3s ease;">
                Settings
            </MudNavLink>
        </MudNavMenu>
        
        <!-- Footer branding in drawer -->
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 16px; border-top: 1px solid rgba(0, 255, 255, 0.2); text-align: center;">
            <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.4);">
                The Sentinel
            </MudText>
            <MudText Typo="Typo.caption" Style="color: rgba(0, 255, 255, 0.6); margin-top: 4px;">
                v3.0 Production
            </MudText>
        </div>
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private MudTheme _theme = new()
    {
        // The Sentinel Theme - Obsidian & Neon
        Palette = new PaletteLight
        {
            // Core brand colors
            Primary = "#00ffff",           // Cyan - primary actions
            Secondary = "#ff00ff",         // Magenta - secondary elements  
            Tertiary = "#00ff88",          // Green - success states
            
            // Backgrounds - absolute black
            Background = "#000000",
            BackgroundGrey = "#0a0a0a",
            Surface = "#0f0f0f",
            DrawerBackground = "#000000",
            AppbarBackground = "#000000",
            
            // Text - high contrast white
            TextPrimary = "#ffffff",
            TextSecondary = "rgba(255, 255, 255, 0.7)",
            TextDisabled = "rgba(255, 255, 255, 0.38)",
            
            // Semantic colors - neon palette
            Success = "#00ff88",           // Neon green
            Error = "#ff0055",             // Neon red/pink
            Warning = "#ffaa00",           // Neon orange
            Info = "#00ffff",              // Cyan
            
            // Borders and dividers
            Divider = "rgba(0, 255, 255, 0.2)",
            DividerLight = "rgba(0, 255, 255, 0.1)",
            
            // Actions and overlays
            ActionDefault = "rgba(0, 255, 255, 0.54)",
            ActionDisabled = "rgba(255, 255, 255, 0.26)",
            ActionDisabledBackground = "rgba(255, 255, 255, 0.12)",
            
            // Hover effects - neon glow
            HoverOpacity = 0.15,
            
            // Lines
            LinesDefault = "rgba(0, 255, 255, 0.2)",
            LinesInputs = "rgba(0, 255, 255, 0.3)"
        },
        
        Typography = new Typography()
        {
            Default = new Default()
            {
                FontFamily = new[] { "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif" },
                FontWeight = 400,
                FontSize = "0.875rem",
                LineHeight = 1.43,
                LetterSpacing = "0.01071em"
            },
            H1 = new H1()
            {
                FontFamily = new[] { "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif" },
                FontWeight = 700,  // Bold - The Sentinel aesthetic
                FontSize = "3rem",
                LineHeight = 1.167,
                LetterSpacing = "-0.01562em"
            },
            H2 = new H2()
            {
                FontFamily = new[] { "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif" },
                FontWeight = 700,
                FontSize = "2.125rem",
                LineHeight = 1.235,
                LetterSpacing = "-0.00833em"
            },
            H6 = new H6()
            {
                FontFamily = new[] { "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif" },
                FontWeight = 700,
                FontSize = "1.25rem",
                LineHeight = 1.6,
                LetterSpacing = "0.0075em"
            }
        },
        
        Shadows = new Shadow()
        {
            // Neon glow effects instead of standard shadows (MudBlazor requires 25 elevation levels)
            Elevation = new string[]
            {
                "none",                                                                     // 0
                "0 0 10px rgba(0, 255, 255, 0.2)",                                        // 1
                "0 0 15px rgba(0, 255, 255, 0.3)",                                        // 2
                "0 0 20px rgba(0, 255, 255, 0.4), 0 0 30px rgba(255, 0, 255, 0.1)",      // 3
                "0 0 25px rgba(0, 255, 255, 0.5), 0 0 40px rgba(255, 0, 255, 0.2)",      // 4
                "0 0 30px rgba(0, 255, 255, 0.6), 0 0 50px rgba(255, 0, 255, 0.3)",      // 5
                "0 0 35px rgba(0, 255, 255, 0.6), 0 0 60px rgba(255, 0, 255, 0.3)",      // 6
                "0 0 40px rgba(0, 255, 255, 0.7), 0 0 70px rgba(255, 0, 255, 0.4)",      // 7
                "0 0 45px rgba(0, 255, 255, 0.7), 0 0 80px rgba(255, 0, 255, 0.4)",      // 8
                "0 0 50px rgba(0, 255, 255, 0.8), 0 0 90px rgba(255, 0, 255, 0.5)",      // 9
                "0 0 55px rgba(0, 255, 255, 0.8), 0 0 100px rgba(255, 0, 255, 0.5)",     // 10
                "0 0 60px rgba(0, 255, 255, 0.9), 0 0 110px rgba(255, 0, 255, 0.6)",     // 11
                "0 0 65px rgba(0, 255, 255, 0.9), 0 0 120px rgba(255, 0, 255, 0.6)",     // 12
                "0 0 70px rgba(0, 255, 255, 1.0), 0 0 130px rgba(255, 0, 255, 0.7)",     // 13
                "0 0 75px rgba(0, 255, 255, 1.0), 0 0 140px rgba(255, 0, 255, 0.7)",     // 14
                "0 0 80px rgba(0, 255, 255, 1.0), 0 0 150px rgba(255, 0, 255, 0.8)",     // 15
                "0 0 85px rgba(0, 255, 255, 1.0), 0 0 160px rgba(255, 0, 255, 0.8)",     // 16
                "0 0 90px rgba(0, 255, 255, 1.0), 0 0 170px rgba(255, 0, 255, 0.9)",     // 17
                "0 0 95px rgba(0, 255, 255, 1.0), 0 0 180px rgba(255, 0, 255, 0.9)",     // 18
                "0 0 100px rgba(0, 255, 255, 1.0), 0 0 190px rgba(255, 0, 255, 1.0)",    // 19
                "0 0 105px rgba(0, 255, 255, 1.0), 0 0 200px rgba(255, 0, 255, 1.0)",    // 20
                "0 0 110px rgba(0, 255, 255, 1.0), 0 0 210px rgba(255, 0, 255, 1.0)",    // 21
                "0 0 115px rgba(0, 255, 255, 1.0), 0 0 220px rgba(255, 0, 255, 1.0)",    // 22
                "0 0 120px rgba(0, 255, 255, 1.0), 0 0 230px rgba(255, 0, 255, 1.0)",    // 23
                "0 0 125px rgba(0, 255, 255, 1.0), 0 0 240px rgba(255, 0, 255, 1.0)"     // 24
            }
        }
    };

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
