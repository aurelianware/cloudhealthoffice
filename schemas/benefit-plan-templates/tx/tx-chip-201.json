  "notModeled": [
    {
      "item": "Prior authorization lists",
      "why": "PA requirements are MCO policy within UMCM limits; load them as prior-auth rules per plan, not as benefit flags.",
      "status": "verify"
    },
    {
      "item": "Value-added services",
      "why": "MCO-specific extras (for example adult dental, gift cards, extra vision) approved by HHSC per contract; not a state benefit.",
      "status": "verify"
    },
    {
      "item": "Formulary",
      "why": "Outpatient drugs follow the state Vendor Drug Program formulary and preferred drug list; CHO has no formulary resolution yet (capability 5.14).",
      "status": "verify"
    },
    {
      "item": "Cost-sharing cap of 5% of family income",
      "why": "The cap is per household and depends on income for the certification period; CHO's out-of-pocket maximum is a fixed dollar amount on the plan. The enrollment broker tracks it (households report at 4.75%).",
      "status": "sourced",
      "source": "hhsc-chip-cost-sharing"
    },
    {
      "item": "Non-emergency ER copay ($75)",
      "why": "CHO cost sharing cannot tell an emergent ER visit from a non-emergent one.",
      "status": "sourced",
      "source": "hhsc-chip-cost-sharing"
    },
    {
      "item": "Enrollment fee ($50 per household per term)",
      "why": "A premium-billing item, not a claim cost share.",
      "status": "sourced",
      "source": "hhsc-chip-cost-sharing"
    },
    {
      "item": "American Indian, Alaska Native and unaccompanied refugee minor exemptions",
      "why": "Member-level exemption from all cost sharing; needs a member attribute that zeroes copays.",
      "status": "sourced",
      "source": "hhsc-chip-cost-sharing"
    },
    {
      "item": "Tobacco cessation ($100 per 12-month period)",
      "why": "No CHO service category for tobacco cessation programs.",
      "status": "sourced",
      "source": "tchp-chip-benefits"
    },
    {
      "item": "Frequency limits (one eye exam and one pair of eyewear per 12 months)",
      "why": "Kept as text: a CHO visit limit counts every claim in the category, so it would deny the eyewear after the exam.",
      "status": "sourced",
      "source": "tchp-chip-benefits"
    },
    {
      "item": "Prenatal visit schedule",
      "why": "Not applicable to CHIP members; see the CHIP Perinatal templates.",
      "status": "sourced",
      "source": "tchp-chip-benefits"
    }
  ],
