  "notModeled": [
    {
      "item": "Prior authorization lists",
      "why": "PA requirements are MCO policy within UMCM limits; load them as prior-auth rules per plan, not as benefit flags.",
      "status": "verify"
    },
    {
      "item": "Value-added services",
      "why": "MCO-specific extras (for example adult dental, gift cards, extra vision) approved by HHSC per contract; not a state benefit.",
      "status": "verify"
    },
    {
      "item": "Formulary",
      "why": "Outpatient drugs follow the state Vendor Drug Program formulary and preferred drug list; CHO has no formulary resolution yet (capability 5.14).",
      "status": "verify"
    },
    {
      "item": "30-day spell of illness",
      "why": "Rolling per-spell inpatient day limit; CHO benefit limits count visits or dollars per year.",
      "status": "sourced",
      "source": "molina-spell-of-illness"
    },
    {
      "item": "Long-term services and supports (HCBS waiver)",
      "why": "Personal attendant services, day activity and health services, adult foster care, assisted living, respite, adaptive aids, minor home modifications, emergency response and others are authorized through the individual service plan with cost ceilings; CHO has no LTSS service plan or service categories.",
      "status": "sourced",
      "source": "starplus-hcbs"
    },
    {
      "item": "Nursing facility",
      "why": "Custodial nursing facility days with applied income (member liability set by the state) are not a benefit-plan cost share.",
      "status": "verify"
    },
    {
      "item": "Dual eligibles",
      "why": "Medicare pays first; Medicaid pays Medicare cost sharing. Handled through coordination of benefits, not this plan.",
      "status": "verify"
    },
    {
      "item": "Service coordination",
      "why": "Care management function, not a claim benefit.",
      "status": "verify"
    }
  ],
