      "item": "Prior authorization lists",
      "why": "PA requirements are MCO policy within UMCM limits; load them as prior-auth rules per plan, not as benefit flags.",
      "status": "verify"
    },
    {
      "item": "Value-added services",
      "why": "MCO-specific extras (for example adult dental, gift cards, extra vision) approved by HHSC per contract; not a state benefit.",
      "status": "verify"
    },
    {
      "item": "Formulary",
      "why": "Outpatient drugs follow the state Vendor Drug Program formulary and preferred drug list; CHO has no formulary resolution yet (capability 5.14).",
      "status": "verify"
    },
    {
      "item": "Coverage conditioned on diagnosis",
      "why": "Emergency, ambulance and outpatient coverage applies only to pregnancy-related diagnoses; needs diagnosis rule predicates authored per plan.",
      "status": "sourced",
      "source": "tchp-chip-perinatal"
    },
    {
      "item": "Prenatal visit limit (20 plus 2 postpartum)",
      "why": "Kept as text: a CHO visit limit counts every maternity claim (delivery, labs), and high-risk pregnancies are exempt.",
      "status": "sourced",
      "source": "tchp-chip-perinatal"
    },
    {
      "item": "Newborn transition",
      "why": "At birth the newborn moves to 12 months of continuous CHIP (or Medicaid) coverage; that is an enrollment event onto the CHIP plan, not part of this plan.",
      "status": "sourced",
      "source": "tchp-chip-perinatal"
    },
    {
      "item": "Postpartum care for the mother",
      "why": "Limited to the 2 postpartum visits; other services for the mother after delivery are excluded.",
      "status": "sourced",
      "source": "tchp-chip-perinatal"
    }
  ],
