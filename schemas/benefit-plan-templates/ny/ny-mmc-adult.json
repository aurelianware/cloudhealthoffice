      "status": "sourced"
    },
    {
      "item": "Non-pharmacy Medicaid copayments",
      "why": "State fee-for-service schedule (clinic, lab, imaging, non-urgent ER); whether a managed care plan applies any is set by the model contract. Template uses $0.",
      "status": "verify"
    },
    {
      "item": "Dental",
      "why": "Mainstream managed care covers dental, but CHO has no dental service category; route to the plan's dental benefit.",
      "status": "verify"
    },
    {
      "item": "Dual eligibles",
      "why": "Medicare pays first; duals are usually in MLTC, MAP or D-SNP products rather than mainstream managed care.",
