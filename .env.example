# .env.example — Copy to .env and customise for local development
# Used by: docker compose -f docker-compose.development.yml up -d
#
# Every value here is a LOCAL-DEVELOPMENT PLACEHOLDER, not a credential.
# The services it configures listen only on the local compose network.
# Never reuse these values in a shared or production environment.
#
# Changing a password after a container has already initialised its volume
# will not take effect — the volume keeps the original credential. Reset with:
#   docker compose -f docker-compose.development.yml down -v

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=local-dev-only
MONGO_DATABASE=cloudhealthoffice
MONGO_PORT=27017

# Redis
REDIS_PORT=6379
